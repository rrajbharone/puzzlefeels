<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/" aria-label="PuzzleFeels home"><span class="mark" aria-hidden="true"><svg viewBox="0 0 40 40"><path d="M5 5h12v8a5 5 0 1 0 0 10v12H8a3 3 0 0 1-3-3V5Zm17 0h10a3 3 0 0 1 3 3v10h-8a5 5 0 1 0-5-5V5Z" fill="currentColor"/></svg></span><span>Puzzle<span>Feels</span></span></a>
    <button class="menu" type="button" aria-label="Open navigation menu" aria-expanded="false" aria-controls="nav">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path class="menu-line line-top" d="M4 6h16"/><path class="menu-line line-middle" d="M4 12h16"/><path class="menu-line line-bottom" d="M4 18h16"/></svg>
    </button>
    <nav id="nav" aria-label="Main navigation">
      <a href="/">Home</a><a href="/games/">All Games</a><a href="/#daily">Daily Challenge</a><a href="/about/">About</a>
    </nav>
    <button class="theme-toggle" type="button" role="switch" aria-label="Switch to dark mode" aria-checked="false"><svg class="sun-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"/></svg><svg class="moon-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.2 15.2A8.5 8.5 0 0 1 8.8 3.8 8.5 8.5 0 1 0 20.2 15.2Z"/><path d="m16.5 3 .5 1.5 1.5.5-1.5.5-.5 1.5-.5-1.5-1.5-.5 1.5-.5.5-1.5Z"/></svg></button>
  </div>
</header>
<style>
  .site-header{height:76px;background:#ffffffd9;border-bottom:1px solid #e7eaf1;position:sticky;top:0;z-index:20;backdrop-filter:blur(14px)}
  .bar{height:100%;display:flex;align-items:center;gap:24px}
  .brand{font-size:19px;font-weight:800;letter-spacing:-.04em;display:flex;align-items:center;gap:9px}
  .brand>span:last-child>span{color:#315ee8}
  .mark{display:grid;place-items:center;background:#315ee8;color:white;border-radius:12px;width:34px;height:34px}
  .mark svg{width:25px}
  .bar nav{display:flex;align-items:center;gap:28px;margin-left:auto;color:#59667d;font-size:14px;font-weight:600}
  .bar nav a{transition:color .18s ease;display:inline-flex;align-items:center;padding:6px 0}
  .bar nav a:hover{color:#315ee8}
  .bar nav a:focus-visible{outline:2px solid #315ee8;outline-offset:3px;border-radius:4px;color:#315ee8}
  .theme-toggle{width:44px;min-width:44px;min-height:44px;display:grid;place-items:center;padding:0;border:1px solid #e7eaf1;border-radius:13px;background:#fff;color:#394761;cursor:pointer;transition:background-color .18s,border-color .18s,color .18s,transform .18s,box-shadow .18s}
  .theme-toggle:hover{background:#f3f6ff;border-color:#cdd8ff;box-shadow:0 4px 12px #233c9014;transform:translateY(-1px)}
  .theme-toggle svg{width:20px;height:20px;grid-area:1/1;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round;transition:opacity .2s ease,transform .28s cubic-bezier(.2,.75,.25,1)}
  .theme-toggle .sun-icon{opacity:1;transform:rotate(0) scale(1)}.theme-toggle .moon-icon{opacity:0;transform:rotate(-35deg) scale(.72)}.theme-toggle:active{transform:scale(.96)}
  .menu{display:none}
  :global(html[data-theme="dark"]) .bar nav{color:#b8c4dd}
  :global(html[data-theme="dark"]) .bar nav a:hover,
  :global(html[data-theme="dark"]) .bar nav a:focus-visible{color:#a9bcff;outline-color:#a9bcff}
  :global(html[data-theme="dark"]) .menu{background:#151f3d;border-color:#293858;color:#f1f5ff}
  :global(html[data-theme="dark"]) .menu:hover{background:#1b294b;border-color:#52678f}
  :global(html[data-theme="dark"]) .menu:focus-visible{outline-color:#a9bcff}
  @media(max-width:680px){
    .site-header{height:66px}.bar{gap:14px}
    .bar nav{display:flex;position:absolute;top:65px;left:0;right:0;padding:12px 20px 16px;background:white;border-bottom:1px solid #e7eaf1;box-shadow:0 15px 20px #17233b0d;align-items:stretch;gap:2px;flex-direction:column;margin:0;opacity:0;visibility:hidden;transform:translateY(-8px);pointer-events:none;transition:opacity .18s ease,transform .18s ease,visibility .18s ease}
    .bar nav.open{opacity:1;visibility:visible;transform:translateY(0);pointer-events:auto}
    .bar nav a{display:flex;align-items:center;min-height:48px;padding:10px 4px;border-bottom:1px solid #edf0f6}
    .bar nav a:last-child{border-bottom:0}
    .menu{display:grid;place-items:center;order:3;flex:0 0 44px;width:44px;height:44px;margin:0;padding:10px;border:1px solid #e7eaf1;border-radius:12px;background:#fff;color:#27344f;cursor:pointer;transition:background-color .18s,border-color .18s,color .18s,transform .18s}
    .menu:hover{background:#f3f6ff;border-color:#cdd8ff}.menu:active{transform:scale(.96)}
    .menu svg{width:22px;height:22px;overflow:visible}.menu-line{fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;transform-origin:12px 12px;transition:transform .2s ease,opacity .16s ease}
    .menu[aria-expanded="true"] .line-top{transform:translateY(6px) rotate(45deg)}.menu[aria-expanded="true"] .line-middle{opacity:0}.menu[aria-expanded="true"] .line-bottom{transform:translateY(-6px) rotate(-45deg)}
    .theme-toggle{order:2;width:44px;padding:0;margin-left:auto}
  }
  @media(prefers-reduced-motion:reduce){.bar nav,.menu,.menu-line{transition:none}}
</style>
<script>
  const menuButton = document.querySelector('.menu');
  const nav = document.querySelector('#nav');
  const mobileMenu = window.matchMedia('(max-width: 680px)');
  function setMenuOpen(open) {
    menuButton?.setAttribute('aria-expanded', String(open));
    menuButton?.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu');
    nav?.classList.toggle('open', open);
    nav?.setAttribute('aria-hidden', String(!open && mobileMenu.matches));
    if (nav) nav.inert = !open && mobileMenu.matches;
  }
  setMenuOpen(false);
  menuButton?.addEventListener('click', () => setMenuOpen(menuButton.getAttribute('aria-expanded') !== 'true'));
  nav?.addEventListener('click', event => {
    if (event.target instanceof Element && event.target.closest('a')) setMenuOpen(false);
  });
  document.addEventListener('click', event => {
    if (mobileMenu.matches && menuButton?.getAttribute('aria-expanded') === 'true' &&
      event.target instanceof Node && !nav?.contains(event.target) && !menuButton.contains(event.target)) setMenuOpen(false);
  });
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && menuButton?.getAttribute('aria-expanded') === 'true') {
      setMenuOpen(false);
      menuButton?.focus();
    }
  });
  mobileMenu.addEventListener('change', event => setMenuOpen(false));

  const themeToggle=document.querySelector('.theme-toggle');const themeKey='puzzlefeels-theme';const media=window.matchMedia('(prefers-color-scheme: dark)');function applyTheme(theme){const dark=theme==='dark';document.documentElement.dataset.theme=dark?'dark':'light';document.documentElement.style.colorScheme=dark?'dark':'light';themeToggle?.setAttribute('aria-checked',String(dark));themeToggle?.setAttribute('aria-label',dark?'Switch to light mode':'Switch to dark mode');const meta=document.querySelector('meta[name="theme-color"]');meta?.setAttribute('content',dark?'#0B132B':'#f7f8fc')}function savedTheme(){try{const value=localStorage.getItem(themeKey);return value==='dark'||value==='light'?value:null}catch{return null}}themeToggle?.addEventListener('click',()=>{const theme=document.documentElement.dataset.theme==='dark'?'light':'dark';applyTheme(theme);try{localStorage.setItem(themeKey,theme)}catch{}});media.addEventListener?.('change',event=>{if(!savedTheme())applyTheme(event.matches?'dark':'light')});window.addEventListener('storage',event=>{if(event.key===themeKey)applyTheme(event.newValue==='dark'?'dark':event.newValue==='light'?'light':media.matches?'dark':'light')});applyTheme(document.documentElement.dataset.theme||'light');
</script>
