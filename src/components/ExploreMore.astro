---
import { ALL_GAMES, type GameCatalogItem } from '../data/games';

interface Props {
  currentGameId: string;
  recommendations?: string[];
  eyebrow?: string;
  heading?: string;
  description?: string;
}

const {
  currentGameId,
  recommendations,
  eyebrow = 'Keep Your Brain Sharp',
  heading = 'Explore More Puzzle Games',
  description = 'Challenge your mind with our curated collection of free, high-focus browser puzzle games.'
} = Astro.props;

// Curated 3 recommendations for every game on PuzzleFeels
const DEFAULT_RECOMMENDATIONS: Record<string, string[]> = {
  'sliding-puzzle': ['number-sequence', 'color-flood', 'picross'],
  'mahjong-variants': ['memory-matching', 'picross', 'sliding-puzzle'],
  'memory-matching': ['sliding-puzzle', 'reaction-time', 'word-ladder'],
  'word-ladder': ['number-sequence', 'picross', 'sliding-puzzle'],
  'picross': ['sliding-puzzle', 'color-flood', 'word-ladder'],
  'color-flood': ['sliding-puzzle', 'picross', 'number-sequence'],
  'number-sequence': ['sliding-puzzle', 'color-flood', 'picross'],
  'reaction-time': ['sliding-puzzle', 'word-ladder', 'color-flood'],
  'norinori': ['sliding-puzzle', 'reaction-time', 'memory-matching'],
  'murdoku': ['sliding-puzzle', 'reaction-time', 'memory-matching'],
  'spot-the-difference': ['memory-matching', 'picross', 'reaction-time'],
  'hidden-object': ['spot-the-difference', 'memory-matching', 'picross'],
  'shakashaka': ['norinori', 'picross', 'sliding-puzzle'],
};

const targetIds = (recommendations && recommendations.length === 3)
  ? recommendations
  : (DEFAULT_RECOMMENDATIONS[currentGameId] || ['sliding-puzzle', 'memory-matching', 'picross'].filter(id => id !== currentGameId).slice(0, 3));

// Exactly 3 unique games, strictly excluding current game
const recommendedGames: GameCatalogItem[] = targetIds
  .filter(id => id !== currentGameId)
  .map(id => ALL_GAMES.find(g => g.id === id))
  .filter((g): g is GameCatalogItem => Boolean(g))
  .slice(0, 3);
---

<section class="wrap related-games-section" aria-label="Explore more puzzle games">
  <div class="related-games-head">
    <span class="eyebrow">{eyebrow}</span>
    <h2>{heading}</h2>
    <p class="muted">{description}</p>
  </div>

  <div class="related-games-grid">
    {recommendedGames.map((game) => (
      <a class="related-card card" href={game.href}>
        <div class={`related-visual ${game.visualClass}`} aria-hidden="true">
          <div class="related-orbit"></div>
          <div class={`related-icon ${game.iconClass}`}>
            {game.id === 'number-sequence' && (
              <><span>3</span><span>?</span><span>9</span><span>27</span></>
            )}
            {game.id === 'color-flood' && (
              <><span></span><span></span><span></span><span></span></>
            )}
            {game.id === 'picross' && (
              <><span>■</span><span>□</span><span>□</span><span>■</span></>
            )}
            {game.id === 'sliding-puzzle' && (
              <><span>1</span><span>2</span><span>3</span><span class="slide-empty"></span></>
            )}
            {game.id === 'word-ladder' && (
              <><span>W</span><span>O</span><span>R</span><span>D</span></>
            )}
            {game.id === 'reaction-time' && (
              <>
                <span><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" fill="currentColor" fill-opacity="0.25"></polygon></svg></span>
                <span><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="13" r="8"></circle><path d="M12 9v4l2.5 2.5"></path><path d="M10 2h4"></path><path d="M12 2v3"></path></svg></span>
                <span><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="6" fill="currentColor" fill-opacity="0.25"></circle><circle cx="12" cy="12" r="2" fill="currentColor"></circle></svg></span>
                <span><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3.34 19a10 10 0 1 1 17.32 0"></path><path d="m12 14 4-4"></path><circle cx="12" cy="14" r="2" fill="currentColor"></circle></svg></span>
              </>
            )}
            {game.id === 'memory-matching' && (
              <>
                <span><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76" fill="currentColor" fill-opacity="0.25"></polygon></svg></span>
                <span><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"></path><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"></path></svg></span>
                <span><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg></span>
                <span><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="5" r="3"></circle><line x1="12" y1="8" x2="12" y2="21"></line><path d="M5 12H2a10 10 0 0 0 20 0h-3"></path></svg></span>
              </>
            )}
            {game.id === 'murdoku' && (
              <>
                <span><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg></span>
                <span><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg></span>
                <span><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="3" y1="9" x2="21" y2="9"></line><line x1="9" y1="21" x2="9" y2="9"></line></svg></span>
                <span><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg></span>
              </>
            )}
            {game.id === 'norinori' && (
              <>
                <span><svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><rect x="3" y="3" width="18" height="18" rx="3"></rect></svg></span>
                <span><svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><rect x="3" y="3" width="18" height="18" rx="3"></rect></svg></span>
                <span><svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><circle cx="12" cy="12" r="5"></circle></svg></span>
                <span><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"></rect></svg></span>
              </>
            )}
            {game.id === 'spot-the-difference' && (
              <>
                <span><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg></span>
                <span><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg></span>
                <span><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 14 14"></polyline></svg></span>
                <span><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg></span>
              </>
            )}
            {game.id === 'hidden-object' && (
              <>
                <span><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="10.5" cy="10.5" r="7"></circle><line x1="21" y1="21" x2="15.5" y2="15.5"></line><circle cx="10.5" cy="10.5" r="2.5" fill="currentColor" fill-opacity="0.3"></circle></svg></span>
                <span><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="7.5" cy="15.5" r="4.5"></circle><path d="m11 12 9.5-9.5"></path><path d="m18 5 2.5 2.5"></path><path d="m15.5 7.5 1.5 1.5"></path></svg></span>
                <span><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="13" r="8"></circle><path d="M12 5V2M10 2h4"></path><polyline points="12 9 12 13 15 15"></polyline></svg></span>
                <span><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h12l4 6-10 12L2 9z"></path><path d="M2 9h20"></path></svg></span>
              </>
            )}
            {game.id === 'mahjong-variants' && (
              <>
                <span><svg viewBox="0 0 24 24" width="18" height="18" fill="none"><text x="12" y="17" font-weight="900" font-size="16" fill="#dc2626" text-anchor="middle">中</text></svg></span>
                <span><svg viewBox="0 0 24 24" width="18" height="18" fill="none"><circle cx="12" cy="12" r="7" fill="#dc2626"/><circle cx="12" cy="12" r="4.5" fill="#2563eb"/><circle cx="12" cy="12" r="2" fill="#fef08a"/></svg></span>
                <span><svg viewBox="0 0 24 24" width="18" height="18" fill="none"><rect x="10" y="4" width="4" height="16" rx="2" fill="#16a34a"/><circle cx="12" cy="12" r="3" fill="#15803d"/></svg></span>
                <span><svg viewBox="0 0 24 24" width="18" height="18" fill="none"><circle cx="12" cy="12" r="6" fill="#ea580c"/><circle cx="12" cy="12" r="3" fill="#fef08a"/></svg></span>
              </>
            )}
            {game.id === 'shakashaka' && (
              <>
                <span><svg viewBox="0 0 24 24" width="16" height="16"><polygon points="3,3 21,3 3,21" fill="currentColor"></polygon></svg></span>
                <span><svg viewBox="0 0 24 24" width="16" height="16"><polygon points="3,3 21,3 21,21" fill="currentColor"></polygon></svg></span>
                <span><svg viewBox="0 0 24 24" width="16" height="16"><polygon points="3,3 3,21 21,21" fill="currentColor"></polygon></svg></span>
                <span><svg viewBox="0 0 24 24" width="16" height="16"><polygon points="21,3 21,21 3,21" fill="currentColor"></polygon></svg></span>
              </>
            )}
          </div>
        </div>
        <div class="related-card-body">
          <div class="related-labels">
            <span class="pill">{game.pill}</span>
            <span class="difficulty-label">{game.difficulty}</span>
          </div>
          <h3>{game.title}</h3>
          <p class="muted">{game.description}</p>
          <span class="related-play">Play Now <span aria-hidden="true">→</span></span>
        </div>
      </a>
    ))}
  </div>
</section>

<style>
  .related-games-section {
    padding: 56px 0 36px;
    border-top: 1px solid var(--line);
    margin-top: 48px;
  }

  .related-games-head {
    max-width: 620px;
    margin: 0 auto 36px;
    text-align: center;
  }

  .related-games-head .eyebrow {
    font-size: 12px;
    letter-spacing: .12em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--blue);
  }

  .related-games-head h2 {
    font-size: clamp(1.8rem, 3.2vw, 2.4rem);
    margin: 10px 0 12px;
    letter-spacing: -.03em;
    line-height: 1.15;
  }

  .related-games-head p {
    font-size: 15px;
    line-height: 1.65;
    margin: 0 auto;
  }

  .related-games-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    align-items: stretch;
  }

  .related-card {
    text-decoration: none;
    color: var(--ink);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: 18px;
    background: var(--paper);
    border: 1px solid var(--line);
    box-shadow: 0 10px 30px #17233b08;
    transition: transform .18s ease, border-color .18s ease, box-shadow .18s ease;
  }

  .related-card:hover {
    transform: translateY(-3px);
    border-color: #cfd8ef;
    box-shadow: 0 14px 34px #17233b12;
  }

  .related-visual {
    height: 170px;
    position: relative;
    display: grid;
    place-items: center;
    background: linear-gradient(145deg, #eaf0ff, #f6f3ff);
    overflow: hidden;
  }

  .related-orbit {
    position: absolute;
    width: 140px;
    height: 140px;
    border: 1px dashed #cad5fa;
    border-radius: 50%;
  }

  .related-icon {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(2, 50px);
    gap: 8px;
    transform: rotate(-7deg);
  }

  .related-icon span {
    width: 50px;
    height: 50px;
    display: grid;
    place-items: center;
    border-radius: 14px;
    background: white;
    color: #315ee8;
    font-size: 18px;
    font-weight: 800;
    box-shadow: 0 6px 16px #293e8b14;
  }

  /* Specific Light Mode Icon Palettes */
  .sequence-icon span:nth-child(2) { background: #315ee8; color: #fff; }
  .sequence-icon span:nth-child(3) { background: #dff5ef; color: #16825d; }
  .sequence-icon span:nth-child(4) { background: #fff1d9; color: #c28b2f; }

  .flood-icon span { border-radius: 13px; background: #ef6b67; }
  .flood-icon span:nth-child(2) { background: #efa347; }
  .flood-icon span:nth-child(3) { background: #48ad83; }
  .flood-icon span:nth-child(4) { background: #5187dc; }

  .picross-icon span:nth-child(1), .picross-icon span:nth-child(4) { background: #315ee8; color: #fff; }
  .picross-icon span:nth-child(2), .picross-icon span:nth-child(3) { background: #edf2ff; color: #315ee8; }

  .slide-icon span:nth-child(1) { background: #315ee8; color: #fff; }
  .slide-icon span:nth-child(2) { background: #edf2ff; color: #315ee8; }
  .slide-icon span:nth-child(3) { background: #eaf7f2; color: #16825d; }
  .slide-icon .slide-empty { background: transparent; border: 2px dashed #b9c8f5; box-shadow: none; }

  .ladder-icon span:nth-child(1) { background: #315ee8; color: #fff; }
  .ladder-icon span:nth-child(2) { background: #dff5ef; color: #16825d; }
  .ladder-icon span:nth-child(3) { background: #ede9fe; color: #6d28d9; }
  .ladder-icon span:nth-child(4) { background: #fff1d9; color: #c28b2f; }

  .reaction-icon span:nth-child(1) { background: #fef08a; color: #a16207; }
  .reaction-icon span:nth-child(2) { background: #315ee8; color: #fff; }
  .reaction-icon span:nth-child(3) { background: #dcfce7; color: #15803d; }
  .reaction-icon span:nth-child(4) { background: #fee2e2; color: #b91c1c; }

  .memory-icon span:nth-child(1) { background: #ede9fe; color: #7c3aed; }
  .memory-icon span:nth-child(2) { background: #315ee8; color: #fff; }
  .memory-icon span:nth-child(3) { background: #fef08a; color: #a16207; }
  .memory-icon span:nth-child(4) { background: #dcfce7; color: #15803d; }

  .murdoku-icon span:nth-child(1) { background: #fef2f2; color: #dc2626; }
  .murdoku-icon span:nth-child(2) { background: #315ee8; color: #fff; }
  .murdoku-icon span:nth-child(3) { background: #eff6ff; color: #2563eb; }
  .murdoku-icon span:nth-child(4) { background: #fef3c7; color: #d97706; }

  .norinori-icon span:nth-child(1), .norinori-icon span:nth-child(2) { background: #315ee8; color: #fff; }
  .norinori-icon span:nth-child(3) { background: #eff6ff; color: #2563eb; }
  .norinori-icon span:nth-child(4) { background: #f1f5f9; color: #64748b; }

  .spot-icon span:nth-child(1) { background: #fef3c7; color: #d97706; }
  .spot-icon span:nth-child(2) { background: #315ee8; color: #fff; }
  .spot-icon span:nth-child(3) { background: #dcfce7; color: #16a34a; }
  .spot-icon span:nth-child(4) { background: #ede9fe; color: #7c3aed; }

  .hidden-object-icon span:nth-child(1) { background: #fef3c7; color: #d97706; }
  .hidden-object-icon span:nth-child(2) { background: #315ee8; color: #fff; }
  .hidden-object-icon span:nth-child(3) { background: #dcfce7; color: #16a34a; }
  .hidden-object-icon span:nth-child(4) { background: #ede9fe; color: #7c3aed; }

  .mahjong-icon span:nth-child(1) { background: #fef2f2; color: #dc2626; }
  .mahjong-icon span:nth-child(2) { background: #eff6ff; color: #2563eb; }
  .mahjong-icon span:nth-child(3) { background: #dcfce7; color: #16a34a; }
  .mahjong-icon span:nth-child(4) { background: #f0fdf4; color: #15803d; }

  .shakashaka-icon span:nth-child(1) { background: #eff6ff; color: #2563eb; }
  .shakashaka-icon span:nth-child(2) { background: #ede9fe; color: #7c3aed; }
  .shakashaka-icon span:nth-child(3) { background: #dcfce7; color: #16a34a; }
  .shakashaka-icon span:nth-child(4) { background: #fff1d9; color: #c28b2f; }

  .related-card-body {
    padding: 20px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    flex: 1;
  }

  .related-labels {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 2px;
  }
  .related-labels .pill { font-size: 9px; letter-spacing: .04em; }
  .difficulty-label { font-size: 10px; color: var(--muted); }

  .related-card h3 {
    margin: 8px 0;
    font-size: 18px;
    letter-spacing: -.02em;
    color: var(--ink);
  }

  .related-card p {
    font-size: 13px;
    line-height: 1.6;
    margin: 0 0 16px;
    color: var(--muted);
  }

  .related-play {
    margin-top: auto;
    font-size: 13px;
    font-weight: 700;
    color: var(--blue);
  }
  .related-play span { transition: transform .18s ease; }
  .related-card:hover .related-play span { transform: translateX(3px); }

  /* Responsive Rules */
  @media (max-width: 900px) {
    .related-games-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
    }
  }

  @media (max-width: 560px) {
    .related-games-section { padding: 40px 0 24px; margin-top: 36px; }
    .related-games-head { margin-bottom: 24px; }
    .related-games-grid { grid-template-columns: 1fr; gap: 16px; }
    .related-card {
      display: grid;
      grid-template-columns: 110px minmax(0, 1fr);
      min-height: 160px;
      border-radius: 16px;
    }
    .related-visual { height: auto; min-height: 160px; }
    .related-orbit { width: 90px; height: 90px; }
    .related-icon { grid-template-columns: repeat(2, 34px); gap: 5px; }
    .related-icon span { width: 34px; height: 34px; border-radius: 9px; font-size: 13px; }
    .related-card-body { padding: 14px 12px; }
    .related-card h3 { font-size: 16px; margin: 8px 0 4px; }
    .related-card p { font-size: 12px; margin-bottom: 10px; }
    .related-play { font-size: 12px; }
  }

  @media (max-width: 390px) {
    .related-card { grid-template-columns: 95px minmax(0, 1fr); }
    .related-orbit { width: 80px; height: 80px; }
    .related-icon { grid-template-columns: repeat(2, 28px); gap: 4px; }
    .related-icon span { width: 28px; height: 28px; border-radius: 8px; font-size: 11px; }
  }

  /* Dark Theme for Related Games (Strictly Matching Spot the Difference Reference) */
  :global(html[data-theme="dark"]) .related-games-section {
    border-color: #27375a;
  }

  :global(html[data-theme="dark"]) .related-card {
    background: #141f3d;
    border-color: #27375a;
    color: #f1f5ff;
  }

  :global(html[data-theme="dark"]) .related-card:hover {
    border-color: #52678f;
    box-shadow: 0 16px 38px #03081760;
  }

  :global(html[data-theme="dark"]) .related-visual {
    background: linear-gradient(145deg, #1b294b, #222345);
  }

