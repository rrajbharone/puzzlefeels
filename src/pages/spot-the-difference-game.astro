  :global(html[data-theme="dark"]) .spot-toolbar {
    background: #152042;
    border-color: #23335c;
  }

  :global(html[data-theme="dark"]) .image-card {
    background: #111a36;
    border-color: #23335c;
  }

  :global(html[data-theme="dark"]) .image-card-header {
    background: #152042;
    border-color: #23335c;
  }

  :global(html[data-theme="dark"]) .spot-victory-card,
  :global(html[data-theme="dark"]) .pause-card {
    background: #111a36;
    border-color: #23335c;
  }

  :global(html[data-theme="dark"]) .vstat-box {
    background: #19264c;
    border-color: #23335c;
  }

  :global(html[data-theme="dark"]) .spot-table th,
  :global(html[data-theme="dark"]) .spot-table td {
    border-color: #23335c;
  }

  :global(html[data-theme="dark"]) .spot-table th {
    background: #19264c;
  }

  

  :global(html[data-theme="dark"]) .memory-icon span:nth-child(1) { background: #3b1e75; color: #c4b5fd; }
  :global(html[data-theme="dark"]) .memory-icon span:nth-child(2) { background: #8ea8ff; color: #0b132b; }
  :global(html[data-theme="dark"]) .memory-icon span:nth-child(3) { background: #713f12; color: #fef08a; }
  :global(html[data-theme="dark"]) .memory-icon span:nth-child(4) { background: #14532d; color: #86efac; }

  :global(html[data-theme="dark"]) .picross-icon span:nth-child(1),
  :global(html[data-theme="dark"]) .picross-icon span:nth-child(4) { background: #8ea8ff; color: #0b132b; }
  :global(html[data-theme="dark"]) .picross-icon span:nth-child(2),
  :global(html[data-theme="dark"]) .picross-icon span:nth-child(3) { background: #1b294b; color: #a9bcff; }

  :global(html[data-theme="dark"]) .reaction-icon span:nth-child(1) { background: #713f12; color: #fef08a; }
  :global(html[data-theme="dark"]) .reaction-icon span:nth-child(2) { background: #8ea8ff; color: #0b132b; }
  :global(html[data-theme="dark"]) .reaction-icon span:nth-child(3) { background: #14532d; color: #86efac; }
  :global(html[data-theme="dark"]) .reaction-icon span:nth-child(4) { background: #7f1d1d; color: #fca5a5; }

  :global(html[data-theme="dark"]) .wrap.game-article-content.spot-guide-section a {
    color: #8ea8ff;
  }

  :global(html[data-theme="dark"]) .wrap.game-article-content.spot-guide-section a:hover {
    color: #b8c8ff;
  }
</style>

<script>
  import { SPOT_DIFFERENCE_PUZZLES } from '../data/spotDifferenceData';

  // State Management
  let currentDiff = 'easy';
  let currentLevelIndex = 0; // index within filtered difficulty puzzles
  let activePuzzle = SPOT_DIFFERENCE_PUZZLES[0];
  let foundDiffIds = new Set<number>();
  let timerInterval: number | null = null;
  let elapsedSeconds = 0;
  let isPaused = false;
  let hintsUsed = 0;
  let mistakes = 0;
  let soundEnabled = true;

  // Web Audio Context for synthesized SFX
  let audioCtx: AudioContext | null = null;

  function initAudio() {
    if (!audioCtx && typeof window !== 'undefined') {
      const AudioCtxClass = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
      if (AudioCtxClass) {
        audioCtx = new AudioCtxClass();
      }
    }
    if (audioCtx && audioCtx.state === 'suspended') {
      audioCtx.resume();
    }
  }

  function playTone(freq: number, type: OscillatorType, duration: number, delay = 0) {
    if (!soundEnabled) return;
    try {
      initAudio();
      if (!audioCtx) return;
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      const startTime = audioCtx.currentTime + delay;

      osc.type = type;
      osc.frequency.setValueAtTime(freq, startTime);

      gain.gain.setValueAtTime(0.18, startTime);
      gain.gain.exponentialRampToValueAtTime(0.001, startTime + duration);

      osc.connect(gain);
      gain.connect(audioCtx.destination);

      osc.start(startTime);
      osc.stop(startTime + duration);
    } catch {
      // Audio autoplay policy fallback
    }
  }

  function playSuccessSound() {
    playTone(523.25, 'triangle', 0.15, 0);      // C5
    playTone(659.25, 'triangle', 0.18, 0.08);   // E5
    playTone(783.99, 'triangle', 0.25, 0.16);   // G5
  }

  function playMissSound() {
    playTone(220, 'sine', 0.15, 0);             // A3 low thud
  }

  function playHintSound() {
    playTone(784, 'sine', 0.12, 0);
    playTone(988, 'sine', 0.15, 0.08);
    playTone(1318, 'sine', 0.25, 0.16);
  }

  function playVictorySound() {
    playTone(523.25, 'triangle', 0.18, 0);      // C5
    playTone(659.25, 'triangle', 0.18, 0.12);   // E5
    playTone(783.99, 'triangle', 0.18, 0.24);   // G5
    playTone(1046.50, 'triangle', 0.45, 0.36);  // C6
  }

  // Format mm:ss
  function formatTime(sec: number): string {
    const m = Math.floor(sec / 60);
    const s = sec % 60;
    return `${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}`;
  }

  // Filter puzzles for current difficulty
  function getPuzzlesForDiff(diff: string) {
    return SPOT_DIFFERENCE_PUZZLES.filter(p => p.difficulty === diff);
  }

  function loadSavedSettings() {
    try {
      const soundPref = localStorage.getItem('puzzlefeels-spot-sound');
      if (soundPref !== null) {
        soundEnabled = soundPref === 'true';
      }
    } catch {
      // Storage blocked
    }
    updateSoundUI();
  }

  function updateSoundUI() {
    const soundBtn = document.getElementById('btn-sound');
    if (!soundBtn) return;
    const svgOn = soundBtn.querySelector('.sound-on-svg') as HTMLElement | null;
    const svgOff = soundBtn.querySelector('.sound-off-svg') as HTMLElement | null;
    if (svgOn && svgOff) {
      svgOn.hidden = !soundEnabled;
      svgOff.hidden = soundEnabled;
    }
  }

  function startTimer() {
    stopTimer();
    timerInterval = window.setInterval(() => {
      if (!isPaused) {
        elapsedSeconds++;
        const el = document.getElementById('metric-timer');
        if (el) el.textContent = formatTime(elapsedSeconds);
      }
    }, 1000);
  }

  function stopTimer() {
    if (timerInterval !== null) {
      clearInterval(timerInterval);
      timerInterval = null;
    }
  }

  function clearMarkersAndFeedback() {
    const layerA = document.getElementById('markers-layer-a');
    const layerB = document.getElementById('markers-layer-b');
    const feedA = document.getElementById('feedback-layer-a');
    const feedB = document.getElementById('feedback-layer-b');
    if (layerA) layerA.innerHTML = '';
    if (layerB) layerB.innerHTML = '';
    if (feedA) feedA.innerHTML = '';
    if (feedB) feedB.innerHTML = '';
    hideHintBanner();
  }

  function hideHintBanner() {
    const banner = document.getElementById('spot-hint-banner');
    if (banner) banner.hidden = true;
  }

  function setupProgressDots() {
    const container = document.getElementById('spot-progress-dots');
    if (!container) return;
    container.innerHTML = '';
    for (let i = 0; i < activePuzzle.differences.length; i++) {
      const dot = document.createElement('span');
      dot.className = 'p-dot';
      dot.dataset.diffIndex = String(i);
      container.appendChild(dot);
    }
  }

  function updateProgressDots() {
    const container = document.getElementById('spot-progress-dots');
    if (!container) return;
    const dots = container.querySelectorAll('.p-dot');
    dots.forEach((dot, idx) => {
      if (idx < foundDiffIds.size) {
        dot.classList.add('is-found');
      } else {
        dot.classList.remove('is-found');
      }
    });
  }

  function updateMetricsUI() {
    const foundEl = document.getElementById('metric-found');
    const timerEl = document.getElementById('metric-timer');
    const hintsEl = document.getElementById('metric-hints');
    const mistakesEl = document.getElementById('metric-mistakes');

    if (foundEl) foundEl.textContent = `${foundDiffIds.size} / ${activePuzzle.differences.length}`;
    if (timerEl) timerEl.textContent = formatTime(elapsedSeconds);
    if (hintsEl) hintsEl.textContent = String(hintsUsed);
    if (mistakesEl) mistakesEl.textContent = String(mistakes);

    updateProgressDots();
  }

  function renderPuzzle(puzzle: typeof SPOT_DIFFERENCE_PUZZLES[0]) {
    activePuzzle = puzzle;
    foundDiffIds.clear();
    elapsedSeconds = 0;
    isPaused = false;
    hintsUsed = 0;
    mistakes = 0;

    // Update images
    const imgA = document.getElementById('img-a') as HTMLImageElement | null;
    const imgB = document.getElementById('img-b') as HTMLImageElement | null;
    if (imgA) imgA.src = puzzle.imageA;
    if (imgB) imgB.src = puzzle.imageB;

    // Update titles
    const badgeEl = document.getElementById('spot-level-badge');
    const titleEl = document.getElementById('spot-puzzle-title');
    const catEl = document.getElementById('spot-puzzle-cat');
    if (badgeEl) badgeEl.textContent = `Level ${currentLevelIndex + 1}`;
    if (titleEl) titleEl.textContent = puzzle.title;
    if (catEl) catEl.textContent = puzzle.category;

    // Reset overlay
    clearMarkersAndFeedback();
    setupProgressDots();
    updateMetricsUI();
    startTimer();
  }

  function addMarkerToBothImages(diff: typeof SPOT_DIFFERENCE_PUZZLES[0]['differences'][0], index: number) {
    const layerA = document.getElementById('markers-layer-a');
    const layerB = document.getElementById('markers-layer-b');

    [layerA, layerB].forEach(layer => {
      if (!layer) return;
      const marker = document.createElement('div');
      marker.className = 'diff-marker';
      marker.style.left = `${diff.x}%`;
      marker.style.top = `${diff.y}%`;
      marker.textContent = String(index);
      marker.title = diff.label;
      layer.appendChild(marker);
    });
  }

  function showMissFeedback(canvasBox: HTMLElement, clickX: number, clickY: number) {
    const feedbackLayer = canvasBox.querySelector('.feedback-layer');
    if (!feedbackLayer) return;

    const ripple = document.createElement('div');
    ripple.className = 'click-ripple';
    ripple.style.left = `${clickX}%`;
    ripple.style.top = `${clickY}%`;
    feedbackLayer.appendChild(ripple);

    setTimeout(() => {
      ripple.remove();
    }, 550);
  }

  function handleImageClick(e: MouseEvent, role: 'a' | 'b') {
    if (isPaused) return;
    initAudio();

    const canvasBox = e.currentTarget as HTMLElement;
    const rect = canvasBox.getBoundingClientRect();
    if (!rect.width || !rect.height) return;

    // Normalized percentages (0 - 100)
    const clickX = ((e.clientX - rect.left) / rect.width) * 100;
    const clickY = ((e.clientY - rect.top) / rect.height) * 100;

    // Aspect ratio weighting for radial distance (800 x 520 => 520 / 800 = 0.65)
    const aspectCorrection = 520 / 800;

    let matchedDiff: typeof SPOT_DIFFERENCE_PUZZLES[0]['differences'][0] | null = null;

    for (const diff of activePuzzle.differences) {
      if (foundDiffIds.has(diff.id)) continue;

      const dx = clickX - diff.x;
      const dy = (clickY - diff.y) * aspectCorrection;
      const dist = Math.sqrt(dx * dx + dy * dy);

      if (dist <= diff.radius) {
        matchedDiff = diff;
        break;
      }
    }

    if (matchedDiff) {
      // Correct spot!
      foundDiffIds.add(matchedDiff.id);
      playSuccessSound();
      addMarkerToBothImages(matchedDiff, foundDiffIds.size);
      updateMetricsUI();

      // Show brief notification
      const banner = document.getElementById('spot-hint-banner');
      const text = document.getElementById('hint-text');
      if (banner && text) {
        text.textContent = `Found: ${matchedDiff.label}!`;
        banner.hidden = false;
        setTimeout(() => {
          if (banner.textContent?.includes(matchedDiff?.label || '')) {
            banner.hidden = true;
          }
        }, 2200);
      }

      // Check level completion
      if (foundDiffIds.size === activePuzzle.differences.length) {
        handleLevelComplete();
      }
    } else {
      // Missed click
      mistakes++;
      playMissSound();
      showMissFeedback(canvasBox, clickX, clickY);
      updateMetricsUI();
    }
  }

  function handleHint() {
    if (isPaused) return;
    initAudio();

    // Find first undiscovered difference
    const unfound = activePuzzle.differences.filter(d => !foundDiffIds.has(d.id));
    if (unfound.length === 0) return;

    const targetDiff = unfound[0];
    hintsUsed++;
    playHintSound();
    updateMetricsUI();

    // Show radar circles on both images
    const layerA = document.getElementById('markers-layer-a');
    const layerB = document.getElementById('markers-layer-b');

    [layerA, layerB].forEach(layer => {
      if (!layer) return;
      const radar = document.createElement('div');
      radar.className = 'hint-radar';
      radar.style.left = `${targetDiff.x}%`;
      radar.style.top = `${targetDiff.y}%`;
      layer.appendChild(radar);

      setTimeout(() => {
        radar.remove();
      }, 3600);
    });

    // Display clue in banner
    const banner = document.getElementById('spot-hint-banner');
    const text = document.getElementById('hint-text');
    if (banner && text) {
      text.textContent = `Hint: ${targetDiff.hint}`;
      banner.hidden = false;
    }
  }

  function handleLevelComplete() {
    stopTimer();
    playVictorySound();

    // Calculate stars
    let stars = '★★★';
    if (hintsUsed > 2 || mistakes > 5) {
      stars = '★☆☆';
    } else if (hintsUsed > 0 || mistakes > 2) {
      stars = '★★☆';
    }

    // Save best time
    try {
      const key = `puzzlefeels-spot-best-${activePuzzle.id}`;
      const prevBest = localStorage.getItem(key);
      if (!prevBest || elapsedSeconds < Number(prevBest)) {
        localStorage.setItem(key, String(elapsedSeconds));
      }
    } catch {
      // Storage blocked
    }

    // Populate modal
    const modal = document.getElementById('victory-modal');
    const timeEl = document.getElementById('vstat-time');
    const hintsEl = document.getElementById('vstat-hints');
    const mistakesEl = document.getElementById('vstat-mistakes');
    const diffEl = document.getElementById('vstat-diff');
    const starsEl = document.getElementById('victory-stars');

    if (timeEl) timeEl.textContent = formatTime(elapsedSeconds);
    if (hintsEl) hintsEl.textContent = String(hintsUsed);
    if (mistakesEl) mistakesEl.textContent = String(mistakes);
    if (diffEl) diffEl.textContent = activePuzzle.difficulty.toUpperCase();
    if (starsEl) starsEl.textContent = stars;

    if (modal) modal.hidden = false;
  }

  function shareResult() {
    const text = `I found all ${activePuzzle.differences.length} differences in "${activePuzzle.title}" on PuzzleFeels in ${formatTime(elapsedSeconds)} with ${hintsUsed} hints! Can you beat my time? https://puzzlefeels.com/spot-the-difference-game/`;
    if (navigator.clipboard?.writeText) {
      navigator.clipboard.writeText(text).then(() => {
        alert('Result copied to clipboard!');
      }).catch(() => {
        prompt('Copy your score:', text);
      });
    } else {
      prompt('Copy your score:', text);
    }
  }

  function togglePause() {
    isPaused = !isPaused;
    const overlay = document.getElementById('spot-pause-overlay');
    const pauseText = document.getElementById('pause-text');
    if (overlay) overlay.hidden = !isPaused;
    if (pauseText) pauseText.textContent = isPaused ? 'Resume' : 'Pause';
  }

  // Mobile view switcher
  function initMobileViewToggle() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('.mobile-view-toggle .view-btn');
    const board = document.getElementById('spot-comparison-board');
    if (!board) return;

    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        buttons.forEach(b => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        const view = btn.dataset.view || 'both';
        board.dataset.activeView = view;
      });
    });
  }

  // Initialize all listeners
  function initSpotGame() {
    loadSavedSettings();

    // Canvas click listeners
    const boxA = document.getElementById('box-image-a');
    const boxB = document.getElementById('box-image-b');
    if (boxA) boxA.addEventListener('click', (e) => handleImageClick(e, 'a'));
    if (boxB) boxB.addEventListener('click', (e) => handleImageClick(e, 'b'));

    // Difficulty buttons
    document.querySelectorAll<HTMLButtonElement>('.spot-tab-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.spot-tab-btn').forEach(b => {
          b.classList.remove('is-active');
          b.setAttribute('aria-pressed', 'false');
        });
        btn.classList.add('is-active');
        btn.setAttribute('aria-pressed', 'true');

        currentDiff = btn.dataset.difficulty || 'easy';
        currentLevelIndex = 0;
        const puzzles = getPuzzlesForDiff(currentDiff);
        if (puzzles.length > 0) {
          renderPuzzle(puzzles[0]);
        }
      });
    });

    // Level navigation arrows
    const prevBtn = document.getElementById('btn-prev-level');
    const nextBtn = document.getElementById('btn-next-level');

    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        const puzzles = getPuzzlesForDiff(currentDiff);
        currentLevelIndex = (currentLevelIndex - 1 + puzzles.length) % puzzles.length;
        renderPuzzle(puzzles[currentLevelIndex]);
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        const puzzles = getPuzzlesForDiff(currentDiff);
        currentLevelIndex = (currentLevelIndex + 1) % puzzles.length;
        renderPuzzle(puzzles[currentLevelIndex]);
      });
    }

    // Toolbar actions
    const hintBtn = document.getElementById('btn-hint');
    if (hintBtn) hintBtn.addEventListener('click', handleHint);

    const restartBtn = document.getElementById('btn-restart');
    if (restartBtn) restartBtn.addEventListener('click', () => renderPuzzle(activePuzzle));

    const pauseBtn = document.getElementById('btn-pause');
    if (pauseBtn) pauseBtn.addEventListener('click', togglePause);

    const resumeBtn = document.getElementById('btn-resume');
    if (resumeBtn) resumeBtn.addEventListener('click', togglePause);

    const soundBtn = document.getElementById('btn-sound');
    if (soundBtn) {
      soundBtn.addEventListener('click', () => {
        soundEnabled = !soundEnabled;
        try {
          localStorage.setItem('puzzlefeels-spot-sound', String(soundEnabled));
        } catch {}
        updateSoundUI();
      });
    }

    // Victory modal buttons
    const nextPuzzleBtn = document.getElementById('btn-next-puzzle');
    if (nextPuzzleBtn) {
      nextPuzzleBtn.addEventListener('click', () => {
        const modal = document.getElementById('victory-modal');
        if (modal) modal.hidden = true;
        const puzzles = getPuzzlesForDiff(currentDiff);
        currentLevelIndex = (currentLevelIndex + 1) % puzzles.length;
        renderPuzzle(puzzles[currentLevelIndex]);
      });
    }

    const replayBtn = document.getElementById('btn-replay-puzzle');
    if (replayBtn) {
      replayBtn.addEventListener('click', () => {
        const modal = document.getElementById('victory-modal');
        if (modal) modal.hidden = true;
        renderPuzzle(activePuzzle);
      });
    }

    const shareBtn = document.getElementById('btn-share-result');
    if (shareBtn) shareBtn.addEventListener('click', shareResult);

    initMobileViewToggle();

    // Initial render
    const initialPuzzles = getPuzzlesForDiff(currentDiff);
    if (initialPuzzles.length > 0) {
      renderPuzzle(initialPuzzles[0]);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSpotGame);
  } else {
    initSpotGame();
  }
</script>
