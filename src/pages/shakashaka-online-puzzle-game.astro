import ExploreMore from '../components/ExploreMore.astro';
import ZoomControl from '../components/ZoomControl.astro';
import { SHAKASHAKA_PUZZLES, getDailyShakashakaPuzzle } from '../data/shakashakaPuzzles';

const title = 'Shakashaka – Online Puzzle Game | Free Proof of Quilt | PuzzleFeels';
const description = 'Play Shakashaka online puzzle game for free. Place right-angled triangles in white cells so all remaining white areas form rectangles. Enjoy daily puzzles.';

const faqs = [
  {
    question: 'What is Shakashaka (Proof of Quilt)?',
    answer: 'Shakashaka, also known internationally as Proof of Quilt, is a spatial logic puzzle invented in 2008 by the acclaimed Japanese puzzle magazine Nikoli. Played on a rectangular grid featuring white playable cells and black clue blocks, the objective is to place black right-angled triangles inside white cells so that every remaining white space forms a perfect rectangle or square.'
  },
  {
    question: 'What are the core rules of Shakashaka?',
    answer: 'Shakashaka has two primary rules: 1) Numbered black squares indicate exactly how many of their four orthogonally adjacent white cells contain a black triangle whose flat edge touches the numbered square. 2) Every remaining white area across the entire grid must form an unpartitioned rectangle or square. White rectangles can be aligned orthogonally with the grid or tilted at a 45-degree angle.'
  },
  {
    question: 'What are the four triangle orientations?',
    answer: 'Each placed right-angled isosceles triangle occupies exactly half of a square cell and can face one of four directions: Top-Left (◤, right angle at top-left), Top-Right (◥, right angle at top-right), Bottom-Right (◢, right angle at bottom-right), and Bottom-Left (◣, right angle at bottom-left). The hypotenuse forms a diagonal boundary with the remaining white half of the cell.'
  },
  {
    question: 'How do numbered black squares count adjacent triangles?',
    answer: 'A numbered clue (0, 1, 2, 3, or 4) only counts an adjacent triangle if the triangle\'s flat, right-angled black leg rests directly against that clue cell\'s border. If an adjacent triangle has its hypotenuse or white half facing the clue cell, it does not count toward that clue\'s number. An unnumbered black cell acts as a solid barrier with no quota requirement.'
  },
  {
    question: 'Can white rectangles be tilted at an angle?',
    answer: 'Yes! In Shakashaka, white rectangles can either be upright (parallel to the grid borders, bounded by black squares or grid edges) or tilted at exactly 45 degrees. A 45-degree tilted rectangle or diamond is bounded by the diagonal hypotenuses of surrounding triangles. Irregular polygons, L-shapes, crosses, and stepped areas are strictly prohibited.'
  },
  {
    question: 'Can a white rectangle be a 1×1 square?',
    answer: 'Yes. Any completely empty white cell surrounded on all four sides by black squares, board boundaries, or flat triangle edges forms a valid 1×1 white square. A square is geometrically a rectangle with equal sides.'
  },
  {
    question: 'Do two adjacent white rectangles ever merge?',
    answer: 'If two white spaces meet along an open orthogonal edge without a black wall or triangle hypotenuse separating them, they merge into a single larger region. If that combined region is not a single convex rectangle, it violates the rules. White rectangles may, however, touch diagonally at their corner points.'
  },
  {
    question: 'Does every white cell need a triangle?',
    answer: 'No. Many white cells must be left completely empty to form the bodies of white rectangles. Placing unnecessary triangles is one of the most common mistakes in Shakashaka. Triangles should only be placed where required to satisfy a numbered clue or to turn a white boundary into a 90-degree corner.'
  },
  {
    question: 'What are the best strategies for beginners?',
    answer: 'Start by examining clue 0 (all four neighbors must not have flat legs touching the clue) and clue 4 (all four neighbors must contain touching triangles). Next, check the 2×2 grid corners: a white cell trapped in an outer grid corner cannot have acute angles pointing into the wall, which often forces immediate triangle placement. Finally, extend diagonal hypotenuses until they form closed 4-corner rectangles.'
  },
  {
    question: 'How does the Daily Challenge work?',
    answer: 'The Daily Challenge delivers a synchronized Shakashaka puzzle uniquely selected for the current UTC date. Every player worldwide receives the exact same challenge board on that day. Completing the daily challenge saves your score, time, and streak in your local browser history.'
  },
  {
    question: 'How does the Hint system work?',
    answer: 'If you ever get stuck, clicking the Hint button compares your current grid against the unique mathematical solution. If you have placed an incorrect triangle orientation, it gently alerts you to the error. Otherwise, it automatically places the next logical triangle on the board to guide your deduction forward.'
  },
  {
    question: 'Is this Shakashaka game completely free?',
    answer: 'Yes, 100% free with no ads, paywalls, downloads, or user registration required. The game is fully responsive for smartphones, tablets, and desktop computers, and includes automatic progress saving via LocalStorage.'
  }
];

const gameSchema = {
  '@context': 'https://schema.org',
  '@type': 'VideoGame',
  name: 'Shakashaka – Online Puzzle Game',
  url: 'https://puzzlefeels.com/shakashaka-online-puzzle-game/',
  description,
  gamePlatform: 'Web browser',
  applicationCategory: 'Game',
  genre: ['Logic Puzzle', 'Nikoli Puzzle', 'Geometry Puzzle', 'Brain Game'],
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  publisher: { '@type': 'Organization', name: 'PuzzleFeels', url: 'https://puzzlefeels.com/' }
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://puzzlefeels.com/' },
    { '@type': 'ListItem', position: 2, name: 'Games', item: 'https://puzzlefeels.com/games/' },
    { '@type': 'ListItem', position: 3, name: 'Shakashaka – Online Puzzle Game', item: 'https://puzzlefeels.com/shakashaka-online-puzzle-game/' }
