<script define:vars={{ rawPuzzles: SHAKASHAKA_PUZZLES }}>
  // Web Audio Synthesizer
  class SoundManager {
    constructor() {
      this.ctx = null;
      this.enabled = true;
    }
    init() {
      if (!this.ctx && typeof window !== 'undefined') {
        const AudioClass = window.AudioContext || window.webkitAudioContext;
        if (AudioClass) this.ctx = new AudioClass();
      }
      if (this.ctx && this.ctx.state === 'suspended') {
        this.ctx.resume();
      }
    }
    playTone(freq, type = 'sine', duration = 0.08, gainVal = 0.1) {
      if (!this.enabled) return;
      try {
        this.init();
        if (!this.ctx) return;
        const osc = this.ctx.createOscillator();
        const gain = this.ctx.createGain();
        osc.type = type;
        osc.frequency.setValueAtTime(freq, this.ctx.currentTime);
        gain.gain.setValueAtTime(gainVal, this.ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.0001, this.ctx.currentTime + duration);
        osc.connect(gain);
        gain.connect(this.ctx.destination);
        osc.start();
        osc.stop(this.ctx.currentTime + duration);
      } catch (e) {}
    }
    playClick() { this.playTone(180, 'triangle', 0.04, 0.06); }
    playPlace(step) {
      const freqs = [330, 392, 494, 587, 260];
      this.playTone(freqs[step % freqs.length], 'sine', 0.07, 0.08);
    }
    playClear() { this.playTone(220, 'sine', 0.06, 0.05); }
    playError() {
      this.playTone(180, 'sawtooth', 0.12, 0.1);
      setTimeout(() => this.playTone(140, 'sawtooth', 0.14, 0.1), 100);
    }
    playHint() {
      this.playTone(523.25, 'sine', 0.09, 0.1);
      setTimeout(() => this.playTone(659.25, 'sine', 0.12, 0.12), 80);
    }
    playWin() {
      if (!this.enabled) return;
      const notes = [523.25, 659.25, 783.99, 1046.5];
      notes.forEach((f, i) => {
        setTimeout(() => this.playTone(f, 'triangle', 0.25, 0.12), i * 110);
      });
    }
  }

  const sound = new SoundManager();

  // Geometric Validation Engine
  // Clues checking
  function checkClueStatus(grid, rows, cols) {
    let allSatisfied = true;
    let anyViolated = false;
    let totalClues = 0;
    let satisfiedClues = 0;
    const clueCells = [];

    for (let r = 0; r < rows; r++) {
      for (let c = 0; c < cols; c++) {
        const val = grid[r][c];
        if (val <= -2) {
          totalClues++;
          const target = -val - 2;
          let count = 0;

          // Top neighbor: touches flat leg if BL(4) or BR(3)
          if (r > 0 && (grid[r - 1][c] === 4 || grid[r - 1][c] === 3)) count++;
          // Bottom neighbor: touches flat leg if TL(1) or TR(2)
          if (r < rows - 1 && (grid[r + 1][c] === 1 || grid[r + 1][c] === 2)) count++;
          // Left neighbor: touches flat leg if TR(2) or BR(3)
          if (c > 0 && (grid[r][c - 1] === 2 || grid[r][c - 1] === 3)) count++;
          // Right neighbor: touches flat leg if TL(1) or BL(4)
          if (c < cols - 1 && (grid[r][c + 1] === 1 || grid[r][c + 1] === 4)) count++;

          const satisfied = (count === target);
          const violated = (count > target);
          if (satisfied) satisfiedClues++;
          if (!satisfied) allSatisfied = false;
          if (violated) anyViolated = true;

          clueCells.push({ r, c, count, target, satisfied, violated });
        }
      }
    }
    return { allSatisfied, anyViolated, totalClues, satisfiedClues, clueCells };
  }

  // White regions validation (Strict 4-vertex rectangle check)
  function validateBoardGeometry(grid, rows, cols) {
    const clueRes = checkClueStatus(grid, rows, cols);
    if (!clueRes.allSatisfied) {
      return { valid: false, reason: 'clues_incomplete', clueRes };
    }

    // Deconstruct white space into half-units
    const pieces = [];
    let pieceId = 0;

    for (let r = 0; r < rows; r++) {
      for (let c = 0; c < cols; c++) {
        const v = grid[r][c];
        if (v < 0) continue; // black cell
        const x = c * 2;
        const y = r * 2;

        if (v === 0) { // Full white cell
          pieces.push({
            id: pieceId++,
            vertices: [[x, y], [x + 2, y], [x + 2, y + 2], [x, y + 2]],
            edges: [
              [`${x},${y}->${x + 2},${y}`, [x, y], [x + 2, y]],
              [`${x + 2},${y}->${x + 2},${y + 2}`, [x + 2, y], [x + 2, y + 2]],
              [`${x + 2},${y + 2}->${x},${y + 2}`, [x + 2, y + 2], [x, y + 2]],
              [`${x},${y + 2}->${x},${y}`, [x, y + 2], [x, y]]
            ]
          });
        } else if (v === 1) { // TL black triangle, white half at bottom-right
          pieces.push({
            id: pieceId++,
            vertices: [[x + 2, y], [x + 2, y + 2], [x, y + 2]],
            edges: [
              [`${x + 2},${y}->${x + 2},${y + 2}`, [x + 2, y], [x + 2, y + 2]],
              [`${x + 2},${y + 2}->${x},${y + 2}`, [x + 2, y + 2], [x, y + 2]],
              [`${x},${y + 2}->${x + 2},${y}`, [x, y + 2], [x + 2, y]]
            ]
          });
        } else if (v === 2) { // TR black triangle, white half at bottom-left
          pieces.push({
            id: pieceId++,
            vertices: [[x, y], [x + 2, y + 2], [x, y + 2]],
            edges: [
              [`${x},${y}->${x + 2},${y + 2}`, [x, y], [x + 2, y + 2]],
              [`${x + 2},${y + 2}->${x},${y + 2}`, [x + 2, y + 2], [x, y + 2]],
              [`${x},${y + 2}->${x},${y}`, [x, y + 2], [x, y]]
            ]
          });
        } else if (v === 3) { // BR black triangle, white half at top-left
          pieces.push({
            id: pieceId++,
            vertices: [[x, y], [x + 2, y], [x, y + 2]],
            edges: [
              [`${x},${y}->${x + 2},${y}`, [x, y], [x + 2, y]],
              [`${x + 2},${y}->${x},${y + 2}`, [x + 2, y], [x, y + 2]],
              [`${x},${y + 2}->${x},${y}`, [x, y + 2], [x, y]]
            ]
          });
        } else if (v === 4) { // BL black triangle, white half at top-right
          pieces.push({
            id: pieceId++,
            vertices: [[x, y], [x + 2, y], [x + 2, y + 2]],
            edges: [
              [`${x},${y}->${x + 2},${y}`, [x, y], [x + 2, y]],
              [`${x + 2},${y}->${x + 2},${y + 2}`, [x + 2, y], [x + 2, y + 2]],
              [`${x + 2},${y + 2}->${x},${y}`, [x + 2, y + 2], [x, y]]
            ]
          });
        }
      }
    }

    if (pieces.length === 0) {
      return { valid: false, reason: 'empty_board', clueRes };
    }

    // Disjoint set union to find connected white components
    const parent = Array.from({ length: pieces.length }, (_, i) => i);
    function find(i) {
      if (parent[i] === i) return i;
      return parent[i] = find(parent[i]);
    }
    function union(i, j) {
      const rootI = find(i);
      const rootJ = find(j);
      if (rootI !== rootJ) parent[rootI] = rootJ;
    }

    // Map edges to detect interior shared edges
    const edgeToPieces = new Map();
    for (const p of pieces) {
      for (const [key, p1, p2] of p.edges) {
        const u = `${p1[0]},${p1[1]}`;
        const v = `${p2[0]},${p2[1]}`;
        const undirected = u < v ? `${u}<=>${v}` : `${v}<=>${u}`;
        if (!edgeToPieces.has(undirected)) edgeToPieces.set(undirected, []);
        edgeToPieces.get(undirected).push({ pId: p.id, directedKey: key, p1, p2 });
      }
    }

    for (const [undirected, list] of edgeToPieces.entries()) {
      if (list.length === 2) {
        union(list[0].pId, list[1].pId);
      }
    }

    // Group into components
    const components = new Map();
    for (const p of pieces) {
      const root = find(p.id);
      if (!components.has(root)) components.set(root, []);
      components.get(root).push(p);
    }

    // Validate each connected component is a simple 4-vertex rectangle
    for (const [root, compPieces] of components.entries()) {
      const boundaryDirectedEdges = [];
      for (const p of compPieces) {
        for (const [key, p1, p2] of p.edges) {
          const u = `${p1[0]},${p1[1]}`;
          const v = `${p2[0]},${p2[1]}`;
          const undirected = u < v ? `${u}<=>${v}` : `${v}<=>${u}`;
          if (edgeToPieces.get(undirected).length === 1) {
            boundaryDirectedEdges.push({ from: p1, to: p2 });
          }
        }
      }

      // Chain edges into loop
      const nextMap = new Map();
      for (const e of boundaryDirectedEdges) {
        const k = `${e.from[0]},${e.from[1]}`;
        if (nextMap.has(k)) {
          return { valid: false, reason: 'self_touching_regions', clueRes };
        }
        nextMap.set(k, e.to);
      }

      const startK = `${boundaryDirectedEdges[0].from[0]},${boundaryDirectedEdges[0].from[1]}`;
      const loop = [boundaryDirectedEdges[0].from];
      let curr = boundaryDirectedEdges[0].to;
      let steps = 0;

      while (`${curr[0]},${curr[1]}` !== startK && steps < boundaryDirectedEdges.length + 5) {
        loop.push(curr);
        const next = nextMap.get(`${curr[0]},${curr[1]}`);
        if (!next) break;
        curr = next;
        steps++;
      }

      if (loop.length !== boundaryDirectedEdges.length) {
        return { valid: false, reason: 'multiple_boundary_loops', clueRes };
      }

      // Simplify collinear points
      const simplified = [];
      const n = loop.length;
      for (let i = 0; i < n; i++) {
        const prev = loop[(i - 1 + n) % n];
        const pt = loop[i];
        const nxt = loop[(i + 1) % n];
        const dx1 = pt[0] - prev[0];
        const dy1 = pt[1] - prev[1];
        const dx2 = nxt[0] - pt[0];
        const dy2 = nxt[1] - pt[1];
        const cross = dx1 * dy2 - dy1 * dx2;
        const dot = dx1 * dx2 + dy1 * dy2;
        if (cross === 0 && dot > 0) continue; // collinear
        simplified.push(pt);
      }

      // Must have exactly 4 vertices
      if (simplified.length !== 4) {
        return { valid: false, reason: 'non_rectangle_vertices', vertexCount: simplified.length, clueRes };
      }

      // Check all 4 interior angles are 90 degrees
      for (let i = 0; i < 4; i++) {
        const p1 = simplified[(i + 3) % 4];
        const p2 = simplified[i];
        const p3 = simplified[(i + 1) % 4];
        const v1x = p1[0] - p2[0];
        const v1y = p1[1] - p2[1];
        const v2x = p3[0] - p2[0];
        const v2y = p3[1] - p2[1];
        const dot = v1x * v2x + v1y * v2y;
        const cross = v1x * v2y - v1y * v2x;
        if (dot !== 0 || cross >= 0) {
          return { valid: false, reason: 'non_90_degree_corner', clueRes };
        }
      }

      // Check opposite sides equal
      function distSq(a, b) {
        const dx = a[0] - b[0];
        const dy = a[1] - b[1];
        return dx * dx + dy * dy;
      }
      const s0 = distSq(simplified[0], simplified[1]);
      const s1 = distSq(simplified[1], simplified[2]);
      const s2 = distSq(simplified[2], simplified[3]);
      const s3 = distSq(simplified[3], simplified[0]);

      if (s0 !== s2 || s1 !== s3) {
        return { valid: false, reason: 'opposite_sides_not_equal', clueRes };
      }
    }

    return { valid: true, clueRes };
  }

  // Shakashaka Game Controller
  class ShakashakaGame {
    constructor(puzzles) {
      this.puzzles = puzzles;
      this.currentDiff = 'easy';
      this.puzzleIndex = 0;
      this.puzzle = null;
      this.grid = [];
      this.history = [];
      this.redoStack = [];
      this.moves = 0;
      this.hintsUsed = 0;
      this.timerSeconds = 0;
      this.timerInterval = null;
      this.isTimerRunning = false;
      this.isPaused = false;
      this.isWon = false;
      this.storageKey = 'pf-shakashaka-v1';

      this.initElements();
      this.bindEvents();
      this.loadSettings();
      this.startFromURLOrSaved();
    }

    initElements() {
      this.gridEl = document.querySelector('#shaka-grid');
      this.timerEl = document.querySelector('#shaka-timer');
      this.movesEl = document.querySelector('#shaka-moves');
      this.cluesEl = document.querySelector('#shaka-clues-status');
      this.bestTimeEl = document.querySelector('#shaka-best-time');
      this.toastEl = document.querySelector('#shaka-toast');
      this.toastTextEl = document.querySelector('#shaka-toast-text');
      this.pausedEl = document.querySelector('#shaka-paused');
      this.victoryEl = document.querySelector('#shaka-victory');
      this.liveEl = document.querySelector('#shaka-live');
      this.diffButtons = Array.from(document.querySelectorAll('.shaka-diff-btn'));
      this.soundBtn = document.querySelector('#shaka-sound-toggle');
      this.soundLabel = document.querySelector('.sound-status-label');

      this.undoBtn = document.querySelector('#shaka-undo-btn');
      this.redoBtn = document.querySelector('#shaka-redo-btn');
      this.newBtn = document.querySelector('#shaka-new-btn');
      this.restartBtn = document.querySelector('#shaka-restart-btn');
      this.hintBtn = document.querySelector('#shaka-hint-btn');
      this.checkBtn = document.querySelector('#shaka-check-btn');
      this.clearBtn = document.querySelector('#shaka-clear-btn');
      this.pauseBtn = document.querySelector('#shaka-pause-btn');
      this.resumeBtn = document.querySelector('#shaka-resume');
      this.nextPuzzleBtn = document.querySelector('#shaka-next-puzzle');
      this.shareBtn = document.querySelector('#shaka-share');
      this.shareStatusEl = document.querySelector('#shaka-share-status');
      this.dailyLabelEl = document.querySelector('#shaka-daily-label');
    }

    bindEvents() {
      // Difficulty tab clicks
      this.diffButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          const diff = btn.dataset.difficulty;
          if (diff) this.setDifficulty(diff);
        });
      });

      // Controls
      this.newBtn?.addEventListener('click', () => this.nextPuzzle());
      this.restartBtn?.addEventListener('click', () => this.restartGame());
      this.undoBtn?.addEventListener('click', () => this.undo());
      this.redoBtn?.addEventListener('click', () => this.redo());
      this.hintBtn?.addEventListener('click', () => this.giveHint());
      this.checkBtn?.addEventListener('click', () => this.manualCheck());
      this.clearBtn?.addEventListener('click', () => this.clearUserTriangles());
      this.pauseBtn?.addEventListener('click', () => this.togglePause());
      this.resumeBtn?.addEventListener('click', () => this.togglePause());
      this.nextPuzzleBtn?.addEventListener('click', () => {
        this.victoryEl.hidden = true;
        this.nextPuzzle();
      });
      this.shareBtn?.addEventListener('click', () => this.shareResult());

      // Sound toggle
      this.soundBtn?.addEventListener('click', () => {
        sound.enabled = !sound.enabled;
        this.updateSoundButton();
        this.saveState();
      });

      // Keyboard navigation and placement
      window.addEventListener('keydown', (e) => this.handleKeyDown(e));
    }

    updateSoundButton() {
      if (this.soundLabel) {
        this.soundLabel.textContent = sound.enabled ? 'Sound On' : 'Sound Off';
      }
      if (this.soundBtn) {
        this.soundBtn.classList.toggle('is-muted', !sound.enabled);
      }
    }

    startFromURLOrSaved() {
      const params = new URLSearchParams(window.location.search);
      const isDaily = params.get('daily') === '1' || params.get('mode') === 'daily';
      const urlDiff = params.get('diff');

      if (isDaily) {
        this.setDifficulty('daily');
        return;
      }

      if (urlDiff && ['easy', 'medium', 'hard'].includes(urlDiff)) {
        this.setDifficulty(urlDiff);
        return;
      }

      const saved = this.loadState();
      if (saved && saved.puzzleId) {
        const found = this.puzzles.find(p => p.id === saved.puzzleId);
        if (found) {
          this.currentDiff = found.difficulty;
          this.puzzle = found;
          this.puzzleIndex = this.getDiffPuzzles(found.difficulty).findIndex(p => p.id === found.id);
          this.initBoard(saved.grid, saved.moves, saved.timerSeconds);
          this.updateDiffButtons();
          this.updateBestDisplay();
          return;
        }
      }

      this.setDifficulty('easy');
    }

    getDiffPuzzles(diff) {
      if (diff === 'daily') {
        const todayStr = new Date().toISOString().slice(0, 10);
        return [getDailyPuzzleClient(this.puzzles, todayStr)];
      }
      return this.puzzles.filter(p => p.difficulty === diff);
    }

    setDifficulty(diff) {
      this.currentDiff = diff;
      this.puzzleIndex = 0;
      const list = this.getDiffPuzzles(diff);
      this.puzzle = list[0] || this.puzzles[0];
      this.updateDiffButtons();
      this.initBoard();
      this.updateBestDisplay();
      this.saveState();
    }

    updateDiffButtons() {
      this.diffButtons.forEach(btn => {
        const active = btn.dataset.difficulty === this.currentDiff;
        btn.classList.toggle('is-active', active);
        btn.setAttribute('aria-selected', active ? 'true' : 'false');
      });
    }

    initBoard(savedGrid = null, savedMoves = 0, savedTimer = 0) {
      this.stopTimer();
      this.isWon = false;
      this.isPaused = false;
      this.pausedEl.hidden = true;
      this.victoryEl.hidden = true;
      this.history = [];
      this.redoStack = [];
      this.hintsUsed = 0;
      this.moves = savedMoves;
      this.timerSeconds = savedTimer;
      this.isTimerRunning = false;

      // Deep copy grid
      if (savedGrid && savedGrid.length === this.puzzle.rows) {
        this.grid = savedGrid.map(row => [...row]);
      } else {
        this.grid = this.puzzle.initialGrid.map(row => [...row]);
      }

      this.renderBoard();
      this.updateStats();
      this.updateUndoRedo();
      this.hideToast();
    }

    renderBoard() {
      if (!this.gridEl || !this.puzzle) return;
      this.gridEl.innerHTML = '';
      this.gridEl.style.setProperty('--grid-cols', this.puzzle.cols);
      this.gridEl.style.setProperty('--grid-rows', this.puzzle.rows);

      for (let r = 0; r < this.puzzle.rows; r++) {
        for (let c = 0; c < this.puzzle.cols; c++) {
          const val = this.grid[r][c];
          const cell = document.createElement('button');
          cell.type = 'button';
          cell.className = 'shaka-cell';
          cell.dataset.r = r;
          cell.dataset.c = c;
          cell.setAttribute('role', 'gridcell');

          if (val < 0) {
            cell.classList.add('is-black');
            cell.setAttribute('tabindex', '-1');
            if (val <= -2) {
              const num = -val - 2;
              const span = document.createElement('span');
              span.className = 'clue-number';
              span.textContent = num;
              cell.appendChild(span);
              cell.setAttribute('aria-label', `Black clue cell with number ${num}`);
            } else {
              cell.setAttribute('aria-label', 'Solid black cell');
            }
          } else {
            cell.classList.add('is-white');
            cell.setAttribute('tabindex', '0');
            this.updateCellOrientation(cell, val);

            // Click / tap
            cell.addEventListener('click', (e) => {
              e.preventDefault();
              this.cycleCell(r, c, 1);
            });

            // Secondary tap / Right-click
            cell.addEventListener('contextmenu', (e) => {
              e.preventDefault();
              this.cycleCell(r, c, -1);
            });
          }

          this.gridEl.appendChild(cell);
        }
      }

      this.refreshCluesUI();
    }

    updateCellOrientation(cellEl, val) {
      const existingSvg = cellEl.querySelector('.shaka-tri-svg');
      if (existingSvg) existingSvg.remove();

      cellEl.classList.remove('has-tri', 'tri-1', 'tri-2', 'tri-3', 'tri-4');

      if (val === 0) {
        cellEl.setAttribute('aria-label', 'Empty white cell');
      } else {
        cellEl.classList.add('has-tri', `tri-${val}`);
        const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
        svg.setAttribute('viewBox', '0 0 100 100');
        svg.setAttribute('class', 'shaka-tri-svg');
        svg.setAttribute('aria-hidden', 'true');

        const poly = document.createElementNS('http://www.w3.org/2000/svg', 'polygon');
        let pts = '';
        let orientName = '';
        if (val === 1) { pts = '0,0 100,0 0,100'; orientName = 'Top-Left ◤'; }
        else if (val === 2) { pts = '0,0 100,0 100,100'; orientName = 'Top-Right ◥'; }
        else if (val === 3) { pts = '100,0 100,100 0,100'; orientName = 'Bottom-Right ◢'; }
        else if (val === 4) { pts = '0,0 100,100 0,100'; orientName = 'Bottom-Left ◣'; }

        poly.setAttribute('points', pts);
        svg.appendChild(poly);
        cellEl.appendChild(svg);
        cellEl.setAttribute('aria-label', `White cell with ${orientName} triangle`);
      }
    }

    cycleCell(r, c, direction = 1) {
      if (this.isWon || this.isPaused) return;
      const current = this.grid[r][c];
      if (current < 0) return; // cannot modify black cells

      this.startTimer();
      const next = (current + direction + 5) % 5;
      this.history.push({ r, c, prev: current, next });
      this.redoStack = [];
      this.grid[r][c] = next;
      this.moves++;

      if (next === 0) sound.playClear();
      else sound.playPlace(next);

      const cellEl = this.getCellEl(r, c);
      if (cellEl) this.updateCellOrientation(cellEl, next);

      this.updateStats();
      this.updateUndoRedo();
      this.refreshCluesUI();
      this.saveState();

      // Check win automatically
      this.checkWinCondition(false);
    }

    getCellEl(r, c) {
      return this.gridEl?.querySelector(`button[data-r="${r}"][data-c="${c}"]`);
    }

    refreshCluesUI() {
      const status = checkClueStatus(this.grid, this.puzzle.rows, this.puzzle.cols);
      for (const info of status.clueCells) {
        const cell = this.getCellEl(info.r, info.c);
        if (cell) {
          cell.classList.toggle('is-satisfied', info.satisfied);
          cell.classList.toggle('is-violated', info.violated);
        }
      }
      if (this.cluesEl) {
        this.cluesEl.textContent = `${status.satisfiedClues} / ${status.totalClues}`;
      }
      return status;
    }

    checkWinCondition(isManual = false) {
      if (this.isWon) return;

      // Check clues first
      const clueRes = checkClueStatus(this.grid, this.puzzle.rows, this.puzzle.cols);
      if (!clueRes.allSatisfied) {
        if (isManual) {
          if (clueRes.anyViolated) {
            this.showToast('One or more numbered clues have too many touching triangles.', 'error');
            sound.playError();
          } else {
            this.showToast(`Clues progress: ${clueRes.satisfiedClues} of ${clueRes.totalClues} satisfied. Keep going!`, 'normal');
            sound.playClick();
          }
        }
        return false;
      }

      // Check white rectangles
      const geoRes = validateBoardGeometry(this.grid, this.puzzle.rows, this.puzzle.cols);
      if (geoRes.valid) {
        this.handleVictory();
        return true;
      } else {
        if (isManual) {
          if (geoRes.reason === 'non_rectangle_vertices' || geoRes.reason === 'non_90_degree_corner') {
            this.showToast('All numbered clues are satisfied, but some white areas do not form complete rectangles or squares yet.', 'error');
            sound.playError();
          } else {
            this.showToast('Looking close! Verify that all white corridors form complete 4-sided rectangles.', 'normal');
            sound.playClick();
          }
        }
        return false;
      }
    }

    handleVictory() {
      this.isWon = true;
      this.stopTimer();
      sound.playWin();

      // Check PB
      const bestKey = `pf-shakashaka-best-${this.currentDiff}`;
      let isNewPB = false;
      try {
        const savedBest = JSON.parse(localStorage.getItem(bestKey) || 'null');
        if (!savedBest || this.timerSeconds < savedBest.time || (this.timerSeconds === savedBest.time && this.moves < savedBest.moves)) {
          isNewPB = true;
          localStorage.setItem(bestKey, JSON.stringify({ time: this.timerSeconds, moves: this.moves }));
        }
      } catch (e) {}

      // If Daily Challenge, record completion
      if (this.currentDiff === 'daily') {
        const todayStr = new Date().toISOString().slice(0, 10);
        try {
          localStorage.setItem(`pf-shakashaka-daily-solved-${todayStr}`, 'true');
        } catch (e) {}
      }

      // Show Victory Modal
      const diffLabel = this.currentDiff === 'daily' ? 'Daily Challenge' : this.currentDiff.charAt(0).toUpperCase() + this.currentDiff.slice(1);
      document.querySelector('#victory-diff-label').textContent = diffLabel;
      document.querySelector('#victory-time').textContent = this.formatTime(this.timerSeconds);
      document.querySelector('#victory-moves').textContent = this.moves;
      document.querySelector('#victory-hints').textContent = this.hintsUsed;
      document.querySelector('#shaka-pb-badge').hidden = !isNewPB;

      this.victoryEl.hidden = false;
      this.updateBestDisplay();
      this.announce(`Puzzle Solved in ${this.formatTime(this.timerSeconds)} and ${this.moves} moves!`);
    }

    undo() {
      if (this.history.length === 0 || this.isWon || this.isPaused) return;
      const last = this.history.pop();
      this.redoStack.push(last);
      this.grid[last.r][last.c] = last.prev;
      this.moves++;

      const cell = this.getCellEl(last.r, last.c);
      if (cell) this.updateCellOrientation(cell, last.prev);

      sound.playClick();
      this.updateStats();
      this.updateUndoRedo();
      this.refreshCluesUI();
      this.saveState();
    }

    redo() {
      if (this.redoStack.length === 0 || this.isWon || this.isPaused) return;
      const item = this.redoStack.pop();
      this.history.push(item);
      this.grid[item.r][item.c] = item.next;
      this.moves++;

      const cell = this.getCellEl(item.r, item.c);
      if (cell) this.updateCellOrientation(cell, item.next);

      sound.playPlace(item.next);
      this.updateStats();
      this.updateUndoRedo();
      this.refreshCluesUI();
      this.saveState();
      this.checkWinCondition(false);
    }

    updateUndoRedo() {
      if (this.undoBtn) this.undoBtn.disabled = this.history.length === 0 || this.isWon;
      if (this.redoBtn) this.redoBtn.disabled = this.redoStack.length === 0 || this.isWon;
    }

    giveHint() {
      if (this.isWon || this.isPaused) return;
      this.startTimer();

      const sol = this.puzzle.solution;
      let incorrectCell = null;
      let missingCell = null;

      // 1. Check if user placed an incorrect triangle
      for (let r = 0; r < this.puzzle.rows; r++) {
        for (let c = 0; c < this.puzzle.cols; c++) {
          const current = this.grid[r][c];
          const expected = sol[r][c];
          if (current > 0 && current !== expected) {
            incorrectCell = { r, c, current, expected };
            break;
          }
        }
        if (incorrectCell) break;
      }

      if (incorrectCell) {
        const { r, c } = incorrectCell;
        const cell = this.getCellEl(r, c);
        if (cell) {
          cell.classList.add('is-hint-highlight');
          setTimeout(() => cell.classList.remove('is-hint-highlight'), 1800);
        }
        this.showToast(`Hint: The triangle at row ${r + 1}, column ${c + 1} is not in the correct orientation.`, 'error');
        sound.playError();
        this.hintsUsed++;
        return;
      }

      // 2. Find next missing triangle
      for (let r = 0; r < this.puzzle.rows; r++) {
        for (let c = 0; c < this.puzzle.cols; c++) {
          const current = this.grid[r][c];
          const expected = sol[r][c];
          if (expected > 0 && current === 0) {
            missingCell = { r, c, expected };
            break;
          }
        }
        if (missingCell) break;
      }

      if (missingCell) {
        const { r, c, expected } = missingCell;
        this.cycleCell(r, c, expected);
        const cell = this.getCellEl(r, c);
        if (cell) {
          cell.classList.add('is-hint-highlight');
          setTimeout(() => cell.classList.remove('is-hint-highlight'), 1600);
        }
        const names = ['', 'Top-Left ◤', 'Top-Right ◥', 'Bottom-Right ◢', 'Bottom-Left ◣'];
        this.showToast(`Hint placed: ${names[expected]} at row ${r + 1}, column ${c + 1}.`, 'success');
        sound.playHint();
        this.hintsUsed++;
        return;
      }

      this.showToast('All placed triangles are correct so far! Just form the remaining white rectangles.', 'normal');
      sound.playClick();
    }

    manualCheck() {
      this.checkWinCondition(true);
    }

    clearUserTriangles() {
      if (this.isWon || this.isPaused) return;
      let changed = false;
      for (let r = 0; r < this.puzzle.rows; r++) {
        for (let c = 0; c < this.puzzle.cols; c++) {
          if (this.grid[r][c] > 0) {
            this.grid[r][c] = 0;
            changed = true;
            const cell = this.getCellEl(r, c);
            if (cell) this.updateCellOrientation(cell, 0);
          }
        }
      }
      if (changed) {
        sound.playClear();
        this.history = [];
        this.redoStack = [];
        this.updateUndoRedo();
        this.refreshCluesUI();
        this.saveState();
        this.showToast('Board cleared.', 'normal');
      }
    }

    restartGame() {
      this.initBoard();
      sound.playClick();
      this.showToast('Puzzle restarted.', 'normal');
    }

    nextPuzzle() {
      const list = this.getDiffPuzzles(this.currentDiff);
      this.puzzleIndex = (this.puzzleIndex + 1) % list.length;
      this.puzzle = list[this.puzzleIndex];
      this.initBoard();
      sound.playClick();
      this.showToast(`Loaded ${this.puzzle.title}.`, 'normal');
    }

    togglePause() {
      if (this.isWon) return;
      this.isPaused = !this.isPaused;
      this.pausedEl.hidden = !this.isPaused;
      if (this.isPaused) {
        this.stopTimer();
      } else {
        this.startTimer();
      }
      sound.playClick();
    }

    startTimer() {
      if (this.isTimerRunning || this.isPaused || this.isWon) return;
      this.isTimerRunning = true;
      this.timerInterval = setInterval(() => {
        this.timerSeconds++;
        this.updateTimerDisplay();
      }, 1000);
    }

    stopTimer() {
      if (this.timerInterval) {
        clearInterval(this.timerInterval);
        this.timerInterval = null;
      }
      this.isTimerRunning = false;
    }

    updateTimerDisplay() {
      if (this.timerEl) this.timerEl.textContent = this.formatTime(this.timerSeconds);
    }

    updateStats() {
      if (this.movesEl) this.movesEl.textContent = this.moves;
      this.updateTimerDisplay();
    }

    formatTime(sec) {
      const m = Math.floor(sec / 60).toString().padStart(2, '0');
      const s = (sec % 60).toString().padStart(2, '0');
      return `${m}:${s}`;
    }

    updateBestDisplay() {
      const bestKey = `pf-shakashaka-best-${this.currentDiff}`;
      try {
        const saved = JSON.parse(localStorage.getItem(bestKey) || 'null');
        if (saved && this.bestTimeEl) {
          this.bestTimeEl.textContent = this.formatTime(saved.time);
        } else if (this.bestTimeEl) {
          this.bestTimeEl.textContent = '—';
        }
      } catch (e) {
        if (this.bestTimeEl) this.bestTimeEl.textContent = '—';
      }
    }

    showToast(msg, type = 'normal') {
      if (!this.toastEl || !this.toastTextEl) return;
      this.toastTextEl.textContent = msg;
      this.toastEl.className = `shaka-toast is-${type}`;
      this.toastEl.hidden = false;
      clearTimeout(this.toastTimer);
      this.toastTimer = setTimeout(() => {
        this.hideToast();
      }, 3500);
    }

    hideToast() {
      if (this.toastEl) this.toastEl.hidden = true;
    }

    announce(msg) {
      if (this.liveEl) this.liveEl.textContent = msg;
    }

    shareResult() {
      const timeStr = this.formatTime(this.timerSeconds);
      const diffLabel = this.currentDiff === 'daily' ? 'Daily Challenge' : this.currentDiff.toUpperCase();
      const text = `I solved Shakashaka (${diffLabel}) on PuzzleFeels in ${timeStr} with ${this.moves} moves! 🧩\nhttps://puzzlefeels.com/shakashaka-online-puzzle-game/`;

      if (navigator.clipboard) {
        navigator.clipboard.writeText(text).then(() => {
          if (this.shareStatusEl) {
            this.shareStatusEl.textContent = 'Copied to clipboard!';
            setTimeout(() => { if (this.shareStatusEl) this.shareStatusEl.textContent = ''; }, 2500);
          }
        }).catch(() => {});
      }
    }

    handleKeyDown(e) {
      if (this.isWon || this.isPaused) return;

      const active = document.activeElement;
      if (!active || !active.classList.contains('shaka-cell')) return;

      const r = parseInt(active.dataset.r, 10);
      const c = parseInt(active.dataset.c, 10);
      if (isNaN(r) || isNaN(c)) return;

      if (['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight'].includes(e.key)) {
        e.preventDefault();
        let nr = r;
        let nc = c;
        if (e.key === 'ArrowUp') nr = Math.max(0, r - 1);
        if (e.key === 'ArrowDown') nr = Math.min(this.puzzle.rows - 1, r + 1);
        if (e.key === 'ArrowLeft') nc = Math.max(0, c - 1);
        if (e.key === 'ArrowRight') nc = Math.min(this.puzzle.cols - 1, c + 1);
        const nextCell = this.getCellEl(nr, nc);
        if (nextCell) nextCell.focus();
        return;
      }

      if (e.key === ' ' || e.key === 'Enter') {
        e.preventDefault();
        this.cycleCell(r, c, 1);
        return;
      }

      if (['1', '2', '3', '4'].includes(e.key)) {
        e.preventDefault();
        const target = parseInt(e.key, 10);
        if (this.grid[r][c] >= 0) {
          this.cycleCell(r, c, target - this.grid[r][c]);
        }
        return;
      }

      if (['0', 'Backspace', 'Delete'].includes(e.key)) {
        e.preventDefault();
        if (this.grid[r][c] > 0) {
          this.cycleCell(r, c, -this.grid[r][c]);
        }
        return;
      }

      if (e.key === 'u' || e.key === 'U') {
        e.preventDefault();
        this.undo();
      } else if (e.key === 'r' || e.key === 'R') {
        e.preventDefault();
        this.redo();
      }
    }

    saveState() {
      try {
        const state = {
          puzzleId: this.puzzle.id,
          grid: this.grid,
          moves: this.moves,
          timerSeconds: this.timerSeconds,
          soundEnabled: sound.enabled
        };
        localStorage.setItem(this.storageKey, JSON.stringify(state));
      } catch (e) {}
    }

    loadState() {
      try {
        return JSON.parse(localStorage.getItem(this.storageKey) || 'null');
      } catch (e) {
        return null;
      }
    }

    loadSettings() {
      try {
        const saved = JSON.parse(localStorage.getItem(this.storageKey) || 'null');
        if (saved && typeof saved.soundEnabled === 'boolean') {
          sound.enabled = saved.soundEnabled;
        }
      } catch (e) {}
      this.updateSoundButton();
    }
  }

  // Client daily puzzle selector helper
  function getDailyPuzzleClient(puzzles, dateStr) {
    let hash = 0;
    for (let i = 0; i < dateStr.length; i++) {
      hash = (hash << 5) - hash + dateStr.charCodeAt(i);
      hash |= 0;
    }
    const candidates = puzzles.filter(p => p.difficulty === 'medium');
    const index = Math.abs(hash) % (candidates.length || puzzles.length);
    return (candidates[index] || puzzles[0]);
  }

  // Bootstrap when DOM ready
  document.addEventListener('DOMContentLoaded', () => {
    new ShakashakaGame(rawPuzzles);
  });
</script>
