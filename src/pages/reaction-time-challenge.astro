</Base>

<script>
  // ==========================================
  // REACTION TIME CHALLENGE ENGINE
  // ==========================================

  type ModeType = 'classic' | 'quick' | 'endurance' | 'daily';
  type StateType = 'idle' | 'waiting' | 'ready' | 'false-start' | 'round-result' | 'completed';

  interface ModeConfig {
    name: string;
    totalRounds: number;
    storageKey: string;
  }

  const MODES: Record<ModeType, ModeConfig> = {
    classic: { name: 'Classic Test', totalRounds: 5, storageKey: 'pf-reaction-time-classic-v1' },
    quick: { name: 'Quick Reflex', totalRounds: 1, storageKey: 'pf-reaction-time-quick-v1' },
    endurance: { name: 'Endurance Test', totalRounds: 10, storageKey: 'pf-reaction-time-endurance-v1' },
    daily: { name: 'Daily Challenge', totalRounds: 5, storageKey: 'pf-reaction-time-daily-v1' }
  };

  // State variables
  let currentMode: ModeType = 'classic';
  let currentState: StateType = 'idle';
  let currentRound = 1;
  let roundTimes: number[] = [];
  let startTime = 0;
  let waitTimeoutId: number | null = null;
  let soundEnabled = true;
  let audioCtx: AudioContext | null = null;
  let lastActionTime = 0;

  // Cache DOM elements
  const playZone = document.getElementById('reaction-play-zone') as HTMLElement;
  const statusModePill = document.getElementById('status-mode-pill') as HTMLElement;
  const statusRoundPill = document.getElementById('status-round-pill') as HTMLElement;
  const statusPbDisplay = document.getElementById('status-pb-display') as HTMLElement;
  const modeButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.reaction-mode-btn'));
  const soundToggleBtn = document.getElementById('reaction-sound-toggle') as HTMLButtonElement;
  const soundOnIcon = soundToggleBtn?.querySelector('.sound-on-icon') as SVGElement;
  const soundOffIcon = soundToggleBtn?.querySelector('.sound-off-icon') as SVGElement;
  const soundLabel = soundToggleBtn?.querySelector('.sound-label') as HTMLElement;

  // Dashboard elements
  const dashboard = document.getElementById('reaction-results-dashboard') as HTMLElement;
  const resultsTitle = document.getElementById('results-title') as HTMLElement;
  const resultsSubtitle = document.getElementById('results-subtitle') as HTMLElement;
  const resultsHeroLabel = document.getElementById('results-hero-label') as HTMLElement;
  const resultsHeroVal = document.getElementById('results-hero-value') as HTMLElement;
  const resultsRatingBadge = document.getElementById('results-rating-badge') as HTMLElement;
  const resultsComparison = document.getElementById('results-comparison') as HTMLElement;
  const resultsPbBadge = document.getElementById('results-pb-badge') as HTMLElement;
  const statFastest = document.getElementById('stat-fastest') as HTMLElement;
  const statSlowest = document.getElementById('stat-slowest') as HTMLElement;
  const statRounds = document.getElementById('stat-rounds') as HTMLElement;
  const statRecord = document.getElementById('stat-record') as HTMLElement;
  const roundsList = document.getElementById('rounds-list') as HTMLElement;
  const resultsRoundsContainer = document.getElementById('results-rounds-container') as HTMLElement;
  const btnReplay = document.getElementById('btn-replay') as HTMLButtonElement;
  const btnShare = document.getElementById('btn-share') as HTMLButtonElement;
  const btnResetMode = document.getElementById('btn-reset-mode') as HTMLButtonElement;
  const btnResetAll = document.getElementById('btn-reset-all') as HTMLButtonElement;
  const shareToast = document.getElementById('share-toast') as HTMLElement;

  // Daily elements
  const dailyBanner = document.getElementById('daily-banner') as HTMLElement;
  const dailyDateLabel = document.getElementById('daily-date-label') as HTMLElement;
  const dailyStatusTag = document.getElementById('daily-status-tag') as HTMLElement;
  const dailyTodayScore = document.getElementById('daily-today-score') as HTMLElement;

  // Round result view elements
  const roundResultTag = document.getElementById('round-result-tag') as HTMLElement;
  const roundTimeVal = document.getElementById('round-time-val') as HTMLElement;
  const roundRatingBadge = document.getElementById('round-rating-badge') as HTMLElement;
  const roundSubText = document.getElementById('round-sub-text') as HTMLElement;
  const liveAnnouncer = document.getElementById('reaction-live') as HTMLElement;

  // Views inside play zone
  const viewIdle = playZone?.querySelector('.view-idle') as HTMLElement;
  const viewWaiting = playZone?.querySelector('.view-waiting') as HTMLElement;
  const viewReady = playZone?.querySelector('.view-ready') as HTMLElement;
  const viewFalseStart = playZone?.querySelector('.view-false-start') as HTMLElement;
  const viewRoundResult = playZone?.querySelector('.view-round-result') as HTMLElement;
  const viewCompleted = playZone?.querySelector('.view-completed') as HTMLElement;
  const completedSubText = document.getElementById('completed-sub-text') as HTMLElement;
  const zoneReplayBtn = document.getElementById('zone-replay-btn') as HTMLButtonElement;
  const completedScrollHint = document.getElementById('completed-scroll-hint') as HTMLElement;

  // Sound setup via Web Audio API
  function initAudio() {
    if (!audioCtx) {
      const AudioContextClass = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
      if (AudioContextClass) {
        audioCtx = new AudioContextClass();
      }
    }
    if (audioCtx && audioCtx.state === 'suspended') {
      audioCtx.resume();
    }
  }

  function playTone(freq: number, type: OscillatorType, duration: number, gainVal = 0.08) {
    if (!soundEnabled) return;
    try {
      initAudio();
      if (!audioCtx) return;
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.type = type;
      osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
      gain.gain.setValueAtTime(gainVal, audioCtx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime + duration);
      osc.connect(gain);
      gain.connect(audioCtx.destination);
      osc.start();
      osc.stop(audioCtx.currentTime + duration);
    } catch {
      // Audio autoplay policy fallback
    }
  }

  function playSignalSound() {
    playTone(880, 'sine', 0.12, 0.12);
  }

  function playSuccessClickSound() {
    playTone(523.25, 'sine', 0.08, 0.09);
    setTimeout(() => playTone(659.25, 'sine', 0.1, 0.09), 60);
  }

  function playFalseStartSound() {
    playTone(180, 'sawtooth', 0.22, 0.12);
  }

  function playVictoryFanfare() {
    const notes = [523.25, 659.25, 783.99, 1046.50];
    notes.forEach((n, idx) => {
      setTimeout(() => playTone(n, 'sine', 0.25, 0.1), idx * 110);
    });
  }

  // PRNG for Daily Challenge
  function getUtcDateString(d = new Date()): string {
    const y = d.getUTCFullYear();
    const m = String(d.getUTCMonth() + 1).padStart(2, '0');
    const day = String(d.getUTCDate()).padStart(2, '0');
    return `${y}-${m}-${day}`;
  }

  function hashString(str: string): number {
    let hash = 1779033703 ^ str.length;
    for (let i = 0; i < str.length; i++) {
      hash = Math.imul(hash ^ str.charCodeAt(i), 3432918353);
      hash = (hash << 13) | (hash >>> 19);
    }
    return hash >>> 0;
  }

  function mulberry32(a: number): () => number {
    return function() {
      let t = (a += 0x6D2B79F5);
      t = Math.imul(t ^ (t >>> 15), t | 1);
      t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }

  function getDailyDelays(utcDateStr: string, count = 5): number[] {
    const seed = hashString(utcDateStr);
    const rng = mulberry32(seed);
    const delays: number[] = [];
    for (let i = 0; i < count; i++) {
      // 1800ms to 4600ms deterministic
      const delay = Math.round(1800 + rng() * 2800);
      delays.push(delay);
    }
    return delays;
  }

  // LocalStorage Helpers
  interface StoredStats {
    bestTime: number | null;
    gamesPlayed: number;
    history: number[];
    lastUpdated?: string;
    lastCompletedDate?: string;
    todayAverage?: number | null;
  }

  function getStats(mode: ModeType): StoredStats {
    try {
      const raw = localStorage.getItem(MODES[mode].storageKey);
      if (raw) {
        const parsed = JSON.parse(raw);
        if (typeof parsed === 'object' && parsed !== null) {
          return {
            bestTime: typeof parsed.bestTime === 'number' ? parsed.bestTime : null,
            gamesPlayed: typeof parsed.gamesPlayed === 'number' ? parsed.gamesPlayed : 0,
            history: Array.isArray(parsed.history) ? parsed.history : [],
            lastUpdated: parsed.lastUpdated,
            lastCompletedDate: parsed.lastCompletedDate,
            todayAverage: typeof parsed.todayAverage === 'number' ? parsed.todayAverage : null
          };
        }
      }
    } catch {
      // Storage unavailable or JSON error
    }
    return { bestTime: null, gamesPlayed: 0, history: [] };
  }

  function saveStats(mode: ModeType, stats: StoredStats): void {
    try {
      localStorage.setItem(MODES[mode].storageKey, JSON.stringify(stats));
    } catch {
      // Ignore storage errors
    }
  }

  function getPerformanceRating(ms: number): { label: string; className: string } {
    if (ms < 150) return { label: 'Lightning Fast', className: 'tier-lightning' };
    if (ms < 200) return { label: 'Extremely Fast', className: 'tier-extreme' };
    if (ms < 250) return { label: 'Very Fast', className: 'tier-very-fast' };
    if (ms < 300) return { label: 'Fast', className: 'tier-fast' };
    if (ms < 350) return { label: 'Average', className: 'tier-average' };
    if (ms < 400) return { label: 'Below Average', className: 'tier-below' };
    return { label: 'Keep Practicing', className: 'tier-practice' };
  }

  // UI state switcher
  function updateUIState(state: StateType) {
    currentState = state;
    playZone.className = `reaction-play-zone state-${state}`;

    if (viewIdle) viewIdle.setAttribute('aria-hidden', String(state !== 'idle'));
    if (viewWaiting) viewWaiting.setAttribute('aria-hidden', String(state !== 'waiting'));
    if (viewReady) viewReady.setAttribute('aria-hidden', String(state !== 'ready'));
    if (viewFalseStart) viewFalseStart.setAttribute('aria-hidden', String(state !== 'false-start'));
    if (viewRoundResult) viewRoundResult.setAttribute('aria-hidden', String(state !== 'round-result'));
    if (viewCompleted) viewCompleted.setAttribute('aria-hidden', String(state !== 'completed'));

    if (dashboard) dashboard.hidden = (state !== 'completed');

    if (state === 'completed') {
      playZone.setAttribute('aria-label', 'Reaction time interactive play area - Test completed. Click to play again.');
    } else {
      playZone.setAttribute('aria-label', 'Reaction time interactive play area');
    }

    // Accessibility announcements
    if (state === 'waiting') {
      announce('Wait for green. Timer will begin when screen turns green.');
    } else if (state === 'ready') {
      announce('Click now!');
    } else if (state === 'false-start') {
      announce('False start. You clicked too early.');
    } else if (state === 'completed') {
      announce('Challenge completed! Detailed results and performance stats are displayed below.');
    }
  }

  // Smooth scroll helpers with sticky header clearance and reduced motion support
  function scrollToResults() {
    if (!dashboard || dashboard.hidden) return;
    const headerHeight = window.innerWidth <= 680 ? 66 : 76;
    const buffer = 18;
    const rect = dashboard.getBoundingClientRect();
    const targetY = rect.top + window.scrollY - headerHeight - buffer;
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    window.scrollTo({
      top: Math.max(0, targetY),
      behavior: prefersReducedMotion ? 'auto' : 'smooth'
    });
  }

  function scrollToPlayZone() {
    if (!playZone) return;
    const headerHeight = window.innerWidth <= 680 ? 66 : 76;
    const buffer = 18;
    const rect = playZone.getBoundingClientRect();
    const targetY = rect.top + window.scrollY - headerHeight - buffer;
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    window.scrollTo({
      top: Math.max(0, targetY),
      behavior: prefersReducedMotion ? 'auto' : 'smooth'
    });
  }

  function replayGame() {
    switchMode(currentMode);
    scrollToPlayZone();
  }

  function announce(msg: string) {
    if (liveAnnouncer) {
      liveAnnouncer.textContent = msg;
    }
  }

  function updateStatusDisplay() {
    const config = MODES[currentMode];
    if (statusModePill) statusModePill.textContent = config.name;

    if (currentMode === 'quick') {
      if (statusRoundPill) statusRoundPill.textContent = 'Single Reflex Test';
    } else {
      if (statusRoundPill) statusRoundPill.textContent = `Round ${currentRound} of ${config.totalRounds}`;
    }

    const stats = getStats(currentMode);
    if (statusPbDisplay) {
      if (stats.bestTime !== null) {
        statusPbDisplay.innerHTML = `Personal Best: <strong>${stats.bestTime} ms</strong>`;
      } else {
        statusPbDisplay.innerHTML = `Personal Best: <strong>-- ms</strong>`;
      }
    }

    // Update Daily Banner
    if (currentMode === 'daily') {
      if (dailyBanner) dailyBanner.hidden = false;
      const todayStr = getUtcDateString();
      if (dailyDateLabel) {
        const d = new Date();
        const monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
        dailyDateLabel.textContent = `Daily Challenge · ${monthNames[d.getUTCMonth()]} ${d.getUTCDate()}, ${d.getUTCFullYear()} (UTC)`;
      }
      if (stats.lastCompletedDate === todayStr && stats.todayAverage !== null && stats.todayAverage !== undefined) {
        if (dailyStatusTag) {
          dailyStatusTag.textContent = 'Completed Today';
          dailyStatusTag.className = 'daily-status-tag is-completed';
        }
        if (dailyTodayScore) dailyTodayScore.textContent = `${stats.todayAverage} ms avg`;
      } else {
        if (dailyStatusTag) {
          dailyStatusTag.textContent = 'Not Completed Today';
          dailyStatusTag.className = 'daily-status-tag';
        }
        if (dailyTodayScore) dailyTodayScore.textContent = '-- ms';
      }
    } else {
      if (dailyBanner) dailyBanner.hidden = true;
    }
  }

  // Start waiting phase
  function startRound() {
    if (waitTimeoutId) {
      window.clearTimeout(waitTimeoutId);
      waitTimeoutId = null;
    }

    updateStatusDisplay();
    updateUIState('waiting');

    let delay = 0;
    if (currentMode === 'daily') {
      const todayStr = getUtcDateString();
      const delays = getDailyDelays(todayStr, 5);
      const idx = Math.min(Math.max(currentRound - 1, 0), delays.length - 1);
      delay = delays[idx];
    } else {
      // Randomized between 1500ms and 4800ms
      delay = Math.floor(1500 + Math.random() * 3300);
    }

    waitTimeoutId = window.setTimeout(() => {
      triggerSignal();
    }, delay);
  }

  // Green signal triggers
  function triggerSignal() {
    waitTimeoutId = null;
    startTime = performance.now();
    updateUIState('ready');
    playSignalSound();
  }

  // Handle click during waiting state
  function handleFalseStart() {
    if (waitTimeoutId) {
      window.clearTimeout(waitTimeoutId);
      waitTimeoutId = null;
    }
    playFalseStartSound();
    updateUIState('false-start');
  }

  // Handle valid click in ready state
  function handleValidClick(elapsed: number) {
    playSuccessClickSound();
    roundTimes.push(elapsed);

    const config = MODES[currentMode];
    const isFinalRound = (currentRound >= config.totalRounds);

    if (isFinalRound) {
      completeChallenge();
    } else {
      // Show intermediate round result
      if (roundResultTag) roundResultTag.textContent = `Round ${currentRound} of ${config.totalRounds}`;
      if (roundTimeVal) roundTimeVal.textContent = String(elapsed);
      const rating = getPerformanceRating(elapsed);
      if (roundRatingBadge) {
        roundRatingBadge.textContent = rating.label;
        roundRatingBadge.className = `rating-badge ${rating.className}`;
      }
      if (roundSubText) {
        roundSubText.textContent = `Great reflex! Next is Round ${currentRound + 1} of ${config.totalRounds}. Click or press Spacebar to proceed.`;
      }
      updateUIState('round-result');
      currentRound += 1;
      updateStatusDisplay();
    }
  }

  // Complete challenge and display results
  function completeChallenge() {
    updateUIState('completed');
    playVictoryFanfare();

    const config = MODES[currentMode];
    const sum = roundTimes.reduce((acc, t) => acc + t, 0);
    const average = Math.round(sum / roundTimes.length);
    const fastest = Math.min(...roundTimes);
    const slowest = Math.max(...roundTimes);

    const oldStats = getStats(currentMode);
    const isNewPb = oldStats.bestTime === null || average < oldStats.bestTime;
    const oldBest = oldStats.bestTime;

    // Save statistics
    const todayStr = getUtcDateString();
    const updatedStats: StoredStats = {
      bestTime: isNewPb ? average : oldBest,
      gamesPlayed: oldStats.gamesPlayed + 1,
      history: [average, ...oldStats.history].slice(0, 20),
      lastUpdated: new Date().toISOString()
    };

    if (currentMode === 'daily') {
      updatedStats.lastCompletedDate = todayStr;
      updatedStats.todayAverage = average;
    }

    saveStats(currentMode, updatedStats);

    // Update Dashboard UI
    if (resultsTitle) {
      resultsTitle.textContent = `${config.name} Complete!`;
    }
    if (resultsSubtitle) {
      resultsSubtitle.textContent = currentMode === 'quick' 
        ? 'Here is your single reflex score:' 
        : `Summary of all ${roundTimes.length} completed rounds:`;
    }
    if (resultsHeroLabel) {
      resultsHeroLabel.textContent = currentMode === 'quick' ? 'Reaction Time' : 'Average Reaction Time';
    }
    if (resultsHeroVal) {
      resultsHeroVal.textContent = String(average);
    }

    const rating = getPerformanceRating(average);
    if (resultsRatingBadge) {
      resultsRatingBadge.textContent = rating.label;
      resultsRatingBadge.className = `rating-badge large ${rating.className}`;
    }

    if (resultsPbBadge) {
      resultsPbBadge.hidden = !isNewPb;
    }

    if (resultsComparison) {
      if (isNewPb) {
        if (oldBest !== null) {
          resultsComparison.textContent = `🎉 New personal best! Beat previous record by ${oldBest - average} ms!`;
        } else {
          resultsComparison.textContent = '🎉 Your very first verified record for this mode!';
        }
      } else if (oldBest !== null) {
        resultsComparison.textContent = `Previous personal record: ${oldBest} ms (${average - oldBest} ms slower)`;
      } else {
        resultsComparison.textContent = '';
      }
    }

    if (statFastest) statFastest.textContent = `${fastest} ms`;
    if (statSlowest) statSlowest.textContent = `${slowest} ms`;
    if (statRounds) statRounds.textContent = `${roundTimes.length} / ${config.totalRounds}`;
    if (statRecord) statRecord.textContent = updatedStats.bestTime ? `${updatedStats.bestTime} ms` : '-- ms';

    // Round breakdown list
    if (roundsList) {
      roundsList.innerHTML = '';
      if (currentMode === 'quick') {
        if (resultsRoundsContainer) resultsRoundsContainer.hidden = true;
      } else {
        if (resultsRoundsContainer) resultsRoundsContainer.hidden = false;
        roundTimes.forEach((t, i) => {
          const item = document.createElement('div');
          item.className = 'round-pill-item';
          const rRating = getPerformanceRating(t);
          item.innerHTML = `
            <span class="round-idx">Round ${i + 1}</span>
            <span class="round-val">${t} ms</span>
            <span class="round-tier ${rRating.className}">${rRating.label}</span>
          `;
          roundsList.appendChild(item);
        });
      }
    }

    if (completedSubText) {
      completedSubText.textContent = currentMode === 'quick'
        ? 'Reflex recorded. Your verified results and performance rating are ready below.'
        : `All ${roundTimes.length} rounds recorded. Your verified results and statistics are ready below.`;
    }

    updateStatusDisplay();
    announce(`Challenge complete. Your score is ${average} milliseconds.`);

    // Smoothly scroll down to results dashboard after completed state displays
    window.setTimeout(() => {
      scrollToResults();
    }, 180);
  }

  // User input handler (pointer / click / keyboard)
  function handleAction(event?: Event) {
    if (event) {
      // Prevent rapid double triggers
      const now = performance.now();
      if (now - lastActionTime < 60) return;
      lastActionTime = now;
    }

    initAudio();

    if (currentState === 'completed') {
      replayGame();
    } else if (currentState === 'idle') {
      startRound();
    } else if (currentState === 'waiting') {
      handleFalseStart();
    } else if (currentState === 'ready') {
      const elapsed = Math.round(performance.now() - startTime);
      handleValidClick(elapsed);
    } else if (currentState === 'false-start') {
      startRound();
    } else if (currentState === 'round-result') {
      startRound();
    }
  }

  // Switch game mode
  function switchMode(newMode: ModeType) {
    if (waitTimeoutId) {
      window.clearTimeout(waitTimeoutId);
      waitTimeoutId = null;
    }

    currentMode = newMode;
    currentRound = 1;
    roundTimes = [];

    modeButtons.forEach((btn) => {
      const isTarget = btn.dataset.mode === newMode;
      btn.classList.toggle('is-active', isTarget);
      btn.setAttribute('aria-pressed', String(isTarget));
    });

    updateStatusDisplay();
    updateUIState('idle');
  }

  // Reset current mode statistics
  function resetCurrentModeStats() {
    const config = MODES[currentMode];
    const confirmed = window.confirm(`Reset saved personal records and statistics for ${config.name}?`);
    if (confirmed) {
      try {
        localStorage.removeItem(config.storageKey);
      } catch {
        // Ignore
      }
      updateStatusDisplay();
      if (currentState === 'completed') {
        switchMode(currentMode);
      }
    }
  }

  // Reset ALL statistics
  function resetAllStats() {
    const confirmed = window.confirm('Reset ALL saved reaction statistics and daily records on this browser?');
    if (confirmed) {
      try {
        Object.values(MODES).forEach((cfg) => {
          localStorage.removeItem(cfg.storageKey);
        });
      } catch {
        // Ignore
      }
      updateStatusDisplay();
      switchMode(currentMode);
    }
  }

  // Share functionality
  async function shareResults() {
    const config = MODES[currentMode];
    const sum = roundTimes.reduce((acc, t) => acc + t, 0);
    const avg = roundTimes.length ? Math.round(sum / roundTimes.length) : 0;
    const rating = getPerformanceRating(avg);

    const shareText = `⚡ Reaction Time Challenge: ${avg} ms (${rating.label})\nMode: ${config.name}\nPlay free on PuzzleFeels: https://puzzlefeels.com/reaction-time-challenge/`;

    if (navigator.share) {
      try {
        await navigator.share({
          title: 'Reaction Time Challenge - PuzzleFeels',
          text: shareText,
          url: 'https://puzzlefeels.com/reaction-time-challenge/'
        });
        return;
      } catch {
        // User cancelled or failed; fallback to clipboard
      }
    }

    try {
      await navigator.clipboard.writeText(shareText);
      showShareToast('Result copied to clipboard!');
    } catch {
      showShareToast('Could not copy automatically. Your result: ' + avg + ' ms');
    }
  }

  function showShareToast(msg: string) {
    if (shareToast) {
      shareToast.textContent = msg;
      shareToast.classList.add('is-visible');
      setTimeout(() => {
        shareToast.classList.remove('is-visible');
      }, 3200);
    }
  }

  // Setup Event Listeners
  if (playZone) {
    playZone.addEventListener('pointerdown', (e) => {
      // Don't trigger if clicked directly on an interactive button inside the zone
      const target = e.target as HTMLElement;
      if (
        target.closest('.reaction-mode-btn') || 
        target.closest('.reaction-sound-btn') ||
        target.closest('#zone-replay-btn') ||
        target.closest('#completed-scroll-hint')
      ) return;
      handleAction(e);
    });

    playZone.addEventListener('keydown', (e) => {
      if (e.code === 'Space' || e.key === ' ' || e.key === 'Enter') {
        e.preventDefault();
        handleAction(e);
      }
    });
  }

  // Standalone start, retry, and next button handlers
  document.getElementById('zone-start-btn')?.addEventListener('click', (e) => {
    e.stopPropagation();
    handleAction(e);
  });
  document.getElementById('zone-retry-btn')?.addEventListener('click', (e) => {
    e.stopPropagation();
    handleAction(e);
  });
  document.getElementById('zone-next-btn')?.addEventListener('click', (e) => {
    e.stopPropagation();
    handleAction(e);
  });
  zoneReplayBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    replayGame();
  });
  completedScrollHint?.addEventListener('click', (e) => {
    e.stopPropagation();
    scrollToResults();
  });

  // Global spacebar listener when active
  window.addEventListener('keydown', (e) => {
    if (e.code === 'Space' || e.key === ' ') {
      // Don't intercept if user is typing in search or an input
      const tag = (e.target as HTMLElement)?.tagName?.toLowerCase();
      if (tag === 'input' || tag === 'textarea' || tag === 'select') return;
      if (currentState === 'waiting' || currentState === 'ready' || currentState === 'round-result' || currentState === 'false-start' || currentState === 'completed') {
        e.preventDefault();
        handleAction(e);
      }
    }
  });

  // Mode button events
  modeButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const mode = btn.dataset.mode as ModeType;
      if (mode && MODES[mode]) {
        switchMode(mode);
      }
    });
  });

  // Audio Toggle
  if (soundToggleBtn) {
    soundToggleBtn.addEventListener('click', () => {
      soundEnabled = !soundEnabled;
      soundToggleBtn.setAttribute('aria-pressed', String(soundEnabled));
      if (soundOnIcon) soundOnIcon.style.display = soundEnabled ? 'inline' : 'none';
      if (soundOffIcon) soundOffIcon.style.display = soundEnabled ? 'none' : 'inline';
      if (soundLabel) soundLabel.textContent = soundEnabled ? 'Sound' : 'Muted';
      try {
        localStorage.setItem('pf-reaction-time-sound', String(soundEnabled));
      } catch {
        // Ignore
      }
    });

    try {
      const storedSound = localStorage.getItem('pf-reaction-time-sound');
      if (storedSound === 'false') {
        soundEnabled = false;
        soundToggleBtn.setAttribute('aria-pressed', 'false');
        if (soundOnIcon) soundOnIcon.style.display = 'none';
        if (soundOffIcon) soundOffIcon.style.display = 'inline';
        if (soundLabel) soundLabel.textContent = 'Muted';
      }
    } catch {
      // Ignore
    }
  }

  // Dashboard action listeners
  btnReplay?.addEventListener('click', () => {
    replayGame();
  });
  btnShare?.addEventListener('click', shareResults);
  btnResetMode?.addEventListener('click', resetCurrentModeStats);
  btnResetAll?.addEventListener('click', resetAllStats);

  // Initial render
  updateStatusDisplay();
  updateUIState('idle');
</script>

