    color: var(--ink, #17233b);
  }

  .ho-paused-card p {
    margin: 0 0 6px;
    font-size: 13px;
  }

  /* Completion Modal */
  .ho-completion-overlay {
    position: absolute;
    inset: 0;
    background: rgba(11, 19, 43, 0.82);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    z-index: 10;
    animation: fadeIn 0.25s ease-out;
  }

  .ho-completion-overlay[hidden] {
    display: none !important;
  }

  .ho-completion-card {
    max-width: 420px;
    width: 100%;
    background: var(--paper, #fff);
    border-radius: 18px;
    padding: 28px 24px;
    text-align: center;
    box-shadow: 0 20px 48px rgba(0, 0, 0, 0.35);
    border: 1px solid var(--line, #e2e8f0);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    animation: scaleUp 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  .ho-completion-icon {
    font-size: 42px;
    line-height: 1;
    margin-bottom: 2px;
  }

  .ho-completion-card h3 {
    font-size: 1.45rem;
    margin: 0;
    color: var(--ink, #17233b);
  }

  .ho-completion-card p {
    font-size: 14px;
    margin: 0 0 6px;
    line-height: 1.5;
  }

  .ho-completion-stats {
    display: flex;
    gap: 10px;
    justify-content: center;
    margin-bottom: 8px;
  }

  .stat-badge {
    padding: 5px 12px;
    border-radius: 8px;
    background: var(--wash, #f1f4fb);
    border: 1px solid var(--line, #e2e8f0);
    font-size: 12px;
    font-weight: 700;
    color: var(--ink, #17233b);
  }

  .ho-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 10px 22px;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    border: none;
    transition: all 0.15s ease;
  }

  .ho-btn.primary {
    background: var(--blue, #315ee8);
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(49, 94, 232, 0.35);
  }

  .ho-btn.primary:hover {
    background: #254ec8;
    transform: translateY(-1px);
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes scaleUp {
    from { transform: scale(0.9); opacity: 0; }
    to { transform: scale(1); opacity: 1; }
  }

  /* 7. Redesigned "Objects to Find" Section */
  .ho-objects-section {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-top: 4px;
  }

  .ho-objects-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px;
  }

  .ho-objects-title-wrap h3 {
    font-size: 1.1rem;
    font-weight: 800;
    margin: 0 0 2px;
    color: var(--ink, #17233b);
  }

  .ho-count-tag {
    font-size: 13px;
    color: var(--blue, #315ee8);
    font-weight: 700;
  }

  .ho-objects-title-wrap p {
    margin: 0;
    font-size: 13px;
  }

  .ho-objects-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
  }

  .ho-object-card {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    border-radius: 14px;
    background: var(--wash, #f1f4fb);
    border: 1px solid var(--line, #e2e8f0);
    transition: all 0.2s cubic-bezier(0.2, 0, 0, 1);
    user-select: none;
    position: relative;
    overflow: hidden;
  }

  .ho-object-card:hover {
    border-color: #cbd5e1;
    transform: translateY(-1px);
  }

  .ho-obj-icon {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: #ffffff;
    border: 1px solid var(--line, #e2e8f0);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--blue, #315ee8);
    flex-shrink: 0;
    transition: all 0.2s ease;
  }

  .ho-obj-content {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
    min-width: 0;
  }

  .ho-obj-name {
    font-size: 13px;
    font-weight: 700;
    color: var(--ink, #17233b);
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .ho-obj-badge {
    font-size: 10px;
    font-weight: 600;
    color: var(--muted);
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .ho-obj-status {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    border: 1.5px solid var(--line, #cbd5e1);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: all 0.2s ease;
  }

  /* Found Object Chip State */
  .ho-object-card.is-found {
    background: rgba(16, 185, 129, 0.08);
    border-color: rgba(16, 185, 129, 0.35);
    animation: foundPop 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  .ho-object-card.is-found .ho-obj-name {
    text-decoration: line-through;
    color: #059669;
    opacity: 0.85;
  }

  .ho-object-card.is-found .ho-obj-badge {
    color: #10b981;
  }

  .ho-object-card.is-found .ho-obj-icon {
    background: #10b981;
    color: #ffffff;
    border-color: #10b981;
  }

  .ho-object-card.is-found .ho-obj-status {
    background: #10b981;
    border-color: #10b981;
  }

  .ho-object-card.is-found .ho-obj-status::after {
    content: "✓";
    color: #ffffff;
    font-size: 12px;
    font-weight: 900;
    line-height: 1;
  }

  /* Hinted card pulse */
  .ho-object-card.is-hinted {
    border-color: #f59e0b;
    box-shadow: 0 0 14px rgba(245, 158, 11, 0.45);
    animation: cardHintGlow 1.2s infinite ease-in-out;
  }

  @keyframes foundPop {
    0% { transform: scale(0.96); }
    50% { transform: scale(1.03); }
    100% { transform: scale(1); }
  }

  @keyframes cardHintGlow {
    0%, 100% { transform: scale(1); border-color: #f59e0b; }
    50% { transform: scale(1.02); border-color: #d97706; }
  }

  /* Left-Aligned Informational Content Article */
  .ho-article {
    margin-top: 40px;
    margin-bottom: 60px;
    text-align: left;
    max-width: 820px;
  }

  .ho-article h2 {
    font-size: 24px;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin: 38px 0 14px;
    color: var(--ink, #17233b);
  }

  .ho-article h2:first-of-type {
    margin-top: 0;
  }

  .ho-article p {
    font-size: 15px;
    line-height: 1.75;
    color: var(--ink, #17233b);
    margin: 0 0 16px;
  }

  .ho-article ol,
  .ho-article ul {
    margin: 0 0 20px;
    padding-left: 24px;
  }

  .ho-article li {
    font-size: 15px;
    line-height: 1.75;
    margin-bottom: 8px;
    color: var(--ink, #17233b);
  }

  .ho-article a {
    color: var(--blue, #315ee8);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.15s ease;
  }

  .ho-article a:hover {
    color: #1d40b0;
  }

  /* Explore More Games Section */
  .related-games-section {
    padding: 56px 0 36px;
    border-top: 1px solid var(--line);
    margin-top: 48px;
  }
  .related-games-head {
    max-width: 620px;
    margin: 0 auto 36px;
    text-align: center;
  }
  .related-games-head h2 {
    font-size: clamp(1.8rem, 3.2vw, 2.4rem);
    margin: 10px 0 12px;
    letter-spacing: -.03em;
  }
  .related-games-head p {
    font-size: 15px;
    line-height: 1.65;
    margin: 0 auto;
  }
  .related-games-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    align-items: stretch;
  }
  .related-card {
    min-width: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: 20px;
    border: 1px solid var(--line);
    background: var(--paper);
    color: var(--ink);
    text-decoration: none;
    transition: transform .18s ease, border-color .18s ease, box-shadow .18s ease;
  }
  .related-card:hover {
    transform: translateY(-3px);
    border-color: #cfd8ef;
    box-shadow: 0 16px 38px rgba(23, 35, 59, 0.08);
  }
  .related-visual {
    height: 160px;
    flex: none;
    position: relative;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: linear-gradient(145deg, #eaf0ff, #f6f3ff);
  }
  .related-orbit {
    position: absolute;
    width: 140px;
    height: 140px;
    border: 1px dashed #cad5fa;
    border-radius: 50%;
  }
  .related-icon {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(2, 48px);
    gap: 8px;
    transform: rotate(-7deg);
  }
  .related-icon span {
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    border-radius: 13px;
    background: #fff;
    color: #315ee8;
    font-size: 17px;
    font-weight: 800;
    box-shadow: 0 8px 20px rgba(41, 62, 139, 0.1);
  }
  .spot-icon span:nth-child(1) { background: #fef3c7; color: #d97706; }
  .spot-icon span:nth-child(2) { background: #315ee8; color: #fff; }
  .spot-icon span:nth-child(3) { background: #dcfce7; color: #16a34a; }
  .spot-icon span:nth-child(4) { background: #ede9fe; color: #7c3aed; }
  .memory-icon span:nth-child(1) { background: #ede9fe; color: #7c3aed; }
  .memory-icon span:nth-child(2) { background: #315ee8; color: #fff; }
  .memory-icon span:nth-child(3) { background: #fef08a; color: #a16207; }
  .memory-icon span:nth-child(4) { background: #dcfce7; color: #15803d; }
  .picross-icon span:nth-child(1), .picross-icon span:nth-child(4) { background: #315ee8; color: #fff; }
  .picross-icon span:nth-child(2), .picross-icon span:nth-child(3) { background: #edf2ff; color: #315ee8; }
  .hidden-object-icon span:nth-child(1) { background: #fef3c7; color: #d97706; }
  .hidden-object-icon span:nth-child(2) { background: #315ee8; color: #fff; }
  .hidden-object-icon span:nth-child(3) { background: #dcfce7; color: #16a34a; }
  .hidden-object-icon span:nth-child(4) { background: #ede9fe; color: #7c3aed; }

  .related-card-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    padding: 18px 20px 20px;
  }
  .related-labels {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 2px;
  }
  .related-labels .pill { font-size: 9px; letter-spacing: .04em; }
  .difficulty-label { font-size: 10px; color: var(--muted); }
  .related-card h3 {
    font-size: 18px;
    line-height: 1.25;
    margin: 12px 0 6px;
    letter-spacing: -.025em;
  }
  .related-card p {
    font-size: 12px;
    line-height: 1.6;
    margin: 0 0 14px;
    color: var(--muted);
  }
  .related-play {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: auto;
    color: var(--blue);
    font-size: 12px;
    font-weight: 800;
  }

  /* Dark Theme Support */
  :global(html[data-theme="dark"]) .ho-shell,
  :global(html[data-theme="dark"]) .ho-completion-card,
  :global(html[data-theme="dark"]) .ho-paused-card {
    background: #111a33;
    border-color: #243356;
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.4);
  }

  :global(html[data-theme="dark"]) .ho-diff-bar,
  :global(html[data-theme="dark"]) .ho-level-selector,
  :global(html[data-theme="dark"]) .ho-scene-viewport,
  :global(html[data-theme="dark"]) .ho-toolbar {
    border-color: #243356;
  }

  :global(html[data-theme="dark"]) .ho-toolbar {
    background: #14203f;
  }

  :global(html[data-theme="dark"]) .tool-btn {
    background: #18274d;
    border-color: #293d6c;
    color: #e2e8f0;
  }

  :global(html[data-theme="dark"]) .tool-btn:hover {
    background: #203363;
    border-color: #3b5494;
  }

  :global(html[data-theme="dark"]) .tool-btn.primary {
    background: #f59e0b;
    border-color: #d97706;
    color: #ffffff;
  }

  :global(html[data-theme="dark"]) .ho-tab-btn {
    background: #1a2748;
    border-color: #2b3d6a;
    color: #e2e8f0;
  }

  :global(html[data-theme="dark"]) .ho-tab-btn:hover {
    background: #233560;
  }

  :global(html[data-theme="dark"]) .ho-tab-btn.is-active {
    background: var(--blue, #315ee8);
    border-color: var(--blue, #315ee8);
    color: #ffffff;
  }

  :global(html[data-theme="dark"]) .ho-level-pill {
    background: #1a2748;
    border-color: #2b3d6a;
    color: #e2e8f0;
  }

  :global(html[data-theme="dark"]) .ho-level-pill.is-locked {
    background: #151f38;
    border-color: #1e2c4f;
    opacity: 0.45;
  }

  :global(html[data-theme="dark"]) .ho-level-pill.is-active {
    background: var(--blue, #315ee8);
    border-color: var(--blue, #315ee8);
    color: #ffffff;
  }

  :global(html[data-theme="dark"]) .ho-metric-chip,
  :global(html[data-theme="dark"]) .stat-badge {
    background: #1a2748;
    border-color: #2b3d6a;
    color: #e2e8f0;
  }

  :global(html[data-theme="dark"]) .ho-toast-banner {
    background: #3b2d13;
    border-color: #785215;
    color: #fef08a;
  }

  :global(html[data-theme="dark"]) .ho-object-card {
    background: #162240;
    border-color: #263860;
  }

  :global(html[data-theme="dark"]) .ho-object-card:hover {
    border-color: #3b5494;
  }

  :global(html[data-theme="dark"]) .ho-obj-icon {
    background: #1e2c4f;
    border-color: #2b3d6a;
    color: #93c5fd;
  }

  :global(html[data-theme="dark"]) .ho-obj-name {
    color: #f1f5f9;
  }

  :global(html[data-theme="dark"]) .ho-object-card.is-found {
    background: rgba(16, 185, 129, 0.14);
    border-color: rgba(16, 185, 129, 0.4);
  }

  :global(html[data-theme="dark"]) .ho-object-card.is-found .ho-obj-name {
    color: #6ee7b7;
  }

  :global(html[data-theme="dark"]) .ho-object-card.is-found .ho-obj-status,
  :global(html[data-theme="dark"]) .ho-object-card.is-found .ho-obj-icon {
    background: #10b981;
    border-color: #10b981;
    color: #ffffff;
  }

  :global(html[data-theme="dark"]) .ho-selection-popup.ho-popup-incorrect {
    background: rgba(15, 23, 42, 0.96);
    border-color: #ef4444;
    color: #fca5a5;
  }

  :global(html[data-theme="dark"]) .ho-selection-popup.ho-popup-correct {
    background: #059669;
    border-color: #34d399;
    color: #ffffff;
  }

  :global(html[data-theme="dark"]) .related-games-section { border-color: var(--dark-border, #293858); }
  :global(html[data-theme="dark"]) .related-card { background: var(--dark-card, #151f3d); border-color: var(--dark-border, #293858); }
  :global(html[data-theme="dark"]) .related-card:hover { border-color: #52678f; box-shadow: 0 16px 38px rgba(3, 8, 23, 0.45); }
  :global(html[data-theme="dark"]) .related-visual { background: linear-gradient(145deg, #1b294b, #222345); }
  :global(html[data-theme="dark"]) .related-orbit { border-color: #35466c; }
  :global(html[data-theme="dark"]) .related-icon span { background: #263553; color: #c2d0ff; box-shadow: 0 8px 20px rgba(3, 8, 23, 0.45); }
  :global(html[data-theme="dark"]) .spot-icon span:nth-child(1) { background: #713f12; color: #fef08a; }
  :global(html[data-theme="dark"]) .spot-icon span:nth-child(2) { background: #8ea8ff; color: #0b132b; }
  :global(html[data-theme="dark"]) .spot-icon span:nth-child(3) { background: #14532d; color: #86efac; }
  :global(html[data-theme="dark"]) .spot-icon span:nth-child(4) { background: #3b1e75; color: #c4b5fd; }
  :global(html[data-theme="dark"]) .memory-icon span:nth-child(1) { background: #3b1e75; color: #c4b5fd; }
  :global(html[data-theme="dark"]) .memory-icon span:nth-child(2) { background: #8ea8ff; color: #0b132b; }
  :global(html[data-theme="dark"]) .memory-icon span:nth-child(3) { background: #713f12; color: #fef08a; }
  :global(html[data-theme="dark"]) .memory-icon span:nth-child(4) { background: #14532d; color: #86efac; }
  :global(html[data-theme="dark"]) .picross-icon span:nth-child(1),
  :global(html[data-theme="dark"]) .picross-icon span:nth-child(4) { background: #254dbf; color: #fff; }
  :global(html[data-theme="dark"]) .picross-icon span:nth-child(2),
  :global(html[data-theme="dark"]) .picross-icon span:nth-child(3) { background: #1e2d54; color: #93c5fd; }
  :global(html[data-theme="dark"]) .hidden-object-icon span:nth-child(1) { background: #713f12; color: #fef08a; }
  :global(html[data-theme="dark"]) .hidden-object-icon span:nth-child(2) { background: #8ea8ff; color: #0b132b; }
  :global(html[data-theme="dark"]) .hidden-object-icon span:nth-child(3) { background: #14532d; color: #86efac; }
  :global(html[data-theme="dark"]) .hidden-object-icon span:nth-child(4) { background: #3b1e75; color: #c4b5fd; }
  :global(html[data-theme="dark"]) .related-labels .pill { background: #1e2d54; color: #c7d2fe; }
  :global(html[data-theme="dark"]) .related-card h3 { color: var(--dark-text, #f1f5ff); }
  :global(html[data-theme="dark"]) .related-card p { color: var(--dark-secondary, #b8c4dd); }
  :global(html[data-theme="dark"]) .related-play { color: var(--dark-accent, #8ea8ff); }

  /* Responsive Rules */
  @media (max-width: 960px) {
    .related-games-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
  }

  /* Tablet layout: 3 columns */
  @media (min-width: 641px) and (max-width: 900px) {
    .ho-objects-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
    }
  }

  /* Mobile layout: STRICTLY 2 COLUMNS across all mobile screen widths (320px - 640px) */
  @media (max-width: 640px) {
    .ho-shell {
      padding: 16px;
      border-radius: 16px;
      gap: 12px;
    }

    .ho-diff-bar {
      gap: 6px;
    }

    .ho-tab-btn {
      padding: 6px 12px;
      font-size: 12px;
    }

    .ho-level-selector {
      gap: 6px;
    }

    .ho-level-pills {
      gap: 4px;
    }

    .ho-level-pill {
      min-width: 30px;
      height: 30px;
      padding: 0 7px;
      font-size: 12px;
    }

    .ho-status-bar {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }

    .ho-metrics {
      width: 100%;
      justify-content: space-between;
    }

    .ho-metric-chip {
      padding: 5px 8px;
      font-size: 11px;
    }

    .ho-toolbar {
      flex-direction: column;
      align-items: stretch;
      gap: 8px;
    }

    .toolbar-left, .toolbar-right {
      justify-content: space-between;
    }

    .tool-btn {
      padding: 6px 10px;
      font-size: 12px;
    }

    /* Exactly 2 columns of cards on all mobile devices */
    .ho-objects-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
      gap: 8px;
    }

    .ho-object-card {
      padding: 8px 10px;
      gap: 8px;
      border-radius: 12px;
      min-width: 0;
    }

    .ho-obj-icon {
      width: 28px;
      height: 28px;
      border-radius: 8px;
      flex-shrink: 0;
    }

    .ho-obj-icon svg {
      width: 17px;
      height: 17px;
    }

    .ho-obj-content {
      gap: 1px;
      min-width: 0;
    }

    .ho-obj-name {
      font-size: 12px;
      font-weight: 700;
      line-height: 1.25;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .ho-obj-badge {
      font-size: 9px;
      font-weight: 700;
      letter-spacing: 0.03em;
    }

    .ho-obj-status {
      width: 18px;
      height: 18px;
      flex-shrink: 0;
    }

    .ho-object-card.is-found .ho-obj-status::after {
      font-size: 10px;
    }

    .related-games-section { padding: 40px 0 24px; margin-top: 36px; }
    .related-games-head { margin-bottom: 24px; }
    .related-games-grid { grid-template-columns: 1fr; gap: 14px; }
    .related-card { display: grid; grid-template-columns: 110px minmax(0, 1fr); min-height: 150px; border-radius: 16px; }
    .related-visual { height: auto; min-height: 150px; }
    .related-orbit { width: 90px; height: 90px; }
    .related-icon { grid-template-columns: repeat(2, 34px); gap: 5px; }
    .related-icon span { width: 34px; height: 34px; border-radius: 9px; font-size: 13px; }
    .related-card-body { padding: 14px 12px; }
    .related-card h3 { font-size: 16px; margin: 8px 0 4px; }
    .related-card p { font-size: 12px; margin-bottom: 10px; }
    .related-play { font-size: 12px; }
  }

  @media (max-width: 360px) {
    .related-card { grid-template-columns: 92px minmax(0, 1fr); }
    .related-orbit { width: 76px; height: 76px; }
    .related-icon { grid-template-columns: repeat(2, 28px); gap: 4px; }
    .related-icon span { width: 28px; height: 28px; font-size: 11px; border-radius: 7px; }
    .related-card-body { padding: 10px 8px; }
    .related-card h3 { font-size: 15px; margin: 6px 0 3px; }
    .related-card p { font-size: 11px; line-height: 1.5; margin-bottom: 8px; }
  }
</style>

<script>
  import type { HiddenObjectLevel, HiddenObjectItem } from '../data/hiddenObjectData';

  type Difficulty = 'easy' | 'medium' | 'hard';

  const DIFF_COUNTS: Record<Difficulty, number> = {
    easy: 5,
    medium: 7,
    hard: 8
  };

  const STORAGE_KEY_UNLOCKED = 'puzzlefeels-ho-unlocked';
  const STORAGE_KEY_COMPLETED = 'puzzlefeels-ho-completed';
  const STORAGE_KEY_DIFF = 'puzzlefeels-ho-diff';
  const STORAGE_KEY_SOUND = 'puzzlefeels-ho-sound';

  const dataScript = document.getElementById('ho-data');
  const levels: HiddenObjectLevel[] = dataScript?.textContent ? JSON.parse(dataScript.textContent) : [];

  if (levels.length > 0) {
    // 1. Settings & Progress State
    let currentDiff: Difficulty = 'easy';
    let soundEnabled = true;
    let unlockedLevel = 1;
    let completedLevels: number[] = [];

    try {
      const u = localStorage.getItem(STORAGE_KEY_UNLOCKED);
      if (u) {
        const parsed = parseInt(u, 10);
        if (!isNaN(parsed) && parsed >= 1 && parsed <= 10) unlockedLevel = parsed;
      }
      const c = localStorage.getItem(STORAGE_KEY_COMPLETED);
      if (c) {
        const parsed = JSON.parse(c);
        if (Array.isArray(parsed)) completedLevels = parsed;
      }
      const d = localStorage.getItem(STORAGE_KEY_DIFF) as Difficulty;
      if (d === 'easy' || d === 'medium' || d === 'hard') {
        currentDiff = d;
      }
      const s = localStorage.getItem(STORAGE_KEY_SOUND);
      if (s !== null) {
        soundEnabled = s === 'true';
      }
    } catch {
      // LocalStorage unavailable
    }

    // 2. Active Session State
    let currentLevelIndex = 0;
    let foundObjects = new Set<string>();
    let activeTargets: HiddenObjectItem[] = [];
    let elapsedSeconds = 0;
    let timerInterval: number | null = null;
    let isPaused = false;
    let hintsUsed = 0;
    let toastTimeout: number | null = null;

    // 3. Audio Synthesizer (Web Audio API)
    let audioCtx: AudioContext | null = null;

    function initAudio() {
      if (!audioCtx && typeof window !== 'undefined') {
        const AudioCtxClass = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
        if (AudioCtxClass) {
          audioCtx = new AudioCtxClass();
        }
      }
      if (audioCtx && audioCtx.state === 'suspended') {
        audioCtx.resume();
      }
    }

    function playTone(freq: number, type: OscillatorType, duration: number, delay = 0, gainLevel = 0.15) {
      if (!soundEnabled) return;
      try {
        initAudio();
        if (!audioCtx) return;
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        const startTime = audioCtx.currentTime + delay;

        osc.type = type;
        osc.frequency.setValueAtTime(freq, startTime);

        gain.gain.setValueAtTime(gainLevel, startTime);
        gain.gain.exponentialRampToValueAtTime(0.001, startTime + duration);

        osc.connect(gain);
        gain.connect(audioCtx.destination);

        osc.start(startTime);
        osc.stop(startTime + duration);
      } catch {
        // Audio policy fallback
      }
    }

    function playSuccessSound() {
      playTone(523.25, 'triangle', 0.15, 0, 0.18);      // C5
      playTone(659.25, 'triangle', 0.18, 0.08, 0.18);   // E5
      playTone(783.99, 'triangle', 0.25, 0.16, 0.20);   // G5
    }

    function playMissSound() {
      playTone(220, 'sine', 0.15, 0, 0.12);             // Low muted tap
    }

    function playHintSound() {
      playTone(784, 'sine', 0.12, 0, 0.16);             // G5
      playTone(988, 'sine', 0.15, 0.08, 0.16);          // B5
      playTone(1318, 'sine', 0.25, 0.16, 0.18);         // E6
    }

    function playVictorySound() {
      playTone(523.25, 'triangle', 0.18, 0, 0.22);      // C5
      playTone(659.25, 'triangle', 0.18, 0.12, 0.22);   // E5
      playTone(783.99, 'triangle', 0.18, 0.24, 0.22);   // G5
      playTone(1046.50, 'triangle', 0.45, 0.36, 0.25);  // C6
    }

    function playClickSound() {
      playTone(600, 'sine', 0.05, 0, 0.08);
    }

    // 4. DOM Elements
    const pillsContainer = document.getElementById('ho-level-pills');
    const diffButtons = document.querySelectorAll<HTMLButtonElement>('.ho-tab-btn');
    const levelBadge = document.getElementById('ho-level-badge');
    const puzzleTitle = document.getElementById('ho-puzzle-title');
    const puzzleTheme = document.getElementById('ho-puzzle-theme');
    const foundCounter = document.getElementById('ho-found-counter');
    const timerDisplay = document.getElementById('ho-timer');
    const hintsDisplay = document.getElementById('ho-hints-counter');
    const sceneImg = document.getElementById('ho-scene-img') as HTMLImageElement;
    const sceneOverlay = document.getElementById('ho-scene-overlay');
    const markersLayer = document.getElementById('ho-markers-layer');
    const hintLayer = document.getElementById('ho-hint-layer');
    const feedbackLayer = document.getElementById('ho-feedback-layer');
    const objectsGrid = document.getElementById('ho-objects-grid');
    const remainingTag = document.getElementById('ho-remaining-tag');
    const toastBanner = document.getElementById('ho-toast-banner');
    const toastText = document.getElementById('ho-toast-text');
    const pausedOverlay = document.getElementById('ho-paused-overlay');
    const btnResume = document.getElementById('btn-resume');
    const completionOverlay = document.getElementById('ho-completion-overlay');
    const completionTitle = document.getElementById('ho-completion-title');
    const completionMsg = document.getElementById('ho-completion-msg');
    const completionIcon = document.getElementById('ho-completion-icon');
    const statTime = document.getElementById('ho-stat-time');
    const statHints = document.getElementById('ho-stat-hints');
    const btnNextLevel = document.getElementById('btn-next-level');

    // Controls
    const btnHint = document.getElementById('btn-hint');
    const btnRestart = document.getElementById('btn-restart');
    const btnPause = document.getElementById('btn-pause');
    const pauseText = document.getElementById('pause-text');
    const pauseIcon = btnPause?.querySelector('.pause-icon') as HTMLElement | null;
    const playIcon = btnPause?.querySelector('.play-icon') as HTMLElement | null;
    const btnSound = document.getElementById('btn-sound');
    const soundOnSvg = btnSound?.querySelector('.sound-on-svg') as HTMLElement | null;
    const soundOffSvg = btnSound?.querySelector('.sound-off-svg') as HTMLElement | null;

    function saveState() {
      try {
        localStorage.setItem(STORAGE_KEY_UNLOCKED, String(unlockedLevel));
        localStorage.setItem(STORAGE_KEY_COMPLETED, JSON.stringify(completedLevels));
        localStorage.setItem(STORAGE_KEY_DIFF, currentDiff);
        localStorage.setItem(STORAGE_KEY_SOUND, String(soundEnabled));
      } catch {
        // Storage fallback
      }
    }

    function formatTime(sec: number): string {
      const m = Math.floor(sec / 60);
      const s = sec % 60;
      return `${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}`;
    }

    function showToast(msg: string, duration = 3000) {
      if (!toastBanner || !toastText) return;
      if (toastTimeout) clearTimeout(toastTimeout);
      toastText.textContent = msg;
      toastBanner.hidden = false;
      toastTimeout = window.setTimeout(() => {
        toastBanner.hidden = true;
      }, duration);
    }

    // 5. Timer Controls
    function startTimer() {
      if (timerInterval) clearInterval(timerInterval);
      timerInterval = window.setInterval(() => {
        if (!isPaused) {
          elapsedSeconds++;
          if (timerDisplay) timerDisplay.textContent = formatTime(elapsedSeconds);
        }
      }, 1000);
    }

    function stopTimer() {
      if (timerInterval) {
        clearInterval(timerInterval);
        timerInterval = null;
      }
    }

    function resetTimer() {
      stopTimer();
      elapsedSeconds = 0;
      if (timerDisplay) timerDisplay.textContent = '00:00';
      startTimer();
    }

    // 6. Sound UI Update
    function updateSoundUI() {
      if (!soundOnSvg || !soundOffSvg) return;
      soundOnSvg.hidden = !soundEnabled;
      soundOffSvg.hidden = soundEnabled;
      if (btnSound) {
        btnSound.setAttribute('title', soundEnabled ? 'Mute sound effects' : 'Unmute sound effects');
        btnSound.setAttribute('aria-label', soundEnabled ? 'Mute sound effects' : 'Unmute sound effects');
      }
    }

    // 7. Render UI
    function renderDifficultyUI() {
      diffButtons.forEach((btn) => {
        const d = btn.dataset.difficulty as Difficulty;
        const active = d === currentDiff;
        btn.classList.toggle('is-active', active);
        btn.setAttribute('aria-pressed', String(active));
      });
    }

    function renderLevelSelector() {
      if (!pillsContainer) return;
      const buttons = pillsContainer.querySelectorAll<HTMLButtonElement>('.ho-level-pill');
      buttons.forEach((btn) => {
        const lvlNum = parseInt(btn.dataset.level || '1', 10);
        const isCurrent = lvlNum === currentLevelIndex + 1;
        const isUnlocked = lvlNum <= unlockedLevel;
        const isCompleted = completedLevels.includes(lvlNum);

        btn.disabled = !isUnlocked;
        btn.classList.toggle('is-active', isCurrent);
        btn.classList.toggle('is-locked', !isUnlocked);
        btn.classList.toggle('is-completed', isCompleted);

        btn.setAttribute('aria-label', `Level ${lvlNum}: ${levels[lvlNum - 1]?.title || ''}${!isUnlocked ? ' (Locked)' : ''}`);
        btn.innerHTML = `<span class="pill-num">${lvlNum}</span>${!isUnlocked ? '<span class="pill-lock" aria-hidden="true">🔒</span>' : ''}`;
      });
    }

    function loadLevel(index: number) {
      if (index < 0 || index >= levels.length) return;
      const level = levels[index];
      if (!level) return;

      currentLevelIndex = index;
      foundObjects.clear();
      hintsUsed = 0;
      isPaused = false;

      // Slice target objects according to difficulty
      const targetCount = DIFF_COUNTS[currentDiff];
      activeTargets = level.objects.slice(0, targetCount);

      // Reset Paused state
      if (pausedOverlay) pausedOverlay.hidden = true;
      if (pauseText) pauseText.textContent = 'Pause';
      if (pauseIcon) pauseIcon.hidden = false;
      if (playIcon) playIcon.hidden = true;

      // Update Header Info
      if (levelBadge) levelBadge.textContent = `Level ${level.level}`;
      if (puzzleTitle) puzzleTitle.textContent = level.title;
      const diffLabel = currentDiff.charAt(0).toUpperCase() + currentDiff.slice(1);
      if (puzzleTheme) puzzleTheme.textContent = `${level.theme} · ${diffLabel} · ${targetCount} Hidden Objects`;
      if (foundCounter) foundCounter.textContent = `0 of ${targetCount} Found`;
      if (hintsDisplay) hintsDisplay.textContent = '0';
      if (remainingTag) remainingTag.textContent = `(${targetCount} remaining)`;

      // Update Scene Image
      if (sceneImg) {
        sceneImg.src = level.image;
        sceneImg.alt = `Hidden Object Scene - ${level.title}`;
      }

      // Clear layers & active popups
      if (activePopupTimeout) clearTimeout(activePopupTimeout);
      activePopup = null;
      activePopupTimeout = null;
      if (markersLayer) markersLayer.innerHTML = '';
      if (hintLayer) hintLayer.innerHTML = '';
      if (feedbackLayer) feedbackLayer.innerHTML = '';
      if (completionOverlay) completionOverlay.hidden = true;
      if (toastBanner) toastBanner.hidden = true;

      // Render Object Cards
      if (objectsGrid) {
        objectsGrid.innerHTML = activeTargets.map(obj => `
          <div class="ho-object-card" data-obj-id="${obj.id}" role="listitem">
            <div class="ho-obj-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                ${obj.iconSvg}
              </svg>
            </div>
            <div class="ho-obj-content">
              <span class="ho-obj-name">${obj.name}</span>
              <span class="ho-obj-badge">Hidden</span>
            </div>
            <span class="ho-obj-status" aria-hidden="true"></span>
          </div>
        `).join('');
      }

      renderDifficultyUI();
      renderLevelSelector();
      resetTimer();
    }

    function addFoundMarker(obj: HiddenObjectItem) {
      if (!markersLayer) return;
      const marker = document.createElement('div');
      marker.className = 'ho-marker';
      marker.style.left = `${obj.x}%`;
      marker.style.top = `${obj.y}%`;

      const ring = document.createElement('div');
      ring.className = 'marker-ring';
      const diameterPercent = Math.max(obj.radius * 2.2, 5.5);
      ring.style.width = `${diameterPercent}cqi`;
      ring.style.height = `${diameterPercent}cqi`;
      if (!window.CSS || !CSS.supports || !CSS.supports('width', '1cqi')) {
        const boardW = sceneOverlay?.getBoundingClientRect().width || 900;
        const px = Math.round((diameterPercent / 100) * boardW);
        ring.style.width = `${px}px`;
        ring.style.height = `${px}px`;
      }

      const icon = document.createElement('div');
      icon.className = 'marker-icon';
      icon.textContent = '✓';

      marker.appendChild(ring);
      marker.appendChild(icon);
      markersLayer.appendChild(marker);
    }

    let activePopup: HTMLElement | null = null;
    let activePopupTimeout: number | null = null;

    function showSelectionPopup(x: number, y: number, isCorrect: boolean, objName?: string) {
      if (!feedbackLayer) return;

      // Dismiss any active popup immediately on rapid clicks to prevent clutter
      if (activePopup) {
        activePopup.remove();
        activePopup = null;
      }
      if (activePopupTimeout) {
        clearTimeout(activePopupTimeout);
        activePopupTimeout = null;
      }

      const popup = document.createElement('div');
      popup.className = `ho-selection-popup ${isCorrect ? 'ho-popup-correct success' : 'ho-popup-incorrect miss'}`;

      // Clamp horizontal coordinates (14% - 86%) to keep inside the board boundaries
      const clampedX = Math.max(14, Math.min(x, 86));

      // Near top (<18%) position below click point; otherwise position above
      if (y < 18) {
        popup.style.top = `${Math.min(y + 4, 88)}%`;
        popup.style.transform = 'translate(-50%, 0)';
      } else {
        popup.style.top = `${Math.max(y - 2, 10)}%`;
        popup.style.transform = 'translate(-50%, -100%)';
      }
      popup.style.left = `${clampedX}%`;

      if (isCorrect) {
        popup.innerHTML = `
          <span class="ho-popup-icon correct-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </span>
          <span class="ho-popup-text ho-popup-name">${objName || 'Object Found'}</span>
        `;
      } else {
        popup.innerHTML = `
          <span class="ho-popup-icon incorrect-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </span>
          <span class="ho-popup-text">Not quite! Keep looking.</span>
        `;
      }

      feedbackLayer.appendChild(popup);
      activePopup = popup;

      // Auto-dismiss after 1.2s
      activePopupTimeout = window.setTimeout(() => {
        if (activePopup === popup) {
          popup.remove();
          activePopup = null;
          activePopupTimeout = null;
        }
      }, 1200);
    }

    function showMissRipple(x: number, y: number) {
      if (!sceneOverlay) return;
      const ripple = document.createElement('div');
      ripple.className = 'ho-miss-ripple';
      ripple.style.left = `${x}%`;
      ripple.style.top = `${y}%`;
      sceneOverlay.appendChild(ripple);
      setTimeout(() => {
        ripple.remove();
      }, 400);
    }

    function triggerHint() {
      if (isPaused) return;
      initAudio();

      // Find undiscovered objects in the current active target list
      const undiscovered = activeTargets.filter(o => !foundObjects.has(o.id));
      if (undiscovered.length === 0) {
        showToast('All objects for this level have already been found!');
        return;
      }

      // Select random or first undiscovered object
      const hintObj = undiscovered[Math.floor(Math.random() * undiscovered.length)];

      hintsUsed++;
      if (hintsDisplay) hintsDisplay.textContent = String(hintsUsed);
      playHintSound();

      // Pulse on Scene
      if (hintLayer) {
        hintLayer.innerHTML = '';
        const beacon = document.createElement('div');
        beacon.className = 'ho-hint-beacon';
        beacon.style.left = `${hintObj.x}%`;
        beacon.style.top = `${hintObj.y}%`;
        beacon.innerHTML = `
          <div class="beacon-ping"></div>
          <div class="beacon-core"></div>
        `;
        hintLayer.appendChild(beacon);

        setTimeout(() => {
          beacon.remove();
        }, 3000);
      }

      // Highlight card in list
      const card = document.querySelector<HTMLElement>(`.ho-object-card[data-obj-id="${hintObj.id}"]`);
      if (card) {
        card.classList.add('is-hinted');
        card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        setTimeout(() => {
          card.classList.remove('is-hinted');
        }, 3000);
      }

      showToast(`Hint: Search closely for the ${hintObj.name}!`, 3000);
    }

    function togglePause() {
      isPaused = !isPaused;
      if (pausedOverlay) pausedOverlay.hidden = !isPaused;
      if (pauseText) pauseText.textContent = isPaused ? 'Resume' : 'Pause';
      if (pauseIcon) pauseIcon.hidden = isPaused;
      if (playIcon) playIcon.hidden = !isPaused;
      playClickSound();
    }

    function checkLevelComplete() {
      const level = levels[currentLevelIndex];
      if (!level) return;

      if (foundObjects.size >= activeTargets.length) {
        stopTimer();
        playVictorySound();

        const lvlNum = level.level;
        if (!completedLevels.includes(lvlNum)) {
          completedLevels.push(lvlNum);
        }

        if (lvlNum < 10 && unlockedLevel < lvlNum + 1) {
          unlockedLevel = lvlNum + 1;
        }

        saveState();
        renderLevelSelector();

        setTimeout(() => {
          if (!completionOverlay) return;
          if (statTime) statTime.textContent = `Time: ${formatTime(elapsedSeconds)}`;
          if (statHints) statHints.textContent = `Hints: ${hintsUsed}`;

          if (lvlNum < 10) {
            if (completionIcon) completionIcon.textContent = '🎉';
            if (completionTitle) completionTitle.textContent = `Level ${lvlNum} Complete!`;
            if (completionMsg) completionMsg.textContent = `Magnificent observation! You found all ${activeTargets.length} hidden objects in ${level.title}!`;
            if (btnNextLevel) {
              btnNextLevel.textContent = `Next Level (${levels[lvlNum]?.title || `Level ${lvlNum + 1}`}) →`;
              btnNextLevel.onclick = () => {
                loadLevel(lvlNum);
              };
            }
          } else {
            // Level 10 Grand Victory
            if (completionIcon) completionIcon.textContent = '🏆';
            if (completionTitle) completionTitle.textContent = 'Congratulations! All 10 Levels Completed!';
            if (completionMsg) completionMsg.textContent = `Outstanding! You have mastered all 10 illustrated scenes on ${currentDiff.toUpperCase()} difficulty!`;
            if (btnNextLevel) {
              btnNextLevel.textContent = 'Play Again (Level 1)';
              btnNextLevel.onclick = () => {
                loadLevel(0);
              };
            }
          }
          completionOverlay.hidden = false;
        }, 400);
      }
    }

    // 8. Event Handlers
    // Scene Click Detection
    sceneOverlay?.addEventListener('pointerdown', (e: PointerEvent) => {
      if (isPaused) return;
      initAudio();

      const rect = sceneOverlay.getBoundingClientRect();
      if (!rect.width || !rect.height) return;

      const clickX = ((e.clientX - rect.left) / rect.width) * 100;
      const clickY = ((e.clientY - rect.top) / rect.height) * 100;
      const aspectCorrection = 600 / 900; // 0.6667 for 900x600 viewBox

      let foundItem: HiddenObjectItem | null = null;

      // Check strictly against undiscovered targets for the active difficulty
      for (const obj of activeTargets) {
        if (foundObjects.has(obj.id)) continue;

        const dx = clickX - obj.x;
        const dy = (clickY - obj.y) * aspectCorrection;
        const distance = Math.sqrt(dx * dx + dy * dy);

        if (distance <= obj.radius) {
          foundItem = obj;
          break;
        }
      }

      if (foundItem) {
        foundObjects.add(foundItem.id);
        addFoundMarker(foundItem);
        playSuccessSound();
        showSelectionPopup(clickX, clickY, true, foundItem.name);

        // Update Object Card
        const card = document.querySelector<HTMLElement>(`.ho-object-card[data-obj-id="${foundItem.id}"]`);
        if (card) {
          card.classList.add('is-found');
          const badge = card.querySelector('.ho-obj-badge');
          if (badge) badge.textContent = 'Found';
        }

        // Update Progress Counters
        const foundCount = foundObjects.size;
        const totalCount = activeTargets.length;
        if (foundCounter) foundCounter.textContent = `${foundCount} of ${totalCount} Found`;
        if (remainingTag) remainingTag.textContent = `(${totalCount - foundCount} remaining)`;

        checkLevelComplete();
      } else {
        // Check if user tapped an already found object
        let alreadyFound = false;
        for (const obj of activeTargets) {
          if (!foundObjects.has(obj.id)) continue;
          const dx = clickX - obj.x;
          const dy = (clickY - obj.y) * aspectCorrection;
          if (Math.sqrt(dx * dx + dy * dy) <= obj.radius) {
            alreadyFound = true;
            break;
          }
        }

        if (!alreadyFound) {
          playMissSound();
          showMissRipple(clickX, clickY);
          showSelectionPopup(clickX, clickY, false);
        }
      }
    });

    // Zoom Change Handler to keep viewport center aligned smoothly
    const sceneBoard = document.getElementById('ho-scene-board');
    const sceneViewport = document.getElementById('ho-scene-viewport');

    sceneBoard?.addEventListener('puzzlefeels:zoomchange', (e: Event) => {
      const customEvent = e as CustomEvent<{ pct: number; scale: number }>;
      const scale = customEvent.detail?.scale ?? 1;
      if (!sceneViewport) return;
      if (scale <= 1) {
        sceneViewport.scrollLeft = 0;
        sceneViewport.scrollTop = 0;
      } else {
        requestAnimationFrame(() => {
          const scrollableX = sceneViewport.scrollWidth - sceneViewport.clientWidth;
          const scrollableY = sceneViewport.scrollHeight - sceneViewport.clientHeight;
          if (scrollableX > 0) sceneViewport.scrollLeft = scrollableX / 2;
          if (scrollableY > 0) sceneViewport.scrollTop = scrollableY / 2;
        });
      }
    });

    // Level Pills Selection
    pillsContainer?.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.ho-level-pill');
      if (!btn || btn.disabled) return;
      playClickSound();
      const lvlNum = parseInt(btn.dataset.level || '1', 10);
      if (lvlNum <= unlockedLevel) {
        loadLevel(lvlNum - 1);
      }
    });

    // Difficulty Tabs Selection
    diffButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const d = btn.dataset.difficulty as Difficulty;
        if (d === currentDiff) return;
        playClickSound();
        currentDiff = d;
        saveState();
        loadLevel(currentLevelIndex);
      });
    });

    // Toolbar Buttons
    btnHint?.addEventListener('click', triggerHint);
    btnPause?.addEventListener('click', togglePause);
    btnResume?.addEventListener('click', togglePause);

    btnRestart?.addEventListener('click', () => {
      playClickSound();
      loadLevel(currentLevelIndex);
      showToast('Level restarted');
    });

    btnSound?.addEventListener('click', () => {
      soundEnabled = !soundEnabled;
      updateSoundUI();
      saveState();
      if (soundEnabled) {
        initAudio();
        playClickSound();
      }
    });

    // Keyboard Shortcuts (Space to Pause)
    window.addEventListener('keydown', (e) => {
      if (e.code === 'Space' && e.target === document.body) {
        e.preventDefault();
        togglePause();
      }
    });

    // Initialize UI
    updateSoundUI();
    renderDifficultyUI();
    loadLevel(0);
  }
</script>
