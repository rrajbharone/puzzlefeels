---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FaqList from '../components/FaqList.astro';
import ExploreMore from '../components/ExploreMore.astro';
import ZoomControl from '../components/ZoomControl.astro';
import { SQUARE_JAM_PUZZLES, getDailySquareJamPuzzle } from '../data/squareJamPuzzles';

const title = 'Square Jam Puzzle – Play Free Online Logic Game | PuzzleFeels';
const description = 'Play Square Jam puzzle online for free. Divide the grid into perfect squares, follow number clues and avoid four-way corners in this fun logic game.';

const faqs = [
  {
    question: 'What does each number mean in Square Jam?',
    answer: 'Each number indicates the exact side length of the square-shaped region that contains it. For example, a 1 clue requires a 1×1 square, a 2 clue requires a 2×2 square (covering 4 cells), and a 3 clue requires a 3×3 square (covering 9 cells). Numbers indicate side length, not total cell area.'
  },
  {
    question: 'Does a number represent the area or side length of a square?',
    answer: 'A number represents the side length of the square. For example, a clue 2 designates a 2×2 square consisting of 4 cells, while a clue 3 designates a 3×3 square consisting of 9 cells. Never draw a 2-cell or 3-cell rectangle; every single region on the board must be an equilateral square.'
  },
  {
    question: 'Can a square contain more than one number?',
    answer: 'Yes! A square region can contain multiple numbers as long as all numbers inside that square share the exact same value. For instance, a 2×2 square may enclose two separate 2 clues, but it can never enclose both a 2 and a 3.'
  },
  {
    question: 'Can a square have no number at all?',
    answer: 'Yes. Many squares across the grid will contain no clues whatsoever. You can deduce the positions and dimensions of these unnumbered squares by working backward from surrounding clues, outer grid boundaries, and the Tatami rule.'
  },
  {
    question: 'What is the Tatami Rule in Square Jam?',
    answer: 'The Tatami Rule states that four different square regions must never meet at the exact same internal grid line intersection. In other words, no four-way cross junctions are permitted. Boundaries between adjacent squares must form T-junctions or pass-through straight lines, mirroring traditional Japanese Tatami mat flooring.'
  },
  {
    question: 'Can two square regions share an edge?',
    answer: 'Yes. Two squares are fully allowed to share an orthogonal edge or border. The Tatami Rule only forbids four separate squares from meeting at a single corner vertex point.'
  },
  {
    question: 'How do you solve a difficult Square Jam puzzle?',
    answer: 'Start by anchoring large clues and corner clues where board boundaries heavily restrict placement options. Next, look for narrow 1-cell or 2-cell corridors that can only accommodate smaller squares. Whenever you consider a candidate placement, check whether its corners would force an illegal four-way junction with neighboring squares.'
  },
  {
    question: 'Can I play Square Jam on my phone or tablet?',
    answer: 'Yes! Square Jam is fully responsive and optimized for mobile devices. You can drag your finger to draw and preview squares, or use our accessible two-tap mode (tap starting corner, then tap ending corner). Our integrated zoom controls allow comfortable play on small smartphone screens.'
  },
  {
    question: 'Is Square Jam free to play online?',
    answer: 'Yes, 100% free with no downloads, subscriptions, paywalls, or account registration required. Your progress, best times, and daily challenge completions are automatically saved to your web browser via LocalStorage.'
  }
];

const gameSchema = {
  '@context': 'https://schema.org',
  '@type': 'VideoGame',
  name: 'Square Jam – Online Logic Puzzle',
  url: 'https://puzzlefeels.com/square-jam-puzzle/',
  description,
  gamePlatform: 'Web browser',
  applicationCategory: 'Game',
  genre: ['Logic Puzzle', 'Square Puzzle', 'Grid Puzzle', 'Brain Game'],
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  publisher: { '@type': 'Organization', name: 'PuzzleFeels', url: 'https://puzzlefeels.com/' }
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://puzzlefeels.com/' },
    { '@type': 'ListItem', position: 2, name: 'Games', item: 'https://puzzlefeels.com/games/' },
    { '@type': 'ListItem', position: 3, name: 'Square Jam – Online Logic Puzzle', item: 'https://puzzlefeels.com/square-jam-puzzle/' }
  ]
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(faq => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer
    }
  }))
};
---

<Base {title} {description} path="/square-jam-puzzle/">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(gameSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <Header />

  <main class="jam-page">
    <!-- Breadcrumb Navigation -->
    <nav class="wrap jam-breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">›</span>
      <a href="/games/">Games</a>
      <span aria-hidden="true">›</span>
      <span aria-current="page">Square Jam – Online Logic Puzzle</span>
    </nav>

    <!-- Centered Game Introduction -->
    <section class="wrap jam-intro">
      <span class="eyebrow">Grid Partitioning Logic Puzzle</span>
      <h1>Square Jam – Free Online Logic Puzzle Game</h1>
      <p class="muted">Divide the grid into perfect squares. Numbers specify each square's side length, and four squares must never meet at a single corner junction.</p>
    </section>

    <!-- Main Game Shell Card -->
    <section class="wrap jam-shell card" data-square-jam-game aria-label="Square Jam Logic Puzzle Game">
      
      <!-- Top Bar: Difficulty Selector & Utility Buttons -->
      <div class="jam-header-bar">
        <div class="jam-diff-group" role="tablist" aria-label="Difficulty levels">
          <button type="button" class="jam-diff-btn is-active" data-difficulty="easy" role="tab" aria-selected="true">
            <strong>Easy</strong>
            <span>5×5–6×6 · Beginner</span>
          </button>
          <button type="button" class="jam-diff-btn" data-difficulty="medium" role="tab" aria-selected="false">
            <strong>Medium</strong>
            <span>7×7–8×8 · Intermediate</span>
          </button>
          <button type="button" class="jam-diff-btn" data-difficulty="hard" role="tab" aria-selected="false">
            <strong>Hard</strong>
            <span>9×9–10×10 · Master</span>
          </button>
          <button type="button" class="jam-diff-btn daily-tab" data-difficulty="daily" role="tab" aria-selected="false">
            <strong>Daily</strong>
            <span id="jam-daily-label">Challenge</span>
          </button>
        </div>

        <div class="jam-header-actions">
          <button type="button" class="btn secondary jam-sound-btn" id="jam-sound-toggle" aria-label="Toggle Sound Effects" title="Sound Effects">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
              <path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path>
            </svg>
            <span class="sound-status-label">Sound On</span>
          </button>
          <ZoomControl targetSelector="#jam-board-zoom-target" label="Board Zoom" />
        </div>
      </div>

      <!-- Stats Bar: Moves, Time, Coverage, Best -->
      <div class="jam-stats-bar" role="status" aria-label="Puzzle statistics">
        <div class="jam-stat-item">
          <small>Time</small>
          <strong id="jam-timer">00:00</strong>
        </div>
        <div class="jam-stat-item">
          <small>Moves</small>
          <strong id="jam-moves">0</strong>
        </div>
        <div class="jam-stat-item">
          <small>Coverage</small>
          <strong id="jam-coverage">0 / 0</strong>
        </div>
        <div class="jam-stat-item">
          <small>Best Time</small>
          <strong id="jam-best-time">—</strong>
        </div>
      </div>

      <!-- Live Feedback Toast Notification -->
      <div id="jam-toast" class="jam-toast" role="alert" aria-live="polite" hidden>
        <span id="jam-toast-text"></span>
      </div>

      <!-- Board Area Wrapper with Zoom and Smooth Scroll -->
      <div class="jam-board-wrapper" id="jam-board-container">
        <div class="jam-board-zoom-target" id="jam-board-zoom-target">
          <div class="jam-grid-container" id="jam-grid-container">
            <div class="jam-grid" id="jam-grid" role="grid" aria-label="Square Jam puzzle grid">
              <!-- Dynamically populated via client script -->
            </div>
            <!-- Interactive Drag Preview Box -->
            <div id="jam-drag-preview" class="jam-drag-preview" hidden aria-hidden="true">
              <span id="jam-preview-badge" class="jam-preview-badge">1×1</span>
            </div>
          </div>
        </div>

        <!-- Paused Overlay -->
        <div id="jam-paused" class="jam-overlay" hidden>
          <div class="jam-overlay-box">
            <span class="eyebrow">Puzzle Paused</span>
            <h2>Take a Breather</h2>
            <p class="muted">The timer is stopped and your placed squares are safe. Resume whenever you are ready to continue partitioning.</p>
            <button type="button" class="btn" id="jam-resume">Resume Game <span>→</span></button>
          </div>
        </div>

        <!-- Solution Confirmation Overlay -->
        <div id="jam-solution-modal" class="jam-overlay" hidden>
          <div class="jam-overlay-box">
            <span class="eyebrow">Reveal Solution?</span>
            <h2>Show Solved Squares?</h2>
            <p class="muted">Revealing the solution will display all completed square regions. This puzzle run will be marked as assisted and will not be recorded as a personal best.</p>
            <div class="jam-overlay-actions">
              <button type="button" class="btn" id="jam-confirm-solution">Reveal Solution</button>
              <button type="button" class="btn secondary" id="jam-cancel-solution">Cancel</button>
            </div>
          </div>
        </div>

        <!-- Victory / Solved Modal -->
        <div id="jam-victory" class="jam-overlay" hidden>
          <div class="jam-overlay-box victory-box">
            <span class="pill victory-pill">✦ PUZZLE SOLVED!</span>
            <h2>Board Perfectly Partitioned!</h2>
            <p class="muted">Every cell belongs to a valid square matching all side clues, and all four-way Tatami junctions have been avoided.</p>
            
            <div id="jam-pb-badge" class="jam-pb-badge" hidden>
              <span>★ New Personal Best!</span>
            </div>

            <div class="victory-stats-grid">
              <div>
                <small>Difficulty</small>
                <strong id="victory-diff-label">Easy</strong>
              </div>
              <div>
                <small>Time</small>
                <strong id="victory-time">00:00</strong>
              </div>
              <div>
                <small>Moves</small>
                <strong id="victory-moves">0</strong>
              </div>
              <div>
                <small>Hints Used</small>
                <strong id="victory-hints">0</strong>
              </div>
            </div>

            <div class="victory-actions">
              <button type="button" class="btn" id="jam-next-puzzle">Next Puzzle <span>→</span></button>
              <button type="button" class="btn secondary" id="jam-share">Share Result</button>
            </div>
            <p id="jam-share-status" class="jam-share-status" aria-live="polite"></p>
          </div>
        </div>
      </div>

      <!-- Controls Toolbar -->
      <div class="jam-controls" role="group" aria-label="Game controls">
        <button type="button" class="btn secondary" id="jam-new-btn">New Game</button>
        <button type="button" class="btn secondary" id="jam-restart-btn">Restart</button>
        <button type="button" class="btn secondary" id="jam-undo-btn" disabled>Undo</button>
        <button type="button" class="btn secondary" id="jam-redo-btn" disabled>Redo</button>
        <button type="button" class="btn secondary" id="jam-erase-btn">Erase</button>
        <button type="button" class="btn secondary" id="jam-hint-btn">Hint</button>
        <button type="button" class="btn secondary" id="jam-check-btn">Check</button>
        <button type="button" class="btn secondary" id="jam-solve-btn">Show Solution</button>
        <button type="button" class="btn secondary" id="jam-pause-btn">Pause</button>
      </div>

      <!-- Footer Metadata / Instructions -->
      <div class="jam-footer-meta">
        <p class="jam-help-text"><strong>How to play:</strong> Click and drag from one corner to the opposite corner to place a square, or tap a starting cell then an ending cell. Select any placed square and click <em>Erase</em> (or press Delete) to remove it. Numbers represent square side lengths (1=1×1, 2=2×2, 3=3×3). Four squares must never meet at a single four-way corner!</p>
        <p class="jam-save-note">Puzzle progress, best times, and sound settings save automatically on your device.</p>
      </div>

      <p id="jam-live" class="sr-only" aria-live="polite"></p>
    </section>

    <!-- Comprehensive In-Depth Educational SEO Content Section -->
    <article class="wrap game-article-content jam-article">
      <h2>What Is Square Jam?</h2>
      <p>Square Jam is a pure grid-partitioning logic puzzle that challenges solvers to tile a rectangular board using equilateral square regions. Unlike sliding block or traffic-jam puzzle games where pieces slide across tracks, Square Jam is a deductive pencil-and-paper challenge. Every cell on the board starts unassigned, and several cells display clue numbers. Your goal is to partition the entire board so that every cell belongs to exactly one square, every numbered clue matches the side length of its containing square, and no four squares meet at any single intersection point.</p>
      <p>Fans of classic Nikoli Japanese puzzles like <a href="/shakashaka-online-puzzle-game/">Shakashaka</a>, <a href="/norinori-game/">Norinori</a>, and <a href="/picross-game-online/">Picross Game Online</a> will immediately appreciate the clean spatial elegance of Square Jam. The puzzle relies on pure deductive reasoning rather than arithmetic or guesswork, offering a soothing, deeply satisfying mental workout.</p>

      <h2>How to Play Square Jam</h2>
      <p>Playing Square Jam online on PuzzleFeels is designed to be accessible, fluid, and responsive on all devices:</p>
      <ol>
        <li><strong>Select your difficulty:</strong> Choose from Easy (5×5 and 6×6 starter grids), Medium (7×7 and 8×8 intermediate grids), Hard (9×9 and 10×10 master grids), or tackle the daily global challenge.</li>
        <li><strong>Inspect the number clues:</strong> Each number tells you the side length of the square that must cover that cell. A 1 requires a 1×1 square, a 2 requires a 2×2 square, a 3 requires a 3×3 square, and so forth.</li>
        <li><strong>Place a square:</strong> Click or tap a starting cell, drag across to the opposite corner, and release to lock in the square. On touch screens, you can also simply tap the start corner and tap the opposite corner.</li>
        <li><strong>Ensure squares never overlap:</strong> Placed square regions cannot overlap each other or extend beyond the grid borders.</li>
        <li><strong>Follow the Tatami Rule:</strong> Verify that four different square regions never meet at the exact same internal grid line intersection.</li>
        <li><strong>Complete the full board:</strong> Once every cell belongs to a valid square and all clues are satisfied, the board is solved and your record is saved!</li>
      </ol>

      <h2>Understanding Square Jam Rules With Examples</h2>
      <p>Square Jam is governed by three straightforward but interconnected rules:</p>
      
      <h3>Rule 1: Every Region Must Be a Square</h3>
      <p>Every cell on the board must belong to exactly one square-shaped region. Rectangles with unequal sides—such as a 1×2 domino, a 2×3 block, or an L-tromino—are strictly forbidden. Even if an empty gap spans 1×3 cells, you cannot fill it with a 1×3 rectangle; you must fill it with three individual 1×1 squares.</p>

      <h3>Rule 2: Numbers Indicate Square Side Length</h3>
      <p>A clue number specifies the side length of the square containing that cell, <em>not</em> its area:</p>
      <ul>
        <li><strong>Number 1:</strong> Designates a 1×1 square covering exactly 1 cell.</li>
        <li><strong>Number 2:</strong> Designates a 2×2 square covering 4 cells.</li>
        <li><strong>Number 3:</strong> Designates a 3×3 square covering 9 cells.</li>
        <li><strong>Number 4:</strong> Designates a 4×4 square covering 16 cells.</li>
      </ul>
      <p>A single square may enclose multiple clues provided all of those clues share the exact same number. For instance, two 2 clues can both sit inside the same 2×2 square. Furthermore, many squares on the board will contain no clue numbers at all; these unnumbered squares must be deduced through board geometry and elimination.</p>

      <h3>Rule 3: The Tatami Rule</h3>
      <p>Four separate square regions must never meet at the same internal grid intersection point. In architectural terms, traditional Japanese Tatami mats are arranged so that four corners never meet at a cross (+), which is believed to bring bad luck. In Square Jam, this architectural principle creates beautiful, interlocking stagger patterns where boundaries meet in T-junctions or continuous lines.</p>

      <h2>How to Solve Square Jam Puzzles – Beginner Tips</h2>
      <p>If you are new to Square Jam or transitioning from games like <a href="/sliding-number-puzzle-game/">Sliding Number Puzzle Game</a> and <a href="/number-sequence-game/">Number Sequence Game</a>, these proven deduction strategies will help you solve boards cleanly without guessing:</p>
      <ul>
        <li><strong>Start with corner clues:</strong> A clue located directly in an outer grid corner has only one possible placement direction because the board edges prevent it from extending outward. A clue 2 in the top-left corner must cover rows 1–2 and columns 1–2.</li>
        <li><strong>Anchor large squares first:</strong> Squares of size 3 and 4 occupy 9 and 16 cells respectively. Because they require substantial continuous clearance, they have very few legal positions. Placing large squares early drastically reduces the remaining search space.</li>
        <li><strong>Use outer wall constraints:</strong> A clue 2 placed along an outer border only has two possible orientations along that border. If one of those orientations collides with another clue or leaves an impossible 1-cell notch, the remaining orientation is immediately forced.</li>
        <li><strong>Look for narrow 1-cell corridors:</strong> Whenever placed squares leave an empty strip that is only 1 cell wide, that strip cannot accommodate any square of size 2 or larger. The entire corridor must be partitioned into 1×1 squares.</li>
        <li><strong>Leverage the Tatami Rule for negative deductions:</strong> If three squares already meet around a grid line vertex, the fourth adjacent cell <em>cannot</em> be its own independent square corner. It must either share an edge with one of the existing squares or extend past that vertex to form a T-junction.</li>
      </ul>

      <h2>Common Square Jam Mistakes to Avoid</h2>
      <ul>
        <li><strong>Confusing side length with area:</strong> Mistaking a clue 2 for an area of 2 cells (a domino) or a clue 3 for an area of 3 cells. Always remember: in Square Jam, numbers represent side lengths. A 2 is 2×2 (4 cells), and a 3 is 3×3 (9 cells).</li>
        <li><strong>Drawing rectangles instead of squares:</strong> Forgetting that all regions must have equal width and height. Non-square rectangles are never permitted.</li>
        <li><strong>Creating four-way cross intersections:</strong> Placing four 1×1 squares in a 2×2 cluster creates an illegal four-way junction where all four corners meet at the center. To avoid this, at least one of those corners must be part of a larger square.</li>
        <li><strong>Assuming every square must contain a clue:</strong> Many squares on intermediate and advanced boards have no clues. Treat empty space as an active part of the puzzle.</li>
      </ul>

      <h2>Understanding the Tatami Rule</h2>
      <p>The Tatami Rule is the mathematical backbone of Square Jam that prevents trivial solutions and forces elegant spatial layouts. Consider any internal point where four grid lines intersect. Four cells touch this point: top-left, top-right, bottom-left, and bottom-right. If all four cells belong to different square regions, that intersection is an illegal four-way junction.</p>
      <p>Conversely, if at least two of those cells belong to the same square (meaning an edge of that square passes straight through the intersection without terminating), only two or three separate squares meet at that point, forming a completely legal T-junction. Sharing edges is fully permitted; only four terminating corners meeting at a single cross point is prohibited.</p>

      <h2>Square Jam Controls and Game Features</h2>
      <p>PuzzleFeels Square Jam offers a modern, tactile interface tailored for comfortable puzzle solving:</p>
      <ul>
        <li><strong>Drag or Two-Tap Placement:</strong> Drag across the board to preview and place a square with live size indicators, or tap the start cell and destination cell.</li>
        <li><strong>Erase Feature:</strong> Tap any placed square and click <em>Erase</em> (or press Delete) to remove it from the board.</li>
        <li><strong>Undo and Redo:</strong> Step backward and forward through your placement history effortlessly.</li>
        <li><strong>Educational Hint Engine:</strong> Unlike games that merely reveal random squares, our hint system analyzes the board, detects rule violations, and reveals the next logically forced square along with an explanation of why it is required.</li>
        <li><strong>Check Progress:</strong> Instant feedback that checks for overlapping squares, clue mismatches, and Tatami violations without spoiling unfinished sections.</li>
        <li><strong>Show Solution:</strong> Need to study a completed board? Reveal the solution with confirmation.</li>
        <li><strong>Sound & Zoom Controls:</strong> Enjoy soft synthesized acoustic feedback, or scale the board up to 150% using our integrated Zoom toolbar.</li>
        <li><strong>Daily Challenge:</strong> A fresh synchronized puzzle every day based on UTC date, tracking your streaks and completions separately.</li>
      </ul>

      <h2>Why Play Square Jam on PuzzleFeels?</h2>
      <p>PuzzleFeels is dedicated to providing high-quality, ad-free, respectful browser puzzle games. Square Jam runs 100% in your browser with no downloads, subscriptions, accounts, or tracking scripts required. Whether you are solving a quick 5×5 grid on your smartphone during a commute or relaxing with a 10×10 master grid on your desktop, your progress and personal best times remain safely saved on your device.</p>
      <p>If you enjoy spatial and pattern-recognition games, be sure to also explore our <a href="/mahjong-variants-online-game/">Mahjong Variants Online Game</a> and our complete library of free online logic puzzles.</p>

      <!-- Standard FAQ Section -->
      <section class="jam-faq-section" aria-label="Frequently Asked Questions">
        <h2>Frequently Asked Questions About Square Jam</h2>
        <FaqList items={faqs} />
      </section>
    </article>

    <!-- Explore More Puzzle Games Section (Spot the Difference Standard) -->
    <ExploreMore currentGameId="square-jam" />
  </main>

  <Footer />
</Base>

<style is:global>
  /* Base page layout & typography */
  .jam-page {
    padding-bottom: 70px;
  }
  .wrap {
    max-width: 1040px;
    margin: 0 auto;
    padding: 0 20px;
  }
  .jam-breadcrumbs {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--muted);
    padding-top: 16px;
    padding-bottom: 8px;
  }
  .jam-breadcrumbs a {
    color: var(--muted);
    text-decoration: none;
    transition: color .15s ease;
  }
  .jam-breadcrumbs a:hover {
    color: var(--blue);
  }
  .jam-breadcrumbs span[aria-current="page"] {
    color: var(--ink);
    font-weight: 600;
  }

  /* Centered Intro Section */
  .jam-intro {
    text-align: center;
    padding: 24px 0 28px;
  }
  .jam-intro .eyebrow {
    display: inline-block;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .08em;
    color: var(--blue);
    margin-bottom: 8px;
  }
  .jam-intro h1 {
    font-size: clamp(2rem, 5vw, 2.75rem);
    font-weight: 800;
    letter-spacing: -.03em;
    line-height: 1.18;
    margin: 0 0 12px;
    color: var(--ink);
  }
  .jam-intro p {
    font-size: 16px;
    line-height: 1.6;
    color: var(--muted);
    max-width: 660px;
    margin: 0 auto;
  }

  /* Game Shell Card */
  .jam-shell {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 20px;
    padding: 24px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  /* Header Bar with Difficulty and Utilities */
  .jam-header-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }
  .jam-diff-group {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .jam-diff-btn {
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--paper);
    color: var(--ink);
    padding: 8px 14px;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
    transition: all .16s ease;
  }
  .jam-diff-btn strong { font-size: 13px; font-weight: 700; }
  .jam-diff-btn span { font-size: 10px; color: var(--muted); }
  .jam-diff-btn:hover { border-color: var(--blue); }
  .jam-diff-btn.is-active {
    background: #edf2ff;
    border-color: var(--blue);
    color: var(--blue);
    box-shadow: 0 4px 12px rgba(49, 94, 232, 0.12);
  }
  .jam-diff-btn.is-active span { color: var(--blue); opacity: .85; }

  .jam-header-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .jam-sound-btn {
    min-height: 40px;
    padding: 0 14px;
    font-size: 12px;
    gap: 7px;
    border-radius: 11px;
    display: inline-flex;
    align-items: center;
  }
  .jam-sound-btn svg { width: 16px; height: 16px; flex-shrink: 0; }

  /* Stats Bar */
  .jam-stats-bar {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
