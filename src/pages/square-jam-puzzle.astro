</style>

<script define:vars={{ rawPuzzles: SQUARE_JAM_PUZZLES }}>
  // Web Audio Synthesizer
  class SoundManager {
    constructor() {
      this.ctx = null;
      this.enabled = true;
    }
    init() {
      if (!this.ctx && typeof window !== 'undefined') {
        const AudioClass = window.AudioContext || window.webkitAudioContext;
        if (AudioClass) this.ctx = new AudioClass();
      }
      if (this.ctx && this.ctx.state === 'suspended') {
        this.ctx.resume();
      }
    }
    playTone(freq, type = 'sine', duration = 0.08, gainVal = 0.1) {
      if (!this.enabled) return;
      try {
        this.init();
        if (!this.ctx) return;
        const osc = this.ctx.createOscillator();
        const gain = this.ctx.createGain();
        osc.type = type;
        osc.frequency.setValueAtTime(freq, this.ctx.currentTime);
        gain.gain.setValueAtTime(gainVal, this.ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.0001, this.ctx.currentTime + duration);
        osc.connect(gain);
        gain.connect(this.ctx.destination);
        osc.start();
        osc.stop(this.ctx.currentTime + duration);
      } catch (e) {}
    }
    playClick() { this.playTone(180, 'triangle', 0.04, 0.06); }
    playPlace(size = 1) {
      const freqs = [330, 440, 550, 660, 770];
      this.playTone(freqs[(size - 1) % freqs.length], 'sine', 0.09, 0.09);
    }
    playErase() { this.playTone(220, 'triangle', 0.06, 0.05); }
    playError() {
      this.playTone(180, 'sawtooth', 0.12, 0.1);
      setTimeout(() => this.playTone(140, 'sawtooth', 0.14, 0.1), 100);
    }
    playHint() {
      this.playTone(523.25, 'sine', 0.09, 0.1);
      setTimeout(() => this.playTone(659.25, 'sine', 0.12, 0.12), 80);
    }
    playWin() {
      if (!this.enabled) return;
      const notes = [523.25, 659.25, 783.99, 1046.5];
      notes.forEach((f, i) => {
        setTimeout(() => this.playTone(f, 'triangle', 0.25, 0.12), i * 110);
      });
    }
  }

  const sound = new SoundManager();

  // Square Jam Game Controller
  class SquareJamGame {
    constructor(puzzles) {
      this.puzzles = puzzles;
      this.currentDiff = 'easy';
      this.puzzleIndex = 0;
      this.puzzle = null;
      this.placedSquares = []; // array of { r0, c0, s, colorIdx }
      this.history = []; // stack of actions for undo
      this.redoStack = []; // stack of actions for redo
      this.selectedSquareIdx = -1;
      this.anchorStartCell = null; // for two-tap mode { r, c }
      this.isDragging = false;
      this.dragStart = null; // { r, c, clientX, clientY }
      this.moves = 0;
      this.hintsUsed = 0;
      this.timerSeconds = 0;
      this.timerInterval = null;
      this.isTimerRunning = false;
      this.isPaused = false;
      this.isWon = false;
      this.isAssisted = false;
      this.storageKey = 'pf-square-jam-v1';

      this.initElements();
      this.bindEvents();
      this.loadSettings();
      this.startFromURLOrSaved();
    }

    initElements() {
      this.gridContainerEl = document.querySelector('#jam-grid-container');
      this.gridEl = document.querySelector('#jam-grid');
      this.previewEl = document.querySelector('#jam-drag-preview');
      this.previewBadgeEl = document.querySelector('#jam-preview-badge');
      this.timerEl = document.querySelector('#jam-timer');
      this.movesEl = document.querySelector('#jam-moves');
      this.coverageEl = document.querySelector('#jam-coverage');
      this.bestTimeEl = document.querySelector('#jam-best-time');
      this.toastEl = document.querySelector('#jam-toast');
      this.toastTextEl = document.querySelector('#jam-toast-text');
      this.pausedEl = document.querySelector('#jam-paused');
      this.solutionModalEl = document.querySelector('#jam-solution-modal');
      this.victoryEl = document.querySelector('#jam-victory');
      this.liveEl = document.querySelector('#jam-live');
      this.diffButtons = Array.from(document.querySelectorAll('.jam-diff-btn'));
      this.soundBtn = document.querySelector('#jam-sound-toggle');
      this.soundLabel = document.querySelector('.sound-status-label');

      this.newBtn = document.querySelector('#jam-new-btn');
      this.restartBtn = document.querySelector('#jam-restart-btn');
      this.undoBtn = document.querySelector('#jam-undo-btn');
      this.redoBtn = document.querySelector('#jam-redo-btn');
      this.eraseBtn = document.querySelector('#jam-erase-btn');
      this.hintBtn = document.querySelector('#jam-hint-btn');
      this.checkBtn = document.querySelector('#jam-check-btn');
      this.solveBtn = document.querySelector('#jam-solve-btn');
      this.pauseBtn = document.querySelector('#jam-pause-btn');
      this.resumeBtn = document.querySelector('#jam-resume');
      this.confirmSolutionBtn = document.querySelector('#jam-confirm-solution');
      this.cancelSolutionBtn = document.querySelector('#jam-cancel-solution');
      this.nextPuzzleBtn = document.querySelector('#jam-next-puzzle');
      this.shareBtn = document.querySelector('#jam-share');
      this.shareStatusEl = document.querySelector('#jam-share-status');
      this.dailyLabelEl = document.querySelector('#jam-daily-label');
    }

    bindEvents() {
      // Difficulty buttons
      this.diffButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          const diff = btn.dataset.difficulty;
          if (diff) this.setDifficulty(diff);
        });
      });

      // Controls
      this.newBtn?.addEventListener('click', () => this.nextPuzzle());
      this.restartBtn?.addEventListener('click', () => this.restartGame());
      this.undoBtn?.addEventListener('click', () => this.undo());
      this.redoBtn?.addEventListener('click', () => this.redo());
      this.eraseBtn?.addEventListener('click', () => this.eraseSelectedSquare());
      this.hintBtn?.addEventListener('click', () => this.giveHint());
      this.checkBtn?.addEventListener('click', () => this.manualCheck());
      this.solveBtn?.addEventListener('click', () => this.promptShowSolution());
      this.pauseBtn?.addEventListener('click', () => this.togglePause());
      this.resumeBtn?.addEventListener('click', () => this.togglePause());
      this.confirmSolutionBtn?.addEventListener('click', () => this.revealSolution());
      this.cancelSolutionBtn?.addEventListener('click', () => {
        if (this.solutionModalEl) this.solutionModalEl.hidden = true;
      });
      this.nextPuzzleBtn?.addEventListener('click', () => {
        if (this.victoryEl) this.victoryEl.hidden = true;
        this.nextPuzzle();
      });
      this.shareBtn?.addEventListener('click', () => this.shareResult());

      // Sound toggle
      this.soundBtn?.addEventListener('click', () => {
        sound.enabled = !sound.enabled;
        this.updateSoundButton();
        this.saveState();
      });

      // Pointer drag interaction on grid
      if (this.gridContainerEl) {
        this.gridContainerEl.addEventListener('pointerdown', (e) => this.handlePointerDown(e));
        window.addEventListener('pointermove', (e) => this.handlePointerMove(e));
        window.addEventListener('pointerup', (e) => this.handlePointerUp(e));
        window.addEventListener('pointercancel', (e) => this.handlePointerCancel(e));
      }

      // Keyboard
      window.addEventListener('keydown', (e) => this.handleKeyDown(e));
    }

    updateSoundButton() {
      if (this.soundLabel) {
        this.soundLabel.textContent = sound.enabled ? 'Sound On' : 'Sound Off';
      }
      if (this.soundBtn) {
        this.soundBtn.classList.toggle('is-muted', !sound.enabled);
      }
    }

    startFromURLOrSaved() {
      const params = new URLSearchParams(window.location.search);
      const isDaily = params.get('daily') === '1' || params.get('mode') === 'daily' || params.get('daily') === 'today';
      const urlDiff = params.get('diff');

      if (isDaily) {
        this.setDifficulty('daily');
        return;
      }

      if (urlDiff && ['easy', 'medium', 'hard'].includes(urlDiff)) {
        this.setDifficulty(urlDiff);
        return;
      }

      const saved = this.loadState();
      if (saved && saved.puzzleId) {
        const found = this.puzzles.find(p => p.id === saved.puzzleId);
        if (found) {
          this.currentDiff = found.difficulty;
          this.puzzle = found;
          this.puzzleIndex = this.getDiffPuzzles(found.difficulty).findIndex(p => p.id === found.id);
          this.initBoard(saved.placedSquares, saved.moves, saved.timerSeconds);
          this.updateDiffButtons();
          this.updateBestDisplay();
          return;
        }
      }

      this.setDifficulty('easy');
    }

    getDiffPuzzles(diff) {
      if (diff === 'daily') {
        const todayStr = new Date().toISOString().slice(0, 10);
        return [getDailyPuzzleClient(this.puzzles, todayStr)];
      }
      return this.puzzles.filter(p => p.difficulty === diff);
    }

    setDifficulty(diff) {
      this.currentDiff = diff;
      this.puzzleIndex = 0;
      const list = this.getDiffPuzzles(diff);
      this.puzzle = list[0] || this.puzzles[0];
      this.updateDiffButtons();
      this.initBoard();
      this.updateBestDisplay();
      this.saveState();
    }

    updateDiffButtons() {
      this.diffButtons.forEach(btn => {
        const active = btn.dataset.difficulty === this.currentDiff;
        btn.classList.toggle('is-active', active);
        btn.setAttribute('aria-selected', active ? 'true' : 'false');
      });
    }

    initBoard(savedSquares = null, savedMoves = 0, savedTimer = 0) {
      this.stopTimer();
      this.isWon = false;
      this.isPaused = false;
      this.isAssisted = false;
      this.selectedSquareIdx = -1;
      this.anchorStartCell = null;
      if (this.pausedEl) this.pausedEl.hidden = true;
      if (this.victoryEl) this.victoryEl.hidden = true;
      if (this.solutionModalEl) this.solutionModalEl.hidden = true;
      this.history = [];
      this.redoStack = [];
      this.hintsUsed = 0;
      this.moves = savedMoves;
      this.timerSeconds = savedTimer;
      this.isTimerRunning = false;

      if (savedSquares && Array.isArray(savedSquares)) {
        this.placedSquares = savedSquares.map(s => ({ ...s }));
      } else {
        this.placedSquares = [];
      }

      this.renderGrid();
      this.updateStats();
      this.updateUndoRedo();
      this.hideToast();
    }

    renderGrid() {
      if (!this.gridEl || !this.puzzle) return;
      this.gridEl.innerHTML = '';
      this.gridEl.style.setProperty('--grid-cols', this.puzzle.cols);
      this.gridEl.style.setProperty('--grid-rows', this.puzzle.rows);

      for (let r = 0; r < this.puzzle.rows; r++) {
        for (let c = 0; c < this.puzzle.cols; c++) {
          const cell = document.createElement('button');
          cell.type = 'button';
          cell.className = 'jam-cell';
          cell.dataset.r = r;
          cell.dataset.c = c;
          cell.setAttribute('role', 'gridcell');
          cell.setAttribute('tabindex', '0');

          const clue = this.puzzle.clues[r][c];
          if (clue !== null) {
            const badge = document.createElement('span');
            badge.className = 'jam-clue-badge';
            badge.textContent = clue;
            cell.appendChild(badge);
            cell.setAttribute('aria-label', `Cell (${r + 1}, ${c + 1}) with clue number ${clue}`);
          } else {
            cell.setAttribute('aria-label', `Empty cell (${r + 1}, ${c + 1})`);
          }

          // Right click erases square under cursor
          cell.addEventListener('contextmenu', (e) => {
            e.preventDefault();
            const sqIdx = this.getSquareAtCell(r, c);
            if (sqIdx !== -1) {
              this.removeSquareAt(sqIdx);
            }
          });

          this.gridEl.appendChild(cell);
        }
      }

      this.refreshBoardUI();
    }

    getCellEl(r, c) {
      return this.gridEl?.querySelector(`button[data-r="${r}"][data-c="${c}"]`);
    }

    getCellFromPoint(clientX, clientY) {
      const el = document.elementFromPoint(clientX, clientY);
      const cell = el?.closest('.jam-cell');
      if (cell) {
        const r = parseInt(cell.dataset.r, 10);
        const c = parseInt(cell.dataset.c, 10);
        if (!isNaN(r) && !isNaN(c)) return { r, c };
      }
      return null;
    }

    getSquareAtCell(r, c) {
      return this.placedSquares.findIndex(sq =>
        r >= sq.r0 && r < sq.r0 + sq.s &&
        c >= sq.c0 && c < sq.c0 + sq.s
      );
    }

    refreshBoardUI() {
      // Clear all cell region classes and borders
      const cells = this.gridEl?.querySelectorAll('.jam-cell') || [];
      cells.forEach(cell => {
        cell.className = 'jam-cell';
        if (cell.dataset.r && cell.dataset.c) {
          const r = parseInt(cell.dataset.r, 10);
          const c = parseInt(cell.dataset.c, 10);
          if (this.anchorStartCell && this.anchorStartCell.r === r && this.anchorStartCell.c === c) {
            cell.classList.add('is-anchor-start');
          }
        }
      });

      // Apply region colors and borders
      this.placedSquares.forEach((sq, idx) => {
        const colorClass = `color-${sq.colorIdx % 8}`;
        const isSelected = (idx === this.selectedSquareIdx);

        for (let r = sq.r0; r < sq.r0 + sq.s; r++) {
          for (let c = sq.c0; c < sq.c0 + sq.s; c++) {
            const cell = this.getCellEl(r, c);
            if (cell) {
              cell.classList.add('is-occupied', colorClass);
              if (isSelected) cell.classList.add('is-selected-square');

              if (r === sq.r0) cell.classList.add('border-top');
              if (r === sq.r0 + sq.s - 1) cell.classList.add('border-bottom');
              if (c === sq.c0) cell.classList.add('border-left');
              if (c === sq.c0 + sq.s - 1) cell.classList.add('border-right');
            }
          }
        }
      });

      this.updateCoverageStats();
    }

    updateCoverageStats() {
      let covered = 0;
      this.placedSquares.forEach(sq => {
        covered += sq.s * sq.s;
      });
      const total = this.puzzle ? this.puzzle.rows * this.puzzle.cols : 0;
      if (this.coverageEl) {
        this.coverageEl.textContent = `${covered} / ${total}`;
      }
    }

    // Pointer Events: Click, Drag, Preview
    handlePointerDown(e) {
      if (this.isWon || this.isPaused || e.button === 2) return;
      const cell = this.getCellFromPoint(e.clientX, e.clientY);
      if (!cell) return;

      this.startTimer();

      // Check if clicked on an existing square
      const existingIdx = this.getSquareAtCell(cell.r, cell.c);

      // Start drag / tap anchor
      this.isDragging = true;
      this.dragStart = { r: cell.r, c: cell.c, clientX: e.clientX, clientY: e.clientY };
      this.dragCurrent = { r: cell.r, c: cell.c };

      // Update preview
      this.updatePreview(this.dragStart.r, this.dragStart.c, this.dragCurrent.r, this.dragCurrent.c);
    }

    handlePointerMove(e) {
      if (!this.isDragging || !this.dragStart) return;
      const cell = this.getCellFromPoint(e.clientX, e.clientY);
      if (cell) {
        this.dragCurrent = { r: cell.r, c: cell.c };
        this.updatePreview(this.dragStart.r, this.dragStart.c, this.dragCurrent.r, this.dragCurrent.c);
      }
    }

    handlePointerUp(e) {
      if (!this.isDragging || !this.dragStart) return;
      this.isDragging = false;
      this.hidePreview();

      const start = this.dragStart;
      const end = this.dragCurrent || start;
      this.dragStart = null;
      this.dragCurrent = null;

      const dr = Math.abs(end.r - start.r);
      const dc = Math.abs(end.c - start.c);

      // If dragged at least 1 cell:
      if (dr > 0 || dc > 0) {
        this.anchorStartCell = null;
        const side = Math.max(dr, dc) + 1;
        const r0 = Math.min(start.r, end.r);
        const c0 = Math.min(start.c, end.c);

        // Fit within grid
        const adjR0 = Math.min(r0, this.puzzle.rows - side);
        const adjC0 = Math.min(c0, this.puzzle.cols - side);
        if (adjR0 >= 0 && adjC0 >= 0) {
          this.placeSquare(adjR0, adjC0, side);
        }
        return;
      }

      // If clicked without dragging (Tap interaction):
      const r = start.r;
      const c = start.c;
      const existingIdx = this.getSquareAtCell(r, c);

      // Two-tap mode
      if (this.anchorStartCell) {
        const aR = this.anchorStartCell.r;
        const aC = this.anchorStartCell.c;
        this.anchorStartCell = null;

        if (aR === r && aC === c) {
          // Tapped same cell: deselect
          this.refreshBoardUI();
          return;
        }

        const tDr = Math.abs(r - aR);
        const tDc = Math.abs(c - aC);
        const side = Math.max(tDr, tDc) + 1;
        const r0 = Math.min(aR, r);
        const c0 = Math.min(aC, c);
        const adjR0 = Math.min(r0, this.puzzle.rows - side);
        const adjC0 = Math.min(c0, this.puzzle.cols - side);

        if (adjR0 >= 0 && adjC0 >= 0) {
          this.placeSquare(adjR0, adjC0, side);
        }
        return;
      }

      // If clicked on an existing square, select it
      if (existingIdx !== -1) {
        if (this.selectedSquareIdx === existingIdx) {
          // Double tap: erase!
          this.removeSquareAt(existingIdx);
        } else {
          this.selectedSquareIdx = existingIdx;
          sound.playClick();
          this.refreshBoardUI();
        }
        return;
      }

      // Otherwise, set as two-tap anchor start
      this.selectedSquareIdx = -1;
      this.anchorStartCell = { r, c };
      sound.playClick();
      this.refreshBoardUI();
    }

    handlePointerCancel() {
      this.isDragging = false;
      this.dragStart = null;
      this.dragCurrent = null;
      this.hidePreview();
    }

    updatePreview(r1, c1, r2, c2) {
      if (!this.previewEl || !this.gridEl || !this.puzzle) return;
      const dr = Math.abs(r2 - r1);
      const dc = Math.abs(c2 - c1);
      const side = Math.max(dr, dc) + 1;
      const r0 = Math.max(0, Math.min(Math.min(r1, r2), this.puzzle.rows - side));
      const c0 = Math.max(0, Math.min(Math.min(c1, c2), this.puzzle.cols - side));

      const firstCell = this.getCellEl(r0, c0);
      if (!firstCell) return;

      const cellRect = firstCell.getBoundingClientRect();
      const gridRect = this.gridEl.getBoundingClientRect();

      const zoom = parseFloat(getComputedStyle(document.querySelector('#jam-board-zoom-target') || document.body).getPropertyValue('--zoom-scale')) || 1;

      const left = (cellRect.left - gridRect.left) / zoom;
      const top = (cellRect.top - gridRect.top) / zoom;
      const sizePx = (cellRect.width / zoom) * side;

      this.previewEl.style.left = `${left}px`;
      this.previewEl.style.top = `${top}px`;
      this.previewEl.style.width = `${sizePx}px`;
      this.previewEl.style.height = `${sizePx}px`;

      if (this.previewBadgeEl) {
        this.previewBadgeEl.textContent = `${side}×${side}`;
      }
      this.previewEl.hidden = false;
    }

    hidePreview() {
      if (this.previewEl) this.previewEl.hidden = true;
    }

    placeSquare(r0, c0, s) {
      // Remove any squares that overlap with the new square
      const removed = [];
      const kept = [];
      this.placedSquares.forEach(sq => {
        const overlaps = !(
          r0 + s <= sq.r0 ||
          sq.r0 + sq.s <= r0 ||
          c0 + s <= sq.c0 ||
          sq.c0 + sq.s <= c0
        );
        if (overlaps) removed.push(sq);
        else kept.push(sq);
      });

      const colorIdx = (this.placedSquares.length + Math.floor(Math.random() * 8)) % 8;
      const newSquare = { r0, c0, s, colorIdx };
      kept.push(newSquare);

      // Record to undo stack
      this.history.push({
        type: 'place',
        newSquare,
        removedSquares: removed
      });
      this.redoStack = [];

      this.placedSquares = kept;
      this.selectedSquareIdx = -1;
      this.anchorStartCell = null;
      this.moves++;

      sound.playPlace(s);
      this.refreshBoardUI();
      this.updateStats();
      this.updateUndoRedo();
      this.saveState();

      // Check win condition
      this.checkWinCondition(false);
    }

    eraseSelectedSquare() {
      if (this.selectedSquareIdx < 0 || this.selectedSquareIdx >= this.placedSquares.length) {
        this.showToast('Tap or select a square first to erase it.', 'normal');
        return;
      }
      this.removeSquareAt(this.selectedSquareIdx);
    }

    removeSquareAt(idx) {
      const removed = this.placedSquares.splice(idx, 1)[0];
      this.history.push({
        type: 'remove',
        removedSquare: removed
      });
      this.redoStack = [];
      this.selectedSquareIdx = -1;
      this.moves++;

      sound.playErase();
      this.refreshBoardUI();
      this.updateStats();
      this.updateUndoRedo();
      this.saveState();
      this.showToast(`Erased ${removed.s}×${removed.s} square.`, 'normal');
    }

    undo() {
      if (this.history.length === 0 || this.isWon || this.isPaused) return;
      const action = this.history.pop();
      this.redoStack.push(action);

      if (action.type === 'place') {
        // Remove the placed square
        this.placedSquares = this.placedSquares.filter(s => s !== action.newSquare);
        // Restore removed squares
        if (action.removedSquares && action.removedSquares.length > 0) {
          this.placedSquares.push(...action.removedSquares);
        }
      } else if (action.type === 'remove') {
        // Re-add removed square
        this.placedSquares.push(action.removedSquare);
      }

      this.selectedSquareIdx = -1;
      this.anchorStartCell = null;
      this.moves++;

      sound.playClick();
      this.refreshBoardUI();
      this.updateStats();
      this.updateUndoRedo();
      this.saveState();
    }

    redo() {
      if (this.redoStack.length === 0 || this.isWon || this.isPaused) return;
      const action = this.redoStack.pop();
      this.history.push(action);

      if (action.type === 'place') {
        // Remove any overlapping with newSquare
        if (action.removedSquares && action.removedSquares.length > 0) {
          this.placedSquares = this.placedSquares.filter(s => !action.removedSquares.includes(s));
        }
        this.placedSquares.push(action.newSquare);
      } else if (action.type === 'remove') {
        this.placedSquares = this.placedSquares.filter(s => s !== action.removedSquare);
      }

      this.selectedSquareIdx = -1;
      this.anchorStartCell = null;
      this.moves++;

      sound.playClick();
      this.refreshBoardUI();
      this.updateStats();
      this.updateUndoRedo();
      this.saveState();
      this.checkWinCondition(false);
    }

    updateUndoRedo() {
      if (this.undoBtn) this.undoBtn.disabled = this.history.length === 0 || this.isWon;
      if (this.redoBtn) this.redoBtn.disabled = this.redoStack.length === 0 || this.isWon;
    }

    checkWinCondition(isManual = false) {
      if (this.isWon || !this.puzzle) return false;

      // Validate full board
      const res = this.validateCurrentBoard();
      if (res.valid) {
        this.handleVictory();
        return true;
      }

      if (isManual) {
        const partial = this.checkPartialBoard();
        this.showToast(partial.message, partial.type);
        if (partial.type === 'error') sound.playError();
        else sound.playClick();
      }
      return false;
    }

    validateCurrentBoard() {
      const rows = this.puzzle.rows;
      const cols = this.puzzle.cols;
      const board = Array.from({ length: rows }, () => new Array(cols).fill(-1));

      for (let i = 0; i < this.placedSquares.length; i++) {
        const sq = this.placedSquares[i];
        if (sq.r0 < 0 || sq.r0 + sq.s > rows || sq.c0 < 0 || sq.c0 + sq.s > cols) {
          return { valid: false, reason: 'Out of bounds' };
        }

        let clueVal = null;
        for (let r = sq.r0; r < sq.r0 + sq.s; r++) {
          for (let c = sq.c0; c < sq.c0 + sq.s; c++) {
            if (board[r][c] !== -1) return { valid: false, reason: 'Overlapping squares' };
            board[r][c] = i;

            const cVal = this.puzzle.clues[r][c];
            if (cVal !== null) {
              if (cVal !== sq.s) return { valid: false, reason: 'Clue mismatch' };
              if (clueVal === null) clueVal = cVal;
              else if (clueVal !== cVal) return { valid: false, reason: 'Multiple conflicting clues' };
            }
          }
        }
      }

      // Check all covered
      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          if (board[r][c] === -1) return { valid: false, reason: 'Uncovered cells' };
        }
      }

      // Check Tatami rule
      for (let y = 1; y < rows; y++) {
        for (let x = 1; x < cols; x++) {
          const id0 = board[y - 1][x - 1];
          const id1 = board[y - 1][x];
          const id2 = board[y][x - 1];
          const id3 = board[y][x];

          if (id0 !== id1 && id0 !== id2 && id0 !== id3 &&
              id1 !== id2 && id1 !== id3 && id2 !== id3) {
            return { valid: false, reason: 'Tatami 4-way corner violation' };
          }
        }
      }

      return { valid: true };
    }

    checkPartialBoard() {
      const rows = this.puzzle.rows;
      const cols = this.puzzle.cols;
      const board = Array.from({ length: rows }, () => new Array(cols).fill(-1));

      if (this.placedSquares.length === 0) {
        return { valid: true, message: 'Select and place squares to begin solving the puzzle.', type: 'normal' };
      }

      for (let i = 0; i < this.placedSquares.length; i++) {
        const sq = this.placedSquares[i];
        for (let r = sq.r0; r < sq.r0 + sq.s; r++) {
          for (let c = sq.c0; c < sq.c0 + sq.s; c++) {
            if (board[r][c] !== -1) {
              return { valid: false, message: `Overlapping squares detected at cell (${r + 1}, ${c + 1}).`, type: 'error' };
            }
            board[r][c] = i;

            const cVal = this.puzzle.clues[r][c];
            if (cVal !== null && cVal !== sq.s) {
              return {
                valid: false,
                message: `Clue ${cVal} at row ${r + 1}, column ${c + 1} requires a ${cVal}×${cVal} square, but is in a ${sq.s}×${sq.s} square.`,
                type: 'error'
              };
            }
          }
        }
      }

      // Check Tatami at filled intersections
      for (let y = 1; y < rows; y++) {
        for (let x = 1; x < cols; x++) {
          const id0 = board[y - 1][x - 1];
          const id1 = board[y - 1][x];
          const id2 = board[y][x - 1];
          const id3 = board[y][x];

          if (id0 !== -1 && id1 !== -1 && id2 !== -1 && id3 !== -1) {
            if (id0 !== id1 && id0 !== id2 && id0 !== id3 &&
                id1 !== id2 && id1 !== id3 && id2 !== id3) {
              return {
                valid: false,
                message: `Tatami violation: 4 squares meet at intersection (${y}, ${x}). Stagger square boundaries.`,
                type: 'error'
              };
            }
          }
        }
      }

      let covered = 0;
      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          if (board[r][c] !== -1) covered++;
        }
      }

      const total = rows * cols;
      if (covered === total) {
        return { valid: true, message: 'All cells covered and all rules satisfied! Congratulations!', type: 'success' };
      }

      return {
        valid: true,
        message: `Looking good! ${covered} of ${total} cells covered with valid squares. Keep going!`,
        type: 'success'
      };
    }

    giveHint() {
      if (this.isWon || this.isPaused || !this.puzzle) return;
      this.startTimer();

      // 1. Check if user placed an incorrect square (not in solution)
      let incorrectSquareIdx = -1;
      for (let i = 0; i < this.placedSquares.length; i++) {
        const sq = this.placedSquares[i];
        const inSolution = this.puzzle.solution.some(s => s.r0 === sq.r0 && s.c0 === sq.c0 && s.s === sq.s);
        if (!inSolution) {
          incorrectSquareIdx = i;
          break;
        }
      }

      if (incorrectSquareIdx !== -1) {
        this.selectedSquareIdx = incorrectSquareIdx;
        const badSq = this.placedSquares[incorrectSquareIdx];
        this.refreshBoardUI();
        this.showToast(`Hint: The ${badSq.s}×${badSq.s} square at row ${badSq.r0 + 1}, col ${badSq.c0 + 1} does not belong in the solution.`, 'error');
        sound.playError();
        this.hintsUsed++;
        return;
      }

      // 2. Find next required square from solution
      const missingSquare = this.puzzle.solution.find(solSq =>
        !this.placedSquares.some(ps => ps.r0 === solSq.r0 && ps.c0 === solSq.c0 && ps.s === solSq.s)
      );

      if (missingSquare) {
        this.placeSquare(missingSquare.r0, missingSquare.c0, missingSquare.s);
        
        // Find hint step message or explain why
        const hintIdx = Math.min(this.hintsUsed, this.puzzle.hintSteps.length - 1);
        const explanation = this.puzzle.hintSteps[hintIdx] || `Placed ${missingSquare.s}×${missingSquare.s} square at row ${missingSquare.r0 + 1}, column ${missingSquare.c0 + 1}.`;
        
        this.showToast(`Hint: ${explanation}`, 'success');
        sound.playHint();
        this.hintsUsed++;
        return;
      }

      this.showToast('All currently placed squares are correct! Complete the remaining spaces.', 'normal');
      sound.playClick();
    }

    manualCheck() {
      this.checkWinCondition(true);
    }

    promptShowSolution() {
      if (this.isWon || this.isPaused) return;
      if (this.solutionModalEl) this.solutionModalEl.hidden = false;
    }

    revealSolution() {
      if (this.solutionModalEl) this.solutionModalEl.hidden = true;
      if (!this.puzzle) return;

      this.isAssisted = true;
      this.stopTimer();

      this.placedSquares = this.puzzle.solution.map((sq, i) => ({
        ...sq,
        colorIdx: i % 8
      }));

      sound.playPlace(3);
      this.refreshBoardUI();
      this.updateStats();
      this.showToast('Solution revealed! Study the square layout and Tatami intersections.', 'normal');
    }

    handleVictory() {
      this.isWon = true;
      this.stopTimer();
      sound.playWin();

      // Personal Best
      const bestKey = `pf-square-jam-best-${this.currentDiff}`;
      let isNewPB = false;
      if (!this.isAssisted) {
        try {
          const savedBest = JSON.parse(localStorage.getItem(bestKey) || 'null');
          if (!savedBest || this.timerSeconds < savedBest.time || (this.timerSeconds === savedBest.time && this.moves < savedBest.moves)) {
            isNewPB = true;
            localStorage.setItem(bestKey, JSON.stringify({ time: this.timerSeconds, moves: this.moves }));
          }
        } catch (e) {}
      }

      // Record daily challenge completion
      if (this.currentDiff === 'daily') {
        const todayStr = new Date().toISOString().slice(0, 10);
        try {
          localStorage.setItem(`pf-square-jam-daily-solved-${todayStr}`, 'true');
        } catch (e) {}
      }

      // Show Victory Modal
      const diffLabel = this.currentDiff === 'daily' ? 'Daily Challenge' : this.currentDiff.charAt(0).toUpperCase() + this.currentDiff.slice(1);
      const diffEl = document.querySelector('#victory-diff-label');
      const timeEl = document.querySelector('#victory-time');
      const movesEl = document.querySelector('#victory-moves');
      const hintsEl = document.querySelector('#victory-hints');
      const pbBadge = document.querySelector('#jam-pb-badge');

      if (diffEl) diffEl.textContent = diffLabel;
      if (timeEl) timeEl.textContent = this.formatTime(this.timerSeconds);
      if (movesEl) movesEl.textContent = this.moves;
      if (hintsEl) hintsEl.textContent = this.hintsUsed;
      if (pbBadge) pbBadge.hidden = !isNewPB;

      if (this.victoryEl) this.victoryEl.hidden = false;
      this.updateBestDisplay();
      this.announce(`Puzzle Solved in ${this.formatTime(this.timerSeconds)} and ${this.moves} moves!`);
    }

    restartGame() {
      this.initBoard();
      sound.playClick();
      this.showToast('Puzzle restarted.', 'normal');
    }

    nextPuzzle() {
      const list = this.getDiffPuzzles(this.currentDiff);
      this.puzzleIndex = (this.puzzleIndex + 1) % list.length;
      this.puzzle = list[this.puzzleIndex];
      this.initBoard();
      sound.playClick();
      this.showToast(`Loaded ${this.puzzle.title}.`, 'normal');
    }

    togglePause() {
      if (this.isWon) return;
      this.isPaused = !this.isPaused;
      if (this.pausedEl) this.pausedEl.hidden = !this.isPaused;
      if (this.isPaused) {
        this.stopTimer();
      } else {
        this.startTimer();
      }
      sound.playClick();
    }

    startTimer() {
      if (this.isTimerRunning || this.isPaused || this.isWon) return;
      this.isTimerRunning = true;
      this.timerInterval = setInterval(() => {
        this.timerSeconds++;
        this.updateTimerDisplay();
      }, 1000);
    }

    stopTimer() {
      if (this.timerInterval) {
        clearInterval(this.timerInterval);
        this.timerInterval = null;
      }
      this.isTimerRunning = false;
    }

    updateTimerDisplay() {
      if (this.timerEl) this.timerEl.textContent = this.formatTime(this.timerSeconds);
    }

    updateStats() {
      if (this.movesEl) this.movesEl.textContent = this.moves;
      this.updateTimerDisplay();
    }

    formatTime(sec) {
      const m = Math.floor(sec / 60).toString().padStart(2, '0');
      const s = (sec % 60).toString().padStart(2, '0');
      return `${m}:${s}`;
    }

    updateBestDisplay() {
      const bestKey = `pf-square-jam-best-${this.currentDiff}`;
      try {
        const saved = JSON.parse(localStorage.getItem(bestKey) || 'null');
        if (saved && this.bestTimeEl) {
          this.bestTimeEl.textContent = this.formatTime(saved.time);
        } else if (this.bestTimeEl) {
          this.bestTimeEl.textContent = '—';
        }
      } catch (e) {
        if (this.bestTimeEl) this.bestTimeEl.textContent = '—';
      }
    }

    showToast(msg, type = 'normal') {
      if (!this.toastEl || !this.toastTextEl) return;
      this.toastTextEl.textContent = msg;
      this.toastEl.className = `jam-toast is-${type}`;
      this.toastEl.hidden = false;
      clearTimeout(this.toastTimer);
      this.toastTimer = setTimeout(() => {
        this.hideToast();
      }, 3500);
    }

    hideToast() {
      if (this.toastEl) this.toastEl.hidden = true;
    }

    announce(msg) {
      if (this.liveEl) this.liveEl.textContent = msg;
    }

    shareResult() {
      const timeStr = this.formatTime(this.timerSeconds);
      const diffLabel = this.currentDiff === 'daily' ? 'Daily Challenge' : this.currentDiff.toUpperCase();
      const text = `I solved Square Jam (${diffLabel}) on PuzzleFeels in ${timeStr} with ${this.moves} moves! 🟦\nhttps://puzzlefeels.com/square-jam-puzzle/`;

      if (navigator.clipboard) {
        navigator.clipboard.writeText(text).then(() => {
          if (this.shareStatusEl) {
            this.shareStatusEl.textContent = 'Copied to clipboard!';
            setTimeout(() => { if (this.shareStatusEl) this.shareStatusEl.textContent = ''; }, 2500);
          }
        }).catch(() => {});
      }
    }

    handleKeyDown(e) {
      if (this.isWon || this.isPaused) return;

      const active = document.activeElement;
      const isCell = active && active.classList.contains('jam-cell');

      if (isCell) {
        const r = parseInt(active.dataset.r, 10);
        const c = parseInt(active.dataset.c, 10);

        if (['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight'].includes(e.key)) {
          e.preventDefault();
          let nr = r;
          let nc = c;
          if (e.key === 'ArrowUp') nr = Math.max(0, r - 1);
          if (e.key === 'ArrowDown') nr = Math.min(this.puzzle.rows - 1, r + 1);
          if (e.key === 'ArrowLeft') nc = Math.max(0, c - 1);
          if (e.key === 'ArrowRight') nc = Math.min(this.puzzle.cols - 1, c + 1);
          const nextCell = this.getCellEl(nr, nc);
          if (nextCell) nextCell.focus();
          return;
        }

        // Direct size placement using numbers 1, 2, 3, 4, 5
        if (['1', '2', '3', '4', '5'].includes(e.key)) {
          e.preventDefault();
          const s = parseInt(e.key, 10);
          const adjR = Math.min(r, this.puzzle.rows - s);
          const adjC = Math.min(c, this.puzzle.cols - s);
          if (adjR >= 0 && adjC >= 0) {
            this.placeSquare(adjR, adjC, s);
          }
          return;
        }

        // Space / Enter
        if (e.key === ' ' || e.key === 'Enter') {
          e.preventDefault();
          const existingIdx = this.getSquareAtCell(r, c);
          if (existingIdx !== -1) {
            this.selectedSquareIdx = existingIdx;
            this.refreshBoardUI();
          } else {
            // Place 1x1 or complete two-tap
            if (this.anchorStartCell) {
              const aR = this.anchorStartCell.r;
              const aC = this.anchorStartCell.c;
              this.anchorStartCell = null;
              const side = Math.max(Math.abs(r - aR), Math.abs(c - aC)) + 1;
              const r0 = Math.min(aR, r);
              const c0 = Math.min(aC, c);
              const adjR0 = Math.min(r0, this.puzzle.rows - side);
              const adjC0 = Math.min(c0, this.puzzle.cols - side);
              if (adjR0 >= 0 && adjC0 >= 0) this.placeSquare(adjR0, adjC0, side);
            } else {
              this.anchorStartCell = { r, c };
              this.refreshBoardUI();
            }
          }
          return;
        }

        // Delete / Backspace
        if (e.key === 'Delete' || e.key === 'Backspace') {
          e.preventDefault();
          const existingIdx = this.getSquareAtCell(r, c);
          if (existingIdx !== -1) {
            this.removeSquareAt(existingIdx);
          }
          return;
        }
      }

      // Undo / Redo
      if (e.key === 'u' || e.key === 'U') {
        e.preventDefault();
        this.undo();
      } else if (e.key === 'r' || e.key === 'R') {
        e.preventDefault();
        this.redo();
      }
    }

    saveState() {
      try {
        const state = {
          puzzleId: this.puzzle.id,
          placedSquares: this.placedSquares,
          moves: this.moves,
          timerSeconds: this.timerSeconds,
          soundEnabled: sound.enabled
        };
        localStorage.setItem(this.storageKey, JSON.stringify(state));
      } catch (e) {}
    }

    loadState() {
      try {
        return JSON.parse(localStorage.getItem(this.storageKey) || 'null');
      } catch (e) {
        return null;
      }
    }

    loadSettings() {
      try {
        const saved = JSON.parse(localStorage.getItem(this.storageKey) || 'null');
        if (saved && typeof saved.soundEnabled === 'boolean') {
          sound.enabled = saved.soundEnabled;
        }
      } catch (e) {}
      this.updateSoundButton();
    }
  }

  // Client daily puzzle selector helper
  function getDailyPuzzleClient(puzzles, dateStr) {
    let hash = 0;
    for (let i = 0; i < dateStr.length; i++) {
      hash = (hash << 5) - hash + dateStr.charCodeAt(i);
      hash |= 0;
    }
    const candidates = puzzles.filter(p => p.difficulty === 'medium');
    const index = Math.abs(hash) % (candidates.length || puzzles.length);
    return (candidates[index] || puzzles[0]);
  }

  // Bootstrap when DOM ready
  document.addEventListener('DOMContentLoaded', () => {
    new SquareJamGame(rawPuzzles);
  });
</script>
