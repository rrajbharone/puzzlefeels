  /* Tighter game proportions; the puzzle itself retains a readable minimum cell size. */
  .picross-intro{padding:24px 0 12px}
  .picross-intro h1{font-size:clamp(30px,3vw,36px);letter-spacing:-.04em;margin:8px 0}
  .picross-intro p{font-size:14px;line-height:1.55}
  .picross-shell{max-width:820px;padding:20px;margin-bottom:42px}
  .picross-header-bar {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 12px;
    width: 100%;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }
  .picross-difficulties-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  .picross-diff-btn {
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--paper);
    color: var(--ink);
    padding: 8px 14px;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
    transition: all .16s ease;
  }
  .picross-diff-btn strong { font-size: 13px; font-weight: 700; }
  .picross-diff-btn span { font-size: 10px; color: var(--muted); }
  .picross-diff-btn:hover { border-color: var(--blue); }
  .picross-diff-btn.is-active, .picross-diff-btn.is-selected {
    background: #edf2ff;
    border-color: var(--blue);
    color: var(--blue);
    box-shadow: 0 4px 12px rgba(49, 94, 232, 0.12);
  }
  .picross-diff-btn.is-active span, .picross-diff-btn.is-selected span { color: var(--blue); opacity: .85; }
  .picross-shell h2{font-size:22px;margin:10px 0 6px}
  .picross-game-top h2{font-size:21px;margin-top:7px}
  .picross-stats{margin:10px 0;gap:10px}
  .picross-tools{margin:8px 0 4px;gap:10px}
  .picross-mark-modes button{min-height:40px;padding:8px 13px}
  .picross-instruction{font-size:12px;line-height:1.45;margin:7px 0}
  .picross-board-scroll{display:flex;justify-content:center;padding:3px 2px 6px}
  .picross-board{--picross-cell-size:clamp(28px,calc(2.5vw + 20px),36px);width:max-content;aspect-ratio:auto;grid-template-columns:34px repeat(var(--picross-size),var(--picross-cell-size));grid-template-rows:36px repeat(var(--picross-size),var(--picross-cell-size));margin:0 auto}
  .picross-cell{width:var(--picross-cell-size);height:var(--picross-cell-size);aspect-ratio:auto}
  .picross-row-clue{font-size:11px;padding-right:5px}
  .picross-column-clue{font-size:10px}
  .picross-empty-mark{font-size:16px}
  .picross-board-meta{margin:5px 0 8px}
  .picross-actions{gap:8px}
  .picross-actions .btn{min-height:40px}
  .picross-play-area{display:grid;grid-template-columns:minmax(0,1fr) 154px;gap:18px;align-items:center}
  .picross-board-column{min-width:0}
  .picross-side-controls{display:grid;gap:12px;align-content:center}
  .picross-check-label{display:flex;align-items:center;gap:8px;font-size:13px;font-weight:600;color:var(--ink)}
  .picross-check-label input{width:17px;height:17px;accent-color:var(--blue)}
  .picross-side-controls .picross-actions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:7px}
  .picross-side-controls .picross-actions .btn{min-width:0;min-height:40px;padding-inline:5px;font-size:12px}
  .picross-side-controls .picross-actions .picross-hint-button,.picross-side-controls .picross-actions button:nth-child(n+4){grid-column:1/-1}
  .picross-control-note{font-size:11px;line-height:1.45;color:var(--muted);margin:0}
  .picross-live{min-height:1.2em;margin:8px 0 0;font-size:12px}
  .wrap.game-article-content.picross-article{width:min(780px,calc(100% - 40px));margin-bottom:48px;font-size:16px;line-height:1.72}
  .wrap.game-article-content.picross-article h2{font-size:24px;line-height:1.25;letter-spacing:-.025em;margin:36px 0 12px;text-align:left}
  .wrap.game-article-content.picross-article h2:first-child{margin-top:0}
  .wrap.game-article-content.picross-article > p{font-size:16px;line-height:1.72;margin:0 0 14px}
  .wrap.game-article-content.picross-article ol,.wrap.game-article-content.picross-article ul{padding-inline-start:24px;margin:0 0 16px}
  .wrap.game-article-content.picross-article li{font-size:16px;line-height:1.65;margin:0 0 7px;padding-inline-start:2px}
  .picross-example{display:flex;align-items:center;gap:18px;padding:14px 18px;margin:14px 0 18px;background:var(--wash);border:1px solid var(--line);border-radius:14px}
  .picross-example pre{font:700 17px/1.4 ui-monospace,SFMono-Regular,Consolas,monospace;letter-spacing:.12em;margin:0;color:var(--ink)}
  .picross-example figcaption{font-size:13px;line-height:1.55;color:var(--muted);max-width:320px}
  .picross-article a{color:var(--blue);font-weight:600;text-decoration:underline;text-underline-offset:3px}
  html[data-theme="dark"] .picross-example{background:#111b36;border-color:#293858}
  @media(max-width:640px){
    .picross-intro{padding:20px 0 10px}
    .picross-intro h1{font-size:30px}
    .picross-shell{padding:16px;margin-bottom:34px}
    .picross-shell h2{font-size:20px}
    .picross-game-top{gap:8px}
    .picross-game-top h2{font-size:19px}
    .picross-top-actions{gap:8px}
    .picross-stats{grid-template-columns:74px 1fr;gap:8px}
    .picross-progress{grid-column:1/-1}
    .picross-tools{align-items:flex-start}
    .picross-mode-help{flex:1 1 150px;line-height:1.45}
    .picross-play-area{grid-template-columns:minmax(0,1fr);gap:10px}
    .picross-side-controls{grid-template-columns:1fr;gap:8px}
    .picross-side-controls .picross-actions{grid-template-columns:repeat(2,minmax(0,1fr))}
    .picross-side-controls .picross-actions .picross-hint-button{grid-column:auto}
    .picross-side-controls .picross-actions button:nth-child(n+4){grid-column:auto}
    .picross-control-note{display:none}
    .picross-board-scroll{justify-content:flex-start}
    .picross-board{margin-inline:auto}
    .picross-actions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr))}
    .picross-actions .btn{min-height:42px;padding-inline:8px;font-size:13px;white-space:normal;line-height:1.2}
    .wrap.game-article-content.picross-article{width:calc(100% - 32px);margin-bottom:36px;font-size:15px}
    .wrap.game-article-content.picross-article h2{font-size:21px;margin-top:28px}
    .wrap.game-article-content.picross-article > p,.wrap.game-article-content.picross-article li{font-size:15px;line-height:1.68}
    .picross-example{gap:12px;padding:12px;margin-inline:0}
    .picross-example pre{font-size:15px}
    .picross-example figcaption{font-size:12px}
  }
  @media(max-width:360px){
    .picross-shell{padding:13px}
    .picross-board{--picross-cell-size:28px;grid-template-columns:34px repeat(var(--picross-size),var(--picross-cell-size))}
    .picross-row-clue{font-size:10px;padding-right:4px}
    .picross-column-clue{font-size:9px}
    .picross-actions .btn{font-size:12px;padding-inline:5px}
  }
  @media(prefers-reduced-motion:reduce){.picross-page *{scroll-behavior:auto!important;transition:none!important}}

  /* Related Games Section */
  .related-games-section {
    padding: 56px 0 36px;
    border-top: 1px solid var(--line);
    margin-top: 48px;
  }
  .related-games-head {
    max-width: 620px;
    margin: 0 auto 36px;
    text-align: center;
  }
  .related-games-head h2 {
    font-size: clamp(1.8rem, 3.2vw, 2.4rem);
    margin: 10px 0 12px;
    letter-spacing: -.03em;
  }
  .related-games-head p {
    font-size: 15px;
    line-height: 1.65;
    margin: 0 auto;
  }
  .related-games-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
    align-items: stretch;
  }
  .related-card {
    min-width: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: 20px;
    color: var(--ink);
    text-decoration: none;
    transition: transform .18s ease, border-color .18s ease, box-shadow .18s ease;
  }
  .related-card:hover {
    transform: translateY(-3px);
    border-color: #cfd8ef;
    box-shadow: 0 16px 38px rgba(23, 35, 59, 0.1);
  }
  .related-card:focus-visible {
    outline: 3px solid #93abff;
    outline-offset: 4px;
  }
  .related-visual {
    height: 180px;
    flex: none;
    position: relative;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: linear-gradient(145deg, #eaf0ff, #f6f3ff);
  }
  .related-orbit {
    position: absolute;
    width: 150px;
    height: 150px;
    border: 1px dashed #cad5fa;
    border-radius: 50%;
  }
  .related-icon {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(2, 54px);
    gap: 8px;
    transform: rotate(-7deg);
  }
  .related-icon span {
    width: 54px;
    height: 54px;
    display: grid;
    place-items: center;
    border-radius: 14px;
    background: white;
    color: var(--blue);
    font-size: 19px;
    font-weight: 800;
    box-shadow: 0 8px 20px rgba(41, 62, 139, 0.1);
  }
  .sequence-icon span:nth-child(2) { background: #315ee8; color: #fff; }
  .sequence-icon span:nth-child(3) { background: #dff5ef; color: #16825d; }
  .sequence-icon span:nth-child(4) { background: #fff1d9; color: #c28b2f; }
  .flood-icon span { border-radius: 14px; background: #ef6b67; }
  .flood-icon span:nth-child(2) { background: #efa347; }
  .flood-icon span:nth-child(3) { background: #48ad83; }
  .flood-icon span:nth-child(4) { background: #5187dc; }
  .picross-icon span:nth-child(1), .picross-icon span:nth-child(4) { background: #315ee8; color: #fff; }
  .picross-icon span:nth-child(2), .picross-icon span:nth-child(3) { background: #edf2ff; color: #315ee8; }
  .slide-icon span:nth-child(1) { background: #315ee8; color: #fff; }
  .slide-icon span:nth-child(2) { background: #edf2ff; color: #315ee8; }
  .slide-icon span:nth-child(3) { background: #eaf7f2; color: #16825d; }
  .slide-icon .slide-empty { background: transparent; border: 2px dashed #b9c8f5; box-shadow: none; }
  .ladder-visual { background: linear-gradient(145deg, #eaf0ff, #f3eaff); }
  .ladder-icon span:nth-child(1) { background: #315ee8; color: #fff; }
  .ladder-icon span:nth-child(2) { background: #e5eaff; color: #315ee8; }
  .ladder-icon span:nth-child(3) { background: #eaf7f2; color: #16825d; }
  .ladder-icon span:nth-child(4) { background: #fff1d9; color: #c28b2f; }

  .related-card-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    padding: 20px 22px 22px;
  }
  .related-labels {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 2px;
  }
