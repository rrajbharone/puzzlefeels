---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FaqList from '../components/FaqList.astro';
import ZoomControl from '../components/ZoomControl.astro';

const title = 'Picross Game Online – Play Free Nonogram Puzzles | PuzzleFeels';
const description = 'Play Picross Game Online for free. Use row and column clues to reveal pixel-art pictures, with beginner, medium, hard, and a daily nonogram puzzle.';
const faqs = [
  { question: 'What is Picross?', answer: 'Picross, also called Nonogram, is a logic puzzle where numbered clues show the runs of filled cells in each row and column. Use both sets of clues to uncover a picture.' },
  { question: 'How do I play this Picross game?', answer: 'Choose Fill or Mark empty, then select cells on the board. A clue such as 3 1 means a run of three filled cells followed by a separate run of one, with at least one empty cell between them.' },
  { question: 'What do the numbers beside a row or column mean?', answer: 'They list the lengths of consecutive filled-cell runs in order. Column clues are displayed from top to bottom.' },
  { question: 'Do I have to mark every empty square?', answer: 'Yes. To complete a puzzle, every cell must be marked filled or empty, and all marks must match the solution.' },
  { question: 'What happens if I make a mistake?', answer: 'You can enable Check mistakes to highlight incorrect marks. Mistakes do not end the puzzle, and you can change a mark or use Undo.' },
  { question: 'Can I undo or redo a move?', answer: 'Yes. Use Undo and Redo to move through your recent board changes. Your current board and history are saved on this device.' },
  { question: 'How does the Hint button work?', answer: 'Hint marks a cell that follows from the current row or column clue patterns when one is logically forced. If the visible marks do not force a cell, it reveals one solution cell. Hints reduce the final score.' },
  { question: 'How is my Picross score calculated?', answer: 'The score starts with a difficulty-based amount, adds a time bonus up to the level target, and subtracts a fixed amount for each hint. The page explains the exact values.' },
  { question: 'Does Picross save my progress?', answer: 'An unfinished standard or daily puzzle is saved in local browser storage on this device, including marks, timer, selected mode, and undo history. Clearing browser storage removes it.' },
  { question: 'Is there a daily Picross challenge?', answer: 'Yes. The daily board is selected from the date in UTC, so everyone gets the same puzzle on that date. Completion is recorded locally on your device.' },
  { question: 'Can I play Picross on my phone?', answer: 'Yes. The board and controls adapt to smaller screens, and cells can be operated with touch. You can switch between Fill and Mark empty modes.' },
  { question: 'Is this Picross game free?', answer: 'Yes. The puzzles on PuzzleFeels are free to play in your browser and do not require an account or download.' },
  { question: 'What is the difference between Beginner, Medium, and Hard?', answer: 'Beginner puzzles use 5-row boards, including one 5-by-10 board. Medium puzzles are 10 by 10. Hard puzzles are 15 by 15.' },
  { question: 'Can I pause and continue later?', answer: 'Yes. Pause stops the timer, and your progress is saved. Continue returns to the saved board.' },
  { question: 'Can I share my result?', answer: 'After solving a puzzle, use Share Result. Supported browsers open their share sheet; other browsers copy a result message to the clipboard when available.' },
];
const gameSchema = { '@context': 'https://schema.org', '@type': 'VideoGame', name: 'Picross Game Online', url: 'https://puzzlefeels.com/picross-game-online/', description, gamePlatform: 'Web browser', applicationCategory: 'Game', operatingSystem: 'Any', offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' } };
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://puzzlefeels.com/' },
    { '@type': 'ListItem', position: 2, name: 'Games', item: 'https://puzzlefeels.com/games/' },
    { '@type': 'ListItem', position: 3, name: 'Picross Game Online', item: 'https://puzzlefeels.com/picross-game-online/' }
  ]
};
