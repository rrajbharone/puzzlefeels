<script>
  import {
    BINAIRO_PUZZLES,
    getDailyBinairoPuzzle,
    getBinairoLogicalHint,
    validateBinairoBoard,
    type BinairoPuzzle
  } from '../data/binairoPuzzles';

  interface GameState {
    difficulty: 'easy' | 'medium' | 'hard' | 'daily';
    puzzleId: string;
    board: (0 | 1 | null)[][];
    moves: number;
    timerSeconds: number;
    hintsUsed: number;
    isComplete: boolean;
  }

  interface MoveAction {
    r: number;
    c: number;
    oldVal: 0 | 1 | null;
    newVal: 0 | 1 | null;
  }

  const STORAGE_KEY = 'puzzlefeels_binairo_state_v1';
  const SOUND_KEY = 'puzzlefeels_binairo_sound_v1';
  const BEST_TIMES_KEY = 'puzzlefeels_binairo_best_times_v1';

  class BinairoGame {
    puzzle: BinairoPuzzle | null = null;
    currentBoard: (0 | 1 | null)[][] = [];
    selectedCell: { r: number; c: number } | null = null;

    difficulty: 'easy' | 'medium' | 'hard' | 'daily' = 'easy';
    puzzleIndex = 0;
    moves = 0;
    timerSeconds = 0;
    hintsUsed = 0;
    isPaused = false;
    isComplete = false;
    soundEnabled = true;

    timerInterval: any = null;
    undoStack: MoveAction[] = [];
    redoStack: MoveAction[] = [];

    // DOM Elements
    gridEl!: HTMLElement;
    timerEl!: HTMLElement;
    movesEl!: HTMLElement;
    filledEl!: HTMLElement;
    bestTimeEl!: HTMLElement;
    toastEl!: HTMLElement;
    toastTextEl!: HTMLElement;
    pausedModalEl!: HTMLElement;
    victoryModalEl!: HTMLElement;
    undoBtn!: HTMLButtonElement;
    redoBtn!: HTMLButtonElement;
    soundBtn!: HTMLElement;
    liveEl!: HTMLElement;

    constructor() {
      this.initElements();
      this.initSound();
      this.initEventListeners();
      this.loadOrCreateGame();
    }

    initElements() {
      this.gridEl = document.querySelector('#binairo-grid')!;
      this.timerEl = document.querySelector('#binairo-timer')!;
      this.movesEl = document.querySelector('#binairo-moves')!;
      this.filledEl = document.querySelector('#binairo-filled')!;
      this.bestTimeEl = document.querySelector('#binairo-best-time')!;
      this.toastEl = document.querySelector('#binairo-toast')!;
      this.toastTextEl = document.querySelector('#binairo-toast-text')!;
      this.pausedModalEl = document.querySelector('#binairo-paused')!;
      this.victoryModalEl = document.querySelector('#binairo-victory')!;
      this.undoBtn = document.querySelector('#binairo-undo-btn')!;
      this.redoBtn = document.querySelector('#binairo-redo-btn')!;
      this.soundBtn = document.querySelector('#binairo-sound-toggle')!;
      this.liveEl = document.querySelector('#binairo-live')!;
    }

    initSound() {
      const saved = localStorage.getItem(SOUND_KEY);
      this.soundEnabled = saved !== 'false';
      this.updateSoundButton();
    }

    updateSoundButton() {
      const label = this.soundBtn.querySelector('.sound-status-label');
      if (label) label.textContent = this.soundEnabled ? 'Sound On' : 'Sound Off';
      this.soundBtn.setAttribute('aria-pressed', String(this.soundEnabled));
    }

    playSound(type: 'click' | 'place' | 'clear' | 'hint' | 'error' | 'victory') {
      if (!this.soundEnabled) return;
      try {
        const AudioContextClass = window.AudioContext || (window as any).webkitAudioContext;
        if (!AudioContextClass) return;
        const ctx = new AudioContextClass();
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.connect(gain);
        gain.connect(ctx.destination);

        const now = ctx.currentTime;
        if (type === 'click') {
          osc.frequency.setValueAtTime(420, now);
          gain.gain.setValueAtTime(0.08, now);
          gain.gain.exponentialRampToValueAtTime(0.001, now + 0.04);
          osc.start(now);
          osc.stop(now + 0.04);
        } else if (type === 'place') {
          osc.frequency.setValueAtTime(540, now);
          gain.gain.setValueAtTime(0.12, now);
          gain.gain.exponentialRampToValueAtTime(0.001, now + 0.08);
          osc.start(now);
          osc.stop(now + 0.08);
        } else if (type === 'clear') {
          osc.frequency.setValueAtTime(280, now);
          gain.gain.setValueAtTime(0.1, now);
          gain.gain.exponentialRampToValueAtTime(0.001, now + 0.06);
          osc.start(now);
          osc.stop(now + 0.06);
        } else if (type === 'hint') {
          osc.type = 'triangle';
          osc.frequency.setValueAtTime(520, now);
          osc.frequency.exponentialRampToValueAtTime(780, now + 0.18);
          gain.gain.setValueAtTime(0.15, now);
          gain.gain.exponentialRampToValueAtTime(0.001, now + 0.2);
          osc.start(now);
          osc.stop(now + 0.2);
        } else if (type === 'error') {
          osc.type = 'sawtooth';
          osc.frequency.setValueAtTime(160, now);
          gain.gain.setValueAtTime(0.18, now);
          gain.gain.exponentialRampToValueAtTime(0.001, now + 0.25);
          osc.start(now);
          osc.stop(now + 0.25);
        } else if (type === 'victory') {
          osc.type = 'sine';
          const notes = [440, 554.37, 659.25, 880];
          notes.forEach((freq, idx) => {
            const oscN = ctx.createOscillator();
            const gainN = ctx.createGain();
            oscN.connect(gainN);
            gainN.connect(ctx.destination);
            oscN.frequency.setValueAtTime(freq, now + idx * 0.1);
            gainN.gain.setValueAtTime(0.18, now + idx * 0.1);
            gainN.gain.exponentialRampToValueAtTime(0.001, now + idx * 0.1 + 0.35);
            oscN.start(now + idx * 0.1);
            oscN.stop(now + idx * 0.1 + 0.35);
          });
        }
      } catch (e) {}
    }

    loadOrCreateGame() {
      // Check for URL ?daily=today
      const urlParams = new URLSearchParams(window.location.search);
      const isDailyUrl = urlParams.get('daily') === 'today';

      if (isDailyUrl) {
        this.difficulty = 'daily';
      }

      const savedJson = localStorage.getItem(STORAGE_KEY);
      if (savedJson && !isDailyUrl) {
        try {
          const saved: GameState = JSON.parse(savedJson);
          this.difficulty = saved.difficulty || 'easy';
          const puzzle = this.findPuzzleById(saved.puzzleId);
          if (puzzle) {
            this.puzzle = puzzle;
            this.currentBoard = saved.board;
            this.moves = saved.moves || 0;
            this.timerSeconds = saved.timerSeconds || 0;
            this.hintsUsed = saved.hintsUsed || 0;
            this.isComplete = saved.isComplete || false;
            this.updateDifficultyTabs();
            this.renderBoard();
            this.updateStats();
            this.updateBestTime();
            if (!this.isComplete) this.startTimer();
            return;
          }
        } catch (e) {}
      }

      this.startNewPuzzle(this.difficulty, 0);
    }

    findPuzzleById(id: string): BinairoPuzzle | null {
      if (id.startsWith('daily-')) return getDailyBinairoPuzzle();
      return BINAIRO_PUZZLES.find(p => p.id === id) || null;
    }

    startNewPuzzle(difficulty: 'easy' | 'medium' | 'hard' | 'daily', indexOffset = 0) {
      this.difficulty = difficulty;
      this.updateDifficultyTabs();

      if (difficulty === 'daily') {
        this.puzzle = getDailyBinairoPuzzle();
      } else {
        const pool = BINAIRO_PUZZLES.filter(p => p.difficulty === difficulty);
        this.puzzleIndex = (this.puzzleIndex + indexOffset + pool.length) % pool.length;
        this.puzzle = pool[this.puzzleIndex];
      }

      // Initialize board from clues
      this.currentBoard = this.puzzle.clues.map(r => [...r]);
      this.selectedCell = null;
      this.moves = 0;
      this.timerSeconds = 0;
      this.hintsUsed = 0;
      this.isComplete = false;
      this.undoStack = [];
      this.redoStack = [];

      this.stopTimer();
      this.startTimer();
      this.renderBoard();
      this.updateStats();
      this.updateBestTime();
      this.updateUndoRedo();
      this.pausedModalEl.hidden = true;
      this.victoryModalEl.hidden = true;
      this.hideToast();
      this.saveState();
    }

    updateDifficultyTabs() {
      document.querySelectorAll('.binairo-diff-btn').forEach(btn => {
        const diff = btn.getAttribute('data-difficulty');
        const isActive = diff === this.difficulty;
        btn.classList.toggle('is-active', isActive);
        btn.setAttribute('aria-selected', String(isActive));
      });
    }

    startTimer() {
      this.stopTimer();
      this.timerInterval = setInterval(() => {
        if (!this.isPaused && !this.isComplete) {
          this.timerSeconds++;
          this.updateTimerDisplay();
          if (this.timerSeconds % 5 === 0) this.saveState();
        }
      }, 1000);
    }

    stopTimer() {
      if (this.timerInterval) {
        clearInterval(this.timerInterval);
        this.timerInterval = null;
      }
    }

    updateTimerDisplay() {
      const mins = Math.floor(this.timerSeconds / 60);
      const secs = this.timerSeconds % 60;
      this.timerEl.textContent = `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
    }

    renderBoard() {
      if (!this.puzzle) return;
      const N = this.puzzle.size;
      this.gridEl.style.setProperty('--grid-cols', String(N));
      this.gridEl.style.setProperty('--grid-rows', String(N));
      this.gridEl.innerHTML = '';

      for (let r = 0; r < N; r++) {
        for (let c = 0; c < N; c++) {
          const isGiven = this.puzzle.clues[r][c] !== null;
          const val = this.currentBoard[r][c];

          const cell = document.createElement('button');
          cell.type = 'button';
          cell.className = 'binairo-cell';
          cell.setAttribute('data-r', String(r));
          cell.setAttribute('data-c', String(c));
          cell.setAttribute('role', 'gridcell');

          if (isGiven) {
            cell.classList.add('is-given');
            cell.setAttribute('aria-label', `Row ${r + 1}, Column ${c + 1}: given ${val}`);
            cell.setAttribute('tabindex', '-1');
          } else {
            cell.setAttribute('aria-label', `Row ${r + 1}, Column ${c + 1}: ${val === null ? 'empty' : val}`);
            cell.setAttribute('tabindex', '0');
          }

          if (this.selectedCell && this.selectedCell.r === r && this.selectedCell.c === c) {
            cell.classList.add('is-selected');
          }

          if (val !== null) {
            const token = document.createElement('span');
            token.className = `binairo-token token-${val}`;
            token.textContent = String(val);
            cell.appendChild(token);
          }

          cell.addEventListener('click', (e) => this.handleCellClick(r, c, e));
          cell.addEventListener('contextmenu', (e) => {
            e.preventDefault();
            this.handleCellRightClick(r, c);
          });

          this.gridEl.appendChild(cell);
        }
      }
    }

    handleCellClick(r: number, c: number, event?: MouseEvent) {
      if (this.isComplete || !this.puzzle) return;
      this.selectCell(r, c);

      // If cell is given clue, cannot cycle
      if (this.puzzle.clues[r][c] !== null) {
        this.playSound('click');
        return;
      }

      // Cycle value: null -> 0 -> 1 -> null
      const current = this.currentBoard[r][c];
      const next: 0 | 1 | null = current === null ? 0 : current === 0 ? 1 : null;
      this.setCellValue(r, c, next);
    }

    handleCellRightClick(r: number, c: number) {
      if (this.isComplete || !this.puzzle) return;
      this.selectCell(r, c);

      if (this.puzzle.clues[r][c] !== null) return;

      // Reverse cycle: null -> 1 -> 0 -> null
      const current = this.currentBoard[r][c];
      const prev: 0 | 1 | null = current === null ? 1 : current === 1 ? 0 : null;
      this.setCellValue(r, c, prev);
    }

    selectCell(r: number, c: number) {
      this.selectedCell = { r, c };
      this.gridEl.querySelectorAll('.binairo-cell').forEach(el => {
        const cellR = Number(el.getAttribute('data-r'));
        const cellC = Number(el.getAttribute('data-c'));
        el.classList.toggle('is-selected', cellR === r && cellC === c);
      });
    }

    setCellValue(r: number, c: number, newVal: 0 | 1 | null, recordHistory = true) {
      if (!this.puzzle || this.puzzle.clues[r][c] !== null) return;
      const oldVal = this.currentBoard[r][c];
      if (oldVal === newVal) return;

      if (recordHistory) {
        this.undoStack.push({ r, c, oldVal, newVal });
        this.redoStack = [];
        this.moves++;
      }

      this.currentBoard[r][c] = newVal;
      this.playSound(newVal === null ? 'clear' : 'place');

      this.updateCellDom(r, c);
      this.updateStats();
      this.updateUndoRedo();
      this.saveState();

      // Check for victory
      this.checkAutoVictory();
    }

    updateCellDom(r: number, c: number) {
      const cell = this.gridEl.querySelector(`.binairo-cell[data-r="${r}"][data-c="${c}"]`);
      if (!cell) return;
      const val = this.currentBoard[r][c];
      cell.innerHTML = '';
      cell.classList.remove('is-error-highlight', 'is-hint-highlight');

      if (val !== null) {
        const token = document.createElement('span');
        token.className = `binairo-token token-${val}`;
        token.textContent = String(val);
        cell.appendChild(token);
        cell.setAttribute('aria-label', `Row ${r + 1}, Column ${c + 1}: ${val}`);
      } else {
        cell.setAttribute('aria-label', `Row ${r + 1}, Column ${c + 1}: empty`);
      }
    }

    undo() {
      if (this.undoStack.length === 0 || this.isComplete) return;
      const action = this.undoStack.pop()!;
      this.redoStack.push(action);
      this.currentBoard[action.r][action.c] = action.oldVal;
      this.updateCellDom(action.r, action.c);
      this.selectCell(action.r, action.c);
      this.updateStats();
      this.updateUndoRedo();
      this.saveState();
      this.playSound('click');
    }

    redo() {
      if (this.redoStack.length === 0 || this.isComplete) return;
      const action = this.redoStack.pop()!;
      this.undoStack.push(action);
      this.currentBoard[action.r][action.c] = action.newVal;
      this.updateCellDom(action.r, action.c);
      this.selectCell(action.r, action.c);
      this.updateStats();
      this.updateUndoRedo();
      this.saveState();
      this.playSound('click');
    }

    updateUndoRedo() {
      this.undoBtn.disabled = this.undoStack.length === 0 || this.isComplete;
      this.redoBtn.disabled = this.redoStack.length === 0 || this.isComplete;
    }

    provideHint() {
      if (this.isComplete || !this.puzzle) return;
      const hint = getBinairoLogicalHint(this.currentBoard, this.puzzle.solution);
      if (!hint) {
        this.showToast('No obvious deduction found. All lines are in order!', 'success');
        return;
      }

      this.hintsUsed++;
      this.playSound('hint');
      this.selectCell(hint.r, hint.c);

      const cell = this.gridEl.querySelector(`.binairo-cell[data-r="${hint.r}"][data-c="${hint.c}"]`);
      if (cell) {
        cell.classList.add(hint.type === 'error' ? 'is-error-highlight' : 'is-hint-highlight');
        setTimeout(() => {
          cell.classList.remove('is-error-highlight', 'is-hint-highlight');
        }, 3000);
      }

      if (hint.type === 'error') {
        this.showToast(hint.message, 'error');
      } else {
        this.showToast(hint.message, 'success');
        if (hint.val !== undefined) {
          this.setCellValue(hint.r, hint.c, hint.val);
        }
      }
    }

    checkProgress() {
      if (!this.puzzle) return;
      const validation = validateBinairoBoard(this.currentBoard);

      if (!validation.isValid && validation.violations) {
        this.playSound('error');
        validation.violations.forEach(({ r, c }) => {
          const el = this.gridEl.querySelector(`.binairo-cell[data-r="${r}"][data-c="${c}"]`);
          if (el) {
            el.classList.add('is-error-highlight');
            setTimeout(() => el.classList.remove('is-error-highlight'), 3000);
          }
        });
        this.showToast('Rule violation detected! Highlighted cells violate trio, balance, or uniqueness rules.', 'error');
      } else {
        this.playSound('click');
        let filled = 0;
        const total = this.puzzle.size * this.puzzle.size;
        for (let r = 0; r < this.puzzle.size; r++) {
          for (let c = 0; c < this.puzzle.size; c++) {
            if (this.currentBoard[r][c] !== null) filled++;
          }
        }
        if (filled === total) {
          this.checkAutoVictory();
        } else {
          this.showToast(`All ${filled} placed numbers follow the rules so far! ${total - filled} cells remaining.`, 'success');
        }
      }
    }

    clearPlayerEntries() {
      if (this.isComplete || !this.puzzle) return;
      if (!confirm('Clear all your entered numbers and reset to original clues?')) return;

      this.currentBoard = this.puzzle.clues.map(r => [...r]);
      this.undoStack = [];
      this.redoStack = [];
      this.renderBoard();
      this.updateStats();
      this.updateUndoRedo();
      this.saveState();
      this.playSound('clear');
      this.showToast('Player entries cleared.', 'success');
    }

    checkAutoVictory() {
      if (!this.puzzle || this.isComplete) return;
      const validation = validateBinairoBoard(this.currentBoard);
      if (validation.isValid && validation.isComplete) {
        this.triggerVictory();
      }
    }

    triggerVictory() {
      this.isComplete = true;
      this.stopTimer();
      this.playSound('victory');
      this.saveState();

      // Check Personal Best
      const isPB = this.recordBestTime();

      // Populate victory modal
      const diffLabelEl = document.querySelector('#victory-diff-label');
      const timeEl = document.querySelector('#victory-time');
      const movesEl = document.querySelector('#victory-moves');
      const hintsEl = document.querySelector('#victory-hints');
      const pbBadgeEl = document.querySelector('#binairo-pb-badge');

      if (diffLabelEl) diffLabelEl.textContent = this.difficulty.toUpperCase();
      if (timeEl) timeEl.textContent = this.timerEl.textContent;
      if (movesEl) movesEl.textContent = String(this.moves);
      if (hintsEl) hintsEl.textContent = String(this.hintsUsed);
      if (pbBadgeEl) pbBadgeEl.removeAttribute('hidden');
      if (pbBadgeEl && !isPB) pbBadgeEl.setAttribute('hidden', '');

      this.victoryModalEl.removeAttribute('hidden');
      this.updateBestTime();
    }

    recordBestTime(): boolean {
      if (!this.puzzle) return false;
      const key = `${BEST_TIMES_KEY}_${this.difficulty}`;
      const savedBest = localStorage.getItem(key);
      const current = this.timerSeconds;
      if (!savedBest || current < Number(savedBest)) {
        localStorage.setItem(key, String(current));
        return true;
      }
      return false;
    }

    updateBestTime() {
      const key = `${BEST_TIMES_KEY}_${this.difficulty}`;
      const saved = localStorage.getItem(key);
      if (saved) {
        const secs = Number(saved);
        const mins = Math.floor(secs / 60);
        const s = secs % 60;
        this.bestTimeEl.textContent = `${String(mins).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
      } else {
        this.bestTimeEl.textContent = '—';
      }
    }

    updateStats() {
      if (!this.puzzle) return;
      this.movesEl.textContent = String(this.moves);
      this.updateTimerDisplay();

      let filled = 0;
      const total = this.puzzle.size * this.puzzle.size;
      for (let r = 0; r < this.puzzle.size; r++) {
        for (let c = 0; c < this.puzzle.size; c++) {
          if (this.currentBoard[r][c] !== null) filled++;
        }
      }
      this.filledEl.textContent = `${filled} / ${total}`;
    }

    showToast(message: string, type: 'success' | 'error' = 'success') {
      this.toastTextEl.textContent = message;
      this.toastEl.className = `binairo-toast is-${type}`;
      this.toastEl.removeAttribute('hidden');
      setTimeout(() => this.hideToast(), 4000);
    }

    hideToast() {
      this.toastEl.setAttribute('hidden', '');
    }

    saveState() {
      if (!this.puzzle) return;
      const state: GameState = {
        difficulty: this.difficulty,
        puzzleId: this.puzzle.id,
        board: this.currentBoard,
        moves: this.moves,
        timerSeconds: this.timerSeconds,
        hintsUsed: this.hintsUsed,
        isComplete: this.isComplete
      };
      localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
    }

    initEventListeners() {
      // Difficulty tabs
      document.querySelectorAll('.binairo-diff-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const diff = btn.getAttribute('data-difficulty') as any;
          if (diff) this.startNewPuzzle(diff, 0);
        });
      });

      // Sound toggle
      this.soundBtn.addEventListener('click', () => {
        this.soundEnabled = !this.soundEnabled;
        localStorage.setItem(SOUND_KEY, String(this.soundEnabled));
        this.updateSoundButton();
      });

      // Buttons
      document.querySelector('#binairo-new-btn')?.addEventListener('click', () => {
        this.startNewPuzzle(this.difficulty, 1);
      });
      document.querySelector('#binairo-restart-btn')?.addEventListener('click', () => {
        if (!confirm('Restart this puzzle from the beginning?')) return;
        if (this.puzzle) {
          this.currentBoard = this.puzzle.clues.map(r => [...r]);
          this.moves = 0;
          this.timerSeconds = 0;
          this.hintsUsed = 0;
          this.isComplete = false;
          this.undoStack = [];
          this.redoStack = [];
          this.renderBoard();
          this.updateStats();
          this.updateUndoRedo();
          this.saveState();
        }
      });
      this.undoBtn.addEventListener('click', () => this.undo());
      this.redoBtn.addEventListener('click', () => this.redo());
      document.querySelector('#binairo-hint-btn')?.addEventListener('click', () => this.provideHint());
      document.querySelector('#binairo-check-btn')?.addEventListener('click', () => this.checkProgress());
      document.querySelector('#binairo-clear-btn')?.addEventListener('click', () => this.clearPlayerEntries());

      // Pause & Resume
      document.querySelector('#binairo-pause-btn')?.addEventListener('click', () => {
        this.isPaused = true;
        this.pausedModalEl.removeAttribute('hidden');
      });
      document.querySelector('#binairo-resume')?.addEventListener('click', () => {
        this.isPaused = false;
        this.pausedModalEl.setAttribute('hidden', '');
      });

      // Victory actions
      document.querySelector('#binairo-next-puzzle')?.addEventListener('click', () => {
        this.victoryModalEl.setAttribute('hidden', '');
        this.startNewPuzzle(this.difficulty, 1);
      });

      // Share button
      document.querySelector('#binairo-share')?.addEventListener('click', () => {
        const text = `I solved the ${this.difficulty.toUpperCase()} Binairo puzzle on PuzzleFeels in ${this.timerEl.textContent} with ${this.moves} moves! Play free: https://puzzlefeels.com/binairo-online-puzzle-game/`;
        navigator.clipboard.writeText(text).then(() => {
          const statusEl = document.querySelector('#binairo-share-status');
          if (statusEl) statusEl.textContent = '✓ Result copied to clipboard!';
        });
      });

      // Quick digit selector buttons (0, 1, Clear)
      document.querySelector('#binairo-set-0')?.addEventListener('click', () => {
        if (this.selectedCell) this.setCellValue(this.selectedCell.r, this.selectedCell.c, 0);
      });
      document.querySelector('#binairo-set-1')?.addEventListener('click', () => {
        if (this.selectedCell) this.setCellValue(this.selectedCell.r, this.selectedCell.c, 1);
      });
      document.querySelector('#binairo-set-clear')?.addEventListener('click', () => {
        if (this.selectedCell) this.setCellValue(this.selectedCell.r, this.selectedCell.c, null);
      });

      // Keyboard Controls
      window.addEventListener('keydown', (e) => {
        if (!this.selectedCell || !this.puzzle || this.isComplete) return;
        const { r, c } = this.selectedCell;
        const N = this.puzzle.size;

        if (e.key === 'ArrowUp') {
          e.preventDefault();
          this.selectCell((r - 1 + N) % N, c);
        } else if (e.key === 'ArrowDown') {
          e.preventDefault();
          this.selectCell((r + 1) % N, c);
        } else if (e.key === 'ArrowLeft') {
          e.preventDefault();
          this.selectCell(r, (c - 1 + N) % N);
        } else if (e.key === 'ArrowRight') {
          e.preventDefault();
          this.selectCell(r, (c + 1) % N);
        } else if (e.key === '0') {
          e.preventDefault();
          this.setCellValue(r, c, 0);
        } else if (e.key === '1') {
          e.preventDefault();
          this.setCellValue(r, c, 1);
        } else if (e.key === 'Backspace' || e.key === 'Delete' || e.key === 'x' || e.key === 'X') {
          e.preventDefault();
          this.setCellValue(r, c, null);
        } else if (e.key === 'z' && (e.ctrlKey || e.metaKey)) {
          e.preventDefault();
          if (e.shiftKey) this.redo();
          else this.undo();
        } else if (e.key === 'y' && (e.ctrlKey || e.metaKey)) {
          e.preventDefault();
          this.redo();
        }
      });
    }
  }

  // Initialize on DOM load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => new BinairoGame());
  } else {
    new BinairoGame();
  }
</script>
