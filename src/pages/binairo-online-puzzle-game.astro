    { '@type': 'ListItem', position: 2, name: 'Games', item: 'https://puzzlefeels.com/games/' },
    { '@type': 'ListItem', position: 3, name: 'Binairo – Online Puzzle Game', item: 'https://puzzlefeels.com/binairo-online-puzzle-game/' }
