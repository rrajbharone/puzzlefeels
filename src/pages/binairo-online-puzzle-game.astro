const title = 'Binairo – Online Puzzle Game | Play Free Binary Logic Puzzles | PuzzleFeels';
const description = 'Play Binairo online puzzle game for free! Fill the grid with 0s and 1s, balance every row and column, prevent trios, and solve classic Takuzu logic puzzles.';

const faqs = [
  {
    question: 'What is Binairo also called?',
    answer: 'Binairo is widely known around the world by several different names, most notably Takuzu, Binary Puzzle, Tic-Tac-Logic, Binary Grid, and Zero-One Puzzle. Despite the different branding and translations, all of these variations share the exact same four foundational rules: equal balance of 0s and 1s, no trios, and unique rows and columns.'
  },
  {
    question: 'How do you play Binairo online?',
    answer: 'To play Binairo online on PuzzleFeels, select an empty cell and click or tap to cycle through states: Empty → 0 → 1 → Empty. You can also use the 0 and 1 buttons below the board or type 0 or 1 on your keyboard. Your goal is to fill every square so that each row and column contains an equal number of 0s and 1s, no three identical digits appear consecutively, and all lines are unique.'
  },
  {
    question: 'What are the three main rules of Binairo?',
    answer: 'Binairo is governed by three core principles: 1) Equal Balance: every row and column must contain an equal number of 0s and 1s. 2) No Trios: you cannot place three identical consecutive digits horizontally or vertically (no 000 or 111). 3) Uniqueness: no two completed rows can have the exact same sequence of digits, and no two completed columns can be identical.'
  },
  {
    question: 'How many 0s and 1s should be in each row and column?',
    answer: 'Because Binairo is always played on an even-sized square grid (N×N), each row and column must contain exactly N/2 zeros and N/2 ones. For example, on a 6×6 board, every line requires three 0s and three 1s. On an 8×8 board, each line requires four 0s and four 1s. On a 10×10 board, each line requires five 0s and five 1s.'
  },
  {
    question: 'Can three identical numbers appear next to each other?',
    answer: 'No. Having three identical digits in a row or column (such as 0-0-0 or 1-1-1) is strictly forbidden. This rule applies in both directions: across rows from left to right, and down columns from top to bottom. However, pairs of identical digits (such as 0-0 or 1-1) are completely valid and serve as primary clues for logical deduction.'
  },
  {
    question: 'Why can\'t two completed rows or columns be identical?',
    answer: 'The line uniqueness rule guarantees that every puzzle has a single, unambiguous mathematical solution. If two completed rows or columns were permitted to be identical, many boards would possess multiple valid solutions, creating guesswork. Comparing completed lines against partially filled lines allows advanced solvers to make crucial deductions.'
  },
  {
    question: 'What is the difference between Binairo and Sudoku?',
    answer: 'While both games are grid-based deduction puzzles that prohibit duplicate lines, Sudoku uses digits 1 through 9 placed across 3×3 regional subgrids, whereas Binairo uses only binary digits (0 and 1) across the entire grid. Binairo features specific trio restrictions (no 000 or 111) and direct row/column balance requirements that do not exist in Sudoku.'
  },
  {
    question: 'Is Binairo the same game as Takuzu?',
    answer: 'Yes. Takuzu and Binairo are identical games. The name Takuzu was popularized in Europe by Peter De Schepper and Frank Coussement, while Binairo is the trademarked title popularized by puzzle syndicates. Both feature the exact same binary grid, equal-parity rule, trio prohibition, and uniqueness constraints.'
  },
  {
    question: 'Can I play Binairo on my smartphone or tablet?',
    answer: 'Yes! PuzzleFeels Binairo is engineered mobile-first with touch-friendly controls, responsive cell scaling, tap-to-cycle cell toggling, and zero horizontal overflow. You can enjoy the full desktop and mobile experience without downloading apps or creating accounts.'
  },
  {
    question: 'Is this online Binairo puzzle game completely free?',
    answer: 'Yes, 100% free with no subscription, paywalls, or invasive ads. You can play unlimited Easy, Medium, and Hard puzzles, practice daily challenges, use hints, and track your best completion times freely.'
  }
];

const gameSchema = {
  '@context': 'https://schema.org',
  '@type': 'VideoGame',
  name: 'Binairo – Online Puzzle Game',
  url: 'https://puzzlefeels.com/binairo-online-puzzle-game/',
  description,
  gamePlatform: 'Web browser',
  applicationCategory: 'Game',
  genre: ['Logic Puzzle', 'Binary Puzzle', 'Takuzu', 'Brain Game'],
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  publisher: { '@type': 'Organization', name: 'PuzzleFeels', url: 'https://puzzlefeels.com/' }
};

const breadcrumbSchema = {
