    { id: 'shp-circle', name: 'Circle', color: '#3b82f6', svg: '<svg viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="9"/></svg>' },
    { id: 'shp-diamond', name: 'Diamond', color: '#8b5cf6', svg: '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2L2 12l10 10 10-10L12 2z"/></svg>' },
