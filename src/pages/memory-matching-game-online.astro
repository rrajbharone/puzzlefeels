    { id: 'shp-moon', name: 'Moon', color: '#eab308', svg: '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>' },
    { id: 'shp-shield', name: 'Shield', color: '#6366f1', svg: '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/></svg>' },
    { id: 'shp-cross', name: 'Cross Badge', color: '#14b8a6', svg: '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M19 10.5h-5.5V5a1.5 1.5 0 0 0-3 0v5.5H5a1.5 1.5 0 0 0 0 3h5.5V19a1.5 1.5 0 0 0 3 0v-5.5H19a1.5 1.5 0 0 0 0-3z"/></svg>' },
    { id: 'shp-clover', name: 'Clover', color: '#22c55e', svg: '<svg viewBox="0 0 24 24" fill="currentColor"><circle cx="8" cy="8" r="4"/><circle cx="16" cy="8" r="4"/><circle cx="8" cy="16" r="4"/><circle cx="16" cy="16" r="4"/><path d="M12 12v9" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>' },
    { id: 'shp-sun', name: 'Sunburst', color: '#f97316', svg: '<svg viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="5"/><path d="M12 1v3m0 16v3M4.22 4.22l2.12 2.12m11.32 11.32l2.12 2.12M1 12h3m16 0h3M4.22 19.78l2.12-2.12m11.32-11.32l2.12-2.12" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>' }
  ];

  // State variables
  let currentMode: PlayerMode = 'adults';
  let currentCategory: Category = 'icon';
  let currentDifficulty: Difficulty = 'easy';
  let isDaily = false;
  let cards: CardItem[] = [];
  let flippedIndices: number[] = [];
  let matchedPairIds: Set<string> = new Set();
  let isLocked = false;
  let moves = 0;
  let timerSeconds = 0;
  let timerInterval: number | null = null;
  let isTimerRunning = false;
  let isPaused = false;
  let hintsUsed = 0;
  let isHintActive = false;
  let hintTimeoutId: number | null = null;
  let kidsToastTimeoutId: number | null = null;
  let soundEnabled = true;
  let audioCtx: AudioContext | null = null;

  // DOM element caches
  const gridEl = document.getElementById('memory-grid') as HTMLElement;
  const statMoves = document.getElementById('stat-moves') as HTMLElement;
  const statTimer = document.getElementById('stat-timer') as HTMLElement;
  const statPairs = document.getElementById('stat-pairs') as HTMLElement;
  const statBest = document.getElementById('stat-best') as HTMLElement;
  const progressBar = document.getElementById('memory-progress-bar') as HTMLElement;
  const pauseOverlay = document.getElementById('memory-paused') as HTMLElement;
  const victoryOverlay = document.getElementById('memory-victory') as HTMLElement;
  const kidsToast = document.getElementById('kids-toast') as HTMLElement;
  const shareToast = document.getElementById('memory-share-toast') as HTMLElement;
  const liveAnnouncer = document.getElementById('memory-live-announcer') as HTMLElement;
  const dailyBanner = document.getElementById('memory-daily-banner') as HTMLElement;
  const dailyDateLabel = document.getElementById('daily-date-label') as HTMLElement;
  const dailyStatusTag = document.getElementById('daily-status-tag') as HTMLElement;
  const diffBar = document.getElementById('memory-difficulty-bar') as HTMLElement;

  // Audio System
  function initAudio() {
    if (!audioCtx && typeof window !== 'undefined') {
      const AudioClass = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
      if (AudioClass) {
        audioCtx = new AudioClass();
      }
    }
    if (audioCtx && audioCtx.state === 'suspended') {
      audioCtx.resume();
    }
  }

  function playTone(freq: number, type: OscillatorType, duration: number, delay = 0, gainLevel = 0.1) {
    if (!soundEnabled || !audioCtx) return;
    try {
      const startTime = audioCtx.currentTime + delay;
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.type = type;
      osc.frequency.setValueAtTime(freq, startTime);
      gain.gain.setValueAtTime(gainLevel, startTime);
      gain.gain.exponentialRampToValueAtTime(0.001, startTime + duration);
      osc.connect(gain);
      gain.connect(audioCtx.destination);
      osc.start(startTime);
      osc.stop(startTime + duration);
    } catch {
      // Audio playback gracefully suppressed
    }
  }

  function playFlipSound() {
    playTone(520, 'sine', 0.08, 0, 0.08);
  }

  function playMatchSound() {
    playTone(523.25, 'triangle', 0.14, 0, 0.12);     // C5
    playTone(659.25, 'triangle', 0.18, 0.08, 0.12);  // E5
    playTone(783.99, 'triangle', 0.24, 0.16, 0.14);  // G5
  }

  function playMismatchSound() {
    playTone(320, 'sine', 0.12, 0, 0.08);
    playTone(280, 'sine', 0.16, 0.09, 0.08);
  }

  function playHintSound() {
    playTone(880, 'sine', 0.12, 0, 0.1);
    playTone(1174.66, 'sine', 0.22, 0.08, 0.1);
  }

  function playVictorySound() {
    playTone(523.25, 'triangle', 0.16, 0, 0.15);     // C5
    playTone(659.25, 'triangle', 0.16, 0.12, 0.15);  // E5
    playTone(783.99, 'triangle', 0.16, 0.24, 0.15);  // G5
    playTone(1046.50, 'triangle', 0.40, 0.36, 0.18); // C6
  }

  // PRNG and Date Helpers for Daily Challenge
  function getUtcDateString(d = new Date()): string {
    const y = d.getUTCFullYear();
    const m = String(d.getUTCMonth() + 1).padStart(2, '0');
    const day = String(d.getUTCDate()).padStart(2, '0');
    return `${y}-${m}-${day}`;
  }

  function hashString(str: string): number {
    let hash = 1779033703 ^ str.length;
    for (let i = 0; i < str.length; i++) {
      hash = Math.imul(hash ^ str.charCodeAt(i), 3432918353);
      hash = (hash << 13) | (hash >>> 19);
    }
    return hash >>> 0;
  }

  function mulberry32(a: number): () => number {
    return function() {
      let t = (a += 0x6D2B79F5);
      t = Math.imul(t ^ (t >>> 15), t | 1);
      t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }

  // LocalStorage Helpers
  interface StoredStats {
    bestTime: number | null; // in seconds
    bestMoves: number | null;
    gamesPlayed: number;
    history?: number[];
  }

  interface DailyResult {
    date: string;
    completed: boolean;
    time: number;
    moves: number;
  }

  function getStorageKey(mode: PlayerMode, cat: Category, diff: Difficulty): string {
    const base = mode === 'adults' ? 'pf-memory-matching-adults-v1' : 'pf-memory-matching-kids-v1';
    return `${base}-${cat}-${diff}`;
  }

  function getStats(mode: PlayerMode, cat: Category, diff: Difficulty): StoredStats {
    try {
      const raw = localStorage.getItem(getStorageKey(mode, cat, diff));
      if (raw) {
        const parsed = JSON.parse(raw);
        if (typeof parsed === 'object' && parsed !== null) {
          return {
            bestTime: typeof parsed.bestTime === 'number' ? parsed.bestTime : null,
            bestMoves: typeof parsed.bestMoves === 'number' ? parsed.bestMoves : null,
            gamesPlayed: typeof parsed.gamesPlayed === 'number' ? parsed.gamesPlayed : 0,
            history: Array.isArray(parsed.history) ? parsed.history : []
          };
        }
      }
    } catch {
      // Storage unavailable
    }
    return { bestTime: null, bestMoves: null, gamesPlayed: 0 };
  }

  function saveStats(mode: PlayerMode, cat: Category, diff: Difficulty, stats: StoredStats): void {
    try {
      localStorage.setItem(getStorageKey(mode, cat, diff), JSON.stringify(stats));
    } catch {
      // Storage full
    }
  }

  function getDailyRecord(dateStr: string): DailyResult | null {
    try {
      const raw = localStorage.getItem('pf-memory-matching-daily-v1');
      if (raw) {
        const parsed = JSON.parse(raw);
        if (parsed && parsed.date === dateStr) {
          return parsed;
        }
      }
    } catch {
      // Ignore
    }
    return null;
  }

  function saveDailyRecord(record: DailyResult): void {
    try {
      localStorage.setItem('pf-memory-matching-daily-v1', JSON.stringify(record));
    } catch {
      // Ignore
    }
  }

  // Formatting helpers
  function formatTime(totalSeconds: number): string {
    const mins = Math.floor(totalSeconds / 60);
    const secs = totalSeconds % 60;
    return `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
  }

  function announce(msg: string) {
    if (liveAnnouncer) {
      liveAnnouncer.textContent = msg;
    }
  }

  function showToast(text: string) {
    if (!shareToast) return;
    shareToast.textContent = text;
    shareToast.classList.add('is-visible');
    setTimeout(() => {
      shareToast.classList.remove('is-visible');
    }, 2200);
  }

  // Timer Management
  function startTimer() {
    if (isTimerRunning) return;
    isTimerRunning = true;
    timerInterval = window.setInterval(() => {
      if (!isPaused) {
        timerSeconds += 1;
        if (statTimer) statTimer.textContent = formatTime(timerSeconds);
      }
    }, 1000);
  }

  function stopTimer() {
    isTimerRunning = false;
    if (timerInterval) {
      window.clearInterval(timerInterval);
      timerInterval = null;
    }
  }

  function resetTimer() {
    stopTimer();
    timerSeconds = 0;
    if (statTimer) statTimer.textContent = '00:00';
  }

  // Card Generation
  function generateCards(): CardItem[] {
    const config = DIFFICULTY_MAP[currentDifficulty];
    const pairCount = config.pairs;
    let baseList: { id: string; label: string; html: string }[] = [];

    if (currentCategory === 'icon') {
      baseList = ICON_ITEMS.slice(0, pairCount).map(item => ({
        id: item.id,
        label: item.label,
        html: `<div class="card-symbol card-icon" style="color: ${item.color}">${item.svg}</div>`
      }));
    } else if (currentCategory === 'number') {
      baseList = NUMBER_ITEMS.slice(0, pairCount).map(item => ({
        id: item.id,
        label: item.label,
        html: `
          <div class="card-number-wrap">
            <span class="card-number-badge" style="color: ${item.color}">${item.symbol}</span>
            <span class="card-number-sub">${item.label}</span>
          </div>
        `
      }));
    } else if (currentCategory === 'color') {
      baseList = COLOR_ITEMS.slice(0, pairCount).map(item => ({
        id: item.id,
        label: item.label,
        html: `
          <div class="card-color-wrap">
            <span class="card-color-swatch" style="background-color: ${item.color}" aria-hidden="true">
              ${item.iconSvg}
            </span>
            <span class="card-color-label">${item.label}</span>
          </div>
        `
      }));
    } else if (currentCategory === 'shape') {
      baseList = SHAPE_ITEMS.slice(0, pairCount).map(item => ({
        id: item.id,
        label: item.name,
        html: `<div class="card-symbol card-shape" style="color: ${item.color}">${item.svg}</div>`
      }));
    }

    // Duplicate each item once to create pairs
    const deck: CardItem[] = [];
    baseList.forEach(item => {
      deck.push({ id: `${item.id}-a`, pairId: item.id, label: item.label, html: item.html });
      deck.push({ id: `${item.id}-b`, pairId: item.id, label: item.label, html: item.html });
    });

    // Shuffle using Fisher-Yates (Deterministic seed for Daily, standard crypto/math for casual)
    if (isDaily) {
      const todayStr = getUtcDateString();
      const rng = mulberry32(hashString(todayStr));
      for (let i = deck.length - 1; i > 0; i--) {
        const j = Math.floor(rng() * (i + 1));
        [deck[i], deck[j]] = [deck[j], deck[i]];
      }
    } else {
      for (let i = deck.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [deck[i], deck[j]] = [deck[j], deck[i]];
      }
    }

    return deck;
  }

  // Render cards to DOM
  function renderBoard() {
    if (!gridEl) return;
    const config = DIFFICULTY_MAP[currentDifficulty];
    gridEl.className = `memory-grid ${config.gridClass} mode-${currentMode} cat-${currentCategory}`;
    gridEl.innerHTML = '';

    cards.forEach((card, idx) => {
      const isMatched = matchedPairIds.has(card.pairId);
      const isFlipped = isMatched || flippedIndices.includes(idx);

      const cardEl = document.createElement('div');
      cardEl.className = `memory-card ${isFlipped ? 'is-flipped' : ''} ${isMatched ? 'is-matched' : ''}`;
      cardEl.setAttribute('role', 'button');
      cardEl.setAttribute('tabindex', isMatched ? '-1' : '0');
      cardEl.setAttribute('aria-label', isMatched ? `Matched card ${idx + 1}: ${card.label}` : isFlipped ? `Revealed card ${idx + 1}: ${card.label}` : `Face-down card ${idx + 1}`);
      cardEl.dataset.index = String(idx);
      cardEl.dataset.pairId = card.pairId;

      cardEl.innerHTML = `
        <div class="memory-card-inner">
          <div class="card-front" aria-hidden="true">
            <div class="card-back-pattern">
              <div class="card-back-emblem">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="card-emblem-svg">
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                </svg>
              </div>
            </div>
          </div>
          <div class="card-back">
            ${card.html}
            ${isMatched ? '<span class="card-matched-badge" aria-hidden="true"><svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg></span>' : ''}
          </div>
        </div>
      `;

      cardEl.addEventListener('click', () => handleCardSelect(idx));
      cardEl.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          handleCardSelect(idx);
        }
      });

      gridEl.appendChild(cardEl);
    });

    updateStatsBar();
  }

  // Update Stats Bar
  function updateStatsBar() {
    const config = DIFFICULTY_MAP[currentDifficulty];
    if (statMoves) statMoves.textContent = String(moves);
    if (statPairs) statPairs.textContent = `${matchedPairIds.size} / ${config.pairs}`;

    const percent = Math.round((matchedPairIds.size / config.pairs) * 100);
    if (progressBar) progressBar.style.width = `${percent}%`;

    const stats = getStats(currentMode, currentCategory, currentDifficulty);
    if (statBest) {
      statBest.textContent = stats.bestTime !== null ? formatTime(stats.bestTime) : '—';
    }

    // Daily Banner status
    if (isDaily && dailyStatusTag) {
      const todayStr = getUtcDateString();
      const record = getDailyRecord(todayStr);
      if (record && record.completed) {
        dailyStatusTag.textContent = `Completed: ${formatTime(record.time)} (${record.moves} moves)`;
        dailyStatusTag.className = 'daily-status-tag is-completed';
      } else {
        dailyStatusTag.textContent = 'Ready to Play';
        dailyStatusTag.className = 'daily-status-tag';
      }
    }
  }

  // Handle Card Click / Selection
  function handleCardSelect(index: number) {
    if (isLocked || isPaused) return;
    const card = cards[index];
    if (!card) return;

    // Do nothing if already matched or already face-up
    if (matchedPairIds.has(card.pairId)) return;
    if (flippedIndices.includes(index)) return;

    // If an active hint is running, clear it immediately upon card selection
    clearHintState();

    // Ensure audio and timer start on first interaction
    initAudio();
    if (!isTimerRunning && matchedPairIds.size < DIFFICULTY_MAP[currentDifficulty].pairs) {
      startTimer();
    }

    flippedIndices.push(index);
    playFlipSound();
    renderFlippedState();

    if (flippedIndices.length === 2) {
      moves += 1;
      updateStatsBar();
      isLocked = true;

      const idx1 = flippedIndices[0];
      const idx2 = flippedIndices[1];
      const card1 = cards[idx1];
      const card2 = cards[idx2];

      if (card1.pairId === card2.pairId) {
        // MATCH FOUND
        matchedPairIds.add(card1.pairId);
        playMatchSound();
        announce(`Match found! ${card1.label}. ${matchedPairIds.size} of ${DIFFICULTY_MAP[currentDifficulty].pairs} pairs matched.`);

        if (currentMode === 'kids') {
          showKidsToast(`Awesome Match! ${card1.label}`);
        }

        setTimeout(() => {
          flippedIndices = [];
          isLocked = false;
          renderBoard();
          checkVictory();
        }, 360);
      } else {
        // MISMATCH
        playMismatchSound();
        announce(`Not a match: ${card1.label} and ${card2.label}.`);
        setTimeout(() => {
          flippedIndices = [];
          isLocked = false;
          renderBoard();
        }, 850);
      }
    }
  }

  function renderFlippedState() {
    const cardEls = gridEl?.querySelectorAll('.memory-card');
    if (!cardEls) return;

    cards.forEach((card, idx) => {
      const el = cardEls[idx] as HTMLElement;
      if (!el) return;
      const isMatched = matchedPairIds.has(card.pairId);
      const isFlipped = isMatched || flippedIndices.includes(idx);
      el.classList.toggle('is-flipped', isFlipped);
    });
  }

  // Kids toast encouraging message (Zero emojis, clean SVG icon)
  function showKidsToast(text: string) {
    if (!kidsToast) return;
    const textEl = kidsToast.querySelector('.kids-toast-text');
    if (textEl) textEl.textContent = text;
    kidsToast.hidden = false;
    kidsToast.classList.add('is-visible');

    if (kidsToastTimeoutId) window.clearTimeout(kidsToastTimeoutId);
    kidsToastTimeoutId = window.setTimeout(() => {
      kidsToast.classList.remove('is-visible');
      kidsToast.hidden = true;
      kidsToastTimeoutId = null;
    }, 1600);
  }

  // Check victory condition
  function checkVictory() {
    const config = DIFFICULTY_MAP[currentDifficulty];
    if (matchedPairIds.size >= config.pairs) {
      stopTimer();
      playVictorySound();

      const finalTime = timerSeconds;
      const finalMoves = moves;
      const minPairs = config.pairs;

      // Calculate star rating
      let starCount = 1;
      let starTitle = 'Good Effort – Keep Practicing!';
      if (finalMoves <= Math.ceil(minPairs * 1.45)) {
        starCount = 3;
        starTitle = currentMode === 'kids' ? 'Superstar Memory!' : 'Outstanding Memory!';
      } else if (finalMoves <= Math.ceil(minPairs * 2.1)) {
        starCount = 2;
        starTitle = currentMode === 'kids' ? 'Great Job!' : 'Great Concentration!';
      }

      // Check Personal Best
      const prevStats = getStats(currentMode, currentCategory, currentDifficulty);
      let isNewPB = false;
      if (prevStats.bestTime === null || finalTime < prevStats.bestTime) {
        isNewPB = true;
      }

      // Save statistics
      const updatedStats: StoredStats = {
        bestTime: prevStats.bestTime === null ? finalTime : Math.min(prevStats.bestTime, finalTime),
        bestMoves: prevStats.bestMoves === null ? finalMoves : Math.min(prevStats.bestMoves, finalMoves),
        gamesPlayed: prevStats.gamesPlayed + 1,
        history: [...(prevStats.history || []).slice(-19), finalTime]
      };
      saveStats(currentMode, currentCategory, currentDifficulty, updatedStats);

      // Handle Daily Challenge persistence
      if (isDaily) {
        const todayStr = getUtcDateString();
        saveDailyRecord({
          date: todayStr,
          completed: true,
          time: finalTime,
          moves: finalMoves
        });
      }

      // Populate victory modal elements
      const vicTitle = document.getElementById('victory-title');
      const vicMessage = document.getElementById('victory-message');
      const vicTime = document.getElementById('victory-time');
      const vicMoves = document.getElementById('victory-moves');
      const vicPairs = document.getElementById('victory-pairs');
      const vicBestTime = document.getElementById('victory-best-time');
      const vicHints = document.getElementById('victory-hints');
      const vicDiffLabel = document.getElementById('victory-diff-label');
      const vicModePill = document.getElementById('victory-mode-pill');
      const vicPbBanner = document.getElementById('victory-pb-banner');
      const vicStars = document.getElementById('victory-stars');

      const catDisplayNames: Record<Category, string> = {
        icon: 'Icons',
        number: 'Numbers',
        color: 'Colors',
        shape: 'Shapes'
      };

      if (vicTitle) vicTitle.textContent = isNewPB ? 'New Personal Best!' : 'Game Completed!';
      if (vicMessage) vicMessage.textContent = starTitle;
      if (vicTime) vicTime.textContent = formatTime(finalTime);
      if (vicMoves) vicMoves.textContent = String(finalMoves);
      if (vicPairs) vicPairs.textContent = `${config.pairs} / ${config.pairs}`;
      if (vicBestTime) vicBestTime.textContent = formatTime(updatedStats.bestTime || finalTime);
      if (vicHints) vicHints.textContent = String(hintsUsed);
      if (vicDiffLabel) vicDiffLabel.textContent = `${currentDifficulty.charAt(0).toUpperCase() + currentDifficulty.slice(1)}`;
      if (vicModePill) {
        vicModePill.textContent = `${currentMode === 'adults' ? 'Adults Mode' : 'Kids Mode'} · ${currentDifficulty.charAt(0).toUpperCase() + currentDifficulty.slice(1)} · ${catDisplayNames[currentCategory]}`;
      }

      if (vicPbBanner) {
        vicPbBanner.hidden = !isNewPB;
      }

      if (vicStars) {
        const starSvgs = vicStars.querySelectorAll('svg.star');
        starSvgs.forEach((svg, idx) => {
          svg.classList.toggle('active', idx < starCount);
          svg.classList.toggle('inactive', idx >= starCount);
        });
        vicStars.setAttribute('aria-label', `Performance Rating: ${starCount} of 3 Stars`);
      }

      if (victoryOverlay) {
        victoryOverlay.hidden = false;
        victoryOverlay.classList.add('is-active');
      }

      announce(`Congratulations! All ${config.pairs} pairs matched in ${finalMoves} moves and ${formatTime(finalTime)}.`);
      updateStatsBar();
    }
  }

  // ==========================================
  // CRITICAL HINT SYSTEM (RELIABLE & AIRTIGHT)
  // ==========================================

  function clearHintState() {
    if (hintTimeoutId !== null) {
      window.clearTimeout(hintTimeoutId);
      hintTimeoutId = null;
    }
    isHintActive = false;
    const hintedCards = gridEl?.querySelectorAll('.memory-card.is-hinted');
    hintedCards?.forEach(el => el.classList.remove('is-hinted'));
  }

  function provideHint() {
    // 1. Guard against clicks during active hint, active card lock, pause, or completed puzzle
    if (isHintActive || isLocked || isPaused || matchedPairIds.size >= DIFFICULTY_MAP[currentDifficulty].pairs) {
      return;
    }

    // 2. Identify all currently unmatched and unrevealed cards
    // Must strictly exclude already matched pairs and currently revealed cards
    const availableIndices: number[] = [];
    cards.forEach((card, index) => {
      if (!matchedPairIds.has(card.pairId) && !flippedIndices.includes(index)) {
        availableIndices.push(index);
      }
    });

    // 3. Group available unrevealed card indices by their pairId
    const pairMap = new Map<string, number[]>();
    availableIndices.forEach(index => {
      const pid = cards[index].pairId;
      if (!pairMap.has(pid)) {
        pairMap.set(pid, []);
      }
      pairMap.get(pid)!.push(index);
    });

    // 4. Find valid pairs where BOTH cards are unmatched and unrevealed
    const candidatePairs: { pairId: string; indices: [number, number] }[] = [];
    pairMap.forEach((indices, pairId) => {
      if (indices.length === 2) {
        // Assert identical pairId
        if (cards[indices[0]].pairId === pairId && cards[indices[1]].pairId === pairId) {
          candidatePairs.push({ pairId, indices: [indices[0], indices[1]] });
        }
      }
    });

    // 5. If one card is currently flipped (partial turn) and only that pair remains
    if (candidatePairs.length === 0 && flippedIndices.length === 1) {
      const flippedIdx = flippedIndices[0];
      const flippedCard = cards[flippedIdx];
      const partnerIdx = cards.findIndex((c, idx) => idx !== flippedIdx && c.pairId === flippedCard.pairId && !matchedPairIds.has(c.pairId));
      if (partnerIdx !== -1) {
        candidatePairs.push({ pairId: flippedCard.pairId, indices: [flippedIdx, partnerIdx] });
      }
    }

    // 6. If no valid unmatched pair exists on the board
    if (candidatePairs.length === 0) {
      showToast('No matching pairs available for hints.');
      announce('No matching pairs are available for hints.');
      return;
    }

    // 7. Pick a valid matching pair
    const chosen = candidatePairs[Math.floor(Math.random() * candidatePairs.length)];
    const [idxA, idxB] = chosen.indices;

    // 8. Strict verification: ensure both indices point to the same valid pairId
    if (cards[idxA].pairId !== cards[idxB].pairId || matchedPairIds.has(chosen.pairId)) {
      return;
    }

    isHintActive = true;
    hintsUsed += 1;
    playHintSound();

    const cardEls = gridEl?.querySelectorAll('.memory-card');
    const elA = cardEls?.[idxA] as HTMLElement;
    const elB = cardEls?.[idxB] as HTMLElement;

    if (elA) elA.classList.add('is-hinted');
    if (elB) elB.classList.add('is-hinted');

    announce(`Hint: one available matching pair is highlighted.`);

    // 9. Remove highlight automatically after duration (1400ms)
    hintTimeoutId = window.setTimeout(() => {
      if (elA) elA.classList.remove('is-hinted');
      if (elB) elB.classList.remove('is-hinted');
      isHintActive = false;
      hintTimeoutId = null;
    }, 1400);
  }

  // Start fresh game (shuffled new deal)
  function startNewGame(confirmIfProgress = false) {
    if (confirmIfProgress && moves > 0 && matchedPairIds.size < DIFFICULTY_MAP[currentDifficulty].pairs) {
      const confirmReset = window.confirm('Start a new game? Current progress will be lost.');
      if (!confirmReset) return;
    }

    clearHintState();
    stopTimer();
    resetTimer();
    moves = 0;
    hintsUsed = 0;
    isLocked = false;
    isPaused = false;
    flippedIndices = [];
    matchedPairIds.clear();

    if (victoryOverlay) {
      victoryOverlay.hidden = true;
      victoryOverlay.classList.remove('is-active');
    }
    if (pauseOverlay) pauseOverlay.hidden = true;

    cards = generateCards();
    renderBoard();
  }

  // Restart current board (same card positions, reset moves/timer)
  function restartCurrentGame(promptConfirm = true) {
    if (promptConfirm && moves > 0 && matchedPairIds.size < DIFFICULTY_MAP[currentDifficulty].pairs) {
      const confirmRestart = window.confirm('Restart current puzzle from the beginning?');
      if (!confirmRestart) return;
    }

    clearHintState();
    stopTimer();
    resetTimer();
    moves = 0;
    hintsUsed = 0;
    isLocked = false;
    isPaused = false;
    flippedIndices = [];
    matchedPairIds.clear();

    if (victoryOverlay) {
      victoryOverlay.hidden = true;
      victoryOverlay.classList.remove('is-active');
    }
    if (pauseOverlay) pauseOverlay.hidden = true;

    renderBoard();
  }

  // Pause / Resume
  function togglePause() {
    if (matchedPairIds.size >= DIFFICULTY_MAP[currentDifficulty].pairs) return;
    isPaused = !isPaused;

    if (isPaused) {
      clearHintState();
      stopTimer();
      if (pauseOverlay) pauseOverlay.hidden = false;
    } else {
      if (pauseOverlay) pauseOverlay.hidden = true;
      if (moves > 0) startTimer();
    }
  }

  // Switch Player Mode (Adults / Kids)
  function switchPlayerMode(newMode: PlayerMode) {
    if (newMode === currentMode) return;
    clearHintState();
    currentMode = newMode;

    const modeBtns = document.querySelectorAll<HTMLButtonElement>('.memory-mode-btn');
    modeBtns.forEach(btn => {
      const active = btn.dataset.playerMode === newMode;
      btn.classList.toggle('is-active', active);
      btn.setAttribute('aria-pressed', String(active));
    });

    startNewGame(false);
  }

  // Switch Category
  function switchCategory(newCat: Category) {
    if (newCat === currentCategory && !isDaily) return;
    clearHintState();
    currentCategory = newCat;
    isDaily = false;

    if (dailyBanner) dailyBanner.hidden = true;
    if (diffBar) diffBar.hidden = false;

    const catBtns = document.querySelectorAll<HTMLButtonElement>('.memory-cat-btn');
    catBtns.forEach(btn => {
      const catVal = btn.dataset.category || btn.dataset.legacyCategory;
      const active = catVal === newCat || (newCat === 'icon' && catVal === 'emoji');
      btn.classList.toggle('is-active', active);
      btn.setAttribute('aria-pressed', String(active));
    });

    startNewGame(false);
  }

  // Switch Difficulty
  function switchDifficulty(newDiff: Difficulty) {
    if (newDiff === currentDifficulty && !isDaily) return;
    if (moves > 0 && matchedPairIds.size < DIFFICULTY_MAP[currentDifficulty].pairs) {
      const ok = window.confirm('Changing difficulty will start a fresh game. Proceed?');
      if (!ok) return;
    }

    clearHintState();
    currentDifficulty = newDiff;
    isDaily = false;

    if (dailyBanner) dailyBanner.hidden = true;

    const diffBtns = document.querySelectorAll<HTMLButtonElement>('.memory-diff-btn');
    diffBtns.forEach(btn => {
      const active = btn.dataset.difficulty === newDiff;
      btn.classList.toggle('is-active', active);
      btn.setAttribute('aria-pressed', String(active));
    });

    startNewGame(false);
  }

  // Toggle Daily Challenge
  function toggleDailyMode() {
    clearHintState();
    isDaily = true;
    currentDifficulty = 'medium'; // Standardized daily challenge difficulty
    const todayStr = getUtcDateString();
    const seed = hashString(todayStr);
    const catList: Category[] = ['icon', 'shape', 'number', 'color'];
    currentCategory = catList[seed % catList.length];

    if (dailyBanner) dailyBanner.hidden = false;
    if (diffBar) diffBar.hidden = true;

    if (dailyDateLabel) {
      const d = new Date();
      const monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
      dailyDateLabel.textContent = `Daily Memory Challenge · ${monthNames[d.getUTCMonth()]} ${d.getUTCDate()}, ${d.getUTCFullYear()} (UTC)`;
    }

    // Update Category visual buttons to match daily
    const catBtns = document.querySelectorAll<HTMLButtonElement>('.memory-cat-btn');
    catBtns.forEach(btn => {
      const catVal = btn.dataset.category;
      const active = catVal === currentCategory || (currentCategory === 'icon' && catVal === 'emoji');
      btn.classList.toggle('is-active', active);
      btn.setAttribute('aria-pressed', String(active));
    });

    startNewGame(false);
  }

  function exitDailyMode() {
    clearHintState();
    isDaily = false;
    if (dailyBanner) dailyBanner.hidden = true;
    if (diffBar) diffBar.hidden = false;
    switchCategory('icon');
  }

  // Reset Statistics Confirmation
  function resetAllStatistics() {
    const ok = window.confirm('Reset all saved memory records, best times, and game counts? This action cannot be undone.');
    if (!ok) return;

    try {
      const keysToRemove: string[] = [];
      for (let i = 0; i < localStorage.length; i++) {
        const k = localStorage.key(i);
        if (k && (k.startsWith('pf-memory-matching-adults-v1') || k.startsWith('pf-memory-matching-kids-v1') || k === 'pf-memory-matching-daily-v1')) {
          keysToRemove.push(k);
        }
      }
      keysToRemove.forEach(k => localStorage.removeItem(k));
      showToast('All statistics have been reset.');
      updateStatsBar();
    } catch {
      // Ignore
    }
  }

  // Share Score Functionality
  async function shareScore() {
    const config = DIFFICULTY_MAP[currentDifficulty];
    const catName = currentCategory.charAt(0).toUpperCase() + currentCategory.slice(1);
    const modeName = currentMode === 'adults' ? 'Adults' : 'Kids';
    const shareText = `PuzzleFeels Memory Matching (${modeName} · ${currentDifficulty.toUpperCase()} · ${catName}): Solved all ${config.pairs} pairs in ${formatTime(timerSeconds)} (${moves} moves)! Play free: https://puzzlefeels.com/memory-matching-game-online/`;

    if (navigator.share) {
      try {
        await navigator.share({
          title: 'Memory Matching Game Online – PuzzleFeels',
          text: shareText,
          url: 'https://puzzlefeels.com/memory-matching-game-online/'
        });
        showToast('Shared successfully!');
      } catch {
        // User cancelled share
      }
    } else if (navigator.clipboard) {
      try {
        await navigator.clipboard.writeText(shareText);
        showToast('Results copied to clipboard!');
      } catch {
        showToast('Failed to copy score.');
      }
    }
  }

  // ==========================================
  // EVENT LISTENERS & INITIALIZATION
  // ==========================================

  // Player Mode buttons
  document.querySelectorAll<HTMLButtonElement>('.memory-mode-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const mode = btn.dataset.playerMode as PlayerMode;
      if (mode) switchPlayerMode(mode);
    });
  });

  // Category buttons
  document.querySelectorAll<HTMLButtonElement>('.memory-cat-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      let cat = btn.dataset.category as Category;
      if ((cat as string) === 'emoji') cat = 'icon';
      if (cat) switchCategory(cat);
    });
  });

  // Difficulty buttons
  document.querySelectorAll<HTMLButtonElement>('.memory-diff-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const diff = btn.dataset.difficulty as Difficulty;
      if (diff) switchDifficulty(diff);
    });
  });

  // Toolbar Actions
  document.getElementById('memory-hint-btn')?.addEventListener('click', provideHint);
  document.getElementById('memory-pause-btn')?.addEventListener('click', togglePause);
  document.getElementById('memory-restart-btn')?.addEventListener('click', () => restartCurrentGame(true));
  document.getElementById('memory-new-btn')?.addEventListener('click', () => startNewGame(true));
  document.getElementById('memory-resume-btn')?.addEventListener('click', togglePause);
  document.getElementById('memory-daily-toggle')?.addEventListener('click', toggleDailyMode);
  document.getElementById('exit-daily-btn')?.addEventListener('click', exitDailyMode);
  document.getElementById('memory-reset-stats')?.addEventListener('click', resetAllStatistics);

  // Victory modal buttons & close
  document.getElementById('victory-replay-btn')?.addEventListener('click', () => restartCurrentGame(false));
  document.getElementById('victory-new-btn')?.addEventListener('click', () => startNewGame(false));
  document.getElementById('victory-share-btn')?.addEventListener('click', shareScore);
  document.getElementById('victory-close-btn')?.addEventListener('click', () => {
    if (victoryOverlay) {
      victoryOverlay.hidden = true;
      victoryOverlay.classList.remove('is-active');
    }
  });

  // Sound toggle
  const soundBtn = document.getElementById('memory-sound-toggle') as HTMLButtonElement;
  const soundOnIcon = soundBtn?.querySelector('.sound-on-icon') as HTMLElement;
  const soundOffIcon = soundBtn?.querySelector('.sound-off-icon') as HTMLElement;
  const soundLabel = soundBtn?.querySelector('.sound-label') as HTMLElement;

  if (soundBtn) {
    soundBtn.addEventListener('click', () => {
      soundEnabled = !soundEnabled;
      soundBtn.setAttribute('aria-pressed', String(soundEnabled));
      if (soundOnIcon) soundOnIcon.hidden = !soundEnabled;
      if (soundOffIcon) soundOffIcon.hidden = soundEnabled;
      if (soundLabel) soundLabel.textContent = soundEnabled ? 'Sound' : 'Muted';
      try {
        localStorage.setItem('pf-memory-matching-preferences-v1', JSON.stringify({ sound: soundEnabled }));
      } catch {
        // Ignore
      }
    });

    try {
      const rawPref = localStorage.getItem('pf-memory-matching-preferences-v1');
      if (rawPref) {
        const parsed = JSON.parse(rawPref);
        if (parsed && parsed.sound === false) {
          soundEnabled = false;
          soundBtn.setAttribute('aria-pressed', 'false');
          if (soundOnIcon) soundOnIcon.hidden = true;
          if (soundOffIcon) soundOffIcon.hidden = false;
          if (soundLabel) soundLabel.textContent = 'Muted';
        }
      }
    } catch {
      // Ignore
    }
  }

  // Check URL query parameters (e.g. ?daily=today)
  const urlParams = new URLSearchParams(window.location.search);
  if (urlParams.get('daily') === 'today') {
    toggleDailyMode();
  } else {
    // Initial start in Easy Icon mode
    startNewGame(false);
  }
</script>

