---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FaqList from '../components/FaqList.astro';
import ZoomControl from '../components/ZoomControl.astro';

const title = 'Memory Matching Game Online – Play Free Memory Card Games';
const description = 'Play our free Memory Matching Game Online! Match icon, number, color, and shape cards, test your memory, beat your best time, and enjoy daily challenges.';

const faqs = [
  {
    question: 'What is a memory matching game?',
    answer: 'A memory matching game (also historically known as Concentration, Pelmanism, or Pairs) is a tabletop or digital puzzle where players flip over two face-down cards at a time to identify matching pairs. When a pair matches, it stays revealed; when cards differ, they flip back down. The objective is to recall previous card locations and clear the entire board in the fewest moves and fastest time.'
  },
  {
    question: 'How do you play this memory card matching game?',
    answer: 'Click or tap any face-down card to reveal its symbol, then select a second card. If both cards display the identical item, they remain face up and count toward your matched pairs. If they do not match, both cards turn face down again after a brief pause. Continue flipping cards until every pair has been matched.'
  },
  {
    question: 'Is this memory matching game free to play?',
    answer: 'Yes, 100% free. The Memory Matching Game on PuzzleFeels requires no subscription, credit card, registration, or hidden fees. You can jump directly into a game on any desktop, tablet, or smartphone browser.'
  },
  {
    question: 'Can I play this memory game online without downloading anything?',
    answer: 'Yes. The game runs directly in your standard modern web browser using lightweight client-side code. There are no downloads, app store installations, or browser plugins required.'
  },
  {
    question: 'What is the difference between Easy, Medium, and Hard levels?',
    answer: 'Easy features a 4×3 grid with 12 cards (6 matching pairs), perfect for quick warm-ups and beginners. Medium expands to a 4×4 grid with 16 cards (8 matching pairs), offering a balanced concentration test. Hard provides a 6×4 grid with 24 cards (12 matching pairs), demanding keen spatial recall and systematic mapping.'
  },
  {
    question: 'Are there memory matching games for adults?',
    answer: 'Yes! Adults Mode focuses on cognitive speed, move efficiency, and personal records. The larger Hard grid (24 cards) and abstract Shape, Number, or Icon categories provide a genuine concentration workout that challenges adult working memory and sustained focus.'
  },
  {
    question: 'Is this game suitable for kids?',
    answer: 'Yes. Kids Mode provides cheerful, encouraging feedback, larger visual symbols, friendly vector illustrations, and bright colors. It eliminates stressful timers or negative feedback, making it an engaging way for children to develop visual recognition, patience, and memory skills.'
  },
  {
    question: 'What are icon, number, color, and shape matching games?',
    answer: 'These are four distinct matching categories available in the game. Icon Matching uses modern vector illustrations of everyday objects and nature; Number Matching uses high-contrast numerals with accent cards; Color Matching displays vibrant color swatches with accessible geometric patterns; and Shape Matching tests geometric pattern recognition (stars, hearts, circles, diamonds, and shields).'
  },
  {
    question: 'How can I finish a memory game in fewer moves?',
    answer: 'To minimize moves, scan the grid systematically rather than flipping cards randomly. Mentally assign names or quadrant coordinates to cards as they are revealed, and avoid guessing when opening a second card—only flip a card if you already know where its match is located.'
  },
  {
    question: 'Does this memory game save my best time?',
    answer: 'Yes. Your best completion times and move counts are automatically saved in your browser’s local storage. Records are kept completely separate for Adults Mode, Kids Mode, each matching category, each difficulty level, and the Daily Memory Challenge.'
  },
  {
    question: 'What is a daily memory challenge?',
    answer: 'The Daily Memory Challenge is a unique puzzle synchronized to the current UTC date. Every player around the world receives the exact same category, difficulty, and shuffled card layout for that day. You can complete the challenge once per day and track your daily streak.'
  },
  {
    question: 'Can I play this memory game on my mobile phone?',
    answer: 'Yes. The game is built mobile-first with touch-friendly card dimensions, responsive grid layouts, 3D flip animations, and full dark theme support across all screen sizes from 320px smartphones to high-resolution tablets.'
  }
];

const gameSchema = {
  '@context': 'https://schema.org',
  '@type': 'VideoGame',
  name: 'Memory Matching Game Online',
  url: 'https://puzzlefeels.com/memory-matching-game-online/',
  description,
  gamePlatform: 'Web browser',
  applicationCategory: 'Puzzle game',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  publisher: { '@type': 'Organization', name: 'PuzzleFeels', url: 'https://puzzlefeels.com/' }
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://puzzlefeels.com/' },
    { '@type': 'ListItem', position: 2, name: 'Games', item: 'https://puzzlefeels.com/games/' },
    { '@type': 'ListItem', position: 3, name: 'Memory Matching Game Online', item: 'https://puzzlefeels.com/memory-matching-game-online/' }
  ]
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(faq => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer
    }
  }))
};
---

<Base {title} {description} path="/memory-matching-game-online/">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(gameSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <Header />

  <main class="memory-page">
    <nav class="wrap memory-breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">›</span>
      <a href="/games/">Games</a>
      <span aria-hidden="true">›</span>
      <span aria-current="page">Memory Matching Game Online</span>
    </nav>

    <section class="wrap memory-intro">
      <span class="eyebrow">Visual recall & concentration puzzle</span>
      <h1>Memory Matching Game Online</h1>
      <p class="muted">Match the Cards, Train Your Memory, and Beat Your Best Time. Flip cards, reveal matching pairs across icon, number, color, and shape categories, and challenge your focus across multiple difficulty levels. Play free on any device with no downloads or account needed.</p>
    </section>

    <!-- Main Game Shell -->
    <section class="wrap memory-shell card" data-memory-game aria-label="Interactive memory matching game">
      <!-- Player Mode Selector (Adults vs Kids) -->
      <div class="memory-player-modes" role="group" aria-label="Choose player mode">
        <button type="button" class="memory-mode-btn is-active" data-player-mode="adults" aria-pressed="true">
          <svg class="mode-icon-svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9.5 2A2.5 2.5 0 0 1 12 4.5v15a2.5 2.5 0 0 1-4.96.44 2.5 2.5 0 0 1-2.96-3.08 3 3 0 0 1-.34-5.58 2.5 2.5 0 0 1 1.32-4.24 2.5 2.5 0 0 1 4.44-2.04z"></path>
            <path d="M14.5 2A2.5 2.5 0 0 0 12 4.5v15a2.5 2.5 0 0 0 4.96.44 2.5 2.5 0 0 0 2.96-3.08 3 3 0 0 0 .34-5.58 2.5 2.5 0 0 0-1.32-4.24 2.5 2.5 0 0 0-4.44-2.04z"></path>
          </svg>
          <span>Adults Mode</span>
        </button>
        <button type="button" class="memory-mode-btn" data-player-mode="kids" aria-pressed="false">
          <svg class="mode-icon-svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
          </svg>
          <span>Kids Mode</span>
        </button>
      </div>

      <!-- Categories & Quick Actions Bar -->
      <div class="memory-controls-bar">
        <div class="memory-categories" role="group" aria-label="Matching categories">
          <button type="button" class="memory-cat-btn is-active" data-category="icon" aria-pressed="true">
            <svg class="cat-svg" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"></circle>
              <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76" fill="currentColor" fill-opacity="0.25"></polygon>
            </svg>
            <span>Icons</span>
          </button>
          <button type="button" class="memory-cat-btn" data-category="number" aria-pressed="false">
            <svg class="cat-svg" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="4" y1="9" x2="20" y2="9"></line>
              <line x1="4" y1="15" x2="20" y2="15"></line>
              <line x1="10" y1="3" x2="8" y2="21"></line>
              <line x1="16" y1="3" x2="14" y2="21"></line>
            </svg>
            <span>Numbers</span>
          </button>
          <button type="button" class="memory-cat-btn" data-category="color" aria-pressed="false">
            <svg class="cat-svg" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="13.5" cy="6.5" r=".5" fill="currentColor"></circle>
              <circle cx="17.5" cy="10.5" r=".5" fill="currentColor"></circle>
              <circle cx="8.5" cy="7.5" r=".5" fill="currentColor"></circle>
              <circle cx="6.5" cy="12.5" r=".5" fill="currentColor"></circle>
              <path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.563-2.512 5.563-5.563C22 6.5 17.5 2 12 2z"></path>
            </svg>
            <span>Colors</span>
          </button>
          <button type="button" class="memory-cat-btn" data-category="shape" aria-pressed="false">
            <svg class="cat-svg" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 2L2 12l10 10 10-10L12 2z"></path>
            </svg>
            <span>Shapes</span>
          </button>
        </div>

        <div class="memory-quick-actions">
          <ZoomControl id="memory-zoom" label="Board Zoom" targetSelector="#memory-grid" zoomVar="--memory-zoom" />
          <button type="button" class="btn secondary memory-btn-action" id="memory-sound-toggle" aria-label="Toggle sound effects" aria-pressed="true">
            <svg class="sound-on-icon btn-svg" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
              <path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path>
              <path d="M19.07 4.93a10 10 0 0 1 0 14.14"></path>
            </svg>
            <svg class="sound-off-icon btn-svg" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" hidden>
              <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
              <line x1="23" y1="9" x2="17" y2="15"></line>
              <line x1="17" y1="9" x2="23" y2="15"></line>
            </svg>
            <span class="sound-label">Sound</span>
          </button>
          <button type="button" class="btn secondary memory-btn-action" id="memory-daily-toggle" aria-label="Toggle daily memory challenge">
            <svg class="btn-svg" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            <span>Daily</span>
          </button>
        </div>
      </div>

      <!-- Difficulty Selector Bar -->
      <div class="memory-difficulty-bar" id="memory-difficulty-bar">
        <div class="memory-difficulties" role="group" aria-label="Select board difficulty">
          <button type="button" class="memory-diff-btn is-active" data-difficulty="easy" aria-pressed="true">
            <strong>Easy</strong>
            <span>4 × 3 · 6 Pairs</span>
          </button>
          <button type="button" class="memory-diff-btn" data-difficulty="medium" aria-pressed="false">
            <strong>Medium</strong>
            <span>4 × 4 · 8 Pairs</span>
          </button>
          <button type="button" class="memory-diff-btn" data-difficulty="hard" aria-pressed="false">
            <strong>Hard</strong>
            <span>6 × 4 · 12 Pairs</span>
          </button>
        </div>
      </div>

      <!-- Daily Challenge Banner (Active in Daily Mode) -->
      <div class="memory-daily-banner" id="memory-daily-banner" hidden>
        <div class="daily-banner-info">
          <span class="daily-badge">
            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
            </svg>
            DAILY CHALLENGE
          </span>
          <strong id="daily-date-label">Today's Memory Challenge</strong>
          <span class="daily-status-tag" id="daily-status-tag">Ready to Play</span>
        </div>
        <button type="button" class="btn secondary exit-daily-btn" id="exit-daily-btn">
          <span>Exit Daily</span>
          <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
      </div>

      <!-- Live Statistics Strip -->
      <div class="memory-stats-bar">
        <div class="stat-cell">
          <small>Moves</small>
          <strong id="stat-moves">0</strong>
        </div>
        <div class="stat-cell">
          <small>Time</small>
          <strong id="stat-timer">00:00</strong>
        </div>
        <div class="stat-cell">
          <small>Pairs Matched</small>
          <strong id="stat-pairs">0 / 6</strong>
        </div>
        <div class="stat-cell">
          <small>Best Time</small>
          <strong id="stat-best">—</strong>
        </div>
      </div>

      <!-- Progress Track -->
      <div class="memory-progress-wrap" aria-label="Matching progress">
        <div class="memory-progress-bar" id="memory-progress-bar" style="width: 0%;"></div>
      </div>

      <!-- Main Game Board Grid -->
      <div class="memory-board-wrapper">
        <div 
          id="memory-grid" 
          class="memory-grid grid-easy" 
          role="grid" 
          aria-label="Memory card matching board"
        >
          <!-- Dynamically populated by client JavaScript -->
        </div>

        <!-- Pause Screen Overlay -->
        <div id="memory-paused" class="memory-overlay" hidden>
          <div class="memory-overlay-box">
            <span class="eyebrow">Game Paused</span>
            <h2>Take a Breather</h2>
            <p class="muted">Timer stopped and cards hidden. Your session is safe. Click resume whenever you are ready to continue.</p>
            <button type="button" class="btn" id="memory-resume-btn">
              <span>Resume Game</span>
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </button>
          </div>
        </div>

        <!-- Victory Modal Overlay (Redesigned Premium Results) -->
        <div id="memory-victory" class="memory-overlay" hidden>
          <div class="memory-overlay-box victory-box" role="dialog" aria-modal="true" aria-labelledby="victory-title">
            <button type="button" class="victory-close-btn" id="victory-close-btn" aria-label="Close results modal">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
            </button>

            <div class="victory-trophy-badge" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 9H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h2"></path>
                <path d="M18 9h2a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2h-2"></path>
                <path d="M4 22h16"></path>
                <path d="M10 14.66V17c0 .55-.45 1-1 1H7v4h10v-4h-2c-.55 0-1-.45-1-1v-2.34"></path>
                <path d="M4 3h16v7a8 8 0 0 1-16 0V3z"></path>
              </svg>
            </div>

            <div class="victory-mode-badge" id="victory-mode-pill">Adults Mode · Easy · Icons</div>
            <h2 id="victory-title">Game Completed!</h2>
            <p class="muted" id="victory-message">You matched all cards with exceptional focus and memory recall.</p>

            <!-- Star rating using clean SVG stars -->
            <div class="victory-stars" id="victory-stars" aria-label="Performance Rating: 3 Stars">
              <svg class="star active" viewBox="0 0 24 24" width="26" height="26" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
              <svg class="star active" viewBox="0 0 24 24" width="26" height="26" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
              <svg class="star active" viewBox="0 0 24 24" width="26" height="26" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
            </div>

            <!-- Stats Grid -->
            <div class="victory-stats-grid">
              <div class="victory-stat-item">
                <small>Total Time</small>
                <strong id="victory-time">00:42</strong>
              </div>
              <div class="victory-stat-item">
                <small>Total Moves</small>
                <strong id="victory-moves">14</strong>
              </div>
              <div class="victory-stat-item">
                <small>Matched Pairs</small>
                <strong id="victory-pairs">6 / 6</strong>
              </div>
              <div class="victory-stat-item">
                <small>Best Time</small>
                <strong id="victory-best-time">—</strong>
              </div>
              <div class="victory-stat-item">
                <small>Hints Used</small>
                <strong id="victory-hints">0</strong>
              </div>
              <div class="victory-stat-item">
                <small>Difficulty</small>
                <strong id="victory-diff-label">Easy</strong>
              </div>
            </div>

            <div class="victory-pb-banner" id="victory-pb-banner" hidden>
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
              <span>New Personal Best Record for this Mode!</span>
            </div>

            <div class="victory-actions">
              <button type="button" class="btn primary-victory-btn" id="victory-replay-btn">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="1 4 1 10 7 10"></polyline><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path></svg>
                <span>Play Again</span>
              </button>
              <button type="button" class="btn secondary" id="victory-new-btn">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                <span>New Game</span>
              </button>
              <button type="button" class="btn secondary" id="victory-share-btn">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line></svg>
                <span>Share Result</span>
              </button>
            </div>
          </div>
        </div>

        <!-- Kids Encouragement Toast (SVG Star / Checkmark) -->
        <div id="kids-toast" class="kids-toast" aria-live="polite" hidden>
          <span class="kids-toast-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
              <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
          </span>
          <span class="kids-toast-text">Awesome Match!</span>
        </div>
      </div>

      <!-- Action Toolbar -->
      <div class="memory-toolbar">
        <button type="button" class="btn secondary toolbar-btn" id="memory-hint-btn" title="Highlight one available matching pair briefly">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9 18h6"></path>
            <path d="M10 22h4"></path>
            <path d="M12 2a7 7 0 0 0-7 7c0 2.5 1.5 4.5 3 6h8c1.5-1.5 3-3.5 3-6a7 7 0 0 0-7-7z"></path>
          </svg>
          <span>Hint</span>
        </button>
        <button type="button" class="btn secondary toolbar-btn" id="memory-pause-btn">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="6" y="4" width="4" height="16"></rect>
            <rect x="14" y="4" width="4" height="16"></rect>
          </svg>
          <span>Pause</span>
        </button>
        <button type="button" class="btn secondary toolbar-btn" id="memory-restart-btn">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="1 4 1 10 7 10"></polyline>
            <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
          </svg>
          <span>Restart</span>
        </button>
        <button type="button" class="btn toolbar-btn" id="memory-new-btn">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="12" y1="5" x2="12" y2="19"></line>
