<!-- Client Game Implementation Script -->
<script>
  import { TILE_DEFINITIONS } from '../lib/mahjong/tiles';
  import {
    isTileFree,
    findSolitaireHint,
    generateSolvableSolitaireBoard,
    shuffleSolitaireTiles,
    type SolitaireTile,
  } from '../lib/mahjong/solitaire';
  import {
    findConnectPath,
    findConnectHint,
    generateConnectBoard,
    shuffleConnectTiles,
    buildConnectGridMatrix,
    type ConnectTile,
    type ConnectPoint,
  } from '../lib/mahjong/connect';
  import {
    isTripleTileFree,
    findTripleHint,
    generateTripleBoard,
    shuffleTripleTiles,
    insertTileIntoTray,
    type TripleTile,
  } from '../lib/mahjong/triple';
  import { soundManager } from '../lib/mahjong/sound';
  import {
    storage,
    getUtcDateString,
    createSeededRng,
    type GameMode,
    type GameDifficulty,
  } from '../lib/mahjong/storage';

  // --- Client State ---
  let currentMode: GameMode = 'solitaire';
  let currentDifficulty: GameDifficulty = 'easy';
  let isDaily = false;
  let moves = 0;
  let score = 0;
  let timerSeconds = 0;
  let timerInterval: number | null = null;
  let isTimerRunning = false;
  let isPaused = false;
  let isCompleted = false;
  let isGameOver = false;

  // Active Boards
  let solitaireTiles: SolitaireTile[] = [];
  let selectedSolitaireTileId: string | null = null;

  let connectTiles: ConnectTile[] = [];
  let connectRows = 6;
  let connectCols = 6;
  let selectedConnectTileId: string | null = null;

  let tripleBoardTiles: TripleTile[] = [];
  let tripleTrayTiles: TripleTile[] = [];

  // Undo Stack
  interface UndoState {
    solitaireTiles?: SolitaireTile[];
    connectTiles?: ConnectTile[];
    tripleBoardTiles?: TripleTile[];
    tripleTrayTiles?: TripleTile[];
    score: number;
    moves: number;
  }
  let undoStack: UndoState[] = [];

  // DOM Elements
  const modeTabs = document.querySelectorAll<HTMLButtonElement>('.mahjong-mode-tab');
  const diffBtns = document.querySelectorAll<HTMLButtonElement>('.mahjong-diff-btn');
  const dailyToggle = document.getElementById('mahjong-daily-toggle') as HTMLButtonElement;
  const soundToggle = document.getElementById('mahjong-sound-toggle') as HTMLButtonElement;
  const soundLabel = document.getElementById('mahjong-sound-label') as HTMLElement;
  const soundOnIcon = soundToggle?.querySelector('.sound-on-icon') as HTMLElement;
  const soundOffIcon = soundToggle?.querySelector('.sound-off-icon') as HTMLElement;

  const statModeLabel = document.getElementById('stat-mode-label') as HTMLElement;
  const statScore = document.getElementById('stat-score') as HTMLElement;
  const statMoves = document.getElementById('stat-moves') as HTMLElement;
  const statRemaining = document.getElementById('stat-remaining') as HTMLElement;
  const statTimer = document.getElementById('stat-timer') as HTMLElement;
  const statBest = document.getElementById('stat-best') as HTMLElement;

  const solitaireBoardEl = document.getElementById('solitaire-board') as HTMLElement;
  const connectBoardEl = document.getElementById('connect-board') as HTMLElement;
  const connectGridEl = document.getElementById('connect-grid') as HTMLElement;
  const connectSvgOverlay = document.getElementById('connect-svg-overlay') as unknown as SVGSVGElement;
  const tripleBoardEl = document.getElementById('triple-board') as HTMLElement;
  const tripleBoardTilesEl = document.getElementById('triple-board-tiles') as HTMLElement;
  const tripleTrayEl = document.getElementById('triple-tray') as HTMLElement;
  const trayCountLabel = document.getElementById('tray-count-label') as HTMLElement;

  const btnNew = document.getElementById('btn-new-game') as HTMLButtonElement;
  const btnRestart = document.getElementById('btn-restart') as HTMLButtonElement;
  const btnUndo = document.getElementById('btn-undo') as HTMLButtonElement;
  const btnHint = document.getElementById('btn-hint') as HTMLButtonElement;
  const btnShuffle = document.getElementById('btn-shuffle') as HTMLButtonElement;
  const btnPause = document.getElementById('btn-pause') as HTMLButtonElement;

  const pausedOverlay = document.getElementById('mahjong-paused') as HTMLElement;
  const btnResume = document.getElementById('mahjong-resume') as HTMLButtonElement;
  const victoryOverlay = document.getElementById('mahjong-victory') as HTMLElement;
  const btnPlayAgain = document.getElementById('mahjong-play-again') as HTMLButtonElement;
  const btnVictoryNew = document.getElementById('mahjong-victory-new') as HTMLButtonElement;
  const btnShareResult = document.getElementById('mahjong-share-result') as HTMLButtonElement;
  const shareStatusEl = document.getElementById('mahjong-share-status') as HTMLElement;

  const gameoverOverlay = document.getElementById('mahjong-gameover') as HTMLElement;
  const btnRetry = document.getElementById('mahjong-retry') as HTMLButtonElement;
  const btnGameoverNew = document.getElementById('mahjong-gameover-new') as HTMLButtonElement;

  const confirmOverlay = document.getElementById('mahjong-confirm') as HTMLElement;
  const confirmCancel = document.getElementById('confirm-cancel') as HTMLButtonElement;
  const confirmProceed = document.getElementById('confirm-proceed') as HTMLButtonElement;
  let pendingResetAction: (() => void) | null = null;

  const helpText = document.getElementById('mahjong-help-text') as HTMLElement;
  const ariaLive = document.getElementById('mahjong-aria-live') as HTMLElement;

  // --- Sound Initialization ---
  function updateSoundUI() {
    const enabled = storage.getSoundEnabled();
    soundManager.setEnabled(enabled);
    if (soundLabel) soundLabel.textContent = enabled ? 'Sound: On' : 'Sound: Off';
    if (soundOnIcon) soundOnIcon.hidden = !enabled;
    if (soundOffIcon) soundOffIcon.hidden = enabled;
    soundToggle?.setAttribute('aria-pressed', String(enabled));
  }

  soundToggle?.addEventListener('click', () => {
    const next = !storage.getSoundEnabled();
    storage.setSoundEnabled(next);
    updateSoundUI();
    if (next) soundManager.playSelect();
  });

  // --- Timer Management ---
  function formatTime(totalSeconds: number): string {
    const m = Math.floor(totalSeconds / 60);
    const s = totalSeconds % 60;
    return `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
  }

  function startTimer() {
    if (isTimerRunning || isCompleted || isGameOver || isPaused) return;
    isTimerRunning = true;
    timerInterval = window.setInterval(() => {
      timerSeconds++;
      if (statTimer) statTimer.textContent = formatTime(timerSeconds);
    }, 1000);
  }

  function stopTimer() {
    if (timerInterval) {
      clearInterval(timerInterval);
      timerInterval = null;
    }
    isTimerRunning = false;
  }

  function resetTimer() {
    stopTimer();
    timerSeconds = 0;
    if (statTimer) statTimer.textContent = '00:00';
  }

  // --- Stats and Best Records ---
  function updateStatsUI() {
    if (statScore) statScore.textContent = String(score);
    if (statMoves) statMoves.textContent = String(moves);
    if (statTimer) statTimer.textContent = formatTime(timerSeconds);
    if (btnUndo) btnUndo.disabled = undoStack.length === 0 || isCompleted || isGameOver || isPaused;

    let remaining = 0;
    if (currentMode === 'solitaire') remaining = solitaireTiles.length;
    else if (currentMode === 'connect') remaining = connectTiles.filter((t) => t.tileId).length;
    else if (currentMode === 'triple') remaining = tripleBoardTiles.length + tripleTrayTiles.length;
    if (statRemaining) statRemaining.textContent = String(remaining);

    // Update best record
    const best = storage.getBestRecord(currentMode, currentDifficulty);
    if (statBest) {
      statBest.textContent = best && best.bestTime !== Infinity ? `${formatTime(best.bestTime)} (${best.bestScore} pts)` : '—';
    }

    saveCurrentState();
  }

  function saveCurrentState() {
    let boardState: any = null;
    let trayState: any = null;

    if (currentMode === 'solitaire') boardState = solitaireTiles;
    else if (currentMode === 'connect') boardState = { tiles: connectTiles, rows: connectRows, cols: connectCols };
    else if (currentMode === 'triple') {
      boardState = tripleBoardTiles;
      trayState = tripleTrayTiles;
    }

    storage.saveGame({
      mode: currentMode,
      difficulty: currentDifficulty,
      isDaily,
      dailyDate: getUtcDateString(),
      moves,
      score,
      elapsedSeconds: timerSeconds,
      boardState,
      trayState,
      status: isCompleted ? 'won' : isGameOver ? 'lost' : isPaused ? 'paused' : 'playing',
      timestamp: Date.now(),
    });
  }

  // --- Confirm Dialog Helper ---
  function requireResetConfirmation(action: () => void) {
    if (moves > 0 && !isCompleted && !isGameOver) {
      pendingResetAction = action;
      if (confirmOverlay) confirmOverlay.hidden = false;
    } else {
      action();
    }
  }

  confirmCancel?.addEventListener('click', () => {
    if (confirmOverlay) confirmOverlay.hidden = true;
    pendingResetAction = null;
  });

  confirmProceed?.addEventListener('click', () => {
    if (confirmOverlay) confirmOverlay.hidden = true;
    if (pendingResetAction) {
      pendingResetAction();
      pendingResetAction = null;
    }
  });

  // --- Tile Rendering Helper ---
  function createTileHtml(tileId: string, className = '', customAttrs = ''): string {
    const def = TILE_DEFINITIONS[tileId] || { svg: '', label: '?' };
    return `<div class="mahjong-tile ${className}" data-tile-id="${tileId}" ${customAttrs} tabindex="0" role="button" aria-label="${def.name || tileId}">
      <div class="tile-face">
        ${def.svg}
      </div>
      <div class="tile-side-bevel" aria-hidden="true"></div>
    </div>`;
  }

  // --- Solitaire Mode Controller ---
  function updateSolitaireSelectionUI() {
    if (!solitaireBoardEl) return;
    solitaireBoardEl.querySelectorAll<HTMLElement>('.solitaire-tile').forEach((el) => {
      const isSelected = el.dataset.id === selectedSolitaireTileId;
      el.classList.toggle('is-selected', isSelected);
    });
  }

  function renderSolitaireBoard() {
    if (!solitaireBoardEl) return;
    solitaireBoardEl.innerHTML = '';

    if (solitaireTiles.length === 0) {
      solitaireBoardEl.style.width = '0px';
      solitaireBoardEl.style.height = '0px';
      return;
    }

    // Calculate bounding dimensions for responsive scaling
    let minX = Infinity;
    let maxX = -Infinity;
    let minY = Infinity;
    let maxY = -Infinity;
    let maxZ = 0;
    for (const t of solitaireTiles) {
      if (t.x < minX) minX = t.x;
      if (t.x > maxX) maxX = t.x;
      if (t.y < minY) minY = t.y;
      if (t.y > maxY) maxY = t.y;
      if (t.z > maxZ) maxZ = t.z;
    }

    const unitW = 24; // unit step in px
    const unitH = 28;
    const tileW = 44;
    const tileH = 56;
    const padX = 8;
    const padY = maxZ * 6 + 10;

    const boardWidth = (maxX - minX) * unitW + tileW + padX * 2;
    const boardHeight = padY + (maxY - minY) * unitH + tileH + 16;
    solitaireBoardEl.style.width = `${boardWidth}px`;
    solitaireBoardEl.style.height = `${boardHeight}px`;

    const wrapper = solitaireBoardEl.closest('.mahjong-board-wrapper') as HTMLElement;
    const wrapperW = wrapper?.clientWidth || (window.innerWidth - 32);
    const availableW = wrapperW - 16;
    if (availableW > 0 && availableW < boardWidth) {
      const scale = Math.min(1, Math.max(0.35, availableW / boardWidth));
      solitaireBoardEl.style.transform = `scale(${scale})`;
      solitaireBoardEl.style.transformOrigin = 'top center';
      solitaireBoardEl.style.marginBottom = `-${boardHeight * (1 - scale)}px`;
    } else {
      solitaireBoardEl.style.transform = '';
      solitaireBoardEl.style.transformOrigin = 'top center';
      solitaireBoardEl.style.marginBottom = '';
    }
    solitaireBoardEl.style.marginLeft = '';
    solitaireBoardEl.style.marginRight = '';

    for (const t of solitaireTiles) {
      const free = isTileFree(t, solitaireTiles);
      const isSelected = selectedSolitaireTileId === t.id;
      const left = padX + (t.x - minX) * unitW;
      const top = padY + (t.y - minY) * unitH - t.z * 6; // elevation 3D shift

      const el = document.createElement('div');
      el.className = `mahjong-tile solitaire-tile ${free ? 'is-free' : 'is-blocked'} ${isSelected ? 'is-selected' : ''}`;
      el.id = t.id;
      el.dataset.id = t.id;
      el.dataset.tileId = t.tileId;
      el.style.left = `${left}px`;
      el.style.top = `${top}px`;
      el.style.zIndex = String(t.z * 100 + t.y);

      const def = TILE_DEFINITIONS[t.tileId] || { svg: '', name: t.tileId };
      el.innerHTML = `
        <div class="tile-face">
          ${def.svg}
        </div>
        <div class="tile-side-bevel" aria-hidden="true"></div>
      `;

      el.addEventListener('click', () => onSolitaireTileClick(t));
      el.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          onSolitaireTileClick(t);
        }
      });
      solitaireBoardEl.appendChild(el);
    }
  }

  function onSolitaireTileClick(target: SolitaireTile) {
    if (isPaused || isCompleted || isGameOver) return;
    startTimer();

    const free = isTileFree(target, solitaireTiles);
    if (!free) {
      soundManager.playInvalid();
      const el = document.getElementById(target.id);
      if (el) {
        el.classList.add('is-shaking');
        setTimeout(() => el.classList.remove('is-shaking'), 300);
      }
      return;
    }

    if (!selectedSolitaireTileId) {
      // First tile selected
      selectedSolitaireTileId = target.id;
      soundManager.playSelect();
      updateSolitaireSelectionUI();
    } else if (selectedSolitaireTileId === target.id) {
      // Deselect
      selectedSolitaireTileId = null;
      soundManager.playSelect();
      updateSolitaireSelectionUI();
    } else {
      // Second tile selected
      const first = solitaireTiles.find((t) => t.id === selectedSolitaireTileId);
      if (!first) {
        selectedSolitaireTileId = target.id;
        updateSolitaireSelectionUI();
        return;
      }

      if (first.tileId === target.tileId) {
        // MATCH!
        pushUndoState();
        moves++;
        score += 100;
        soundManager.playMatch();

        // Animate match
        const el1 = document.getElementById(first.id);
        const el2 = document.getElementById(target.id);
        if (el1) el1.classList.add('is-matching');
        if (el2) el2.classList.add('is-matching');

        setTimeout(() => {
          solitaireTiles = solitaireTiles.filter((t) => t.id !== first.id && t.id !== target.id);
          selectedSolitaireTileId = null;
          renderSolitaireBoard();
          updateStatsUI();

          if (solitaireTiles.length === 0) {
            handleVictory();
          } else {
            // Check if moves remain; if not, prompt or shuffle
            const hint = findSolitaireHint(solitaireTiles);
            if (!hint && solitaireTiles.length > 0) {
              if (ariaLive) ariaLive.textContent = 'No matching free tiles remaining! Shuffle available.';
            }
          }
        }, 180);
      } else {
        // Mismatch
        soundManager.playInvalid();
        selectedSolitaireTileId = target.id;
        updateSolitaireSelectionUI();
      }
    }
  }

  // --- Connect Mode Controller ---
  function renderConnectBoard() {
    if (!connectGridEl || !connectBoardEl) return;
    connectGridEl.innerHTML = '';

    const cellW = 46;
    const cellH = 58;
    const gap = 8;
    const pad = 16;
    const gridW = connectCols * cellW + (connectCols - 1) * gap;
    const gridH = connectRows * cellH + (connectRows - 1) * gap;
    const boardWidth = gridW + pad * 2;
    const boardHeight = gridH + pad * 2;

    connectBoardEl.style.width = `${boardWidth}px`;
    connectBoardEl.style.height = `${boardHeight}px`;
    connectGridEl.style.width = `${gridW}px`;
    connectGridEl.style.height = `${gridH}px`;
    connectGridEl.style.gridTemplateColumns = `repeat(${connectCols}, ${cellW}px)`;
    connectGridEl.style.gap = `${gap}px`;

    for (const t of connectTiles) {
      const cell = document.createElement('div');
      cell.className = 'connect-cell';
      cell.style.width = `${cellW}px`;
      cell.style.height = `${cellH}px`;
      cell.dataset.r = String(t.r);
      cell.dataset.c = String(t.c);

      if (t.tileId) {
        const isSelected = selectedConnectTileId === t.id;
        const def = TILE_DEFINITIONS[t.tileId] || { svg: '', name: t.tileId };
        const tile = document.createElement('div');
        tile.className = `mahjong-tile connect-tile ${isSelected ? 'is-selected' : ''}`;
        tile.id = t.id;
        tile.dataset.id = t.id;
        tile.tabIndex = 0;
        tile.role = 'button';
        tile.setAttribute('aria-label', def.name || t.tileId);
        tile.innerHTML = `
          <div class="tile-face">${def.svg}</div>
          <div class="tile-side-bevel" aria-hidden="true"></div>
        `;
        tile.addEventListener('click', () => onConnectTileClick(t));
        tile.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            onConnectTileClick(t);
          }
        });
        cell.appendChild(tile);
      }
      connectGridEl.appendChild(cell);
    }

    // Dynamic responsive scaling for Connect grid on smaller screens
    const wrapper = connectBoardEl.closest('.mahjong-board-wrapper') as HTMLElement;
    const wrapperW = wrapper?.clientWidth || (window.innerWidth - 32);
    const availableW = wrapperW - 16;
    if (availableW > 0 && availableW < boardWidth) {
      const scale = Math.min(1, Math.max(0.35, availableW / boardWidth));
      connectBoardEl.style.transform = `scale(${scale})`;
      connectBoardEl.style.transformOrigin = 'top center';
      connectBoardEl.style.marginBottom = `-${boardHeight * (1 - scale)}px`;
    } else {
      connectBoardEl.style.transform = '';
      connectBoardEl.style.transformOrigin = 'top center';
      connectBoardEl.style.marginBottom = '';
    }
    connectBoardEl.style.marginLeft = '';
    connectBoardEl.style.marginRight = '';
  }

  function drawConnectPathAnimation(path: ConnectPoint[], onDone: () => void) {
    if (!connectSvgOverlay || !connectGridEl) {
      onDone();
      return;
    }

    const cellW = 46;
    const cellH = 58;
    const gap = 8;
    const gridW = connectCols * cellW + (connectCols - 1) * gap;
    const gridH = connectRows * cellH + (connectRows - 1) * gap;

    // Helper to get pixel center from (r, c)
    // Note: r=1..rows, c=1..cols. r=0 or r=rows+1 are outside border!
    function pointToPx(p: ConnectPoint): { x: number; y: number } {
      let x = (p.c - 0.5) * (cellW + gap) - gap / 2;
      let y = (p.r - 0.5) * (cellH + gap) - gap / 2;
      // Clamp/offset outer borders
      if (p.c === 0) x = -10;
      if (p.c === connectCols + 1) x = gridW + 10;
      if (p.r === 0) y = -10;
      if (p.r === connectRows + 1) y = gridH + 10;
      return { x, y };
    }

    const points = path.map(pointToPx);
    const d = points.map((pt, i) => `${i === 0 ? 'M' : 'L'} ${pt.x} ${pt.y}`).join(' ');

    connectSvgOverlay.setAttribute('viewBox', `0 0 ${gridW} ${gridH}`);
    connectSvgOverlay.innerHTML = `
      <path d="${d}" class="connect-beam-glow" />
      <path d="${d}" class="connect-beam-core" />
    `;

    setTimeout(() => {
      connectSvgOverlay.innerHTML = '';
      onDone();
    }, 280);
  }

  function updateConnectSelectionUI() {
    if (!connectGridEl) return;
    connectGridEl.querySelectorAll<HTMLElement>('.connect-tile').forEach((el) => {
      const isSelected = el.dataset.id === selectedConnectTileId;
      el.classList.toggle('is-selected', isSelected);
    });
  }

  function onConnectTileClick(target: ConnectTile) {
    if (isPaused || isCompleted || isGameOver || !target.tileId) return;
    startTimer();

    if (!selectedConnectTileId) {
      selectedConnectTileId = target.id;
      soundManager.playSelect();
      updateConnectSelectionUI();
    } else if (selectedConnectTileId === target.id) {
      selectedConnectTileId = null;
      soundManager.playSelect();
      updateConnectSelectionUI();
    } else {
      const first = connectTiles.find((t) => t.id === selectedConnectTileId);
      if (!first || !first.tileId) {
        selectedConnectTileId = target.id;
        updateConnectSelectionUI();
        return;
      }

      if (first.tileId !== target.tileId) {
        soundManager.playInvalid();
        selectedConnectTileId = target.id;
        updateConnectSelectionUI();
        return;
      }

      // Check path
      const p1: ConnectPoint = { r: first.r, c: first.c };
      const p2: ConnectPoint = { r: target.r, c: target.c };
      const grid = buildConnectGridMatrix(connectTiles, connectRows, connectCols);
      const path = findConnectPath(p1, p2, grid, connectRows + 2, connectCols + 2);

      if (path) {
        // MATCH!
        pushUndoState();
        moves++;
        score += 120;
        soundManager.playMatch();

        drawConnectPathAnimation(path, () => {
          first.tileId = '';
          target.tileId = '';
          selectedConnectTileId = null;
          renderConnectBoard();
          updateStatsUI();

          const remaining = connectTiles.filter((t) => t.tileId).length;
          if (remaining === 0) {
            handleVictory();
          } else {
            // Check if moves remain
            const hint = findConnectHint(connectTiles, connectRows, connectCols);
            if (!hint) {
              if (ariaLive) ariaLive.textContent = 'No direct connect moves available! Shuffling remaining tiles...';
              setTimeout(handleShuffle, 300);
            }
          }
        });
      } else {
        soundManager.playInvalid();
        const el = document.getElementById(target.id);
        if (el) {
          el.classList.add('is-shaking');
          setTimeout(() => el.classList.remove('is-shaking'), 300);
        }
      }
    }
  }

  // --- Triple Mahjong Mode Controller ---
  function renderTripleBoard() {
    if (!tripleBoardTilesEl || !tripleTrayEl) return;
    tripleBoardTilesEl.innerHTML = '';

    if (tripleBoardTiles.length === 0) {
      tripleBoardTilesEl.style.width = '0px';
      tripleBoardTilesEl.style.height = '0px';
    } else {
      // Calculate dimensions
      let minX = Infinity;
      let maxX = -Infinity;
      let minY = Infinity;
      let maxY = -Infinity;
      let maxZ = 0;
      for (const t of tripleBoardTiles) {
        if (t.x < minX) minX = t.x;
        if (t.x > maxX) maxX = t.x;
        if (t.y < minY) minY = t.y;
        if (t.y > maxY) maxY = t.y;
        if (t.z > maxZ) maxZ = t.z;
      }

      const unitW = 26;
      const unitH = 30;
      const tileW = 44;
      const tileH = 56;
      const padX = 8;
      const padY = maxZ * 6 + 10;

      const boardWidth = (maxX - minX) * unitW + tileW + padX * 2;
      const boardHeight = padY + (maxY - minY) * unitH + tileH + 16;
      tripleBoardTilesEl.style.width = `${boardWidth}px`;
      tripleBoardTilesEl.style.height = `${boardHeight}px`;

      const wrapper = tripleBoardEl.closest('.mahjong-board-wrapper') as HTMLElement;
      const wrapperW = wrapper?.clientWidth || (window.innerWidth - 32);
      const availableW = wrapperW - 16;
      if (availableW > 0 && availableW < boardWidth) {
        const scale = Math.min(1, Math.max(0.35, availableW / boardWidth));
        tripleBoardTilesEl.style.transform = `scale(${scale})`;
        tripleBoardTilesEl.style.transformOrigin = 'top center';
        tripleBoardTilesEl.style.marginBottom = `-${boardHeight * (1 - scale)}px`;
      } else {
        tripleBoardTilesEl.style.transform = '';
        tripleBoardTilesEl.style.transformOrigin = 'top center';
        tripleBoardTilesEl.style.marginBottom = '';
      }
      tripleBoardTilesEl.style.marginLeft = '';
      tripleBoardTilesEl.style.marginRight = '';

      for (const t of tripleBoardTiles) {
        const free = !isTripleTileFree(t, tripleBoardTiles);
        const left = padX + (t.x - minX) * unitW;
        const top = padY + (t.y - minY) * unitH - t.z * 6;

        const el = document.createElement('div');
        el.className = `mahjong-tile triple-tile ${free ? 'is-free' : 'is-blocked'}`;
        el.id = t.id;
        el.dataset.id = t.id;
        el.dataset.tileId = t.tileId;
        el.style.left = `${left}px`;
        el.style.top = `${top}px`;
        el.style.zIndex = String(t.z * 100 + t.y);

        const def = TILE_DEFINITIONS[t.tileId] || { svg: '', name: t.tileId };
        el.innerHTML = `
          <div class="tile-face">${def.svg}</div>
          <div class="tile-side-bevel" aria-hidden="true"></div>
        `;

        el.addEventListener('click', () => onTripleTileClick(t));
        el.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            onTripleTileClick(t);
          }
        });
        tripleBoardTilesEl.appendChild(el);
      }
    }

    // Render Tray (7 slots)
    tripleTrayEl.innerHTML = '';
    for (let slot = 0; slot < 7; slot++) {
      const slotEl = document.createElement('div');
      slotEl.className = 'triple-tray-slot';
      if (slot < tripleTrayTiles.length) {
        const item = tripleTrayTiles[slot];
        const def = TILE_DEFINITIONS[item.tileId] || { svg: '', name: item.tileId };
        slotEl.innerHTML = `
          <div class="mahjong-tile tray-tile" id="${item.id}">
            <div class="tile-face">${def.svg}</div>
            <div class="tile-side-bevel" aria-hidden="true"></div>
          </div>
        `;
      }
      tripleTrayEl.appendChild(slotEl);
    }

    if (trayCountLabel) {
      trayCountLabel.textContent = `${tripleTrayTiles.length} / 7`;
    }
  }

  function onTripleTileClick(target: TripleTile) {
    if (isPaused || isCompleted || isGameOver) return;
    startTimer();

    const free = !isTripleTileFree(target, tripleBoardTiles);
    if (!free) {
      soundManager.playInvalid();
      const el = document.getElementById(target.id);
      if (el) {
        el.classList.add('is-shaking');
        setTimeout(() => el.classList.remove('is-shaking'), 300);
      }
      return;
    }

    // Pick tile into tray
    pushUndoState();
    moves++;
    soundManager.playSelect();

    // Remove from board
    tripleBoardTiles = tripleBoardTiles.filter((t) => t.id !== target.id);

    // Insert into tray
    const res = insertTileIntoTray(tripleTrayTiles, target);
    tripleTrayTiles = res.newTray;

    if (res.matched) {
      score += 150;
      soundManager.playMatch();
      renderTripleBoard();
      updateStatsUI();

      if (tripleBoardTiles.length === 0 && tripleTrayTiles.length === 0) {
        handleVictory();
      }
    } else {
      renderTripleBoard();
      updateStatsUI();

      if (res.isFull) {
        handleGameOver('Your selection tray has reached maximum capacity (7 tiles) with no matching triplets. Plan ahead to keep your tray clear!');
      }
    }
  }

  // --- Undo Mechanism ---
  function pushUndoState() {
    undoStack.push({
      solitaireTiles: currentMode === 'solitaire' ? JSON.parse(JSON.stringify(solitaireTiles)) : undefined,
      connectTiles: currentMode === 'connect' ? JSON.parse(JSON.stringify(connectTiles)) : undefined,
      tripleBoardTiles: currentMode === 'triple' ? JSON.parse(JSON.stringify(tripleBoardTiles)) : undefined,
      tripleTrayTiles: currentMode === 'triple' ? JSON.parse(JSON.stringify(tripleTrayTiles)) : undefined,
      score,
      moves,
    });
    if (undoStack.length > 25) undoStack.shift();
    if (btnUndo) btnUndo.disabled = false;
  }

  function handleUndo() {
    if (undoStack.length === 0 || isCompleted || isGameOver || isPaused) return;
    const prev = undoStack.pop();
    if (!prev) return;

    soundManager.playSelect();
    score = prev.score;
    moves = prev.moves;

    if (currentMode === 'solitaire' && prev.solitaireTiles) {
      solitaireTiles = prev.solitaireTiles;
      selectedSolitaireTileId = null;
      renderSolitaireBoard();
    } else if (currentMode === 'connect' && prev.connectTiles) {
      connectTiles = prev.connectTiles;
      selectedConnectTileId = null;
      renderConnectBoard();
    } else if (currentMode === 'triple' && prev.tripleBoardTiles && prev.tripleTrayTiles) {
      tripleBoardTiles = prev.tripleBoardTiles;
      tripleTrayTiles = prev.tripleTrayTiles;
      renderTripleBoard();
    }

    updateStatsUI();
  }

  btnUndo?.addEventListener('click', handleUndo);

  // --- Hint System ---
  function handleHint() {
    if (isCompleted || isGameOver || isPaused) return;

    if (currentMode === 'solitaire') {
      const pair = findSolitaireHint(solitaireTiles);
      if (pair) {
        soundManager.playHint();
        score = Math.max(0, score - 25);
        updateStatsUI();
        for (const t of pair) {
          const el = document.getElementById(t.id);
          if (el) {
            el.classList.add('is-hinted');
            setTimeout(() => el.classList.remove('is-hinted'), 2000);
          }
        }
      } else {
        soundManager.playInvalid();
        if (ariaLive) ariaLive.textContent = 'No matching free tiles available. Try shuffling!';
      }
    } else if (currentMode === 'connect') {
      const hint = findConnectHint(connectTiles, connectRows, connectCols);
      if (hint) {
        soundManager.playHint();
        score = Math.max(0, score - 25);
        updateStatsUI();
        const el1 = document.getElementById(hint.tile1.id);
        const el2 = document.getElementById(hint.tile2.id);
        if (el1) el1.classList.add('is-hinted');
        if (el2) el2.classList.add('is-hinted');
        setTimeout(() => {
          if (el1) el1.classList.remove('is-hinted');
          if (el2) el2.classList.remove('is-hinted');
        }, 2000);
      } else {
        soundManager.playInvalid();
        if (ariaLive) ariaLive.textContent = 'No connectable moves available. Try shuffling!';
      }
    } else if (currentMode === 'triple') {
      const hint = findTripleHint(tripleBoardTiles, tripleTrayTiles);
      if (hint) {
        soundManager.playHint();
        score = Math.max(0, score - 25);
        updateStatsUI();
        const el = document.getElementById(hint.id);
        if (el) {
          el.classList.add('is-hinted');
          setTimeout(() => el.classList.remove('is-hinted'), 2000);
        }
      } else {
        soundManager.playInvalid();
      }
    }
  }

  btnHint?.addEventListener('click', handleHint);

  // --- Shuffle System ---
  function handleShuffle() {
    if (isCompleted || isGameOver || isPaused) return;
    soundManager.playShuffle();

    if (currentMode === 'solitaire') {
      pushUndoState();
      solitaireTiles = shuffleSolitaireTiles(solitaireTiles);
      selectedSolitaireTileId = null;
      renderSolitaireBoard();
    } else if (currentMode === 'connect') {
      pushUndoState();
      connectTiles = shuffleConnectTiles(connectTiles, connectRows, connectCols);
      selectedConnectTileId = null;
      renderConnectBoard();
    } else if (currentMode === 'triple') {
      pushUndoState();
      tripleBoardTiles = shuffleTripleTiles(tripleBoardTiles);
      renderTripleBoard();
    }

    updateStatsUI();
  }

  btnShuffle?.addEventListener('click', handleShuffle);

  // --- Pause / Resume ---
  function togglePause() {
    if (isCompleted || isGameOver) return;
    isPaused = !isPaused;

    if (isPaused) {
      stopTimer();
      if (pausedOverlay) pausedOverlay.hidden = false;
      if (btnPause) btnPause.textContent = 'Resume';
    } else {
      if (pausedOverlay) pausedOverlay.hidden = true;
      if (btnPause) btnPause.textContent = 'Pause';
      if (moves > 0) startTimer();
    }
    updateStatsUI();
  }

  btnPause?.addEventListener('click', togglePause);
  btnResume?.addEventListener('click', togglePause);

  // --- Victory and Game Over Handlers ---
  function handleVictory() {
    isCompleted = true;
    stopTimer();
    soundManager.playVictory();

    const isPB = storage.updateBestRecord(currentMode, currentDifficulty, timerSeconds, moves, score);
    if (isDaily) {
      storage.markDailyCompleted({
        date: getUtcDateString(),
        mode: currentMode,
        time: timerSeconds,
        moves,
        score,
      });
    }

    const pbBadge = document.getElementById('mahjong-pb-badge');
    if (pbBadge) pbBadge.hidden = !isPB;

    const modeLabels: Record<GameMode, string> = {
      solitaire: 'Classic Solitaire',
      connect: 'Mahjong Connect',
      triple: 'Triple Mahjong',
    };
    const vMode = document.getElementById('victory-mode');
    const vDiff = document.getElementById('victory-diff');
    const vTime = document.getElementById('victory-time');
    const vMoves = document.getElementById('victory-moves');
    const vScore = document.getElementById('victory-score');

    if (vMode) vMode.textContent = modeLabels[currentMode];
    if (vDiff) vDiff.textContent = `${currentDifficulty.charAt(0).toUpperCase()}${currentDifficulty.slice(1)}`;
    if (vTime) vTime.textContent = formatTime(timerSeconds);
    if (vMoves) vMoves.textContent = String(moves);
    if (vScore) vScore.textContent = String(score);

    if (victoryOverlay) victoryOverlay.hidden = false;
    storage.clearSavedGame(currentMode, isDaily);
  }

  function handleGameOver(reason: string) {
    isGameOver = true;
    stopTimer();
    soundManager.playGameOver();

    const descEl = document.getElementById('gameover-desc');
    if (descEl) descEl.textContent = reason;

    if (gameoverOverlay) gameoverOverlay.hidden = false;
  }

  btnPlayAgain?.addEventListener('click', () => {
    if (victoryOverlay) victoryOverlay.hidden = true;
    startNewGame(false);
  });
  btnVictoryNew?.addEventListener('click', () => {
    if (victoryOverlay) victoryOverlay.hidden = true;
    startNewGame(true);
  });
  btnRetry?.addEventListener('click', () => {
    if (gameoverOverlay) gameoverOverlay.hidden = true;
    startNewGame(false);
  });
  btnGameoverNew?.addEventListener('click', () => {
    if (gameoverOverlay) gameoverOverlay.hidden = true;
    startNewGame(true);
  });

  // Share Result Handler
  btnShareResult?.addEventListener('click', () => {
    const text = `PuzzleFeels Mahjong Variants (${currentMode.toUpperCase()}) 🏆 Solved in ${formatTime(timerSeconds)} with ${moves} moves and ${score} points! Play free: https://puzzlefeels.com/mahjong-variants-online-game/`;
    if (navigator.clipboard) {
      navigator.clipboard.writeText(text).then(() => {
        if (shareStatusEl) {
          shareStatusEl.textContent = 'Result copied to clipboard!';
          setTimeout(() => { if (shareStatusEl) shareStatusEl.textContent = ''; }, 3000);
        }
      });
    }
  });

  // --- Game Lifecycle & Mode Initialization ---
  function startNewGame(freshSeed: boolean = true) {
    stopTimer();
    resetTimer();
    moves = 0;
    score = 0;
    isCompleted = false;
    isGameOver = false;
    isPaused = false;
    undoStack = [];
    selectedSolitaireTileId = null;
    selectedConnectTileId = null;

    if (pausedOverlay) pausedOverlay.hidden = true;
    if (victoryOverlay) victoryOverlay.hidden = true;
    if (gameoverOverlay) gameoverOverlay.hidden = true;

    // Deterministic seed if daily
    const rng = isDaily
      ? createSeededRng(`${getUtcDateString()}_${currentMode}_${currentDifficulty}`)
      : Math.random;

    if (currentMode === 'solitaire') {
      solitaireTiles = generateSolvableSolitaireBoard(currentDifficulty, rng);
      renderSolitaireBoard();
    } else if (currentMode === 'connect') {
      const res = generateConnectBoard(currentDifficulty, rng);
      connectTiles = res.tiles;
      connectRows = res.rows;
      connectCols = res.cols;
      renderConnectBoard();
    } else if (currentMode === 'triple') {
      tripleBoardTiles = generateTripleBoard(currentDifficulty, rng);
      tripleTrayTiles = [];
      renderTripleBoard();
    }

    updateStatsUI();
  }

  function switchMode(newMode: GameMode) {
    if (newMode === currentMode) return;
    requireResetConfirmation(() => {
      currentMode = newMode;
      modeTabs.forEach((tab) => {
        const active = tab.dataset.mode === newMode;
        tab.classList.toggle('is-active', active);
        tab.setAttribute('aria-selected', String(active));
      });

      // Switch active view container
      if (solitaireBoardEl) solitaireBoardEl.hidden = newMode !== 'solitaire';
      if (connectBoardEl) connectBoardEl.hidden = newMode !== 'connect';
      if (tripleBoardEl) tripleBoardEl.hidden = newMode !== 'triple';

      // Update stat pill label
      const modeLabels: Record<GameMode, string> = {
        solitaire: 'Classic Solitaire',
        connect: 'Mahjong Connect',
        triple: 'Triple Mahjong',
      };
      if (statModeLabel) statModeLabel.textContent = modeLabels[newMode];

      // Update help text
      if (helpText) {
        if (newMode === 'solitaire') {
          helpText.innerHTML = '<strong>Solitaire Tips:</strong> Match two identical free tiles. A tile is free when nothing is covering it and at least one lateral edge is open.';
        } else if (newMode === 'connect') {
          helpText.innerHTML = '<strong>Connect Tips:</strong> Match identical tiles that can be linked with at most two 90-degree turns. Paths can travel through cleared spaces or outer boundaries.';
        } else {
          helpText.innerHTML = '<strong>Triple Tips:</strong> Click available uncovered tiles to collect them into your 7-slot tray. Group three identical tiles to clear them before the tray fills up!';
        }
      }

      startNewGame(true);
    });
  }

  function switchDifficulty(newDiff: GameDifficulty) {
    if (newDiff === currentDifficulty) return;
    requireResetConfirmation(() => {
      currentDifficulty = newDiff;
      diffBtns.forEach((btn) => {
        const active = btn.dataset.difficulty === newDiff;
        btn.classList.toggle('is-active', active);
        btn.setAttribute('aria-pressed', String(active));
      });
      startNewGame(true);
    });
  }

  // Bind Mode Tabs
  modeTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const m = tab.dataset.mode as GameMode;
      if (m) switchMode(m);
    });
  });

  // Bind Difficulty Buttons
  diffBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const d = btn.dataset.difficulty as GameDifficulty;
      if (d) switchDifficulty(d);
    });
  });

  // Bind Daily Challenge Toggle
  dailyToggle?.addEventListener('click', () => {
    requireResetConfirmation(() => {
      isDaily = !isDaily;
      storage.setIsDailyActive(isDaily);
      dailyToggle.classList.toggle('is-active', isDaily);
      dailyToggle.setAttribute('aria-pressed', String(isDaily));
      const label = document.getElementById('mahjong-daily-label');
      if (label) label.textContent = isDaily ? `Daily (${getUtcDateString().slice(5)})` : 'Daily Challenge';
      startNewGame(true);
    });
  });

  btnNew?.addEventListener('click', () => requireResetConfirmation(() => startNewGame(true)));
  btnRestart?.addEventListener('click', () => requireResetConfirmation(() => startNewGame(false)));

  // --- Initial Load / Restore ---
  function initGame() {
    updateSoundUI();

    // Check daily mode via URL parameter or stored active state
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('daily') === 'today' || storage.getIsDailyActive()) {
      isDaily = true;
      if (dailyToggle) {
        dailyToggle.classList.add('is-active');
        dailyToggle.setAttribute('aria-pressed', 'true');
        const label = document.getElementById('mahjong-daily-label');
        if (label) label.textContent = `Daily (${getUtcDateString().slice(5)})`;
      }
    }

    // Check saved state
    const saved = storage.loadGame(currentMode, isDaily);
    if (saved && saved.moves > 0 && saved.status === 'playing') {
      currentMode = saved.mode;
      currentDifficulty = saved.difficulty;
      moves = saved.moves;
      score = saved.score;
      timerSeconds = saved.elapsedSeconds;

      // Update UI tabs and buttons
      modeTabs.forEach((t) => t.classList.toggle('is-active', t.dataset.mode === currentMode));
      diffBtns.forEach((b) => b.classList.toggle('is-active', b.dataset.difficulty === currentDifficulty));
      if (solitaireBoardEl) solitaireBoardEl.hidden = currentMode !== 'solitaire';
      if (connectBoardEl) connectBoardEl.hidden = currentMode !== 'connect';
      if (tripleBoardEl) tripleBoardEl.hidden = currentMode !== 'triple';

      if (currentMode === 'solitaire' && saved.boardState) {
        solitaireTiles = saved.boardState;
        renderSolitaireBoard();
      } else if (currentMode === 'connect' && saved.boardState) {
        connectTiles = saved.boardState.tiles;
        connectRows = saved.boardState.rows;
        connectCols = saved.boardState.cols;
        renderConnectBoard();
      } else if (currentMode === 'triple' && saved.boardState) {
        tripleBoardTiles = saved.boardState;
        tripleTrayTiles = saved.trayState || [];
        renderTripleBoard();
      }
      updateStatsUI();
      startTimer();
    } else {
      startNewGame(true);
    }
  }

  // Keyboard navigation shortcuts
  document.addEventListener('keydown', (e) => {
    if (e.key === 'p' || e.key === 'P') togglePause();
    else if (e.key === 'h' || e.key === 'H') handleHint();
    else if (e.key === 'z' && (e.ctrlKey || e.metaKey)) handleUndo();
    else if (e.key === 'Escape' && isPaused) togglePause();
  });

  // Responsive board re-scaling on viewport resize
  let resizeTimeout: number | null = null;
  window.addEventListener('resize', () => {
    if (resizeTimeout) window.clearTimeout(resizeTimeout);
    resizeTimeout = window.setTimeout(() => {
      if (currentMode === 'solitaire') renderSolitaireBoard();
      else if (currentMode === 'connect') renderConnectBoard();
      else if (currentMode === 'triple') renderTripleBoard();
    }, 120);
  });

  // Launch on load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGame);
  } else {
    initGame();
  }
</script>

