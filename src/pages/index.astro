<script>
  try {
    const d = new Date();
    const localToday = `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
    const utcToday = d.toISOString().slice(0, 10);

    const seq = JSON.parse(localStorage.getItem('pf-number-sequence-v1') || 'null');
    if (seq?.daily?.completed && seq.daily.id === localToday) {
      const el = document.querySelector('#daily-state-sequence');
      if (el) { el.textContent = 'Completed ✓'; el.classList.add('is-completed'); }
    }

    const flood = JSON.parse(localStorage.getItem('pf-color-flood-v1') || 'null');
    if (flood?.dailyCompleted?.[utcToday]) {
      const el = document.querySelector('#daily-state-flood');
      if (el) { el.textContent = 'Completed ✓'; el.classList.add('is-completed'); }
    }

    const ladder = JSON.parse(localStorage.getItem('pf-word-ladder-v1') || 'null');
    if (ladder?.dailyCompleted?.[utcToday]) {
      const el = document.querySelector('#daily-state-ladder');
      if (el) { el.textContent = 'Completed ✓'; el.classList.add('is-completed'); }
    }
  } catch {}
</script>
