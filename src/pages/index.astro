---
import Base from '../layouts/Base.astro'; import Header from '../components/Header.astro'; import Footer from '../components/Footer.astro'; import FaqList from '../components/FaqList.astro';
const title='PuzzleFeels — Play Free Online Puzzle Games'; const description='Give your brain a fun challenge with free online puzzle games. Play instantly on any device, with no downloads or account required.';
const homeFaqs=[
  {question:'Are PuzzleFeels games free?',answer:'Yes. The games currently available on PuzzleFeels are free to play, with no subscription or required payment.'},
  {question:'Do I need to download anything?',answer:'No. Games run in your web browser on a connected device.'},
  {question:'Can I play puzzle games on my phone?',answer:'Yes. The site and its game controls adapt to mobile screens, tablets, and desktops.'},
  {question:'Does PuzzleFeels require registration?',answer:'No account is needed to play. Your progress is stored locally in the browser on your device.'},
  {question:'Is my game progress saved?',answer:'Game progress and scores are saved in your browser’s local storage. Clearing browser data or switching devices may remove or not carry over that data.'},
  {question:'Can I play PuzzleFeels games on desktop?',answer:'Yes. Play in a modern desktop or laptop browser, as well as on mobile and tablet.'},
  {question:'Are more puzzle games coming soon?',answer:'Yes. We’re exploring logic, memory, number, word, and other brain challenge games. They’ll appear here when they’re ready to play.'}
];
---
<Base {title} {description} path="/">
  <Header />
  <main>
    <section class="hero"><div class="wrap hero-grid"><div class="hero-copy"><span class="eyebrow">A little play goes a long way</span><h1>Play Free Online<br/><span>Puzzle Games</span></h1><p>Give your brain a fun challenge! Explore free online puzzle games designed to entertain, challenge, and sharpen your thinking. Play instantly on any device, with no downloads required.</p><div class="actions"><a class="btn" href="/number-sequence-game/">Play Number Sequence <span>→</span></a><a class="btn secondary" href="/games/">Explore games</a></div><div class="hero-note"><span>✦</span> Free to play <i></i> No sign-up <i></i> Play anywhere</div></div><div class="hero-art" aria-label="Illustration of a number puzzle game"><div class="art-orbit orbit-one"></div><div class="art-orbit orbit-two"></div><div class="puzzle-tile tile-a">2</div><div class="puzzle-tile tile-b">8</div><div class="puzzle-tile tile-c">?</div><div class="puzzle-tile tile-d">16</div><div class="art-card"><div class="art-top"><span class="dots">● ● ●</span><span>NUMBER SEQUENCE</span><span class="mini-pill">01 / 10</span></div><div class="sequence"><b>2</b><i>→</i><b>4</b><i>→</i><b>8</b><i>→</i><b>?</b></div><div class="art-rule">Find the pattern <span>✦</span></div><div class="art-answers"><span>12</span><span>14</span><span class="chosen">16</span><span>18</span></div><div class="art-progress"><span></span></div></div><div class="spark spark-one">✦</div><div class="spark spark-two">✧</div></div></div></section>
    <section class="trust-strip"><div class="wrap trust-items"><span class="trust-item"><svg class="trust-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>Always free</span><span class="trust-item"><svg class="trust-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8"/></svg>No downloads</span><span class="trust-item"><svg class="trust-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>Progress saved on your device</span><span class="trust-item"><svg class="trust-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h8"/><path d="M10 19v-4"/><path d="M7 19h6"/><rect width="6" height="10" x="16" y="12" rx="2"/></svg>Made for every screen</span></div></section>
    <!-- FIXED HOMEPAGE FEATURED GAMES COLLECTION (Strictly limited to these 5 games).
         Do NOT automatically add newly created games here in the future. -->
    <section class="section games" id="games"><div class="wrap"><div class="section-head"><span class="eyebrow">Find your flow</span><h2>One good puzzle can change your day.</h2><p class="muted">Take a break, wake up your brain, and enjoy a challenge at your own pace.</p></div><article class="game-card card"><div class="game-visual"><div class="game-icon"><span>3</span><span>?</span><span>9</span><span>27</span></div><div class="game-orbit"></div></div><div class="game-info"><div class="labels"><span class="pill">FREE TO PLAY</span><span class="diff">Easy · Medium · Hard</span></div><h3>Number Sequence</h3><p class="muted">Spot the rule, fill in the missing number, and see how far your pattern-solving skills can take you.</p><div class="game-meta"><span>◷ 5–10 min</span><span>◎ Brain training</span></div><a class="btn" href="/number-sequence-game/">Play now <span>→</span></a></div><div class="game-count"><span>01</span><small>GAME</small></div></article><article class="game-card card color-flood-card"><div class="game-visual"><div class="game-icon flood-card-icon" aria-hidden="true"><span></span><span></span><span></span><span></span></div><div class="game-orbit"></div></div><div class="game-info"><div class="labels"><span class="pill">FREE TO PLAY</span><span class="diff">Easy · Medium · Hard</span></div><h3>Color Flood</h3><p class="muted">Grow the connected color from the top-left corner and try to flood the whole board within the move limit.</p><div class="game-meta"><span>◈ Strategy puzzle</span><span>✦ Daily challenge</span></div><a class="btn" href="/color-flood-game/">Play now <span>→</span></a></div><div class="game-count"><span>02</span><small>GAME</small></div></article><article class="game-card card picross-home-card"><div class="game-visual"><div class="game-icon picross-home-icon" aria-hidden="true"><span>■</span><span>□</span><span>□</span><span>■</span></div><div class="game-orbit"></div></div><div class="game-info"><div class="labels"><span class="pill">FREE TO PLAY</span><span class="diff">Beginner · Medium · Hard</span></div><h3>Picross Game Online</h3><p class="muted">Use number clues to reveal hidden pixel-art pictures in this classic nonogram logic puzzle.</p><div class="game-meta"><span>▦ Logic puzzle</span><span>✦ Daily challenge</span></div><a class="btn" href="/picross-game-online/">Play now <span>→</span></a></div><div class="game-count"><span>03</span><small>GAME</small></div></article><article class="game-card card slide-home-card"><div class="game-visual"><div class="game-icon slide-home-icon" aria-hidden="true"><span>1</span><span>2</span><span>3</span><span class="slide-empty-cell"></span></div><div class="game-orbit"></div></div><div class="game-info"><div class="labels"><span class="pill">FREE TO PLAY</span><span class="diff">Easy · Medium · Hard</span></div><h3>Sliding Number Puzzle Game</h3><p class="muted">Slide numbered tiles into ascending order across 3×3, 4×4, and 5×5 boards. Test your spatial logic and speed.</p><div class="game-meta"><span>▦ Sliding puzzle</span><span>◎ Brain training</span></div><a class="btn" href="/sliding-number-puzzle-game/">Play now <span>→</span></a></div><div class="game-count"><span>04</span><small>GAME</small></div></article><article class="game-card card ladder-home-card"><div class="game-visual"><div class="game-icon ladder-home-icon" aria-hidden="true"><span>W</span><span>O</span><span>R</span><span>D</span></div><div class="game-orbit"></div></div><div class="game-info"><div class="labels"><span class="pill">FREE TO PLAY</span><span class="diff">Easy · Medium · Hard</span></div><h3>Word Ladder Game Online</h3><p class="muted">Change one letter at a time to transform the starting word into the target word. A classic vocabulary and logic puzzle.</p><div class="game-meta"><span>▤ Word puzzle</span><span>✦ Daily challenge</span></div><a class="btn" href="/word-ladder-game-online/">Play now <span>→</span></a></div><div class="game-count"><span>05</span><small>GAME</small></div></article></div></section>
    <section class="section why"><div class="wrap"><div class="section-head"><span class="eyebrow">Good games, thoughtfully made</span><h2>Your happy place for a brain break.</h2><p class="muted">The little details matter. We keep play simple, welcoming, and easy to fit into your day.</p></div><div class="benefits"><article><span class="benefit-icon blue">$</span><h3>Completely free</h3><p>No subscriptions or paywalls. The core game is yours to enjoy.</p></article><article><span class="benefit-icon violet">↗</span><h3>Nothing to download</h3><p>Open your browser and jump right into a puzzle.</p></article><article><span class="benefit-icon mint">⌂</span><h3>Privacy friendly</h3><p>No account needed. Game progress stays in local browser storage on your device.</p></article><article><span class="benefit-icon peach">▣</span><h3>Plays beautifully anywhere</h3><p>Touch-friendly controls make it easy on phones, tablets, and computers.</p></article><article><span class="benefit-icon blue">⚡</span><h3>Instant gameplay</h3><p>Lightweight games start quickly, with no extra software to install.</p></article><article><span class="benefit-icon violet">✳</span><h3>Fun challenges</h3><p>Choose a difficulty that feels right and build your skills one puzzle at a time.</p></article></div></div></section>
    <section class="section how"><div class="wrap how-grid"><div><span class="eyebrow">Easy as 1, 2, 3</span><h2>Make a little room for play.</h2><p class="muted">No setup, no pressure. Just pick a puzzle and enjoy the moment.</p><a class="btn" href="/number-sequence-game/">Find your first puzzle →</a></div><div class="steps"><article><b>01</b><div><h3>Choose a puzzle</h3><p>Pick a game and a level that feels good.</p></div></article><article><b>02</b><div><h3>Play and solve</h3><p>Look for clues, try an answer, and learn the pattern.</p></div></article><article><b>03</b><div><h3>Track your progress</h3><p>Your scores stay on your device so you can keep improving.</p></div></article></div></div></section>
    <section class="daily-section" id="daily">
      <div class="wrap">
        <div class="daily-header">
          <span class="eyebrow">A fresh puzzle every day</span>
          <h2>Your Daily Moments of Focus</h2>
          <p class="daily-sub">New puzzles unlock daily based on the calendar date. Pick your favorite challenge and solve today's puzzle at your own pace.</p>
        </div>
        <!-- FIXED HOMEPAGE DAILY MOMENTS COLLECTION (Strictly limited to these 3 games).
             Picross was intentionally removed. Do NOT automatically add newly created games here. -->
        <div class="daily-cards">
          <article class="daily-card">
            <div class="daily-card-top">
              <span class="daily-pill">NUMBER PUZZLE</span>
              <span class="daily-badge">DAILY ✦</span>
            </div>
            <h3>Number Sequence</h3>
            <p>Deduce today’s numerical pattern and choose the value that comes next.</p>
            <div class="daily-card-meta">
              <span>Medium difficulty</span>
              <span class="daily-state-tag" id="daily-state-sequence">Ready to play</span>
            </div>
            <a class="btn daily-btn" href="/number-sequence-game/?daily=today">Play Daily Challenge <span>→</span></a>
          </article>

          <article class="daily-card">
            <div class="daily-card-top">
              <span class="daily-pill">STRATEGY PUZZLE</span>
              <span class="daily-badge">DAILY ✦</span>
            </div>
            <h3>Color Flood</h3>
            <p>Connect and flood the entire board from the top corner within the move limit.</p>
            <div class="daily-card-meta">
              <span>Shared UTC board</span>
              <span class="daily-state-tag" id="daily-state-flood">Ready to play</span>
            </div>
            <a class="btn daily-btn" href="/color-flood-game/?daily=today">Play Daily Challenge <span>→</span></a>
          </article>

          <article class="daily-card">
            <div class="daily-card-top">
              <span class="daily-pill">WORD PUZZLE</span>
              <span class="daily-badge">DAILY ✦</span>
            </div>
            <h3>Word Ladder</h3>
            <p>Transform today's starting word to the target word in the fewest possible steps.</p>
            <div class="daily-card-meta">
              <span>Synchronized UTC</span>
              <span class="daily-state-tag" id="daily-state-ladder">Ready to play</span>
            </div>
            <a class="btn daily-btn" href="/word-ladder-game-online/?daily=today">Play Daily Challenge <span>→</span></a>
          </article>
        </div>
      </div>
    </section>
    <section class="section coming"><div class="wrap"><div class="section-head"><span class="eyebrow">A growing collection</span><h2>More ways to play are on the way.</h2><p class="muted">We’re building each game with the same care. Here’s what we’re exploring next.</p></div><div class="coming-list"><span>◈ Logic Puzzles <i>Coming soon</i></span><span>▦ Memory Games <i>Coming soon</i></span><span>⌗ Number Puzzles <i>Coming soon</i></span><span>✎ Crosswords <i>Coming soon</i></span><span>✳ Brain Challenges <i>Coming soon</i></span></div></div></section>
    <section class="trust-section"><div class="wrap trust-box"><div><span class="eyebrow">Play with peace of mind</span><h2>Simple, private, and ready when you are.</h2><p>Jump in without creating an account or downloading anything. Your basic game progress and preferences are stored in your browser on this device. PuzzleFeels doesn’t ask for personal details to play.</p><a href="/privacy-policy/">Read our privacy policy <span>→</span></a></div><div class="trust-list"><span><b>✓</b> No registration required</span><span><b>✓</b> No downloads required</span><span><b>✓</b> Progress saved locally</span><span><b>✓</b> Free gameplay</span></div></div></section>
    <section class="section faq"><div class="wrap faq-wrap"><div><span class="eyebrow">Good to know</span><h2>Questions, answered.</h2><p class="muted">Everything you need to know before your first puzzle.</p></div><FaqList items={homeFaqs} /></div></section>
  </main><Footer />
</Base>
<style>
  .picross-home-card{margin:18px auto 0}
  .game-icon.picross-home-icon span:nth-child(1),.game-icon.picross-home-icon span:nth-child(4){background:#315ee8;color:#fff}
  .game-icon.picross-home-icon span:nth-child(2),.game-icon.picross-home-icon span:nth-child(3){background:#e5eaff;color:#315ee8}
  :global(html[data-theme="dark"]) .game-icon.picross-home-icon span:nth-child(1),:global(html[data-theme="dark"]) .game-icon.picross-home-icon span:nth-child(4){background:#8ea8ff;color:#0b132b}
  :global(html[data-theme="dark"]) .game-icon.picross-home-icon span:nth-child(2),:global(html[data-theme="dark"]) .game-icon.picross-home-icon span:nth-child(3){background:#1b294b;color:#c5d2ff}
</style>
<style>
.hero{overflow:hidden;padding:68px 0 72px;background:radial-gradient(ellipse at 83% 45%,#e8edff 0,transparent 36%),linear-gradient(130deg,#fbfcff,#f2f5ff)}.hero-grid{display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:28px;min-height:420px}.hero-copy{max-width:570px}.hero-copy h1{margin:17px 0 20px}.hero-copy h1 span{color:#315ee8}.hero-copy>p{font-size:17px;line-height:1.75;color:#68748a;max-width:535px}.actions{display:flex;gap:12px;margin-top:26px}.hero-note{margin-top:25px;display:flex;align-items:center;gap:12px;font-size:12px;color:#77839a}.hero-note span{color:#315ee8}.hero-note i{width:3px;height:3px;border-radius:50%;background:#aab3c1}.hero-art{height:370px;position:relative;display:grid;place-items:center}.art-card{width:min(410px,87%);padding:20px 24px 18px;position:relative;z-index:2;border:1px solid #e1e6f1;border-radius:23px;background:#fff;box-shadow:0 28px 70px #233c9018;transform:rotate(-2deg)}.art-top{display:flex;justify-content:space-between;align-items:center;color:#8590a4;font-size:9px;font-weight:700;letter-spacing:.1em}.dots{font-size:8px;letter-spacing:1px;color:#d4d9e4}.mini-pill{padding:6px 8px;border-radius:8px;background:#f1f4fc;color:#66738b;letter-spacing:0}.sequence{display:flex;justify-content:space-between;align-items:center;padding:32px 0 20px}.sequence b{width:53px;height:53px;display:grid;place-items:center;border-radius:14px;background:#f3f6ff;color:#23385f;font-size:22px}.sequence b:last-child{background:#e9efff;color:#315ee8}.sequence i{font-style:normal;color:#b7c1d5;font-size:17px}.art-rule{font-size:12px;color:#69758c;display:flex;justify-content:space-between;padding-bottom:15px}.art-rule span{color:#efb83f}.art-answers{display:grid;grid-template-columns:repeat(4,1fr);gap:9px}.art-answers span{display:grid;place-items:center;border:1px solid #e6eaf2;border-radius:10px;height:38px;font-size:13px;font-weight:700;color:#66738b}.art-answers .chosen{color:#315ee8;background:#f1f4ff;border-color:#9fb4ff}.art-progress{height:4px;border-radius:4px;background:#eff1f6;margin-top:20px}.art-progress span{display:block;width:18%;height:100%;border-radius:4px;background:#315ee8}.art-orbit{position:absolute;border:1px solid #dce4fb;border-radius:50%;width:340px;height:340px}.orbit-two{width:270px;height:270px;border-style:dashed}.puzzle-tile{position:absolute;z-index:3;width:54px;height:54px;border-radius:16px;display:grid;place-items:center;background:white;box-shadow:0 12px 26px #233c901a;font-size:21px;font-weight:800;color:#315ee8}.tile-a{top:32px;left:18%}.tile-b{right:4%;top:84px;background:#edefff;color:#7963d7}.tile-c{left:4%;bottom:52px;background:#e4f7f2;color:#17845e}.tile-d{right:12%;bottom:24px;background:#fff3df;color:#cf8d24}.spark{position:absolute;color:#dba834}.spark-one{right:14%;top:26px;font-size:26px}.spark-two{left:15%;top:87px;font-size:23px}.trust-strip{background:white;border-block:1px solid #e9ecf3}.trust-items{display:flex;justify-content:space-between;gap:20px;padding:19px 0;font-size:12px;color:#6e7a90;font-weight:600}.trust-item{display:inline-flex;align-items:center;gap:8px}.trust-icon{width:18px;height:18px;flex:none;color:#315ee8}.games{background:white}.games .wrap{display:grid;gap:18px}.games .section-head{margin-bottom:22px}.games .game-card{margin:0 auto}.game-card{display:grid;grid-template-columns:33% 1fr auto;overflow:hidden;max-width:900px;margin:0 auto;min-height:280px}.game-visual{background:linear-gradient(145deg,#eaf0ff,#f6f3ff);display:grid;place-items:center;position:relative;overflow:hidden}.game-icon{z-index:1;display:grid;grid-template-columns:repeat(2,65px);gap:10px;transform:rotate(-7deg)}.game-icon span{height:65px;display:grid;place-items:center;border-radius:18px;background:white;color:#315ee8;font-size:22px;font-weight:800;box-shadow:0 8px 20px #293e8b14}.game-icon span:nth-child(2){background:#315ee8;color:white}.game-icon span:nth-child(3){background:#dff5ef;color:#16825d}.game-icon span:nth-child(4){background:#fff1d9;color: