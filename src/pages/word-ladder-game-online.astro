</style>

<script>
  import {
    PUZZLES_EASY,
    PUZZLES_MEDIUM,
    PUZZLES_HARD,
    DAILY_PUZZLES,
    isValidWord,
    isOneLetterDiff,
    getChangedIndex,
    getDailyPuzzle,
    findShortestPath,
    findNextHintWord,
    calculateMedal,
    type WordLadderPuzzle
  } from '../data/wordLadderData';

  interface SavedPuzzleState {
    version: number;
    difficulty: 'easy' | 'medium' | 'hard' | 'daily';
    dailyDiff?: 'easy' | 'medium' | 'hard';
    puzzleId: string;
    startWord: string;
    targetWord: string;
    ladder: string[];
    moves: number;
    hintsUsed: number;
    minMoves: number;
    elapsedSeconds: number;
    isWon: boolean;
    isSolutionRevealed?: boolean;
  }

  interface GlobalStats {
    soundEnabled: boolean;
    bests: Record<string, { moves: number; time: number; medal?: string }>;
    dailyCompleted: Record<string, { moves: number; time: number; medal?: string }>;
  }

  const REGULAR_STORAGE_KEY = 'pf-word-ladder-regular-state';
  const GLOBAL_STATS_KEY = 'pf-word-ladder-stats';

  function getDailyStorageKey(dateStr: string, diff: string): string {
    return `pf-word-ladder-daily-${dateStr}-${diff}`;
  }

  function getUtcDateKey(): string {
    return new Date().toISOString().slice(0, 10);
  }

  // Active Game State
  let currentDiff: 'easy' | 'medium' | 'hard' | 'daily' = 'easy';
  let currentDailyDiff: 'easy' | 'medium' | 'hard' = 'easy';
  let currentPuzzle: WordLadderPuzzle = PUZZLES_EASY[0];
  let optimalPath: string[] = [];
  let minMoves = 4;
  let ladder: string[] = [];
  let moves = 0;
  let hintsUsed = 0;
  let elapsedSeconds = 0;
  let timerInterval: number | null = null;
  let isTimerRunning = false;
  let isPaused = false;
  let isWon = false;
  let isSolutionRevealed = false;
  let soundEnabled = true;
  let bests: Record<string, { moves: number; time: number; medal?: string }> = {};
  let dailyCompleted: Record<string, { moves: number; time: number; medal?: string }> = {};

  // Audio Context Synthesizer
  let audioCtx: AudioContext | null = null;
  function getAudioContext(): AudioContext | null {
    if (!audioCtx && typeof window !== 'undefined') {
      const AudioCtx = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
      if (AudioCtx) audioCtx = new AudioCtx();
    }
    if (audioCtx && audioCtx.state === 'suspended') {
      audioCtx.resume();
    }
    return audioCtx;
  }

  function playValidWordSound() {
    if (!soundEnabled) return;
    try {
      const ctx = getAudioContext();
      if (!ctx) return;
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(440, ctx.currentTime);
      osc.frequency.exponentialRampToValueAtTime(880, ctx.currentTime + 0.08);
      gain.gain.setValueAtTime(0.12, ctx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.08);
      osc.connect(gain);
      gain.connect(ctx.destination);
      osc.start();
      osc.stop(ctx.currentTime + 0.08);
    } catch {}
  }

  function playErrorSound() {
    if (!soundEnabled) return;
    try {
      const ctx = getAudioContext();
      if (!ctx) return;
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.type = 'triangle';
      osc.frequency.setValueAtTime(220, ctx.currentTime);
      osc.frequency.exponentialRampToValueAtTime(110, ctx.currentTime + 0.12);
      gain.gain.setValueAtTime(0.1, ctx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.12);
      osc.connect(gain);
      gain.connect(ctx.destination);
      osc.start();
      osc.stop(ctx.currentTime + 0.12);
    } catch {}
  }

  function playVictorySound() {
    if (!soundEnabled) return;
    try {
      const ctx = getAudioContext();
      if (!ctx) return;
      const notes = [261.63, 329.63, 392.00, 523.25, 659.25]; // C4, E4, G4, C5, E5
      notes.forEach((freq, idx) => {
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'triangle';
        osc.frequency.value = freq;
        const startTime = ctx.currentTime + idx * 0.09;
        gain.gain.setValueAtTime(0.12, startTime);
        gain.gain.exponentialRampToValueAtTime(0.001, startTime + 0.3);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start(startTime);
        osc.stop(startTime + 0.32);
      });
    } catch {}
  }

  // DOM Elements
  const movesEl = document.getElementById('ladder-moves');
  const targetMovesEl = document.getElementById('ladder-target-moves');
  const hintsEl = document.getElementById('ladder-hints');
  const timerEl = document.getElementById('ladder-timer');
  const soundToggleBtn = document.getElementById('ladder-sound-toggle');
  const soundLabel = document.getElementById('ladder-sound-label');
  const soundOnIcon = document.querySelector('.sound-on-icon');
  const soundOffIcon = document.querySelector('.sound-off-icon');

  const dailySubbar = document.getElementById('ladder-daily-subbar');
  const dailyTabButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.daily-tab-btn'));

  const startLettersEl = document.getElementById('ladder-start-letters');
  const stepsContainer = document.getElementById('ladder-steps');
  const targetLettersEl = document.getElementById('ladder-target-letters');
  const slotLettersEl = document.getElementById('ladder-slot-letters');

  const wordInput = document.getElementById('ladder-word-input') as HTMLInputElement | null;
  const submitBtn = document.getElementById('ladder-submit-btn');
  const feedbackEl = document.getElementById('ladder-feedback');

  const newGameBtn = document.getElementById('ladder-new');
  const hintBtn = document.getElementById('ladder-hint');
  const undoBtn = document.getElementById('ladder-undo') as HTMLButtonElement | null;
  const solutionBtn = document.getElementById('ladder-solution');
  const restartBtn = document.getElementById('ladder-restart');
  const pauseBtn = document.getElementById('ladder-pause');
  const resumeBtn = document.getElementById('ladder-resume');
  const pausedOverlay = document.getElementById('ladder-paused');

  const victoryOverlay = document.getElementById('ladder-victory');
  const victoryDiffLabel = document.getElementById('victory-diff-label');
  const victoryTime = document.getElementById('victory-time');
  const victoryMoves = document.getElementById('victory-moves');
  const victoryTargetMoves = document.getElementById('victory-target-moves');
  const victoryHintsUsed = document.getElementById('victory-hints-used');
  const victoryEffectiveScore = document.getElementById('victory-effective-score');
  const victoryMedalCard = document.getElementById('victory-medal-card');
  const victoryMedalIcon = document.getElementById('victory-medal-icon');
  const victoryMedalTitle = document.getElementById('victory-medal-title');
  const victoryMedalDesc = document.getElementById('victory-medal-desc');
  const victorySummary = document.getElementById('victory-ladder-summary');
  const victoryPbBadge = document.getElementById('ladder-pb-badge');
  const playAgainBtn = document.getElementById('ladder-play-again');
  const shareBtn = document.getElementById('ladder-share');
  const shareStatus = document.getElementById('ladder-share-status');
  const liveEl = document.getElementById('ladder-live');

  const diffButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.ladder-diff-btn'));

  function formatTime(totalSeconds: number): string {
    const mins = Math.floor(totalSeconds / 60);
    const secs = totalSeconds % 60;
    return `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
  }

  function startTimer() {
    if (isTimerRunning || isPaused || isWon) return;
    isTimerRunning = true;
    timerInterval = window.setInterval(() => {
      elapsedSeconds++;
      if (timerEl) timerEl.textContent = formatTime(elapsedSeconds);
      saveState();
    }, 1000);
  }

  function stopTimer() {
    if (timerInterval) {
      clearInterval(timerInterval);
      timerInterval = null;
    }
    isTimerRunning = false;
  }

  function resetTimer() {
    stopTimer();
    elapsedSeconds = 0;
    if (timerEl) timerEl.textContent = '00:00';
  }

  function computeOptimal(puzzle: WordLadderPuzzle) {
    const path = findShortestPath(puzzle.startWord, puzzle.targetWord);
    if (path && path.length > 1) {
      optimalPath = path;
      minMoves = path.length - 1;
    } else {
      optimalPath = puzzle.optimalPath || [];
      minMoves = puzzle.minMoves || Math.max(2, optimalPath.length - 1);
    }
    if (targetMovesEl) targetMovesEl.textContent = String(minMoves);
  }

  function loadGlobalStats() {
    try {
      const raw = localStorage.getItem(GLOBAL_STATS_KEY);
      if (raw) {
        const parsed = JSON.parse(raw) as GlobalStats;
        if (typeof parsed.soundEnabled === 'boolean') soundEnabled = parsed.soundEnabled;
        if (parsed.bests) bests = { ...parsed.bests };
        if (parsed.dailyCompleted) dailyCompleted = { ...parsed.dailyCompleted };
      }
    } catch {}
  }

  function saveGlobalStats() {
    try {
      const stats: GlobalStats = {
        soundEnabled,
        bests,
        dailyCompleted
      };
      localStorage.setItem(GLOBAL_STATS_KEY, JSON.stringify(stats));
    } catch {}
  }

  function saveState() {
    try {
      const state: SavedPuzzleState = {
        version: 2,
        difficulty: currentDiff,
        dailyDiff: currentDiff === 'daily' ? currentDailyDiff : undefined,
        puzzleId: currentPuzzle.id,
        startWord: currentPuzzle.startWord,
        targetWord: currentPuzzle.targetWord,
        ladder,
        moves,
        hintsUsed,
        minMoves,
        elapsedSeconds,
        isWon,
        isSolutionRevealed
      };

      if (currentDiff === 'daily') {
        const key = getDailyStorageKey(getUtcDateKey(), currentDailyDiff);
        localStorage.setItem(key, JSON.stringify(state));
      } else {
        localStorage.setItem(REGULAR_STORAGE_KEY, JSON.stringify(state));
      }

      saveGlobalStats();
    } catch {}
  }

  function loadSavedPuzzle(diff: 'easy' | 'medium' | 'hard' | 'daily', dailyDiff: 'easy' | 'medium' | 'hard' = 'easy'): boolean {
    try {
      const key = diff === 'daily'
        ? getDailyStorageKey(getUtcDateKey(), dailyDiff)
        : REGULAR_STORAGE_KEY;

      const raw = localStorage.getItem(key);
      if (!raw) return false;

      const parsed = JSON.parse(raw) as SavedPuzzleState;
      if (!parsed || (parsed.version !== 2 && parsed.version !== 1)) return false;
      if (diff !== 'daily' && parsed.difficulty !== diff) return false;
      if (diff === 'daily' && parsed.dailyDiff && parsed.dailyDiff !== dailyDiff) return false;

      // Find puzzle
      let pool = diff === 'easy' ? PUZZLES_EASY : diff === 'medium' ? PUZZLES_MEDIUM : diff === 'hard' ? PUZZLES_HARD : DAILY_PUZZLES;
      let matched = pool.find(p => p.id === parsed.puzzleId);
      if (!matched) {
        if (diff === 'daily') {
          matched = getDailyPuzzle(new Date(), dailyDiff);
        } else {
          matched = pool[0];
        }
      }

      currentPuzzle = matched;
      computeOptimal(matched);

      // Validate ladder steps integrity
      let valid = true;
      let prev = matched.startWord;
      const cleanLadder: string[] = [];

      for (const step of (parsed.ladder || [])) {
        const u = step.toUpperCase().trim();
        if (isValidWord(u) && isOneLetterDiff(prev, u)) {
          cleanLadder.push(u);
          prev = u;
        } else {
          valid = false;
          break;
        }
      }

      ladder = valid ? cleanLadder : [];
      moves = typeof parsed.moves === 'number' ? parsed.moves : ladder.length;
      hintsUsed = typeof parsed.hintsUsed === 'number' ? parsed.hintsUsed : 0;
      elapsedSeconds = typeof parsed.elapsedSeconds === 'number' ? parsed.elapsedSeconds : 0;
      isWon = Boolean(parsed.isWon && ladder[ladder.length - 1] === matched.targetWord);
      isSolutionRevealed = Boolean(parsed.isSolutionRevealed);

      return true;
    } catch {
      return false;
    }
  }

  function setFeedback(msg: string, type: 'normal' | 'error' | 'success' = 'normal') {
    if (!feedbackEl) return;
    feedbackEl.textContent = msg;
    feedbackEl.className = `ladder-feedback ${type === 'error' ? 'is-error' : type === 'success' ? 'is-success' : ''}`;
    if (liveEl) liveEl.textContent = msg;
  }

  function renderWordTiles(
    container: HTMLElement | null,
    word: string,
    prevWord: string | null = null,
    targetWord: string = ''
  ) {
    if (!container) return;
    container.innerHTML = '';
    const changedIdx = prevWord ? getChangedIndex(prevWord, word) : -1;

    for (let i = 0; i < word.length; i++) {
      const tile = document.createElement('div');
      const isMatch = Boolean(targetWord && word[i] === targetWord[i]);
      const isChanged = i === changedIdx;

      let cls = 'node-tile';
      if (isChanged) cls += ' is-changed';
      if (isMatch) cls += ' is-target-match';

      tile.className = cls;
      tile.style.display = 'flex';
      tile.style.alignItems = 'center';
      tile.style.justifyContent = 'center';
      tile.textContent = word[i];
      if (isMatch) {
        tile.setAttribute('title', `Position ${i + 1} ('${word[i]}') matches target word`);
      }
      container.appendChild(tile);
    }
  }

  function updateSlotLetters() {
    if (!slotLettersEl || !currentPuzzle) return;
    const typed = (wordInput?.value || '').trim().toUpperCase();
    slotLettersEl.innerHTML = '';
    slotLettersEl.style.display = 'flex';
    slotLettersEl.style.flexDirection = 'row';
    slotLettersEl.style.flexWrap = 'nowrap';
    slotLettersEl.style.alignItems = 'center';
    slotLettersEl.style.justifyContent = 'center';
    const target = currentPuzzle.targetWord;
    const currentWord = getLatestWord();

    for (let i = 0; i < currentPuzzle.startWord.length; i++) {
      const tile = document.createElement('div');
      const char = typed[i] || '·';
      let cls = 'node-tile';

      if (typed[i]) {
        const isMatch = typed[i] === target[i];
        const isChanged = currentWord[i] && typed[i] !== currentWord[i];
        if (isChanged) cls += ' is-changed';
        if (isMatch) cls += ' is-target-match';
      }

      tile.className = cls;
      tile.style.display = 'flex';
      tile.style.alignItems = 'center';
      tile.style.justifyContent = 'center';
      tile.textContent = char;
      slotLettersEl.appendChild(tile);
    }
  }

  function renderLadder() {
    // Render Start Word (with matching target letters highlighted in green)
    if (startLettersEl) {
      startLettersEl.style.display = 'flex';
      startLettersEl.style.flexDirection = 'row';
      startLettersEl.style.flexWrap = 'nowrap';
      startLettersEl.style.alignItems = 'center';
      startLettersEl.style.justifyContent = 'center';
    }
    renderWordTiles(startLettersEl, currentPuzzle.startWord, null, currentPuzzle.targetWord);

    // Render Steps
    if (stepsContainer) {
      stepsContainer.innerHTML = '';
      let prev = currentPuzzle.startWord;

      ladder.forEach((stepWord, idx) => {
        const stepNode = document.createElement('div');
        stepNode.className = 'ladder-node step-node';
        stepNode.setAttribute('role', 'listitem');
        stepNode.setAttribute('aria-label', `Step ${idx + 1}: ${stepWord}`);

        const meta = document.createElement('div');
        meta.className = 'node-meta';
        const badge = document.createElement('span');
        badge.className = 'node-badge step-badge';
        badge.textContent = `STEP ${idx + 1}`;
        meta.appendChild(badge);

        const lettersContainer = document.createElement('div');
        lettersContainer.className = 'node-letters';
        lettersContainer.style.display = 'flex';
        lettersContainer.style.flexDirection = 'row';
        lettersContainer.style.flexWrap = 'nowrap';
        lettersContainer.style.alignItems = 'center';
        lettersContainer.style.justifyContent = 'center';
        renderWordTiles(lettersContainer, stepWord, prev, currentPuzzle.targetWord);

        stepNode.appendChild(meta);
        stepNode.appendChild(lettersContainer);
        stepsContainer.appendChild(stepNode);

        prev = stepWord;
      });
    }

    // Render Active Slot
    const activeSlot = document.getElementById('ladder-active-slot');
    if (activeSlot) {
      if (isWon) {
        activeSlot.style.display = 'none';
      } else {
        activeSlot.style.display = 'flex';
        updateSlotLetters();
      }
    }

    // Render Target Word
    if (targetLettersEl) {
      targetLettersEl.style.display = 'flex';
      targetLettersEl.style.flexDirection = 'row';
      targetLettersEl.style.flexWrap = 'nowrap';
      targetLettersEl.style.alignItems = 'center';
      targetLettersEl.style.justifyContent = 'center';
    }
    renderWordTiles(targetLettersEl, currentPuzzle.targetWord);

    // Update stats
    if (movesEl) movesEl.textContent = String(moves);
    if (targetMovesEl) targetMovesEl.textContent = String(minMoves);
    if (hintsEl) hintsEl.textContent = String(hintsUsed);
    if (timerEl) timerEl.textContent = formatTime(elapsedSeconds);

    // Update Undo button state
    if (undoBtn) {
      undoBtn.disabled = ladder.length === 0 || isWon;
    }

    // Update input field length constraint & placeholder
    if (wordInput) {
      wordInput.maxLength = currentPuzzle.startWord.length;
      wordInput.placeholder = `${currentPuzzle.startWord.length} LETTERS...`;
      wordInput.disabled = isWon || isPaused;
    }
  }

  function getLatestWord(): string {
    return ladder.length > 0 ? ladder[ladder.length - 1] : currentPuzzle.startWord;
  }

  function submitWord() {
    if (isWon || isPaused || !wordInput) return;

    const raw = wordInput.value.trim().toUpperCase();
    if (!raw) {
      setFeedback('Please enter a word.', 'error');
      playErrorSound();
      return;
    }

    const currentWord = getLatestWord();

    // 1. Length check
    if (raw.length !== currentPuzzle.startWord.length) {
      setFeedback(`Word must be exactly ${currentPuzzle.startWord.length} letters long.`, 'error');
      playErrorSound();
      return;
    }

    // 2. Already used check
    if (raw === currentPuzzle.startWord || ladder.includes(raw)) {
      setFeedback(`"${raw}" is already used in this ladder.`, 'error');
      playErrorSound();
      return;
    }

    // 3. One letter difference check
    if (!isOneLetterDiff(currentWord, raw)) {
      setFeedback(`Must change exactly one letter from "${currentWord}".`, 'error');
      playErrorSound();
      return;
    }

    // 4. Dictionary check
    if (!isValidWord(raw)) {
      setFeedback(`"${raw}" is not recognized in our word list.`, 'error');
      playErrorSound();
      return;
    }

    // Start timer on first move
    if (moves === 0 && !isTimerRunning) {
      startTimer();
    }

    // Valid word accepted!
    ladder.push(raw);
    moves++;
    playValidWordSound();
    wordInput.value = '';

    // Check if won
    if (raw === currentPuzzle.targetWord) {
      handleWin();
    } else {
      setFeedback(`Accepted! Now change one letter from "${raw}".`, 'success');
      renderLadder();
      saveState();
      wordInput.focus();
    }
  }

  function handleWin() {
    isWon = true;
    stopTimer();
    playVictorySound();
    renderLadder();

    const medalInfo = calculateMedal(moves, minMoves, hintsUsed);
    const effectiveSteps = moves + hintsUsed * 1;

    // Check personal best
    const bestKey = currentDiff === 'daily' ? `daily-${currentDailyDiff}` : currentDiff;
    let isNewPb = false;
    if (!isSolutionRevealed) {
      const prevBest = bests[bestKey];
      if (!prevBest || effectiveSteps < prevBest.moves || (effectiveSteps === prevBest.moves && elapsedSeconds < prevBest.time)) {
        bests[bestKey] = { moves: effectiveSteps, time: elapsedSeconds, medal: medalInfo.medal };
        isNewPb = true;
      }

      if (currentDiff === 'daily') {
        const todayKey = `${getUtcDateKey()}-${currentDailyDiff}`;
        dailyCompleted[todayKey] = { moves: effectiveSteps, time: elapsedSeconds, medal: medalInfo.medal };
      }
    }

    saveState();

    // Populate Victory Modal
    if (victoryDiffLabel) {
      victoryDiffLabel.textContent = currentDiff === 'daily' ? `Daily (${currentDailyDiff.toUpperCase()})` : currentDiff.toUpperCase();
    }
    if (victoryTime) victoryTime.textContent = formatTime(elapsedSeconds);
    if (victoryMoves) victoryMoves.textContent = `${moves} Steps`;
    if (victoryTargetMoves) victoryTargetMoves.textContent = `${minMoves} Steps`;
    if (victoryHintsUsed) victoryHintsUsed.textContent = String(hintsUsed);
    if (victoryEffectiveScore) victoryEffectiveScore.textContent = `${effectiveSteps} Steps`;

    if (victoryMedalIcon) victoryMedalIcon.textContent = medalInfo.icon;
    if (victoryMedalTitle) victoryMedalTitle.textContent = medalInfo.title;
    if (victoryMedalDesc) victoryMedalDesc.textContent = medalInfo.desc;

    if (victorySummary) {
      const fullPath = [currentPuzzle.startWord, ...ladder];
      victorySummary.innerHTML = fullPath.map((w, idx) => `<b>${w}</b>${idx < fullPath.length - 1 ? '<span>→</span>' : ''}`).join('');
    }

    if (victoryPbBadge) {
      victoryPbBadge.hidden = !isNewPb;
    }

    if (victoryOverlay) {
      victoryOverlay.hidden = false;
    }

    setFeedback(`Congratulations! You reached ${currentPuzzle.targetWord} in ${moves} moves! (${medalInfo.title})`, 'success');
  }

  function undoLastStep() {
    if (isWon || isPaused || ladder.length === 0) return;
    const removed = ladder.pop();
    if (moves > 0) moves--;
    setFeedback(`Removed "${removed}". Current word is "${getLatestWord()}".`);
    renderLadder();
    saveState();
    if (wordInput) wordInput.focus();
  }

  function giveHint() {
    if (isWon || isPaused) return;
    const currentWord = getLatestWord();
    const used = new Set([currentPuzzle.startWord, ...ladder]);

    const nextWord = findNextHintWord(currentWord, currentPuzzle.targetWord, used);
    if (nextWord) {
      hintsUsed++;
      if (hintsEl) hintsEl.textContent = String(hintsUsed);
      const idx = getChangedIndex(currentWord, nextWord);
      setFeedback(`Hint: Try changing letter #${idx + 1} ('${currentWord[idx]}') to '${nextWord[idx]}' to form "${nextWord}". (+1 Step Penalty applied)`, 'success');
      if (wordInput) {
        wordInput.value = nextWord;
        updateSlotLetters();
        wordInput.focus();
      }
      saveState();
    } else {
      setFeedback('No direct path found without repeating words. Try undoing to a previous step.', 'error');
      playErrorSound();
    }
  }

  function revealSolution() {
    if (isWon || isPaused) return;
    if (!confirm('Reveal the full verified solution path for this puzzle?')) return;

    stopTimer();
    isSolutionRevealed = true;
    ladder = optimalPath.slice(1);
    moves = minMoves;
    isWon = true;
    renderLadder();
    saveState();
    setFeedback(`Solution revealed: ${optimalPath.join(' → ')}`, 'normal');
  }

  function restartCurrentPuzzle() {
    if (ladder.length === 0 && moves === 0) return;
    if (ladder.length > 0 && !isWon && !confirm('Restart this puzzle from the starting word?')) return;

    resetTimer();
    ladder = [];
    moves = 0;
    hintsUsed = 0;
    isWon = false;
    isSolutionRevealed = false;
    isPaused = false;
    if (pausedOverlay) pausedOverlay.hidden = true;
    if (victoryOverlay) victoryOverlay.hidden = true;

    setFeedback(`Restarted. Transform "${currentPuzzle.startWord}" to "${currentPuzzle.targetWord}".`);
    renderLadder();
    saveState();
    if (wordInput) {
      wordInput.value = '';
      updateSlotLetters();
      wordInput.focus();
    }
  }

  function loadNewPuzzle(diff: 'easy' | 'medium' | 'hard' | 'daily', dailyDiff: 'easy' | 'medium' | 'hard' = 'easy') {
    resetTimer();
    currentDiff = diff;
    if (diff === 'daily') currentDailyDiff = dailyDiff;

    isWon = false;
    isSolutionRevealed = false;
    isPaused = false;
    ladder = [];
    moves = 0;
    hintsUsed = 0;

    if (diff === 'daily') {
      if (dailySubbar) dailySubbar.hidden = false;
      const todayDaily = getDailyPuzzle(new Date(), currentDailyDiff);
      currentPuzzle = todayDaily;
      computeOptimal(todayDaily);

      // Check if user already solved today's daily
      const todayKey = `${getUtcDateKey()}-${currentDailyDiff}`;
      const completedRecord = dailyCompleted[todayKey];
      if (completedRecord) {
        // Load saved state if exists
        loadSavedPuzzle('daily', currentDailyDiff);
      }
    } else {
      if (dailySubbar) dailySubbar.hidden = true;
      const pool = diff === 'easy' ? PUZZLES_EASY : diff === 'medium' ? PUZZLES_MEDIUM : PUZZLES_HARD;
      const filtered = pool.filter(p => p.id !== currentPuzzle.id);
      const chosen = filtered[Math.floor(Math.random() * filtered.length)] || pool[0];
      currentPuzzle = chosen;
      computeOptimal(chosen);
    }

    if (pausedOverlay) pausedOverlay.hidden = true;
    if (victoryOverlay) victoryOverlay.hidden = true;

    // Update Difficulty buttons
    diffButtons.forEach(btn => {
      const btnDiff = btn.dataset.difficulty;
      const isActive = btnDiff === diff;
      btn.classList.toggle('is-active', isActive);
      btn.setAttribute('aria-pressed', String(isActive));
    });

    // Update Daily Tabs buttons
    dailyTabButtons.forEach(btn => {
      const bDiff = btn.dataset.dailyDiff;
      const isActive = bDiff === currentDailyDiff;
      btn.classList.toggle('is-active', isActive);
      btn.setAttribute('aria-pressed', String(isActive));
    });

    setFeedback(`Transform "${currentPuzzle.startWord}" into "${currentPuzzle.targetWord}". Good luck!`);
    renderLadder();
    saveState();
    if (wordInput) {
      wordInput.value = '';
      updateSlotLetters();
      wordInput.focus();
    }
  }

  function togglePause() {
    if (isWon) return;
    isPaused = !isPaused;

    if (isPaused) {
      stopTimer();
      if (pausedOverlay) pausedOverlay.hidden = false;
      if (wordInput) wordInput.disabled = true;
    } else {
      if (pausedOverlay) pausedOverlay.hidden = true;
      if (moves > 0) startTimer();
      if (wordInput) {
        wordInput.disabled = false;
        wordInput.focus();
      }
    }
  }

  function shareResult() {
    const timeStr = formatTime(elapsedSeconds);
    const medalInfo = calculateMedal(moves, minMoves, hintsUsed);
    const modeName = currentDiff === 'daily'
      ? `Daily Challenge (${currentDailyDiff.toUpperCase()})`
      : `${currentDiff.toUpperCase()} Mode`;

    const text = `PuzzleFeels Word Ladder — ${modeName}\n${medalInfo.icon} ${medalInfo.title}\n• Your Steps: ${moves}\n• Shortest Path: ${minMoves}\n• Hints (Penalty): ${hintsUsed}\n• Time: ${timeStr}\n\nPlay free: https://puzzlefeels.com/word-ladder-game-online/`;

    if (navigator.share) {
      navigator.share({ title: 'Word Ladder Game Online', text })
        .then(() => {
          if (shareStatus) shareStatus.textContent = 'Shared successfully!';
        })
        .catch(() => copyToClipboard(text));
    } else {
      copyToClipboard(text);
    }
  }

  function copyToClipboard(text: string) {
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(text).then(() => {
        if (shareStatus) shareStatus.textContent = 'Result copied to clipboard!';
        setTimeout(() => { if (shareStatus) shareStatus.textContent = ''; }, 3000);
      });
    } else {
      if (shareStatus) shareStatus.textContent = text;
    }
  }

  function toggleSound() {
    soundEnabled = !soundEnabled;
    if (soundLabel) soundLabel.textContent = `Sound: ${soundEnabled ? 'On' : 'Off'}`;
    if (soundToggleBtn) soundToggleBtn.setAttribute('aria-pressed', String(soundEnabled));
    if (soundOnIcon) (soundOnIcon as HTMLElement).hidden = !soundEnabled;
    if (soundOffIcon) (soundOffIcon as HTMLElement).hidden = soundEnabled;
    saveGlobalStats();
  }

  // Event Listeners
  submitBtn?.addEventListener('click', submitWord);
  wordInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      submitWord();
    }
  });
  wordInput?.addEventListener('input', updateSlotLetters);

  undoBtn?.addEventListener('click', undoLastStep);
  hintBtn?.addEventListener('click', giveHint);
  solutionBtn?.addEventListener('click', revealSolution);
  restartBtn?.addEventListener('click', restartCurrentPuzzle);
  newGameBtn?.addEventListener('click', () => loadNewPuzzle(currentDiff, currentDailyDiff));
  pauseBtn?.addEventListener('click', togglePause);
  resumeBtn?.addEventListener('click', togglePause);
  playAgainBtn?.addEventListener('click', () => {
    if (victoryOverlay) victoryOverlay.hidden = true;
    loadNewPuzzle(currentDiff, currentDailyDiff);
  });
  shareBtn?.addEventListener('click', shareResult);
  soundToggleBtn?.addEventListener('click', toggleSound);

  function switchDifficulty(diff: 'easy' | 'medium' | 'hard' | 'daily', dailyDiff: 'easy' | 'medium' | 'hard' = 'easy') {
    if (diff === currentDiff && diff !== 'daily') return;

    resetTimer();
    isPaused = false;
    if (pausedOverlay) pausedOverlay.hidden = true;
    if (victoryOverlay) victoryOverlay.hidden = true;

    const restored = loadSavedPuzzle(diff, dailyDiff);
    if (restored) {
      currentDiff = diff;
      if (diff === 'daily') currentDailyDiff = dailyDiff;

      if (diff === 'daily') {
        if (dailySubbar) dailySubbar.hidden = false;
      } else {
        if (dailySubbar) dailySubbar.hidden = true;
      }

      diffButtons.forEach(btn => {
        const isActive = btn.dataset.difficulty === diff;
        btn.classList.toggle('is-active', isActive);
        btn.setAttribute('aria-pressed', String(isActive));
      });

      dailyTabButtons.forEach(btn => {
        const isActive = btn.dataset.dailyDiff === currentDailyDiff;
        btn.classList.toggle('is-active', isActive);
        btn.setAttribute('aria-pressed', String(isActive));
      });

      setFeedback(`Transform "${currentPuzzle.startWord}" into "${currentPuzzle.targetWord}". Good luck!`);
      renderLadder();
      if (moves > 0 && !isWon) startTimer();
      if (wordInput) {
        wordInput.value = '';
        updateSlotLetters();
        wordInput.focus();
      }
    } else {
      loadNewPuzzle(diff, dailyDiff);
    }
  }

  // Difficulty button listeners
  diffButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const diff = btn.dataset.difficulty as 'easy' | 'medium' | 'hard' | 'daily';
      if (diff) {
        switchDifficulty(diff, currentDailyDiff);
      }
    });
  });

  // Daily Challenge tab listeners
  dailyTabButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const dDiff = btn.dataset.dailyDiff as 'easy' | 'medium' | 'hard';
      if (dDiff) {
        currentDailyDiff = dDiff;
        switchDifficulty('daily', dDiff);
      }
    });
  });

  // Initialize
  loadGlobalStats();

  const urlParams = new URLSearchParams(window.location.search);
  const wantsDaily = urlParams.get('daily') === 'today';

  if (wantsDaily) {
    loadNewPuzzle('daily', 'easy');
  } else {
    const restored = loadSavedPuzzle('easy');
    if (!restored) {
      loadNewPuzzle('easy');
    } else {
      diffButtons.forEach(btn => {
        const isActive = btn.dataset.difficulty === currentDiff;
        btn.classList.toggle('is-active', isActive);
        btn.setAttribute('aria-pressed', String(isActive));
      });
      if (moves > 0 && !isWon && !isPaused) {
        startTimer();
      }
      renderLadder();
    }
  }

  // Update initial sound UI
  if (soundLabel) soundLabel.textContent = `Sound: ${soundEnabled ? 'On' : 'Off'}`;
  if (soundToggleBtn) soundToggleBtn.setAttribute('aria-pressed', String(soundEnabled));
  if (soundOnIcon) (soundOnIcon as HTMLElement).hidden = !soundEnabled;
  if (soundOffIcon) (soundOffIcon as HTMLElement).hidden = soundEnabled;
</script>
