<script>
  import {
    isSolvable,
    isGoal,
    isMoveLegal,
    getNeighbors,
    generateSolvablePuzzle,
    formatTime
  } from '../lib/sliding-puzzle.js';

  // State definitions
  const STORAGE_KEY = 'pf-sliding-number-puzzle-v1';
  const SIZES = { easy: 3, medium: 4, hard: 5 };

  let currentDiff = 'easy'; // 'easy' | 'medium' | 'hard'
  let currentWidth = 3;
  let board = [];
  let initialBoard = [];
  let moves = 0;
  let elapsedSeconds = 0;
  let timerInterval = null;
  let isTimerRunning = false;
  let isPaused = false;
  let isWon = false;
  let soundEnabled = true;

  let undoStack = [];
  let redoStack = [];

  let bests = {
    easy: { time: null, moves: null },
    medium: { time: null, moves: null },
    hard: { time: null, moves: null }
  };

  // Audio Context (Synthesizer)
  let audioCtx = null;
  function getAudioContext() {
    if (!audioCtx && typeof window !== 'undefined') {
      const AudioCtx = window.AudioContext || window.webkitAudioContext;
      if (AudioCtx) audioCtx = new AudioCtx();
    }
    if (audioCtx && audioCtx.state === 'suspended') {
      audioCtx.resume();
    }
    return audioCtx;
  }

  function playMoveSound() {
    if (!soundEnabled) return;
    try {
      const ctx = getAudioContext();
      if (!ctx) return;
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(360, ctx.currentTime);
      osc.frequency.exponentialRampToValueAtTime(140, ctx.currentTime + 0.05);
      gain.gain.setValueAtTime(0.12, ctx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.05);
      osc.connect(gain);
      gain.connect(ctx.destination);
      osc.start();
      osc.stop(ctx.currentTime + 0.05);
    } catch {}
  }

  function playVictorySound() {
    if (!soundEnabled) return;
    try {
      const ctx = getAudioContext();
      if (!ctx) return;
      const notes = [261.63, 329.63, 392.00, 523.25]; // C4, E4, G4, C5
      notes.forEach((freq, idx) => {
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'triangle';
        osc.frequency.value = freq;
        const startTime = ctx.currentTime + idx * 0.1;
        gain.gain.setValueAtTime(0.14, startTime);
        gain.gain.exponentialRampToValueAtTime(0.001, startTime + 0.28);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start(startTime);
        osc.stop(startTime + 0.3);
      });
    } catch {}
  }

  // DOM Elements
  const boardEl = document.getElementById('slide-board');
  const movesEl = document.getElementById('slide-moves');
  const timerEl = document.getElementById('slide-timer');
  const bestMovesEl = document.getElementById('slide-best-moves');
  const bestTimeEl = document.getElementById('slide-best-time');
  const soundToggleBtn = document.getElementById('slide-sound-toggle');
  const soundLabel = document.getElementById('slide-sound-label');
  const soundOnIcon = document.querySelector('.sound-on-icon');
  const soundOffIcon = document.querySelector('.sound-off-icon');

  const pausedOverlay = document.getElementById('slide-paused');
  const resumeBtn = document.getElementById('slide-resume');

  const victoryOverlay = document.getElementById('slide-victory');
  const victoryDiffLabel = document.getElementById('victory-diff-label');
  const victoryTime = document.getElementById('victory-time');
  const victoryMoves = document.getElementById('victory-moves');
  const victoryPbBadge = document.getElementById('slide-pb-badge');
  const playAgainBtn = document.getElementById('slide-play-again');
  const shareBtn = document.getElementById('slide-share');
  const shareStatus = document.getElementById('slide-share-status');

  const newGameBtn = document.getElementById('slide-new');
  const restartBtn = document.getElementById('slide-restart');
  const undoBtn = document.getElementById('slide-undo');
  const redoBtn = document.getElementById('slide-redo');
  const pauseBtn = document.getElementById('slide-pause');
  const liveEl = document.getElementById('slide-live');

  const diffButtons = Array.from(document.querySelectorAll('.slide-diff-btn'));

  // Timer controls
  function startTimer() {
    if (isTimerRunning || isPaused || isWon) return;
    isTimerRunning = true;
    timerInterval = window.setInterval(() => {
      elapsedSeconds++;
      if (timerEl) timerEl.textContent = formatTime(elapsedSeconds);
      saveState();
    }, 1000);
  }

  function stopTimer() {
    if (timerInterval) {
      clearInterval(timerInterval);
      timerInterval = null;
    }
    isTimerRunning = false;
  }

  function resetTimer() {
    stopTimer();
    elapsedSeconds = 0;
    if (timerEl) timerEl.textContent = '00:00';
  }

  // LocalStorage Persistence
  function saveState() {
    try {
      const data = {
        version: 1,
        difficulty: currentDiff,
        board,
        initialBoard,
        moves,
        elapsedSeconds,
        undoStack,
        redoStack,
        bests,
        soundEnabled
      };
      localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
    } catch {}
  }

  function loadState() {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return false;
      const parsed = JSON.parse(raw);
      if (!parsed || parsed.version !== 1) return false;

      if (!['easy', 'medium', 'hard'].includes(parsed.difficulty)) return false;
      const width = SIZES[parsed.difficulty];
      if (!isSolvable(parsed.board, width) || !Array.isArray(parsed.initialBoard)) return false;

      currentDiff = parsed.difficulty;
      currentWidth = width;
      board = [...parsed.board];
      initialBoard = [...parsed.initialBoard];
      moves = typeof parsed.moves === 'number' ? parsed.moves : 0;
      elapsedSeconds = typeof parsed.elapsedSeconds === 'number' ? parsed.elapsedSeconds : 0;
      undoStack = Array.isArray(parsed.undoStack) ? parsed.undoStack : [];
      redoStack = Array.isArray(parsed.redoStack) ? parsed.redoStack : [];
      if (parsed.bests) bests = { ...bests, ...parsed.bests };
      if (typeof parsed.soundEnabled === 'boolean') soundEnabled = parsed.soundEnabled;

      return true;
    } catch {
      return false;
    }
  }

  // Update Board and UI
  function renderBoard() {
    if (!boardEl) return;
    boardEl.innerHTML = '';
    boardEl.className = `slide-board board-${currentWidth}`;

    const blankIndex = board.indexOf(0);
    const neighbors = getNeighbors(blankIndex, currentWidth);
    const neighborSet = new Set(neighbors);

    board.forEach((val, idx) => {
      if (val === 0) {
        const emptyCell = document.createElement('div');
        emptyCell.className = 'slide-tile slide-tile-empty';
        emptyCell.setAttribute('aria-label', 'Empty space');
        emptyCell.setAttribute('aria-hidden', 'true');
        boardEl.appendChild(emptyCell);
      } else {
        const tileBtn = document.createElement('button');
        tileBtn.type = 'button';
        const isMovable = neighborSet.has(idx);
        tileBtn.className = `slide-tile${isMovable ? ' is-movable' : ''}`;
        tileBtn.textContent = String(val);
        tileBtn.setAttribute('data-tile', String(val));
        tileBtn.setAttribute('data-index', String(idx));
        tileBtn.setAttribute('aria-label', `Tile ${val}${isMovable ? ', moveable' : ''}`);

        if (isMovable) {
          tileBtn.addEventListener('click', () => {
            handleTileClick(idx);
          });
        }
        boardEl.appendChild(tileBtn);
      }
    });

    // Update stats
    if (movesEl) movesEl.textContent = String(moves);
    if (timerEl) timerEl.textContent = formatTime(elapsedSeconds);

    const best = bests[currentDiff];
    if (bestMovesEl) bestMovesEl.textContent = best.moves !== null ? String(best.moves) : '—';
    if (bestTimeEl) bestTimeEl.textContent = best.time !== null ? formatTime(best.time) : '—';

    // Update undo/redo buttons
    if (undoBtn) (undoBtn as HTMLButtonElement).disabled = undoStack.length === 0 || isPaused || isWon;
    if (redoBtn) (redoBtn as HTMLButtonElement).disabled = redoStack.length === 0 || isPaused || isWon;

    // Update difficulty selection pills
    diffButtons.forEach(btn => {
      const match = btn.dataset.difficulty === currentDiff;
      btn.classList.toggle('is-active', match);
      btn.setAttribute('aria-pressed', String(match));
    });
  }

  function handleTileClick(tileIndex: number) {
    if (isPaused || isWon) return;
    const blankIndex = board.indexOf(0);
    if (!isMoveLegal(tileIndex, blankIndex, currentWidth)) return;

    // Start timer on very first move
    if (!isTimerRunning && moves === 0) {
      startTimer();
    }

    const tileVal = board[tileIndex];
    undoStack.push({ from: tileIndex, to: blankIndex, tile: tileVal });
    redoStack = []; // clear redo after new move

    // Swap tile into blank space
    board[blankIndex] = tileVal;
    board[tileIndex] = 0;
    moves++;

    playMoveSound();

    if (isGoal(board)) {
      handleVictory();
    } else {
      renderBoard();
      saveState();
      announceLive(`Moved tile ${tileVal}. Total moves: ${moves}`);
    }
  }

  function handleVictory() {
    isWon = true;
    stopTimer();
    playVictorySound();

    const diff = currentDiff;
    let isPb = false;
    const currentBest = bests[diff];

    if (currentBest.time === null || elapsedSeconds < currentBest.time) {
      currentBest.time = elapsedSeconds;
      isPb = true;
    }
    if (currentBest.moves === null || moves < currentBest.moves) {
      currentBest.moves = moves;
      isPb = true;
    }

    saveState();
    renderBoard();

    // Show Victory Screen
    if (victoryDiffLabel) {
      const labels = { easy: 'Easy (3×3)', medium: 'Medium (4×4)', hard: 'Hard (5×5)' };
      victoryDiffLabel.textContent = labels[diff] || diff;
    }
    if (victoryTime) victoryTime.textContent = formatTime(elapsedSeconds);
    if (victoryMoves) victoryMoves.textContent = String(moves);
    if (victoryPbBadge) victoryPbBadge.hidden = !isPb;
    if (shareStatus) shareStatus.textContent = '';
    if (victoryOverlay) victoryOverlay.hidden = false;

    announceLive(`Congratulations! Puzzle solved in ${formatTime(elapsedSeconds)} and ${moves} moves.`);
  }

  function initNewGame(difficulty = currentDiff) {
    stopTimer();
    isWon = false;
    isPaused = false;
    currentDiff = difficulty;
    currentWidth = SIZES[difficulty];

    const puzzle = generateSolvablePuzzle(currentWidth);
    board = puzzle.board;
    initialBoard = puzzle.initialBoard;
    moves = 0;
    undoStack = [];
    redoStack = [];
    resetTimer();

    if (victoryOverlay) victoryOverlay.hidden = true;
    if (pausedOverlay) pausedOverlay.hidden = true;

    renderBoard();
    saveState();
    announceLive(`New ${difficulty} game ready. Make your first move to start.`);
  }

  function restartCurrentGame() {
    if (initialBoard.length !== currentWidth * currentWidth) {
      initNewGame();
      return;
    }
    stopTimer();
    isWon = false;
    isPaused = false;
    board = [...initialBoard];
    moves = 0;
    undoStack = [];
    redoStack = [];
    resetTimer();

    if (victoryOverlay) victoryOverlay.hidden = true;
    if (pausedOverlay) pausedOverlay.hidden = true;

    renderBoard();
    saveState();
    announceLive('Puzzle restarted to initial layout.');
  }

  function undoMove() {
    if (undoStack.length === 0 || isPaused || isWon) return;
    const last = undoStack.pop();
    if (!last) return;

    redoStack.push(last);
    board[last.from] = last.tile;
    board[last.to] = 0;
    moves = Math.max(0, moves - 1);

    playMoveSound();
    renderBoard();
    saveState();
    announceLive(`Undid move. Moves: ${moves}`);
  }

  function redoMove() {
    if (redoStack.length === 0 || isPaused || isWon) return;
    const next = redoStack.pop();
    if (!next) return;

    undoStack.push(next);
    board[next.to] = next.tile;
    board[next.from] = 0;
    moves++;

    playMoveSound();

    if (isGoal(board)) {
      handleVictory();
    } else {
      renderBoard();
      saveState();
      announceLive(`Redid move. Moves: ${moves}`);
    }
  }

  function setPaused(paused: boolean) {
    if (isWon) return;
    isPaused = paused;
    if (paused) {
      stopTimer();
      if (pausedOverlay) pausedOverlay.hidden = false;
      announceLive('Game paused.');
    } else {
      if (pausedOverlay) pausedOverlay.hidden = true;
      if (moves > 0) startTimer();
      announceLive('Game resumed.');
    }
    renderBoard();
  }

  function toggleSound() {
    soundEnabled = !soundEnabled;
    if (soundLabel) soundLabel.textContent = soundEnabled ? 'Sound: On' : 'Sound: Off';
    if (soundToggleBtn) soundToggleBtn.setAttribute('aria-pressed', String(soundEnabled));
    if (soundOnIcon) soundOnIcon.toggleAttribute('hidden', !soundEnabled);
    if (soundOffIcon) soundOffIcon.toggleAttribute('hidden', soundEnabled);
    saveState();
  }

  function announceLive(msg: string) {
    if (liveEl) liveEl.textContent = msg;
  }

  // Keyboard navigation
  window.addEventListener('keydown', (event) => {
    const active = document.activeElement;
    if (active && (active.tagName === 'INPUT' || active.tagName === 'TEXTAREA' || active.tagName === 'SELECT')) {
      return;
    }
    if (isPaused || isWon) return;

    const blankIndex = board.indexOf(0);
    const blankRow = Math.floor(blankIndex / currentWidth);
    const blankCol = blankIndex % currentWidth;

    let targetIndex = -1;

    switch (event.key) {
      case 'ArrowUp':
        // Move tile below blank up into blank
        if (blankRow < currentWidth - 1) {
          targetIndex = blankIndex + currentWidth;
        }
        break;
      case 'ArrowDown':
        // Move tile above blank down into blank
        if (blankRow > 0) {
          targetIndex = blankIndex - currentWidth;
        }
        break;
      case 'ArrowLeft':
        // Move tile right of blank left into blank
        if (blankCol < currentWidth - 1) {
          targetIndex = blankIndex + 1;
        }
        break;
      case 'ArrowRight':
        // Move tile left of blank right into blank
        if (blankCol > 0) {
          targetIndex = blankIndex - 1;
        }
        break;
      default:
        return;
    }

    if (targetIndex !== -1 && isMoveLegal(targetIndex, blankIndex, currentWidth)) {
      event.preventDefault();
      handleTileClick(targetIndex);
    }
  });

  // Attach button event listeners
  newGameBtn?.addEventListener('click', () => initNewGame(currentDiff));
  restartBtn?.addEventListener('click', restartCurrentGame);
  undoBtn?.addEventListener('click', undoMove);
  redoBtn?.addEventListener('click', redoMove);
  pauseBtn?.addEventListener('click', () => setPaused(true));
  resumeBtn?.addEventListener('click', () => setPaused(false));
  soundToggleBtn?.addEventListener('click', toggleSound);

  diffButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const diff = btn.dataset.difficulty;
      if (diff && diff !== currentDiff) {
        initNewGame(diff);
      }
    });
  });

  playAgainBtn?.addEventListener('click', () => {
    initNewGame(currentDiff);
  });

  shareBtn?.addEventListener('click', async () => {
    const diffLabels = { easy: 'Easy (3×3)', medium: 'Medium (4×4)', hard: 'Hard (5×5)' };
    const text = `I solved the PuzzleFeels Sliding Number Puzzle (${diffLabels[currentDiff] || currentDiff}) in ${formatTime(elapsedSeconds)} with ${moves} moves! Can you beat my time?`;
    const shareData = {
      title: 'Sliding Number Puzzle Game on PuzzleFeels',
      text,
      url: 'https://puzzlefeels.com/sliding-number-puzzle-game/'
    };

    if (navigator.share) {
      try {
        await navigator.share(shareData);
        if (shareStatus) shareStatus.textContent = 'Result shared!';
      } catch {}
    } else if (navigator.clipboard) {
      try {
        await navigator.clipboard.writeText(`${text}\nPlay here: https://puzzlefeels.com/sliding-number-puzzle-game/`);
        if (shareStatus) shareStatus.textContent = 'Score copied to clipboard!';
      } catch {
        if (shareStatus) shareStatus.textContent = 'Could not copy score.';
      }
    }
  });

  // Initialization
  const restored = loadState();
  if (restored) {
    if (soundLabel) soundLabel.textContent = soundEnabled ? 'Sound: On' : 'Sound: Off';
    if (soundToggleBtn) soundToggleBtn.setAttribute('aria-pressed', String(soundEnabled));
    if (soundOnIcon) soundOnIcon.toggleAttribute('hidden', !soundEnabled);
    if (soundOffIcon) soundOffIcon.toggleAttribute('hidden', soundEnabled);
    renderBoard();
  } else {
    initNewGame('easy');
  }
</script>
